+"""A refused or withdrawn approval tells the agent not to work around it and to ask the user instead.
+
+Invariants:
+  1. Every block message from the approval gates (user deny, timeout, withdrawn card, smart approval, hard rule,
+     deny rule, hardline, unattended refusal, plugin approval, protected writes) ends with the same instruction:
+     do not work around the block, ask the user for explicit authorization with clarify, then wait.
+  2. The checker's rule name and reason are in the message.
+  3. A hard rule says an answer in the chat does not clear it; the others point at clarify.
+  4. Loop: denied, the agent asks with clarify, the user authorizes, and the re-run is allowed without a card.
+"""
+
+from __future__ import annotations
+
+import json
+import threading
+
+import pytest
+
+from tools import approval as mod
+from tools import approval_automode as A
+from tools import approval_context
+from tools.approval_guidance import GUIDANCE, HARD_GUIDANCE, NO_WORKAROUND, guided
+
+SESSION = "deny-guidance"
+RULE = 'Smart approval rule "Git Destructive": drops a teammate\'s commit'
+COMMAND = "git push --force origin main"
+STAGE2 = ("<block>yes</block><category>Git Destructive</category>"
+          "<reason>[Git Destructive] drops a teammate's commit</reason>")
+
+
+def _assert_guided(message, *, hard=False):
+    assert NO_WORKAROUND in message
+    assert message.count(NO_WORKAROUND) == 1
+    assert message.endswith(HARD_GUIDANCE if hard else GUIDANCE)
+    assert ("clarify" in message) is True
+    assert "wait for the answer" in message.lower()
+
+
+def test_guided_is_idempotent_and_names_the_reason_once():
+    once = guided("BLOCKED: nope.", reason="rule X")
+    assert once.count("(Flagged by rule X.)") == 1
+    assert once.index("Flagged by") < once.index(NO_WORKAROUND)
+    assert guided(once, reason="rule X") == once
+    assert guided("BLOCKED: rule X nope.", reason="rule X").count("Flagged by") == 0
+
+
+@pytest.fixture()
+def gateway(monkeypatch):
+    mod._gateway_queues.clear()
+    mod._gateway_notify_cbs.clear()
+    mod._session_approved.clear()
+    for k in ("HERMES_CRON_SESSION", "HERMES_YOLO_MODE", "HERMES_INTERACTIVE"):
+        monkeypatch.delenv(k, raising=False)
+    monkeypatch.setenv("HERMES_GATEWAY_SESSION", "1")
+    monkeypatch.setenv("HERMES_EXEC_ASK", "1")
+    monkeypatch.setenv("HERMES_SESSION_KEY", SESSION)
+    monkeypatch.setattr(mod, "_YOLO_MODE_FROZEN", False)
+    cfg = {"mode": "manual", "timeout": 60}
+    monkeypatch.setattr(approval_context, "_get_approval_config", lambda: cfg)
+    monkeypatch.setattr(approval_context, "_get_approval_mode", lambda: cfg["mode"])
+    yield cfg
+    mod._gateway_queues.clear()
+    mod._gateway_notify_cbs.clear()
+
+
+def _answering(choice, reason=None, **kw):
+    def notify(_data):
+        threading.Timer(0.05, lambda: mod.resolve_gateway_approval(SESSION, choice, reason=reason)).start()
+    mod.register_gateway_notify(SESSION, notify)
+
+
+def test_user_deny_in_gateway(gateway):
+    _answering("deny", reason="not now")
+    result = mod.check_all_command_guards("rm -rf .git", "local")
+    assert result["approved"] is False and result["outcome"] == "denied"
+    assert 'Reason given by the user: "not now"' in result["message"]
+    assert "rm -rf" in result["message"] or "delete" in result["message"].lower() or "Flagged by" in result["message"]
+    _assert_guided(result["message"])
+
+
+def test_withdrawn_card_and_timeout(gateway, monkeypatch):
+    from tools.interrupt import set_interrupt
+    notified = threading.Event()
+    mod.register_gateway_notify(SESSION, lambda _d: notified.set())
+    holder = {}
+
+    def worker():
+        holder["tid"] = threading.get_ident()
+        holder["result"] = mod.check_all_command_guards("rm -rf .git", "local")
+
+    thread = threading.Thread(target=worker)
+    thread.start()
+    assert notified.wait(10)
+    set_interrupt(True, holder["tid"], reason="gateway shutdown")
+    try:
+        thread.join(10)
+    finally:
+        set_interrupt(False, holder["tid"])
+    result = holder["result"]
+    assert result["outcome"] == "cancelled" and "gateway shutdown" in result["message"]
+    _assert_guided(result["message"])
+
+
+def test_execute_code_denied_and_withdrawn(gateway):
+    _answering("deny")
+    result = mod.check_execute_code_guard("print(1)", "local")
+    assert result["approved"] is False
+    _assert_guided(result["message"])
+
+
+def test_hardline_and_deny_rule_say_the_chat_does_not_clear_them(gateway, monkeypatch):
+    result = mod.check_all_command_guards("rm -rf /", "local")
+    assert result.get("hardline") is True
+    _assert_guided(result["message"], hard=True)
+    cfg = {"mode": "manual", "deny": ["git push *"]}
+    monkeypatch.setattr(approval_context, "_get_approval_config", lambda: cfg)
+    result = mod.check_all_command_guards("git push origin main", "local")
+    assert result.get("user_deny") is True and "git push *" in result["message"]
+    _assert_guided(result["message"], hard=True)
+
+
+def test_unattended_refusal_names_the_pattern_and_asks(gateway, monkeypatch):
+    for k in ("HERMES_GATEWAY_SESSION", "HERMES_EXEC_ASK"):
+        monkeypatch.delenv(k, raising=False)
+    monkeypatch.setenv("HERMES_CRON_SESSION", "1")
+    monkeypatch.setattr(approval_context, "_get_cron_approval_mode", lambda: "deny")
+    result = mod.check_all_command_guards("chmod 777 /srv/x", "local")
+    assert result["approved"] is False
+    assert "world/other-writable" in result["message"]
+    _assert_guided(result["message"])
+
+
+def test_plugin_approval_denied(gateway):
+    from hermes_cli.plugins import _PreToolCallDirective, _resolve_block_from_details
+    _answering("deny")
+    details = _PreToolCallDirective(action="approve", message="Sign in on example.com", rule_key="browser:login:x")
+    block = _resolve_block_from_details(details, "browser_login")
+    assert block and "Sign in on example.com" in block
+    _assert_guided(block)
+
+
+def test_protected_write_denied(gateway, tmp_path, monkeypatch):
+    from tools import file_tools_write_guards as g
+    _answering("deny")
+    block = g._request_protected_instruction_approval(["AGENTS.md"])
+    assert block and "AGENTS.md" in block
+    assert block.endswith(GUIDANCE)
+
+
+# --- the loop: denied, the agent asks with clarify, the user authorizes, the re-run is allowed --------------
+
+QUESTION = f"May I run `{COMMAND}`? It drops a teammate's commit (Git Destructive)."
+CHOICE = "Yes, force push to main"
+
+
+def _answer(value):
+    return json.dumps({"responses": [{"question": QUESTION, "choices_offered": [CHOICE, "No"], "status": "answered",
+                                      "user_response": value}], "outcome": "submitted"})
+
+
+class _Agent:
+    def __init__(self, messages):
+        self.session_id = SESSION
+        self._session_db = None
+        self._approval_review_messages = messages
+
+
+@pytest.fixture()
+def reviewer(monkeypatch):
+    """Sonnet-like judge: blocks the force push unless a User line says yes to it."""
+    def complete(stage, system, user, max_tokens):
+        transcript = user.partition("<action>")[0]
+        said = any("force push to main" in line and "User:" in line for line in transcript.splitlines())
+        if said:
+            return "<block>no</block>"
+        return "<block>yes</block>" if stage == 1 else STAGE2
+    A.set_complete_override(complete)
+    yield
+    A.set_complete_override(None)
+
+
+def test_denied_then_clarify_authorization_lets_the_rerun_pass_without_a_card(gateway, reviewer, monkeypatch):
+    gateway.update(mode="smart", smart_provenance=True)
+    messages = [{"role": "user", "content": "Land the fix on main"}]
+    agent = _Agent(messages)
+    monkeypatch.setattr(A, "_current_agent", lambda: agent)
+    cards = []
+
+    def deny_card(data):
+        cards.append(data)
+        threading.Timer(0.05, lambda: mod.resolve_gateway_approval(SESSION, "deny")).start()
+
+    mod.register_gateway_notify(SESSION, deny_card)
+    first = mod.check_all_command_guards(COMMAND, "local")
+    assert first["approved"] is False and len(cards) == 1
+    assert "Git Destructive" in first["message"] and "drops a teammate's commit" in first["message"]
+    _assert_guided(first["message"])
+
+    messages += [
+        {"role": "assistant", "content": "", "tool_calls": [
+            {"id": "c1", "type": "function", "function": {"name": "clarify", "arguments": json.dumps(
+                {"questions": [{"question": QUESTION, "choices": [CHOICE, "No"]}]})}}]},
+        {"role": "tool", "tool_call_id": "c1", "content": _answer(CHOICE)},
+    ]
+    second = mod.check_all_command_guards(COMMAND, "local")
+    assert second["approved"] is True and len(cards) == 1, "no second card"
+
+
+def test_a_clarify_no_does_not_authorize(gateway, reviewer, monkeypatch):
+    gateway.update(mode="smart", smart_provenance=True)
+    messages = [
+        {"role": "user", "content": "Land the fix on main"},
+        {"role": "assistant", "content": "", "tool_calls": [
+            {"id": "c1", "type": "function", "function": {"name": "clarify", "arguments": json.dumps(
+                {"questions": [{"question": QUESTION, "choices": [CHOICE, "No"]}]})}}]},
+        {"role": "tool", "tool_call_id": "c1", "content": _answer("No")},
+    ]
+    monkeypatch.setattr(A, "_current_agent", lambda: _Agent(messages))
+    _answering("deny")
+    assert mod.check_all_command_guards(COMMAND, "local")["approved"] is False
+
