--- /dev/null
+++ b/tools/approval_guidance.py
@@ -0,0 +1,50 @@
+"""What every refused or withdrawn approval tells the agent to do next.
+
+One instruction ends every block message: do not work around the block, and if the action is still needed ask the
+user for explicit authorization, with the exact action, why it is needed and the checker's reason. The user's answer
+to that question (a ``clarify`` answer) is read as the user's own words by the smart approval review, so the same
+action can then run again.
+"""
+
+from __future__ import annotations
+
+NO_WORKAROUND = "Do NOT work around this block"
+
+_WORKAROUND = (
+    f" {NO_WORKAROUND}: no other tool, script, rephrased command, or splitting it into smaller steps to reach "
+    "the same outcome."
+)
+_ASK = (
+    " If the action is still needed, ask the user for explicit authorization with the clarify tool (in your reply "
+    "if clarify is unavailable; a subagent's reply goes to its parent, which asks the user), stating the exact "
+    "action, why it is needed, and the checker's reason given above. Then wait for the answer."
+)
+_HARD = (
+    " An answer in the chat does not clear this rule; the user can run the action themselves outside the agent or "
+    "change the rule. If the action is still needed, tell the user with the clarify tool (in your reply if clarify "
+    "is unavailable) the exact action, why it is needed, and the checker's reason given above. Then wait for the "
+    "answer."
+)
+
+GUIDANCE = _WORKAROUND + _ASK
+HARD_GUIDANCE = _WORKAROUND + _HARD
+
+
+def with_reason(message: str, reason: str | None) -> str:
+    """*message* with ``(Flagged by <reason>.)`` before the guidance (or at the end), unless it names the reason."""
+    reason = (reason or "").strip().rstrip(".")
+    if not reason or reason in message:
+        return message
+    note = f" (Flagged by {reason}.)"
+    at = message.find(f" {NO_WORKAROUND}")
+    if at < 0:
+        return message.rstrip() + note
+    return message[:at].rstrip() + note + message[at:]
+
+
+def guided(message: str, *, reason: str | None = None, hard: bool = False) -> str:
+    """*message* followed by the no-workaround instruction, once, with the checker's *reason* named in it."""
+    message = with_reason(message or "BLOCKED.", reason)
+    if NO_WORKAROUND in message:
+        return message
+    return message.rstrip() + (HARD_GUIDANCE if hard else GUIDANCE)
