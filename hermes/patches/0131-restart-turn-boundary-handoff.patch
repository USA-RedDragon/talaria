index 318b9e4b..c7afa06a 100644
--- a/hermes_state_runtime.py
+++ b/hermes_state_runtime.py
@@ -238,6 +238,15 @@ def claim_session_input(db, *, epoch: int, session_id: str, _guard=None, head=_A
