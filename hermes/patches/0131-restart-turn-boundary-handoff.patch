     return db._execute_write(write)
 
 
+RESUME_PREFIX = 'gateway.turn_resume.v1.'
+
+
+def hand_off_session_input(db, *, epoch: int, admission_id: str, generation: int, record: dict,
+                           transfers=None) -> dict:
+    """``gateway.restart_turn_handoff_boundary``: the running claim stopped at a step boundary for a restart,
+    so it goes back to its FIFO place (``seq``) for the next owner, with ``record`` (what the resume needs:
+    its parked prompts) under ``RESUME_PREFIX + admission_id``. Unlike recovery this requeues started work:
+    its owner stopped it at a point where every finished step is durable and nothing is half done. Steers
+    it carried settle as in a completed claim (a delivered text is in the transcript the resume reads)."""
+    def write(conn):
+        _epoch(conn, epoch)
+        row = _admission(conn, admission_id)
+        session = _session(conn, row['target_session_id'])
+        if (row['status'] != 'started' or row['owner_epoch'] != epoch or type(generation) is not int
+                or row['generation'] != generation or session['runtime_generation'] != generation):
+            raise RuntimeStoreError('stale_generation')
+        conn.execute('INSERT INTO state_meta(key,value) VALUES(?,?) '
+                     'ON CONFLICT(key) DO UPDATE SET value=excluded.value',
+                     (RESUME_PREFIX + admission_id, _json(record)))
+        conn.execute("UPDATE session_admissions SET status='queued',outcome=NULL,generation=NULL "
+                     "WHERE admission_id=?", (admission_id,))
+        settle_steer_transfers(conn, epoch=epoch, generation=generation, transfers=transfers, outcome='completed')
+        conn.execute('UPDATE sessions SET runtime_revision=runtime_revision+1 WHERE id=?', (row['target_session_id'],))
+        return _row(_admission(conn, admission_id))
+    return db._execute_write(write)
+
+
+def update_resume_record(db, *, admission_id: str, record: dict) -> bool:
+    """Rewrite the resume record of a handed-off admission that is still queued (an answer to its parked
+    prompt arrived after the handoff); False when it is gone or no longer queued."""
+    def write(conn):
+        row = conn.execute('SELECT status FROM session_admissions WHERE admission_id=?', (admission_id,)).fetchone()
+        if row is None or row[0] != 'queued':
+            return False
+        return conn.execute('UPDATE state_meta SET value=? WHERE key=?',
+                            (_json(record), RESUME_PREFIX + admission_id)).rowcount == 1
+    return db._execute_write(write)
+
+
+def resume_records(db) -> dict:
+    """``{admission_id: record}`` of every handed-off admission still queued for its resume."""
+    rows = db._read_all("SELECT m.key, m.value FROM state_meta m JOIN session_admissions a "
+                        "ON a.admission_id = substr(m.key, ?) WHERE m.key >= ? AND m.key < ? AND a.status='queued'",
+                        (len(RESUME_PREFIX) + 1, RESUME_PREFIX, RESUME_PREFIX + '\uffff'))
+    out = {}
+    for key, value in rows:
+        try:
+            out[key[len(RESUME_PREFIX):]] = json.loads(value)
+        except (TypeError, ValueError):
+            continue
+    return out
+
+
+def resume_record(db, *, admission_id: str) -> dict | None:
+    with db._read_ctx() as conn:
+        row = conn.execute('SELECT value FROM state_meta WHERE key=?', (RESUME_PREFIX + admission_id,)).fetchone()
+    try:
+        return None if row is None else json.loads(row[0])
+    except (TypeError, ValueError):
+        return {}
+
+
 _CANCEL_QUEUED = "UPDATE session_admissions SET status='terminal',outcome='cancelled' WHERE admission_id=?"
 
 
diff --git a/tests/agent/test_turn_boundary_handoff.py b/tests/agent/test_turn_boundary_handoff.py
new file mode 100644
index 00000000..ea6958b7
--- /dev/null
+++ b/tests/agent/test_turn_boundary_handoff.py
@@ -0,0 +1,203 @@
+"""gateway.restart_turn_handoff_boundary, agent side: a turn asked to hand off stops at its next step boundary
+(nothing cut, nothing written that is not a finished step) and the next gateway's agent resumes it from the
+durable transcript: no second user row, no synthetic text, no repeated model call or tool run."""
+import json
+import tempfile
+from pathlib import Path
+from types import SimpleNamespace
+from unittest.mock import MagicMock, patch
+
+import pytest
+
+from agent import turn_boundary_handoff as boundary
+from hermes_state import SessionDB
+from run_agent import AIAgent
+
+
+@pytest.fixture(autouse=True)
+def _quiet(monkeypatch):
+    monkeypatch.setattr("agent.title_generator.maybe_auto_title", lambda *args, **kwargs: None)
+
+
+def _tool_defs(*names):
+    return [{"type": "function", "function": {"name": n, "description": n, "parameters": {"type": "object", "properties": {}}}}
+            for n in names]
+
+
+def _agent(db, session_id):
+    home = Path(tempfile.mkdtemp(prefix="hermes-test-home-"))
+    (home / "logs").mkdir(parents=True, exist_ok=True)
+    with (patch("model_tools.get_tool_definitions", return_value=_tool_defs("web_search")),
+          patch("model_tools.check_toolset_requirements", return_value={}),
+          patch("agent.process_bootstrap.OpenAI"),
+          patch("run_agent._hermes_home", home),
+          patch("agent.model_metadata.fetch_model_metadata", return_value={})):
+        agent = AIAgent(api_key="test-key", base_url="https://openrouter.ai/api/v1", quiet_mode=True,
+                        skip_context_files=True, skip_memory=True)
+    agent.client = MagicMock()
+    agent._cached_system_prompt = "You are helpful."
+    agent._use_prompt_caching = False
+    agent.compression_enabled = False
+    agent.save_trajectories = False
+    agent._session_db = db
+    agent._session_db_created = True
+    agent.session_id = session_id
+    agent._last_flushed_db_idx = 0
+    agent._flushed_db_message_ids = set()
+    agent._flushed_db_message_session_id = None
+    agent._persist_disabled = False
+    return agent
+
+
+def _call(call_id="c1"):
+    return SimpleNamespace(id=call_id, type="function", function=SimpleNamespace(name="web_search", arguments="{}"))
+
+
+def _response(content="", tool_calls=None):
+    msg = SimpleNamespace(content=content, tool_calls=tool_calls)
+    return SimpleNamespace(choices=[SimpleNamespace(message=msg, finish_reason="tool_calls" if tool_calls else "stop")],
+                           model="test/model", usage=None)
+
+
+def _db(tmp_path, session_id="s1"):
+    db = SessionDB(db_path=tmp_path / "state.db")
+    db.create_session(session_id=session_id, source="tui", model="test/model")
+    return db
+
+
+def _rows(tmp_path, session_id="s1"):
+    db = SessionDB(db_path=tmp_path / "state.db")
+    try:
+        return db.get_messages_as_conversation(session_id)
+    finally:
+        db.close()
+
+
+def _run(agent, text, history=None):
+    with (patch.object(agent, "_persist_session"), patch.object(agent, "_save_trajectory"),
+          patch.object(agent, "_cleanup_task_resources")):
+        return agent.run_conversation(text, conversation_history=history)
+
+
+def _resume(tmp_path, final="done"):
+    """The next gateway: a fresh agent on the same store resumes the handed-off turn."""
+    db = SessionDB(db_path=tmp_path / "state.db")
+    agent = _agent(db, "s1")
+    agent.client.chat.completions.create.side_effect = [_response(final)]
+    history = db.get_messages_as_conversation("s1")
+    text = boundary.adopt_turn(history, agent)
+    return agent, _run(agent, text, history), db
+
+
+def _assert_one_clean_turn(rows):
+    assert [r["role"] for r in rows].count("user") == 1
+    blob = json.dumps(rows)
+    assert "Hermes restarted" not in blob and "Gateway restarting" not in blob
+    assert not any(r.get("display_kind") == "failed_turn" for r in rows)
+
+
+def test_boundary_after_the_model_call_runs_the_tools_once_on_the_next_gateway(tmp_path):
+    db = _db(tmp_path)
+    agent = _agent(db, "s1")
+    tools = []
+
+    def model(**kwargs):
+        boundary.request(agent)  # the restart asks while the call streams
+        return _response("Searching now.", [_call()])
+
+    agent.client.chat.completions.create.side_effect = model
+    with patch("model_tools.handle_function_call", side_effect=lambda *a, **k: tools.append(1) or "result-1"):
+        result = _run(agent, "search something")
+        assert result["handed_off"] is True and result["final_response"] == ""
+        assert result["failed"] is False and result["interrupted"] is False
+        assert tools == []  # the tool round had not started: it runs on the next gateway
+        assert agent.client.chat.completions.create.call_count == 1
+        assert [r["role"] for r in _rows(tmp_path)] == ["user", "assistant"]
+
+        resumed, final, _ = _resume(tmp_path)
+    assert final["final_response"] == "done" and not final.get("handed_off")
+    assert tools == [1]  # exactly once, across both gateways
+    assert resumed.client.chat.completions.create.call_count == 1  # no model call to decide what to redo
+    sent = resumed.client.chat.completions.create.call_args.kwargs["messages"]
+    assert [m["role"] for m in sent if m["role"] != "system"] == ["user", "assistant", "tool"]
+    rows = _rows(tmp_path)
+    assert [r["role"] for r in rows] == ["user", "assistant", "tool", "assistant"]
+    assert rows[2]["tool_call_id"] == "c1" and "result-1" in rows[2]["content"]
+    _assert_one_clean_turn(rows)
+
+
+def test_boundary_after_a_tool_round_keeps_its_result_and_calls_the_model_once(tmp_path):
+    db = _db(tmp_path)
+    agent = _agent(db, "s1")
+    tools = []
+
+    def tool(*args, **kwargs):
+        boundary.request(agent)  # the restart asks while the tool runs: the tool finishes
+        tools.append(1)
+        return "result-1"
+
+    agent.client.chat.completions.create.side_effect = [_response("", [_call()])]
+    with patch("model_tools.handle_function_call", side_effect=tool):
+        result = _run(agent, "search something")
+        assert result["handed_off"] is True
+        assert tools == [1]
+        assert agent.client.chat.completions.create.call_count == 1  # stopped before the next model call
+        assert [r["role"] for r in _rows(tmp_path)] == ["user", "assistant", "tool"], _rows(tmp_path)
+        resumed, final, _ = _resume(tmp_path)
+    assert final["final_response"] == "done"
+    assert tools == [1]  # the finished tool is not run again
+    assert resumed.client.chat.completions.create.call_count == 1
+    rows = _rows(tmp_path)
+    assert [r["role"] for r in rows] == ["user", "assistant", "tool", "assistant"]
+    _assert_one_clean_turn(rows)
+
+
+def test_withdrawn_prompt_leaves_its_call_unexecuted_and_unwritten(tmp_path):
+    db = _db(tmp_path)
+    agent = _agent(db, "s1")
+
+    def parked(*args, **kwargs):
+        boundary.withdraw(agent)  # the gateway hands the parked turn off; the prompt's wait ends
+        return "BLOCKED: cancelled"
+
+    agent.client.chat.completions.create.side_effect = [_response("", [_call()])]
+    with patch("model_tools.handle_function_call", side_effect=parked):
+        result = _run(agent, "search something")
+    assert result["handed_off"] is True and result["final_response"] == ""
+    assert [r["role"] for r in _rows(tmp_path)] == ["user", "assistant"]
+    assert not boundary.withdrawn(agent) and not boundary.requested(agent)  # the cached agent is clean again
+    with patch("model_tools.handle_function_call", return_value="answered") as run:
+        _, final, _ = _resume(tmp_path)
+    assert run.call_count == 1 and final["final_response"] == "done"
+    _assert_one_clean_turn(_rows(tmp_path))
+
+
+def test_without_a_request_the_turn_is_unchanged(tmp_path):
+    db = _db(tmp_path)
+    agent = _agent(db, "s1")
+    agent.client.chat.completions.create.side_effect = [_response("", [_call()]), _response("done")]
+    with patch("model_tools.handle_function_call", return_value="result-1") as run:
+        result = _run(agent, "search something")
+    assert result["final_response"] == "done" and "handed_off" not in result
+    assert run.call_count == 1
+    assert [r["role"] for r in _rows(tmp_path)] == ["user", "assistant", "tool", "assistant"]
+
+
+def test_a_cancelled_request_does_not_stop_the_turn(tmp_path):
+    db = _db(tmp_path)
+    agent = _agent(db, "s1")
+    boundary.request(agent)
+    boundary.cancel(agent)
+    agent.client.chat.completions.create.side_effect = [_response("done")]
+    assert _run(agent, "hi")["final_response"] == "done"
+
+
+def test_pending_tool_calls_names_only_unanswered_calls():
+    rows = [{"role": "user", "content": "x"},
+            {"role": "assistant", "content": "", "tool_calls": [{"id": "a", "function": {"name": "t", "arguments": "{}"}},
+                                                                {"id": "b", "function": {"name": "t", "arguments": "{}"}}]},
+            {"role": "tool", "tool_call_id": "a", "content": "ok"}]
+    row, calls = boundary.pending_tool_calls(rows)
+    assert row is rows[1] and [c["id"] for c in calls] == ["b"]
+    rows.append({"role": "tool", "tool_call_id": "b", "content": "ok"})
+    assert boundary.pending_tool_calls(rows) == (None, [])
diff --git a/tests/gateway/test_restart_turn_boundary.py b/tests/gateway/test_restart_turn_boundary.py
new file mode 100644
index 00000000..2f183041
--- /dev/null
+++ b/tests/gateway/test_restart_turn_boundary.py
@@ -0,0 +1,329 @@
+"""gateway.restart_turn_handoff_boundary, gateway side: a restart hands a running turn to the next gateway at
+a step boundary. The admission goes back to its FIFO place with a resume record (no settlement, reply, notice
+or failed-turn row); the next owner's claim resumes it without synthetic text; a parked clarify or approval
+keeps its prompt id, stays answerable on both owners, is applied once and is not reviewed twice."""
+import asyncio
+import threading
+import time
+from types import SimpleNamespace
+
+import pytest
+
+from gateway import turn_boundary, turn_handoff
+from gateway.config import GatewayConfig
+from gateway.session_events import SessionEvents
+from gateway.session_pending_controls import PendingControls
+from hermes_state import SessionDB
+from hermes_state_runtime import (
+    admit_session_input, begin_runtime_epoch, claim_session_input, get_session_admission,
+    hand_off_session_input, recover_session_inputs, resume_record, resume_records,
+)
+from tools import clarify_gateway, prompt_handoff
+
+
+@pytest.fixture(autouse=True)
+def _clean(monkeypatch):
+    monkeypatch.setattr(turn_handoff, "_handing_off", False)
+    monkeypatch.setattr(turn_boundary, "_resuming", set())
+    monkeypatch.setattr(turn_boundary, "_handed_off", set())
+    prompt_handoff.clear()
+    yield
+    prompt_handoff.clear()
+    clarify_gateway.clear_session("route-1")
+
+
+def _store(tmp_path):
+    db = SessionDB(db_path=tmp_path / "state.db")
+    db.create_session(session_id="s1", source="telegram", model="m")
+    return db
+
+
+def _started(db, epoch):
+    row = admit_session_input(db, epoch=epoch, principal_id="p", session_id="s1", request_id="r1",
+                              payload={"text": "do the thing"})
+    claimed = claim_session_input(db, epoch=epoch, session_id="s1")
+    assert claimed["admission_id"] == row["admission_id"] and "resume" not in claimed
+    return claimed
+
+
+def _authority(db, epoch, generation, admission_id, agent):
+    events = SessionEvents()
+    events.execution = {"authority_epoch": epoch, "execution_generation": generation, "admission_id": admission_id}
+    live = SimpleNamespace(event_stream=events, controls=PendingControls(events), route="route-1")
+    return SimpleNamespace(db=db, epoch=epoch, sessions={"s1": live}, adopted={"s1": (generation, agent)},
+                           executing={"s1": generation}, pending_results={}, pending_deliveries={},
+                           steer_transfers={})
+
+
+def _runner(authority, wait=0.0):
+    cfg = GatewayConfig(restart_turn_handoff=True, restart_turn_handoff_boundary=True,
+                        restart_turn_handoff_wait_seconds=wait)
+    return SimpleNamespace(config=cfg, _restart_requested=True, session_authority=authority, session_authorities=None)
+
+
+def test_off_by_default_and_needs_restart_turn_handoff():
+    assert GatewayConfig().restart_turn_handoff_boundary is False
+    cfg = GatewayConfig.from_dict({"gateway": {"restart_turn_handoff": True, "restart_turn_handoff_boundary": True}})
+    assert cfg.restart_turn_handoff_boundary is True
+    assert turn_boundary.enabled(SimpleNamespace(config=cfg, _restart_requested=True)) is True
+    alone = GatewayConfig.from_dict({"gateway": {"restart_turn_handoff_boundary": True}})
+    assert turn_boundary.enabled(SimpleNamespace(config=alone, _restart_requested=True)) is False
+    assert turn_boundary.enabled(SimpleNamespace(config=GatewayConfig(restart_turn_handoff=True),
+                                                 _restart_requested=True)) is False
+
+
+def test_handed_off_admission_is_requeued_and_resumed_by_exactly_one_claim(tmp_path):
+    db = _store(tmp_path)
+    old = begin_runtime_epoch(db, instance_id="old")
+    claimed = _started(db, old)
+    hand_off_session_input(db, epoch=old, admission_id=claimed["admission_id"], generation=claimed["generation"],
+                           record={"prompts": []})
+    row = get_session_admission(db, admission_id=claimed["admission_id"])
+    assert row["status"] == "queued" and row["outcome"] is None
+    assert resume_records(db) == {claimed["admission_id"]: {"prompts": []}}
+
+    new = begin_runtime_epoch(db, instance_id="new")
+    assert recover_session_inputs(db, epoch=new) == 0  # never fenced unknown: it is queued, not started
+    resumed = claim_session_input(db, epoch=new, session_id="s1")
+    assert resumed["admission_id"] == claimed["admission_id"] and resumed["resume"] == {"prompts": []}
