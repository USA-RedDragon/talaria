+    _parked_clarify(authority, claimed["generation"])
+    started = time.monotonic()
+    assert await turn_boundary.hand_off_at_boundaries(_runner(authority), 30.0) == 1
+    assert time.monotonic() - started < 5.0  # a parked turn is at a boundary: no wait
+    assert agent.interrupted.is_set() and agent._handoff_withdrawn is True
+    # Still listed and answerable on the old owner until it exits (no prompt.lost while both run).
+    live = authority.sessions["s1"]
+    assert [p["prompt_id"] for p in live.controls.snapshot("s1", None)] == ["cq-1"]
+    record = resume_record(db, admission_id=claimed["admission_id"])
+    assert record["prompts"][0]["prompt_id"] == "cq-1" and record["prompts"][0]["question"] == "Pick a color"
+    clarify_gateway.clear_session("route-1")  # the old process is gone
+
+    # The next owner: the prompt waits under its old id before any claim and is listed for viewers.
+    new = begin_runtime_epoch(db, instance_id="new")
+    new_auth = _authority(db, new, None, None, None)
+    new_auth.sessions["s1"].event_stream.execution = {}
+    runner = _runner(new_auth)
+    assert turn_boundary.restore_prompts(runner) == 1
+    turn_boundary.show_prompts(runner)
+    controls = new_auth.sessions["s1"].controls
+    assert [p["prompt_id"] for p in controls.snapshot("s1", None)] == ["cq-1"]
+    # The user answers the same card on the new owner (no running turn yet: no generation to match).
+    assert controls.respond("s1", 123, "cq-1", {"answer": "green"}, kind="clarify")["status"] == "resolved"
+    assert controls.respond("s1", 123, "cq-1", {"answer": "blue"}, kind="clarify")["status"] == "already_resolved"
+    # The resumed clarify call adopts it: same id, the answer read at once, no new card.
+    handed = prompt_handoff.take_clarify("route-1", "Pick a color", ["blue", "green"])
+    assert handed is not None and handed.clarify_id == "cq-1"
+    from gateway.run_turn_runner_clarify_delivery import wait_handed_over
+    assert wait_handed_over(handed.clarify_id, clarify_gateway) == ("green", True)
+    assert prompt_handoff.take_clarify("route-1", "Pick a color", ["blue", "green"]) is None
