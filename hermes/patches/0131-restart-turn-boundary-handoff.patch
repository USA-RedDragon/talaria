+def _parked_clarify(authority, generation):
+    live = authority.sessions["s1"]
+    entry = clarify_gateway.register("cq-1", "route-1", "Pick a color", ["blue", "green"])
+    live.controls.register_clarify("s1", generation, entry, timeout_s=1800)
+    return entry
