diff --git a/gateway/turn_boundary.py b/gateway/turn_boundary.py
new file mode 100644
index 00000000..ed9325aa
--- /dev/null
+++ b/gateway/turn_boundary.py
@@ -0,0 +1,339 @@
+"""``gateway.restart_turn_handoff_boundary`` (false = off): a restart hands each running chat turn to the
+next gateway at a step boundary, so the user sees nothing cut, repeated or restarted.
+
+It refines ``gateway.restart_turn_handoff`` (``gateway.turn_handoff``), which stops every running turn at
+once and has the next gateway queue a continuation turn with a synthetic message. With this key the
+restart instead asks each running turn (``agent.turn_boundary_handoff.request``) to stop at its next
+step boundary, and waits up to ``gateway.restart_turn_handoff_wait_seconds`` for every turn to get there:
+
+* a turn that reaches a boundary (its model call streamed and persisted, its tool round finished and
+  persisted) ends with ``handed_off`` and nothing else. The drain puts its admission back at its FIFO
+  place (``hermes_state_runtime.hand_off_session_input``) instead of settling it: no reply, failed-turn
+  row or notice;
+* a turn parked on a clarify question or an approval card counts as at a boundary. When the wait ends
+  its prompt records (id, kind, card, smart verdict) go into the same resume record, the turn is
+  withdrawn (the pending tool call stays unexecuted and unwritten), and the prompt stays answerable
+  here until this process exits: an answer given now is written into the resume record and applies
+  once, on the next gateway;
+* a turn still between boundaries when the wait ends is stopped as ``restart_turn_handoff`` does.
+
+The next gateway claims the handed-off admission like any queued one. The claim carries the resume
+record (``claim_session_input``); the turn adopts its own transcript rows instead of writing a new user
+row, runs exactly the tool calls its last step left without a result (a re-raised prompt adopts the old
+card: same id, no second review, an answer already given is read at once), then goes on with the model.
+Its prompts are registered with the viewers before any claim, so a viewer that reattaches still lists
+them under the same id.
+"""
+from __future__ import annotations
+
+import asyncio
+import logging
+from contextvars import ContextVar
+from typing import Any
+
+logger = logging.getLogger(__name__)
+
+# The resume record of the handed-off turn this claim runs (``gateway.session_ingress.execute_admission``).
+resume_turn: ContextVar[dict | None] = ContextVar("resume_turn", default=None)
+
+# Admission ids queued for a resume: a viewer must not see one as a new pending input.
+_resuming: set[str] = set()
+# Admission ids this process handed off (the 0048 export skips them).
+_handed_off: set[str] = set()
+
+
+def enabled(runner) -> bool:
+    from gateway import turn_handoff
+    return bool(turn_handoff.enabled(runner)
+                and getattr(getattr(runner, "config", None), "restart_turn_handoff_boundary", False))
+
+
+def configured(runner) -> bool:
+    cfg = getattr(runner, "config", None)
+    return bool(getattr(cfg, "restart_turn_handoff", False) and getattr(cfg, "restart_turn_handoff_boundary", False))
+
+
+def is_resuming(admission_id) -> bool:
+    return admission_id in _resuming
+
+
+def handed_off_here(admission_id) -> bool:
+    return admission_id in _handed_off
+
+
+# ── the outgoing gateway ─────────────────────────────────────────────────────────────────────────────
+
+
+class _Turn:
+    __slots__ = ("authority", "session_id", "live", "generation", "admission_id", "agent")
+
+    def __init__(self, authority, session_id, live, generation, admission_id, agent):
+        self.authority, self.session_id, self.live = authority, session_id, live
+        self.generation, self.admission_id, self.agent = generation, admission_id, agent
+
+
+def _turns(runner) -> list[_Turn]:
+    """The running canonical turns whose agent runs in this process."""
+    from gateway.session_authorities import all_authorities
+    turns = []
+    for authority in all_authorities(runner):
+        for session_id, live in list((getattr(authority, "sessions", None) or {}).items()):
+            execution = dict(getattr(getattr(live, "event_stream", None), "execution", None) or {})
+            generation, admission_id = execution.get("execution_generation"), execution.get("admission_id")
+            if generation is None or not admission_id or admission_id in _handed_off:
+                continue
+            adopted_generation, agent = (getattr(authority, "adopted", None) or {}).get(session_id, (None, None))
+            if adopted_generation != generation or agent is None or not _in_process(agent):
+                continue
+            turns.append(_Turn(authority, session_id, live, generation, admission_id, agent))
+    return turns
+
+
+def _in_process(agent) -> bool:
+    """An agent whose loop runs in this process (a managed worker's turn runs in its own process and is stopped
+    the ``restart_turn_handoff`` way)."""
+    from gateway.session_managed_worker import ManagedWorker
+    return not isinstance(agent, ManagedWorker)
+
+
+def _parked_prompts(turn: _Turn) -> list[tuple[str, Any, dict]]:
+    """``(prompt_id, route_or_entry, prompt)`` of the turn's own pending prompts (not a subagent's)."""
+    controls = turn.live.controls
+    with turn.live.event_stream.lock:
+        controls.snapshot(turn.session_id, turn.generation)
+        return [(pid, route, dict(prompt)) for pid, (route, prompt) in controls.pending.items()
+                if prompt.get("execution_generation") == turn.generation and pid not in controls.background]
+
+
+def _prompt_record(turn: _Turn, prompt_id, route, prompt) -> dict | None:
+    if prompt.get("kind") == "clarify":
+        entry = route
+        return {"kind": "clarify", "prompt_id": prompt_id, "session_key": entry.session_key,
+                "question": entry.question, "choices": list(entry.choices or []) or None,
+                "multi_select": bool(entry.multi_select), "timeout_s": prompt.get("timeout_s")}
+    from tools import approval as _approval
+    with _approval._lock:
+        entry = next((e for e in _approval._gateway_queues.get(route, []) if e.data.get("request_id") == prompt_id), None)
+    if entry is None:
+        return None
+    return {"kind": "approval", "prompt_id": prompt_id, "session_key": route, "data": dict(entry.data),
+            "authority": dict(getattr(entry, "authority", None) or {}), "timeout_s": prompt.get("timeout_s"),
+            "card_deny_only": bool(getattr(entry, "card_deny_only", False))}
+
+
+async def hand_off_at_boundaries(runner, cap: float) -> int:
+    """Ask every running turn to stop at its next step boundary and wait up to *cap* seconds; then hand
+    the parked ones off and let the rest fall back to ``restart_turn_handoff``. Returns how many turns
+    were handed off at a boundary."""
+    from agent import turn_boundary_handoff as boundary
+    loop = asyncio.get_running_loop()
+    deadline = loop.time() + max(0.0, cap)
+    asked = {}
+    last_log = 0.0
+    while True:
+        turns = _turns(runner)
+        for turn in turns:
+            boundary.request(turn.agent)
+            asked[turn.admission_id] = turn
+        running = [t for t in turns if not _parked_prompts(t)]
+        now = loop.time()
+        if not running or now >= deadline:
+            break
+        if now - last_log >= 30.0:
+            logger.info("Restart: waiting up to %.0fs for %d running turn(s) to reach a step boundary "
+                        "(gateway.restart_turn_handoff_boundary)", deadline - now, len(running))
+            last_log = now
+        await asyncio.sleep(0.1)
+    for turn in _turns(runner):
+        if _parked_prompts(turn):
+            try:
+                await _withdraw(turn)
+            except Exception:
+                logger.warning("Could not hand off the parked turn of %s", turn.session_id, exc_info=True)
+    left = _turns(runner)
+    for turn in left:
+        # Past the cap: this turn is stopped the 0048 way; a boundary it reaches now must not end it twice.
+        boundary.cancel(turn.agent)
+    handed = sum(1 for aid in asked if aid in _handed_off)
+    logger.info("Restart: %d turn(s) handed to the next gateway at a step boundary, %d stopped "
+                "(gateway.restart_turn_handoff_boundary)", handed, len(left))
+    return handed
+
+
+async def _withdraw(turn: _Turn) -> None:
+    """Hand off a turn parked on its own prompt: the resume record names the prompts, the turn's agent is
+    withdrawn (no further write), and the prompts stay answerable here until the process exits."""
+    from agent import turn_boundary_handoff as boundary
+    from hermes_state_runtime import RuntimeStoreError, get_session_admission
+    authority, live = turn.authority, turn.live
+    boundary.mark_withdrawn(turn.agent)  # from here on nothing the turn appends is durable
+    with live.event_stream.lock:
+        if live.event_stream.execution.get("execution_generation") != turn.generation:
+            return
+        prompts = [r for r in (_prompt_record(turn, pid, route, prompt)
+                               for pid, route, prompt in _parked_prompts(turn)) if r is not None]
+        # The withdrawn turn's own events (its cancelled prompt tool) never reach a viewer.
+        if authority.executing.get(turn.session_id) == turn.generation:
+            authority.executing.pop(turn.session_id, None)
+    row = await asyncio.to_thread(get_session_admission, authority.db, admission_id=turn.admission_id)
+    try:
+        await _commit(authority, live, row, {"prompts": prompts})
+    except RuntimeStoreError:
+        logger.warning("Parked turn of %s could not be handed off", turn.session_id, exc_info=True)
+        return
+    with live.event_stream.lock:
+        for record in prompts:
+            # Answerable here until exit: no longer bound to the (requeued) turn, so no generation check.
+            live.controls.remote_responders[record["prompt_id"]] = _late_answer(authority, turn.admission_id)
+            live.controls.background.add(record["prompt_id"])
+    boundary.withdraw(turn.agent)
+    logger.info("Turn of %s parked on %d prompt(s) handed to the next gateway", turn.session_id, len(prompts))
+
+
+def _late_answer(authority, admission_id):
+    """The responder of a handed-off prompt on this (outgoing) gateway: the answer goes into the resume
+    record, and the next gateway applies it once."""
+    def respond(kind, prompt_id, value):
+        from hermes_state_runtime import resume_record, update_resume_record
+        record = resume_record(authority.db, admission_id=admission_id) or {}
+        for prompt in record.get("prompts") or []:
+            if prompt.get("prompt_id") == prompt_id and "answer" not in prompt:
+                prompt["answer"] = value
+        if not update_resume_record(authority.db, admission_id=admission_id, record=record):
+            logger.warning("Answer to handed-off prompt %s arrived after the next gateway claimed the turn", prompt_id)
+    return respond
+
+
+async def _commit(authority, live, row, record) -> None:
+    from functools import partial
+    from gateway.session_runtime_workers import tracked_write
+    from gateway.session_settlement_recovery import _transfers
+    from hermes_state_runtime import hand_off_session_input
+    transfers = _transfers(authority, live, row)
+    await tracked_write(authority, partial(
+        hand_off_session_input, authority.db, epoch=authority.epoch, admission_id=row["admission_id"],
+        generation=row["generation"], record=record, transfers=transfers))
+    _handed_off.add(row["admission_id"])
+    _resuming.add(row["admission_id"])
+
+
+def handed_off_result(authority, admission_id) -> bool:
+    """The claim's execution returned a turn handed off at a step boundary."""
+    if admission_id in _handed_off:
+        return True
+    captured = (getattr(authority, "pending_results", None) or {}).get(admission_id) or {}
+    return bool((captured.get("result") or {}).get("handed_off"))
+
+
+async def finish_handed_off(authority, ref, live, row) -> None:
+    """The drain's end of a claim handed off at a boundary: the admission goes back to its FIFO place for
+    the next gateway (unless the parked path did that already), with nothing published or delivered."""
+    admission_id = row["admission_id"]
+    try:
+        if admission_id not in _handed_off:
+            await _commit(authority, live, row, {"prompts": []})
+            logger.info("Turn of %s handed to the next gateway at a step boundary", ref.session_id)
+    finally:
+        authority.pending_results.pop(admission_id, None)
+        getattr(authority, "pending_deliveries", {}).pop(admission_id, None)
+        with live.event_stream.lock:
+            if live.event_stream.execution.get("admission_id") == admission_id:
+                live.event_stream.execution = {}
+        authority.adopted.pop(ref.session_id, None)
+
+
+# ── the incoming gateway ─────────────────────────────────────────────────────────────────────────────
+
+
+def restore_prompts(runner) -> int:
+    """At startup, before any claim: put every handed-over prompt back under its old id (the waiters
+    the resumed turns adopt). Returns how many."""
+    from gateway.session_authorities import serving_authorities
+    from hermes_state_runtime import resume_records
+    count = 0
+    for authority in serving_authorities(runner):
+        try:
+            records = resume_records(authority.db)
+        except Exception:
+            logger.warning("Could not read the handed-off turns", exc_info=True)
+            continue
+        for admission_id, record in records.items():
+            _resuming.add(admission_id)
+            for prompt in record.get("prompts") or []:
+                count += _register_waiter(prompt)
+    return count
+
+
+def _register_waiter(prompt: dict) -> int:
+    from tools import prompt_handoff
+    try:
+        if prompt.get("kind") == "clarify":
+            prompt_handoff.add_clarify(prompt["session_key"], prompt["prompt_id"], prompt["question"],
+                                       prompt.get("choices"), bool(prompt.get("multi_select")),
+                                       answer=prompt.get("answer"))
+        elif prompt.get("kind") == "approval":
+            prompt_handoff.add_approval(prompt["session_key"], prompt["data"], authority=prompt.get("authority"),
+                                        answer=prompt.get("answer"))
+        else:
+            return 0
+    except Exception:
+        logger.warning("Could not restore handed-off prompt %s", prompt.get("prompt_id"), exc_info=True)
+        return 0
+    return 1
+
+
+def show_prompts(runner) -> None:
+    """After startup recovery made the sessions live: list each handed-over prompt that still waits with
+    the session's viewers, under its old id (a reattaching viewer keeps the same card)."""
+    from gateway.session_authorities import serving_authorities
+    from hermes_state_runtime import get_session_admission, resume_records
+    for authority in serving_authorities(runner):
+        try:
+            records = resume_records(authority.db)
+        except Exception:
+            continue
+        for admission_id, record in records.items():
+            row = get_session_admission(authority.db, admission_id=admission_id)
+            if row is not None:
+                show_record(authority, row["target_session_id"], record)
+
+
+def show_record(authority, session_id, record) -> None:
+    live = (getattr(authority, "sessions", None) or {}).get(session_id)
+    if live is None:
+        return
+    from tools import clarify_gateway as cg
+    from tools import approval as _approval
+    for prompt in record.get("prompts") or []:
+        if prompt.get("answer") is not None:
+            continue
+        _register_waiter(prompt)  # idempotent
+        pid = prompt.get("prompt_id")
+        with live.event_stream.lock:
+            if pid in live.controls.pending:
+                continue
+            generation = authority.db.get_session(session_id)["runtime_generation"]
+            if prompt.get("kind") == "clarify":
+                with cg._lock:
+                    entry = cg._entries.get(pid)
+                if entry is not None and not entry.event.is_set():
+                    live.controls.register_clarify(session_id, generation, entry, timeout_s=prompt.get("timeout_s"),
+                                                   background=True)
+            else:
+                with _approval._lock:
+                    queued = any(e.data.get("request_id") == pid
+                                 for e in _approval._gateway_queues.get(prompt["session_key"], []))
+                if queued:
+                    live.controls.register(session_id, prompt["session_key"], generation, prompt["data"],
+                                           timeout_s=prompt.get("timeout_s"), background=True)
+
+
+def claimed(authority, session_id, row) -> None:
+    """The claim of a handed-off admission: no longer a pending input, and its prompts are listed."""
+    _resuming.discard(row["admission_id"])
+    record = row.get("resume")
+    if isinstance(record, dict):
+        for prompt in record.get("prompts") or []:
+            _register_waiter(prompt)
+        show_record(authority, session_id, record)
+
