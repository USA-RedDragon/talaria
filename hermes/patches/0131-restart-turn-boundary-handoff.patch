+    live = authority.sessions["s1"]
+    published = []
+    live.event_stream.publish = lambda *a, **k: published.append((a, k))
+
+    async def turn_reaches_its_boundary():
+        while not getattr(agent, "_handoff_boundary", False):
+            await asyncio.sleep(0.01)
+        authority.pending_results[claimed["admission_id"]] = {"result": {"handed_off": True, "final_response": ""}}
+        assert turn_boundary.handed_off_result(authority, claimed["admission_id"])
+        await turn_boundary.finish_handed_off(authority, SimpleNamespace(session_id="s1"), live, claimed)
+
+    task = asyncio.create_task(turn_reaches_its_boundary())
+    started = time.monotonic()
+    assert await turn_boundary.hand_off_at_boundaries(_runner(authority), 30.0) == 1
+    await task
+    assert time.monotonic() - started < 5.0  # did not wait for the cap
+    row = get_session_admission(db, admission_id=claimed["admission_id"])
+    assert row["status"] == "queued"
