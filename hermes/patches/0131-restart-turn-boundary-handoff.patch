new file mode 100644
index 00000000..616b16ff
--- /dev/null
+++ b/tools/prompt_handoff.py
@@ -0,0 +1,135 @@
+"""Prompts a restart handed to this gateway (``gateway.restart_turn_handoff_boundary``).
+
+A turn parked on a clarify question or an approval card when the previous gateway exited is resumed here:
+the tool call that raised the prompt runs again. Before that, the gateway registers the prompt again under
+its old id (``add_clarify`` / ``add_approval``), so the card the user sees stays answerable, and an answer
+given to the old gateway after the handoff is applied here once. When the resumed call raises the same
+question or the same approval, it adopts that entry (``take_clarify`` / ``take_approval``) instead of
+asking again: same prompt id, no second card, no second smart review, and an answer that came first is
+read at once.
+"""
+from __future__ import annotations
+
+import logging
+import threading
+from typing import Any, Optional
+
+logger = logging.getLogger(__name__)
+
+_lock = threading.Lock()
+_clarify: dict[str, list[str]] = {}  # session key -> clarify ids waiting for their call
+_approvals: dict[str, list[Any]] = {}  # session key -> approval entries waiting for their call
+
+
+def _norm_choices(choices) -> Optional[list[str]]:
+    return [str(c) for c in choices] if choices else None
+
+
+def add_clarify(session_key: str, clarify_id: str, question: str, choices=None, multi_select: bool = False, *,
+                answer: Optional[str] = None, via: str = "") -> Any:
+    """Register a handed-over question under its old id (idempotent); returns its clarify entry."""
+    from tools import clarify_gateway as cg
+    with _lock:
+        known = clarify_id in (_clarify.get(session_key) or [])
+    with cg._lock:
+        entry = cg._entries.get(clarify_id)
+    if known and entry is not None:
+        return entry
+    entry = cg.register(clarify_id, session_key, question, _norm_choices(choices), bool(multi_select))
+    if answer is not None:
+        cg.resolve_gateway_clarify(clarify_id, answer, via)
+    with _lock:
+        ids = _clarify.setdefault(session_key, [])
+        if clarify_id not in ids:
+            ids.append(clarify_id)
+    return entry
+
+
+def take_clarify(session_key: str, question: str, choices=None) -> Any:
+    """The handed-over entry of this exact question, removed from the waiting list; None when there is none."""
+    from tools import clarify_gateway as cg
+    with _lock:
+        ids = list(_clarify.get(session_key) or [])
+    for cid in ids:
+        with cg._lock:
+            entry = cg._entries.get(cid)
+        if entry is None:
+            continue
+        if entry.question == question and entry.choices == _norm_choices(choices):
+            with _lock:
+                waiting = _clarify.get(session_key) or []
+                if cid in waiting:
+                    waiting.remove(cid)
+                if not waiting:
+                    _clarify.pop(session_key, None)
+            return entry
+    return None
+
+
+def add_approval(session_key: str, data: dict, *, authority: Optional[dict] = None,
+                 answer: Optional[str] = None) -> Any:
+    """Register a handed-over approval under its old ``request_id`` (idempotent); returns its entry. With
+    *answer* (given to the previous gateway after the handoff) it is decided already and not queued."""
+    from tools import approval as _approval
+    from tools.approval_gateway_wait import _ApprovalEntry
+    request_id = data.get("request_id")
+    with _lock:
+        for entry in _approvals.get(session_key) or []:
+            if entry.data.get("request_id") == request_id:
+                return entry
+    entry = _ApprovalEntry(data)
+    entry.card_deny_only = False  # the previous gateway's card showed the whole command
+    if authority:
+        entry.authority = dict(authority)
+    if answer is not None:
+        entry.result = answer
+        entry.event.set()
+    else:
+        with _approval._lock:
+            _approval._gateway_queues.setdefault(session_key, []).append(entry)
+    with _lock:
+        _approvals.setdefault(session_key, []).append(entry)
+    return entry
+
+
+def _matches(entry: Any, command: str, pattern_keys) -> bool:
+    return (entry.data.get("command") == command
+            and list(entry.data.get("pattern_keys") or [entry.data.get("pattern_key", "")]) == list(pattern_keys or []))
+
+
+def has_approvals(session_key: str) -> bool:
+    """Whether a handed-over approval waits for its call in this session (cheap: no redaction needed)."""
+    with _lock:
+        return bool(_approvals.get(session_key))
+
+
+def peek_approval(session_key: str, command: str, pattern_keys) -> Any:
+    """The handed-over approval of this command (display form) and pattern keys, left waiting; or None."""
+    with _lock:
+        return next((e for e in _approvals.get(session_key) or [] if _matches(e, command, pattern_keys)), None)
+
+
+def take_approval(session_key: str, approval_data: dict) -> Any:
+    """The handed-over entry this approval request adopts (removed from the waiting list), or None."""
+    keys = approval_data.get("pattern_keys") or [approval_data.get("pattern_key", "")]
+    with _lock:
+        waiting = _approvals.get(session_key) or []
+        entry = next((e for e in waiting if _matches(e, approval_data.get("command", ""), keys)), None)
+        if entry is not None:
+            waiting.remove(entry)
+            if not waiting:
+                _approvals.pop(session_key, None)
+    return entry
+
+
+def forget_session(session_key: str) -> None:
+    """Drop what still waits for a session (its resumed turn ended without raising it)."""
+    with _lock:
+        _clarify.pop(session_key, None)
+        _approvals.pop(session_key, None)
+
+
+def clear() -> None:
+    with _lock:
+        _clarify.clear()
+        _approvals.clear()
