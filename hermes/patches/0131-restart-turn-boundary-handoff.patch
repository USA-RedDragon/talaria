diff --git a/agent/turn_boundary_handoff.py b/agent/turn_boundary_handoff.py
new file mode 100644
index 00000000..1dfdd455
--- /dev/null
+++ b/agent/turn_boundary_handoff.py
@@ -0,0 +1,190 @@
+"""Step-boundary handoff of a running turn (``gateway.restart_turn_handoff_boundary``).
+
+A graceful restart with the key asks every running chat turn to stop at its next step boundary instead
+of interrupting it:
+
+* the top of a loop iteration: the previous model call's assistant row and its tool results are
+  durable, the next model call has not started;
+* a tool round whose assistant ``tool_calls`` row is durable and whose tools have not started.
+
+There the turn ends with ``handed_off`` set and nothing else: no interrupted tool result, no failed-turn
+row, no notice, no final text. The gateway puts the turn's admission back at the head of its session's
+FIFO and the gateway that takes the profile over runs it again in resume mode (``play_resume``): no new
+user row, the turn's own rows after its input are restored, the tool calls of the last assistant row that
+have no result run exactly once, and the model loop goes on from there.
+
+A turn parked on a clarify or approval prompt is withdrawn by the gateway when the old process exits
+(``withdraw``): the prompt's tool returns, but nothing it appends after that is made durable, so the
+transcript ends with the assistant row whose tool call the next gateway runs again under the same prompt.
+"""
+from __future__ import annotations
+
+import json
+import logging
+from typing import Any
+
+logger = logging.getLogger(__name__)
+
+HANDED_OFF_EXIT_REASON = "handed_off"
+WITHDRAW_TOOL_REASON = "turn handoff"
+
+
+def request(agent: Any) -> None:
+    """Ask *agent*'s running turn to stop at its next step boundary (thread-safe: a flag)."""
+    agent._handoff_boundary = True
+
+
+def requested(agent: Any) -> bool:
+    return getattr(agent, "_handoff_boundary", False) is True
+
+
+def withdrawn(agent: Any) -> bool:
+    """The gateway withdrew this turn's parked prompt for the handoff: no further write is durable."""
+    return getattr(agent, "_handoff_withdrawn", False) is True
+
+
+def cancel(agent: Any) -> None:
+    """Take back a request the turn did not reach in time (the restart stops it the other way)."""
+    agent._handoff_boundary = False
+
+
+def mark_withdrawn(agent: Any) -> None:
+    """A turn parked on a prompt is being handed off: from here on nothing it appends is durable."""
+    agent._handoff_boundary = True
+    agent._handoff_withdrawn = True
+
+
+def withdraw(agent: Any) -> None:
+    """End a turn parked on a prompt for the handoff. The prompt's wait ends by the interrupt; every row
+    appended after this point stays in memory only (``agent.tool_executor``)."""
+    mark_withdrawn(agent)
+    interrupt = getattr(agent, "interrupt", None)
+    if callable(interrupt):
+        interrupt(tool_reason=WITHDRAW_TOOL_REASON)
+
+
+def stop_here(agent: Any) -> bool:
+    """At a step boundary: True when the turn must end here for the handoff (and marks it handed off)."""
+    if not (requested(agent) or withdrawn(agent)):
+        return False
+    agent._handed_off_at_boundary = True
+    return True
+
+
+def handed_off(agent: Any) -> bool:
+    return getattr(agent, "_handed_off_at_boundary", False) is True
+
+
+def _durable(message: Any) -> bool:
+    from agent.context_compressor import _DB_PERSISTED_MARKER
+    return isinstance(message, dict) and bool(message.get(_DB_PERSISTED_MARKER))
+
+
+def finish(agent: Any, s: Any) -> dict[str, Any]:
+    """The result of a handed-off turn. Rows that are not durable (a withdrawn prompt's tool result, the
+    batch's skipped results) are dropped; the rest is flushed so the next gateway reads the whole step."""
+    messages = list(s.messages or [])
+    if withdrawn(agent):
+        while messages and not _durable(messages[-1]) and messages[-1].get("role") == "tool":
+            messages.pop()
+        s.messages[:] = messages
+    else:
+        try:
+            agent._flush_messages_to_session_db(s.messages, s.conversation_history)
+        except Exception:
+            logger.warning("Flush of a handed-off turn failed (session=%s)", getattr(agent, "session_id", None),
+                           exc_info=True)
+    agent._session_messages = s.messages
+    for name in ("_handoff_boundary", "_handoff_withdrawn", "_handed_off_at_boundary"):
+        if hasattr(agent, name):
+            setattr(agent, name, False)
+    clear = getattr(agent, "clear_interrupt", None)
+    if callable(clear):
+        try:
+            clear()
+        except Exception:
+            logger.debug("clear_interrupt after a handoff failed", exc_info=True)
+    logger.info("Turn handed off at a step boundary (session=%s, api_calls=%d)",
+                getattr(agent, "session_id", None), s.api_call_count)
+    return {
+        "final_response": "", "messages": s.messages, "api_calls": s.api_call_count,
+        "completed": False, "interrupted": False, "failed": False, "partial": False,
+        "handed_off": True, "turn_exit_reason": HANDED_OFF_EXIT_REASON,
+    }
+
+
+# ── resume on the gateway that took the turn over ─────────────────────────────────────────────────
+
+
+def _call_parts(tc: Any) -> tuple[str, str, Any]:
+    fn = tc.get("function") if isinstance(tc, dict) else getattr(tc, "function", None)
+    name = fn.get("name") if isinstance(fn, dict) else getattr(fn, "name", "")
+    args = fn.get("arguments") if isinstance(fn, dict) else getattr(fn, "arguments", "")
+    cid = tc.get("id") if isinstance(tc, dict) else getattr(tc, "id", "")
+    return str(cid or ""), str(name or ""), args
+
+
+def pending_tool_calls(rows: list[dict]) -> tuple[dict | None, list[Any]]:
+    """``(assistant row, calls)``: the last assistant row with tool calls and those of its calls that have
+    no tool result after it; ``(None, [])`` when every call has one or the tail is not a tool round."""
+    idx = next((i for i in range(len(rows) - 1, -1, -1)
+                if isinstance(rows[i], dict) and rows[i].get("role") == "assistant"), None)
+    if idx is None or not rows[idx].get("tool_calls"):
+        return None, []
+    answered = {r.get("tool_call_id") for r in rows[idx + 1:] if isinstance(r, dict) and r.get("role") == "tool"}
+    calls = [tc for tc in rows[idx]["tool_calls"] if _call_parts(tc)[0] not in answered]
+    return (rows[idx], calls) if calls else (None, [])
+
+
+def adopt_turn(history: list[dict], agent: Any) -> Any:
+    """Re-stage the handed-off turn from *history* (trimmed in place): its input row becomes this turn's user
+    message without a second write, the rows after it are restored by ``play_resume``. Returns the input's
+    content (the turn's message), or None when the history holds no input row."""
+    from agent.context_compressor import _DB_PERSISTED_MARKER
+    idx = next((i for i in range(len(history) - 1, -1, -1)
+                if isinstance(history[i], dict) and history[i].get("role") == "user"), None)
+    if idx is None:
+        return None
+    anchor, tail = history[idx], list(history[idx + 1:])
+    del history[idx:]
+    anchor[_DB_PERSISTED_MARKER] = True
+    for row in tail:
+        if isinstance(row, dict):
+            row[_DB_PERSISTED_MARKER] = True
+    agent._pending_cli_user_message = anchor
+    agent._resume_turn_rows = tail
+    return anchor.get("content")
+
+
+def play_resume(agent: Any, s: Any) -> tuple[str, Any]:
+    """Restore the rows of a resumed turn and run the tool calls its last step left without a result.
+    ``("run", None)`` goes on with the model loop (also when the turn is not a resumed one), ``("break",
+    None)`` ends the turn without a model call."""
+    rows = getattr(agent, "_resume_turn_rows", None)
+    if rows is None:
+        return "run", None
+    agent._resume_turn_rows = None
+    s.messages.extend(rows)
+    agent._session_messages = s.messages
+    row, calls = pending_tool_calls(s.messages)
+    if not calls:
+        return "run", None
+    from agent.transports.types import NormalizedResponse, build_tool_call
+    tool_calls = []
+    for tc in calls:
+        cid, name, args = _call_parts(tc)
+        if isinstance(args, str):
+            try:
+                args = json.loads(args) if args.strip() else {}
+            except ValueError:
+                pass
+        tool_calls.append(build_tool_call(cid, name, args))
+    message = NormalizedResponse(content=row.get("content") or "", tool_calls=tool_calls, finish_reason="tool_calls")
+    logger.info("Resuming a handed-off turn: running %d tool call(s) its last step left (session=%s)",
+                len(tool_calls), getattr(agent, "session_id", None))
+    agent._execute_tool_calls(message, s.messages, s.effective_task_id, s.api_call_count)
+    agent._session_messages = s.messages
+    if getattr(agent, "_incremental_persistence_failed", False):
+        s._turn_exit_reason, s.failed, s.final_response = "session_persistence_failed", True, ""
+        return "break", None
+    return "run", None
