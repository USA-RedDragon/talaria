From: USA-RedDragon <USA-RedDragon@users.noreply.github.com>
Date: Tue, 24 Nov 2026 05:20:34 -0600
Subject: [PATCH] hermes: 0176 session approvals tell listeners when they end

A plugin keeps state for a chat's approval, such as a computer's chat-scoped sign-in grant. register_revoke_listener, revoke_session_approval, revoke_approval_in_all_sessions and clear_session now tell it which keys ended.
---
 tests/tools/test_approval_revoke_listeners.py | 89 +++++++++++++++++++
 tools/approval.py                             | 46 +++++++++-
 2 files changed, 134 insertions(+), 1 deletion(-)
 create mode 100644 tests/tools/test_approval_revoke_listeners.py

diff --git a/tests/tools/test_approval_revoke_listeners.py b/tests/tools/test_approval_revoke_listeners.py
new file mode 100644
index 00000000..32efc506
--- /dev/null
+++ b/tests/tools/test_approval_revoke_listeners.py
@@ -0,0 +1,89 @@
+"""A chat's session approvals can be watched for their end: revoking one approval, and clearing the chat's
+approvals (/new, /stop, the end of the chat), tell every registered listener which keys went, so state a
+plugin keeps for them (a computer's chat-scoped sign-in grant) ends with them."""
+
+import pytest
+
+from tools import approval
+
+KEY = "agent:main:local:dm:hub-chat-1"
+LOGIN = "plugin_rule:browser:login-grant:d_pc:portal.example.com"
+
+
+@pytest.fixture(autouse=True)
+def _clean(monkeypatch):
+    monkeypatch.setattr(approval, "_session_approved", {})
+    monkeypatch.setattr(approval, "_revoke_listeners", [])
+
+
+def _record():
+    seen = []
+    approval.register_revoke_listener(lambda session_key, keys: seen.append((session_key, sorted(keys))))
+    return seen
+
+
+def test_revoking_one_session_approval_tells_the_listener():
+    seen = _record()
+    approval.approve_session(KEY, LOGIN)
+    approval.approve_session(KEY, "plugin_rule:browser:visit:example.com")
+    assert approval.revoke_session_approval(KEY, LOGIN) is True
+    assert not approval.is_approved(KEY, LOGIN)
+    assert approval.is_approved(KEY, "plugin_rule:browser:visit:example.com")
+    assert seen == [(KEY, [LOGIN])]
+
+
+def test_revoking_what_was_never_approved_tells_nobody():
+    seen = _record()
+    assert approval.revoke_session_approval(KEY, LOGIN) is False
+    assert seen == []
+
+
+def test_clearing_a_session_tells_the_listener_every_key_it_held():
+    seen = _record()
+    approval.approve_session(KEY, LOGIN)
+    approval.approve_session(KEY, "plugin_rule:browser:visit:example.com")
+    approval.approve_session("other", LOGIN)
+    approval.clear_session(KEY)
+    assert seen == [(KEY, sorted([LOGIN, "plugin_rule:browser:visit:example.com"]))]
+    assert approval.is_approved("other", LOGIN)
+
+
+def test_clearing_a_session_without_approvals_tells_nobody():
+    seen = _record()
+    approval.clear_session(KEY)
+    assert seen == []
+
+
+def test_a_failing_listener_does_not_stop_the_others_or_the_revoke():
+    seen = _record()
+
+    def broken(session_key, keys):
+        raise RuntimeError("boom")
+    approval.register_revoke_listener(broken)
+    approval.approve_session(KEY, LOGIN)
+    assert approval.revoke_session_approval(KEY, LOGIN) is True
+    assert seen == [(KEY, [LOGIN])]
+
+
+def test_a_listener_registers_once():
+    seen = []
+
+    def listener(session_key, keys):
+        seen.append(session_key)
+    approval.register_revoke_listener(listener)
+    approval.register_revoke_listener(listener)
+    approval.approve_session(KEY, LOGIN)
+    approval.revoke_session_approval(KEY, LOGIN)
+    assert seen == [KEY]
+
+
+def test_revoking_one_key_in_every_session_names_each_session():
+    seen = _record()
+    approval.approve_session(KEY, LOGIN)
+    approval.approve_session("other", LOGIN)
+    approval.approve_session("third", "plugin_rule:browser:visit:example.com")
+    assert approval.revoke_approval_in_all_sessions(LOGIN) == sorted([KEY, "other"])
+    assert not approval.is_approved(KEY, LOGIN) and not approval.is_approved("other", LOGIN)
+    assert approval.is_approved("third", "plugin_rule:browser:visit:example.com")
+    assert sorted(seen) == sorted([(KEY, [LOGIN]), ("other", [LOGIN])])
+    assert approval.revoke_approval_in_all_sessions(LOGIN) == []
diff --git a/tools/approval.py b/tools/approval.py
