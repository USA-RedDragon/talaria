--- a/tools/approval.py
+++ b/tools/approval.py
@@ -354,6 +354,49 @@ def approve_session(session_key: str, pattern_key: str):
         _session_approved.setdefault(session_key, set()).add(pattern_key)
 
 
+_revoke_listeners: list = []
+
+
+def register_revoke_listener(listener) -> None:
+    """Call ``listener(session_key, keys)`` whenever session approvals end: one revoked with
+    :func:`revoke_session_approval`, or all of a chat's on :func:`clear_session`. State kept elsewhere
+    for an approval (a plugin's grant for the chat) ends with it."""
+    with _lock:
+        if listener not in _revoke_listeners:
+            _revoke_listeners.append(listener)
+
+
+def _notify_revoked(session_key: str, keys: Iterable[str]) -> None:
+    keys = sorted(keys)
+    if not keys:
+        return
+    with _lock:
+        listeners = list(_revoke_listeners)
+    for listener in listeners:
+        try:
+            listener(session_key, list(keys))
+        except Exception:
+            logger.warning("An approval revoke listener failed", exc_info=True)
+
+
+def revoke_session_approval(session_key: str, pattern_key: str) -> bool:
+    """End a session approval of one key; False when the session held none."""
+    with _lock:
+        held = _session_approved.get(session_key)
+        if not held or pattern_key not in held:
+            return False
+        held.discard(pattern_key)
+    _notify_revoked(session_key, [pattern_key])
+    return True
+
+
+def revoke_approval_in_all_sessions(pattern_key: str) -> list[str]:
+    """End one key's session approval in every session; the sessions that held it, sorted."""
+    with _lock:
+        sessions = sorted(k for k, held in _session_approved.items() if pattern_key in held)
+    return [k for k in sessions if revoke_session_approval(k, pattern_key)]
+
+
