diff --git a/tools/process_hub_stop.py b/tools/process_hub_stop.py
new file mode 100644
index 00000000..58075302
--- /dev/null
+++ b/tools/process_hub_stop.py
@@ -0,0 +1,99 @@
+"""A background command the user stops from the hub is reported to the agent that started it.
+
+``process.kill`` used to kill with ``consume_output=True``, which marks the completion read: the notice the agent
+gets when a job exits on its own was dropped, because a kill is assumed to come from the agent that reads the kill
+result. The hub's Stop button is not that agent. Now the kill records the hub as its source, and the owner is told:
+
+* a top-level chat (or the parent a subagent handed the job to) gets the usual completion notice, worded as a stop;
+  a job without ``notify_on_complete`` gets one too, because the user stopped it and the agent must know;
+* a running or waiting subagent gets the notice as its next input (a waiting one wakes at once), unless it already
+  watches the job: its watch reports the stop when its turn ends;
+* a subagent that cannot take it (finished, no longer accepting input) falls back to the chat that owns the job.
+
+An agent's own kill keeps its behavior: it reads the kill result and gets no second notice.
+"""
+
+from __future__ import annotations
+
+import logging
+import time
+from typing import Any
+
+from tools.process_registry_notifications import HUB_STOP_SOURCE, mark_hub_stop, stopped_text, unmark_hub_stop
+
+logger = logging.getLogger(__name__)
+
+
+def _live_subagent(owner: str):
+    if not owner.startswith("sa-"):
+        return None
+    from tools.delegate_tool_registry import _active_subagents, _active_subagents_lock
+    with _active_subagents_lock:
+        record = _active_subagents.get(owner)
+        if record is None or record.get("agent") is None:
+            return None
+        return record
+
+
+def _ran_seconds(session: Any) -> float:
+    ended = float(getattr(session, "exited_at", 0) or 0) or time.time()
+    started = float(getattr(session, "started_at", 0) or 0)
+    return max(ended - started, 0.0) if started else 0.0
+
+
+def _event(session: Any) -> dict:
+    from tools.process_registry import _completion_output, _redact_process_result
+    evt = {
+        "type": "completion", "session_id": session.id, "session_key": session.session_key,
+        "task_id": session.task_id, "owner_task_id": session.owner_task_id, "command": session.command,
+        **({"handoff_note": session.handoff_note} if session.handoff_note else {}),
+        "exit_code": session.exit_code, "completion_reason": session.completion_reason,
+        "termination_source": session.termination_source, **_completion_output(session),
+        "started_at": session.started_at,
+    }
+    _redact_process_result(evt)
+    return evt
+
+
+def _tell_subagent(record: dict, session: Any) -> bool:
+    """True when the subagent has the stop: through its own watch of the job, or as an input it was given."""
+    from tools.delegate_tool_registry import _active_subagents_lock, steer_record_locked
+    from tools.delegate_tool_wait import waits_of
+    agent = record["agent"]
+    if any(w.get("session_id") == session.id for w in waits_of(agent)):
+        return True  # await_exit reports the stop when the subagent's turn ends (or wakes it now if it waits)
+    from tools.process_registry import _output_tail
+    text = stopped_text(session.command, session.id, _ran_seconds(session), _output_tail(session, 2000))
+    with _active_subagents_lock:
+        if record.get("accepting_steer", False) is not True:
+            return False
+        return bool(steer_record_locked(record, text))
+
+
+def stop_from_hub(registry: Any, proc_id: str) -> dict:
+    """Kill one background process for the hub and report the stop to the agent that owns it."""
+    session = registry.get(proc_id)
+    owner = str(getattr(session, "owner_task_id", "") or "") if session is not None else ""
+    record = _live_subagent(owner)
+    # A subagent's copy of the notice would reach the parent chat, which did not start the job: suppress it and
+    # tell the subagent directly. Anything else keeps the registry's own notice.
+    was_running = session is not None and not session.exited
+    mark_hub_stop(proc_id)
+    result = registry.kill_process(proc_id, source=HUB_STOP_SOURCE, consume_output=record is not None)
+    # The reader thread can record the SIGTERM exit before kill_process does, which then answers "already_exited":
+    # the user's stop still happened, so it is reported like a "killed" one.
+    if session is None or not was_running or result.get("status") not in ("killed", "already_exited"):
+        unmark_hub_stop(proc_id)
+        return result
+    if record is not None:
+        registry._completion_consumed.add(proc_id)
+    try:
+        if record is not None and _tell_subagent(record, session):
+            return result
+        if record is not None:
+            registry._completion_consumed.discard(proc_id)  # the owning chat gets it instead
+        if not session.notify_on_complete:
+            registry.completion_queue.put(_event(session))
+    except Exception as exc:  # the kill happened; never turn a delivery failure into a failed Stop
+        logger.warning("could not report the hub stop of %s: %s", proc_id, exc)
+    return result
