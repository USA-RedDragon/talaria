From: USA-RedDragon <USA-RedDragon@users.noreply.github.com>
Date: Mon, 16 Nov 2026 20:10:00 +0000
Subject: [PATCH] fix(process): a command stopped from the hub reaches its
 owner

process.kill marked the completion read, so the agent that started a job
the user stopped from the hub was never told. Report the stop to the
owning chat or subagent.
---

diff --git a/tests/tools/test_hub_stop_notice.py b/tests/tools/test_hub_stop_notice.py
new file mode 100644
index 00000000..4c24ceaa
--- /dev/null
+++ b/tests/tools/test_hub_stop_notice.py
@@ -0,0 +1,214 @@
+"""A background command stopped from the hub is reported to the agent that started it.
+
+``process.kill`` (the hub's Stop) used to mark the completion read, so the notice an agent gets when a job exits on
+its own never came, for a top-level chat or a subagent. Real registries and a real process; fake child agents.
+"""
+
+import json
+import queue
+import re
+import threading
+import time
+from unittest.mock import MagicMock
+
+import pytest
+
+from tests.tools.test_delegate_resume_action import (  # noqa: F401  (fixtures)
+    PARENT, SID, _Parent, _call, _clean_state, _completions, _db, _fake_child, _finished_child, seams,
+)
+from tests.tools.test_delegate_wait_wake import _start
+from tests.waiting import wait_until
+from tools import delegate_tool_wait as wait
+from tools.delegate_tool_registry import _active_subagents, _active_subagents_lock
+from tools.process_hub_stop import stop_from_hub
+from tools.process_registry import process_registry
+from tools.process_registry_notifications import format_process_notification, process_completion_display_text
+
+# The jobs are real processes the registry kills; their reparented descendants fall outside the guard's subtree walk.
+pytestmark = [pytest.mark.platforms("linux"), pytest.mark.live_system_guard_bypass]
+
+KEY = "chat-key"
+
+
+@pytest.fixture(autouse=True)
+def _empty_queue():
+    def drain():
+        while True:
+            try:
+                process_registry.completion_queue.get_nowait()
+            except queue.Empty:
+                return
+    drain()
+    yield
+    with _active_subagents_lock:
+        _active_subagents.pop(SID, None)
+    drain()
+
+
+def _settled(session):
+    """Wait until the shell has become (or forked) its ``sleep``: the suite's live-system guard rejects a signal
+    sent to a process it does not yet see in the test's tree."""
+    import psutil
+
+    def started():
+        proc = psutil.Process(session.pid)
+        return proc.children(recursive=True) or "sleep" in " ".join(proc.cmdline())
+    wait_until(started, what="the job to start")
+    time.sleep(0.2)
+
+
+def _job(owner=KEY, notify=True, command="sleep 60"):
+    session = process_registry.spawn_local(command, task_id=owner, owner_task_id=owner, session_key=owner)
+    session.notify_on_complete = notify
+    _settled(session)
+    return session
+
+
+def _queued(*sessions):
+    """What the chat's notification poller would deliver for ``sessions``: their queued events not already marked
+    read. (A job killed by an earlier test can publish late, so other jobs' events are not looked at.)"""
+    ids = {s.id for s in sessions}
+    events = []
+    while True:
+        try:
+            events.append(process_registry.completion_queue.get_nowait())
+        except queue.Empty:
+            return [e for e in events if e["session_id"] in ids and not process_registry.is_completion_consumed(e["session_id"])]
+
+
+def _published(session):
+    """The registry publishes a stopped job's notice when its reader thread finishes: wait for it."""
+    wait_until(lambda: session._completion_event.is_set(), what="the completion notice")
+    return _queued(session)
+
+
+def _ago(session, seconds):
+    session.started_at -= seconds  # a job that has run for a while
+
+
+def _assert_stop_text(text, command="sleep 60", ran="41h 41m"):
+    assert f"Stopped by the user from the hub: {command}" in text, text
+    assert f"(ran {ran})" in text or (ran == "0s" and re.search(r"\(ran [0-5]s\)", text)), text
+
+
+def test_stop_of_a_top_level_chats_job_queues_a_notice_for_that_chat():
+    session = _job()
+    _ago(session, 41 * 3600 + 41 * 60)
+    result = stop_from_hub(process_registry, session.id)
+    assert result["status"] == "killed" and result["termination_source"] == "the user from the hub"
+    events = _published(session)
+    assert [e["session_id"] for e in events] == [session.id]
+    assert not process_registry.is_completion_consumed(session.id)  # the poller delivers it
+    text = format_process_notification(events[0])
+    _assert_stop_text(text)
+    assert text.startswith(f"[IMPORTANT: Background process {session.id} stopped by the user from the hub")
+    assert "Command: sleep 60" in text and "Output:" in text
+    assert process_completion_display_text(events[:1]).startswith("Background Process Stopped by You")
+
+
+def test_stop_of_a_job_that_does_not_notify_on_exit_still_notifies():
+    session = _job(notify=False)
+    stop_from_hub(process_registry, session.id)
+    events = _published(session)
+    assert len(events) == 1 and events[0]["owner_task_id"] == KEY
+    assert events[0]["completion_reason"] == "killed"
+    _assert_stop_text(format_process_notification(events[0]), ran="0s")
+
+
+def test_an_agents_own_kill_keeps_its_behavior_and_gets_no_second_notice():
+    session = _job()
+    result = process_registry.kill_process(session.id)  # what process_manage kill does
+    assert result["status"] == "killed", result
+    assert result["termination_source"] == "process.kill"
+    assert process_registry.is_completion_consumed(session.id)
+    time.sleep(1.0)
+    assert _queued(session) == []  # the kill result was the notice
+
+
+def test_stop_of_a_handed_off_job_reaches_the_parent_that_got_it():
+    session = _job(owner=SID)
+    process_registry.keep_for_parent(session.id, from_owner=SID, to_owner=KEY, to_task_id=KEY, to_session_key=KEY,
+                                     note="left running by subagent; kept for you")
+    stop_from_hub(process_registry, session.id)
+    events = _published(session)
+    assert len(events) == 1 and events[0]["owner_task_id"] == KEY
+    text = format_process_notification(events[0])
+    assert text.startswith("[IMPORTANT: Background process")
+    assert "Handed off to you by a subagent" in text
+    _assert_stop_text(text, ran="0s")
+
+
+def _running_subagent(steer_result="queued"):
+    agent = MagicMock()
+    record = {"subagent_id": SID, "agent": agent, "status": "running", "accepting_steer": True}
+    with _active_subagents_lock:
+        _active_subagents[SID] = record
+    return agent, record
+
+
+def test_stop_of_a_running_subagents_job_goes_to_that_subagent_not_the_chat():
+    agent, _record = _running_subagent()
+    agent.steer.return_value = True
+    session = _job(owner=SID)
+    _ago(session, 37 * 3600 + 23 * 60)
+    stop_from_hub(process_registry, session.id)
+    time.sleep(1.0)
+    assert _queued(session) == []  # the parent chat did not start this job
+    assert process_registry.is_completion_consumed(session.id)
+    (text,), _ = agent.steer.call_args
+    _assert_stop_text(text, ran="37h 23m")
+
+
+def test_a_subagent_that_cannot_take_the_notice_hands_it_to_the_chat():
+    _agent, record = _running_subagent()
+    record["accepting_steer"] = False
+    session = _job(owner=SID)
+    stop_from_hub(process_registry, session.id)
+    events = _published(session)
+    assert len(events) == 1 and not process_registry.is_completion_consumed(session.id)
+    text = format_process_notification(events[0])
+    assert f"Started by subagent {SID}" in text
+    _assert_stop_text(text, ran="0s")
+
+
+def test_stop_of_a_job_a_waiting_subagent_watches_wakes_it_with_the_stop(seams):
+    child, run_id = _start(seams, "sleep 60")
+    session = child.seen["session"]
+    _settled(session)
+    _ago(session, 41 * 3600 + 41 * 60)
+    try:
+        stop_from_hub(process_registry, session.id)
+        wait_until(lambda: len(child.conversations) == 2, timeout=10, what="the wake-up round")
+        message = child.conversations[1]["user_message"]
+        assert message.startswith("A process you were waiting on was stopped by the user")
+        _assert_stop_text(message)
+    finally:
+        wait_until(lambda: _completions(run_id), timeout=30, what="completion")
+
+
+def test_stop_of_an_unwatched_job_of_a_waiting_subagent_wakes_it_and_keeps_the_watch(seams):
+    child, run_id = _start(seams, "sleep 60")
+    other = process_registry.spawn_local("sleep 61", task_id=SID, owner_task_id=SID)
+    other.notify_on_complete = True
+    _settled(other)
+    _ago(other, 3 * 3600 + 5 * 60)
+    try:
+        res = stop_from_hub(process_registry, other.id)
+        assert res["status"] == "killed", res
+        wait_until(lambda: len(child.conversations) == 2, timeout=10, what="the wake-up round")
+        message = child.conversations[1]["user_message"]
+        _assert_stop_text(message, command="sleep 61", ran="3h 5m")
+        assert "sleep 60" in message and "still running" in message  # the watched job goes on
+        assert len(wait.waits_of(child)) == 1 and not child.seen["session"].exited
+        assert _queued(other) == []
+    finally:
+        process_registry.kill_process(child.seen["session"].id)
+        wait_until(lambda: _completions(run_id), timeout=30, what="completion")
+
+
+def test_stop_of_an_exited_job_says_nothing():
+    session = _job()
+    process_registry.kill_process(session.id)
+    _queued(session)
+    result = stop_from_hub(process_registry, session.id)
+    assert result["status"] == "already_exited" and _queued(session) == []
