index 7ec87b42..3c5b1380 100644
--- a/tools/process_registry_notifications.py
+++ b/tools/process_registry_notifications.py
@@ -8,6 +8,7 @@ from dataclasses import dataclass
 from contextlib import suppress
 
 _DONE = ("completed", "success")
+HUB_STOP_SOURCE = "the user from the hub"  # ``termination_source`` of a job stopped from the hub (process.kill)
 _REASON_STATUS = {"lost": "marked lost because the process backend disappeared", "failed_start": "failed to start"}
 
 
@@ -391,7 +392,9 @@ def process_completion_display_text(events: list) -> str:
         return f"{len(events)} Background Processes Finished"
     evt = events[0]
     reason, exit_code = evt.get("completion_reason") or "exited", evt.get("exit_code", "?")
-    if reason == "killed":
+    if is_hub_stop(evt):
+        outcome = "Stopped by You"
+    elif reason == "killed":
         outcome = "Terminated"
     elif reason in _REASON_STATUS:
         outcome = "Lost" if reason == "lost" else "Failed to Start"
@@ -484,8 +487,60 @@ def _delegation_attribution_line(evt: dict) -> str | None:
             + (f' Task: "{goal}"' if goal else ""))
 
 
+def ran_for(seconds: float) -> str:
+    """'41h 41m', '5m', '40s': how long a job ran."""
+    seconds = int(max(seconds or 0, 0))
+    if seconds < 60:
+        return f"{seconds}s"
+    minutes = seconds // 60
+    return f"{minutes // 60}h {minutes % 60}m" if minutes >= 60 else f"{minutes}m"
+
+
+def stopped_text(command: str, session_id: str, ran_seconds: float, output_tail: str = "") -> str:
+    """What an agent reads when the user stopped its background job from the hub."""
+    text = (f"Stopped by the user from the hub: {str(command)[:200]} ({session_id}) (ran {ran_for(ran_seconds)}). "
+            "The job is no longer running; do not restart it unless the user asks.")
+    return text + (f"\nOutput tail:\n{output_tail.strip()}" if output_tail.strip() else "")
+
+
+_hub_stops: dict[str, float] = {}  # session id -> when the hub asked for the stop; marked BEFORE the kill
+_HUB_STOPS_CAP = 256
+
+
+def mark_hub_stop(session_id: str) -> None:
+    """Record that the hub is stopping ``session_id``. The process's reader thread can record its exit (as a plain
+    SIGKILL exit) before the kill returns, so the stop is known from this mark, not only from the session fields."""
+    _hub_stops[session_id] = time.time()
+    while len(_hub_stops) > _HUB_STOPS_CAP:
+        _hub_stops.pop(next(iter(_hub_stops)), None)
+
+
+def unmark_hub_stop(session_id: str) -> None:
+    _hub_stops.pop(session_id, None)
+
+
+def is_hub_stop(evt) -> bool:
+    """An event, or ``{completion_reason, termination_source, session_id}`` of a session, that is the hub's stop."""
+    if evt.get("completion_reason") == "killed" and evt.get("termination_source") == HUB_STOP_SOURCE:
+        return True
+    return bool(evt.get("session_id")) and evt["session_id"] in _hub_stops and evt.get("completion_reason") != "lost"
+
+
+def _hub_stop_ran(evt: dict) -> float:
+    started = float(evt.get("started_at") or 0)
+    if not started:
+        return 0.0
+    ended = 0.0
+    with suppress(Exception):
+        from tools.process_registry import process_registry
+        ended = float(getattr(process_registry.get(evt.get("session_id", "")), "exited_at", 0) or 0)
+    return (ended or time.time()) - started
+
+
 def _completion_status(evt: dict) -> str:
     reason = evt.get("completion_reason") or "exited"
+    if is_hub_stop(evt):
+        return f"stopped by {HUB_STOP_SOURCE}"
     if reason == "killed":
         return f"terminated by {evt.get('termination_source') or 'Hermes'}"
     return _REASON_STATUS.get(reason) or ("completed normally" if evt.get("exit_code", "?") == 0 else "exited")
@@ -532,6 +587,8 @@ def format_process_notification(evt: dict) -> str | None:
         # Say so where the output is the payload (a teammate's reply): a silent tail reads as whole.
         _out = (f"...(first {evt['output_cut']} characters cut — process(action=\"log\", "
                 f"session_id=\"{_sid}\") has the full output)\n{_out}")
+    if is_hub_stop(evt):
+        attribution += stopped_text(_cmd, _sid, _hub_stop_ran(evt)).split("\nOutput tail:")[0] + "\n"
     return (
         f"[IMPORTANT: Background process {_sid} {_completion_status(evt)} (exit code {_exit}{_signal}).\n"
         f"{attribution}Command: {_cmd}\nOutput:\n{_out}]")
