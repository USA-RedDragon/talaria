diff --git a/tests/tools/test_approval_scope_enforced.py b/tests/tools/test_approval_scope_enforced.py
new file mode 100644
index 00000000..85c08838
--- /dev/null
+++ b/tests/tools/test_approval_scope_enforced.py
@@ -0,0 +1,217 @@
+"""Every approval card offers once, this chat, always (or a stated exemption) and deny.
+
+Invariants:
+  1. ``tools.approval_scope.offer`` is the one source of a card's choices; a card without a named thing, without
+     the session choice, or without always and no ``always_exempt`` reason raises.
+  2. The gateway wait, the CLI prompt, request_tool_approval and request_elicitation_consent refuse such a card
+     before anything is shown.
+  3. No module outside the approval core builds an approval card that turns the session or always choice off,
+     and every call to request_tool_approval or request_elicitation_consent names its rule (a static scan).
+  4. Each surface draws all the choices it is given: the gateway pending prompt, the CLI menu, the TUI payload, the
+     api_server event, platform buttons, ACP options.
+"""
+
+from __future__ import annotations
+
+import ast
+import pathlib
+
+import pytest
+
+from tools import approval as approval_mod
+from tools import approval_prompt
+from tools.approval_scope import UnscopedApproval, offer, require
+
+ROOT = pathlib.Path(__file__).resolve().parents[2]
+FOUR = ["once", "session", "always", "deny"]
+CARD = {"command": "rm -rf build", "pattern_key": "recursive delete", "pattern_keys": ["recursive delete"]}
+
+
+def test_offer_is_four_choices():
+    assert offer(CARD) == FOUR
+    assert offer({**CARD, "smart_denied": True}) == FOUR
+    assert offer({**CARD, "grant_source": "github.com/o/r"}) == FOUR
+    assert offer({**CARD, "login_grant": {"host": "h"}}) == ["once", "session", "device", "deny"]
+    assert offer({**CARD, "allow_permanent": False, "always_exempt": "one-off content"}) == ["once", "session", "deny"]
+
+
+@pytest.mark.parametrize("card", [
+    {"command": "x"},
+    {**CARD, "pattern_key": "", "pattern_keys": [""]},
+    {**CARD, "allow_session": False},
+    {**CARD, "allow_permanent": False},
+    {**CARD, "allow_permanent": False, "always_exempt": "  "},
+])
+def test_bare_card_is_refused(card):
+    with pytest.raises(UnscopedApproval):
+        require(card)
+
+
+def test_gateway_wait_refuses_a_bare_card():
+    from tools.approval_gateway_wait import _await_gateway_decision
+    with pytest.raises(UnscopedApproval):
+        _await_gateway_decision("s", lambda data: None, {**CARD, "allow_session": False}, surface="gateway")
+
+
+def test_cli_prompt_refuses_a_bare_card():
+    with pytest.raises(UnscopedApproval):
+        approval_prompt.prompt_dangerous_approval("x", "y", allow_session=False, approval_callback=lambda *a, **k: "once")
+    with pytest.raises(UnscopedApproval):
+        approval_prompt.prompt_dangerous_approval("x", "y", allow_permanent=False,
+                                                  approval_callback=lambda *a, **k: "once")
+
+
+@pytest.mark.parametrize("key", ["", "   "])
+def test_request_tool_approval_needs_a_rule(key):
+    with pytest.raises(UnscopedApproval):
+        approval_mod.request_tool_approval("browser_click", "a card", rule_key=key)
+    with pytest.raises(TypeError):
+        approval_mod.request_tool_approval("browser_click", "a card")
+
+
+@pytest.mark.parametrize("key", ["", "   "])
+def test_elicitation_needs_a_rule(key):
+    with pytest.raises(UnscopedApproval):
+        approval_prompt.request_elicitation_consent("m", "d", remember_key=key)
+    with pytest.raises(TypeError):
+        approval_prompt.request_elicitation_consent("m", "d")
+
+
+def test_pending_prompt_lists_every_choice():
+    from gateway.session_pending_controls import PendingControls
+    seen = []
+
+    class _Events:
+        import threading
+        lock = threading.RLock()
+
+    controls = PendingControls.__new__(PendingControls)
+    controls.events, controls.pending, controls.background = _Events(), {}, set()
+    controls.announce = lambda sid, prompt, event_type: seen.append(prompt)
+    for data, want in [
+        ({**CARD, "request_id": "a"}, FOUR),
+        ({**CARD, "request_id": "b", "smart_denied": True, "grant_source": "docker.io/hashicorp/tfe-agent",
+          "rule": "Code from External"}, FOUR),
+        ({**CARD, "request_id": "c", "login_grant": {"host": "login.example.com", "device_id": "d"}},
+         ["once", "session", "device", "deny"]),
+        ({**CARD, "request_id": "d", "edit": {"path": "a"}}, FOUR),
+    ]:
+        controls.register("sid", "route", 1, data)
+        assert seen[-1]["choices"] == want, data
+
+
+def test_cli_menu_offers_session_for_every_card():
+    from hermes_cli.cli_modal_mixin import CLIModalMixin
+    menu = CLIModalMixin._approval_choices
+    assert menu(None, "x") == FOUR
+    assert menu(None, "x", smart_denied=True) == FOUR
+    assert menu(None, "x", allow_session=False) == FOUR
+    assert menu(None, "x", allow_permanent=False) == ["once", "session", "deny"]
+
+
+def test_tui_payload_offers_every_choice():
+    from tui_gateway.server import _approval_request_payload
+    assert _approval_request_payload({**CARD, "smart_denied": True})["choices"] == FOUR
+
+
+def test_api_server_event_offers_every_choice():
+    from gateway.platforms.api_server import _approval_event_choices
+    assert _approval_event_choices(smart_denied=True, allow_session=True, allow_permanent=True) == FOUR
+    with pytest.raises(ValueError):
+        _approval_event_choices(smart_denied=False, allow_session=False, allow_permanent=True)
+
+
+def test_platform_buttons_offer_every_choice():
+    from gateway.platforms.base import BasePlatformAdapter
+
+    class _Labels:
+        _EA_ACTION_LABELS = {c: c for c in FOUR}
+        _EA_ACTION_STYLES: dict = {}
+
+    rows = BasePlatformAdapter._exec_approval_actions(_Labels(), allow_permanent=True, allow_session=True,
+                                                      smart_denied=True)
+    assert [choice for _label, choice, _style in rows] == FOUR
+
+
+def test_acp_options_offer_every_choice():
+    from acp_adapter.permissions import _build_permission_options
+    ids = [o.option_id for o in _build_permission_options(allow_permanent=True, smart_denied=True)]
+    assert ids[:4] == ["allow_once", "allow_session", "allow_always", "deny"]
+    with pytest.raises(UnscopedApproval):
+        _build_permission_options(allow_permanent=True, allow_session=False)
+
+
+def test_qqbot_buttons_offer_this_chat():
+    from plugins.platforms.qqbot.keyboards import build_approval_keyboard
+    text = repr(build_approval_keyboard("s", request_id="r"))
+    assert "allow-session" in text and "allow-always" in text and "allow-once" in text
+
+
+# --- the static scan ------------------------------------------------------------------------------------------
+
+_CORE = {"tools/approval.py", "tools/approval_scope.py", "tools/approval_prompt.py", "tools/approval_gateway_wait.py"}
+_PROMPTS = {"request_tool_approval": "rule_key", "request_elicitation_consent": "remember_key"}
+_OFF_FLAGS = ("allow_session", "allow_permanent")
+
+
+def _sources():
+    for path in sorted(ROOT.rglob("*.py")):
+        rel = path.relative_to(ROOT).as_posix()
+        if rel.startswith(("tests/", ".venv/", "website/", "node_modules/")) or "/node_modules/" in rel:
+            continue
+        try:
+            yield rel, ast.parse(path.read_text(encoding="utf-8"))
+        except (SyntaxError, UnicodeDecodeError):
+            continue
+
+
+def _is_false(node) -> bool:
+    return isinstance(node, ast.Constant) and node.value is False
+
+
+def _name(func) -> str:
+    return func.attr if isinstance(func, ast.Attribute) else func.id if isinstance(func, ast.Name) else ""
+
+
+_EXEMPT = {
+    "agent/transports/codex_app_server_session.py:allow_permanent=False":
+        "codex keeps no permanent grant; acceptForSession is the widest it has",
+}
+
+
+def _problems() -> list[str]:
+    out: list[str] = []
+    for rel, tree in _sources():
+        for node in ast.walk(tree):
+            if isinstance(node, ast.Call):
+                name = _name(node.func)
+                if name in _PROMPTS and rel not in _CORE:
+                    kw = {k.arg: k.value for k in node.keywords}
+                    value = kw.get(_PROMPTS[name])
+                    if value is None and not any(k.arg is None for k in node.keywords):
+                        out.append(f"{rel}:{node.lineno}: {name} without {_PROMPTS[name]}")
+                    elif isinstance(value, ast.Constant) and not (isinstance(value.value, str) and value.value.strip()):
+                        out.append(f"{rel}:{node.lineno}: {name} with an empty {_PROMPTS[name]}")
+                for k in node.keywords:
+                    if k.arg in _OFF_FLAGS and _is_false(k.value) and rel not in _CORE \
+                            and f"{rel}:{k.arg}=False" not in _EXEMPT:
+                        out.append(f"{rel}:{node.lineno}: {k.arg}=False turns a choice off")
+            if isinstance(node, ast.Dict) and rel not in _CORE:
+                for key, value in zip(node.keys, node.values):
+                    if isinstance(key, ast.Constant) and key.value in _OFF_FLAGS and _is_false(value):
+                        out.append(f"{rel}:{node.lineno}: {key.value!r}: False turns a choice off")
+            if isinstance(node, (ast.List, ast.Set)) and rel not in _CORE:
+                values = [e.value for e in node.elts if isinstance(e, ast.Constant)]
+                if len(values) == len(node.elts) and sorted(map(str, values)) == ["deny", "once"]:
+                    out.append(f"{rel}:{node.lineno}: a bare once/deny choice list")
+    return out
+
+
+def test_no_bare_prompt_anywhere():
+    assert _problems() == []
