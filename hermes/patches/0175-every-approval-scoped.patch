diff --git a/tools/approval_scope.py b/tools/approval_scope.py
new file mode 100644
index 00000000..46426a8f
--- /dev/null
+++ b/tools/approval_scope.py
@@ -0,0 +1,57 @@
+"""The choices every approval card offers.
+
+Every card a person answers offers Allow once, Allow in this chat (the chat and its subagents) and Always
+allow, each scoped to the specific thing the card names (its ``pattern_keys``), plus Deny. A card leaves
+out Always only when a permanent grant of that thing would mean nothing; it then names why in
+``always_exempt``. A sign-in grant card's Always is ``device`` (the hub stores it for that computer).
+
+:func:`offer` is the one place a card's choices come from, and :func:`require` refuses a card that would
+offer less: the gateway wait and the CLI prompt call it before anything is shown, so a bare Allow/Deny
+card cannot be raised.
+"""
+
+from __future__ import annotations
+
+from typing import Any, Mapping
+
+ONCE, SESSION, ALWAYS, DEVICE, DENY = "once", "session", "always", "device", "deny"
+
+
+class UnscopedApproval(ValueError):
+    """An approval card that does not offer Allow in this chat, or Always without a reason."""
+
+
+def _keys(data: Mapping[str, Any]) -> list[str]:
+    keys = data.get("pattern_keys")
+    if not keys:
+        keys = [data.get("pattern_key")]
+    return [k for k in keys or [] if isinstance(k, str) and k.strip()]
+
+
+def require(data: Mapping[str, Any]) -> None:
+    """Raise :class:`UnscopedApproval` unless the card names the thing it grants and offers its scopes."""
+    if not _keys(data):
+        raise UnscopedApproval("an approval card must name the specific thing it grants (pattern_keys)")
+    if data.get("allow_session") is False:
+        raise UnscopedApproval(f"approval card {_keys(data)[0]!r} does not offer Allow in this chat")
+    exempt = data.get("always_exempt")
+    if data.get("allow_permanent") is False and not (isinstance(exempt, str) and exempt.strip()):
+        raise UnscopedApproval(f"approval card {_keys(data)[0]!r} leaves out Always without always_exempt")
+
+
+def offer(data: Mapping[str, Any]) -> list[str]:
+    """The card's choices, Deny last."""
+    require(data)
+    if data.get("login_grant") is not None:
+        return [ONCE, SESSION, DEVICE, DENY]
+    exempt = data.get("always_exempt")
+    if isinstance(exempt, str) and exempt.strip():
+        return [ONCE, SESSION, DENY]
+    return [ONCE, SESSION, ALWAYS, DENY]
+
+
+def normalized(data: Mapping[str, Any]) -> dict:
+    """A copy of the card whose ``allow_session``/``allow_permanent`` flags say what :func:`offer` offers,
+    for surfaces that read the flags."""
+    choices = offer(data)
+    return {**data, "allow_session": True, "allow_permanent": ALWAYS in choices or DEVICE in choices}
