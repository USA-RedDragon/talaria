+def image_source(ref: str) -> tuple[str, str] | None:
+    """``(identity, display)`` of a container image on a known registry (``docker.io/hashicorp/tfe-agent``,
+    ``docker://ghcr.io/o/i:tag``, ``https://hub.docker.com/r/o/i``), the tag and digest dropped; ``None`` for
+    anything else (a registry that is not known, a bare ``owner/name``, a wildcard)."""
