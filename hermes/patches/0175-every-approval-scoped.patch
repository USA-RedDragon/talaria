+        if ref.lower().startswith(scheme):
+            ref = ref[len(scheme):]
+    ref = ref.split("@", 1)[0]
+    host, _, path = ref.partition("/")
+    registry = _REGISTRIES.get(host.lower())
+    if registry is None or not path:
+        return None
+    if host.lower() == "hub.docker.com":
+        segs = [s for s in path.split("/") if s]
+        path = "/".join(segs[1:3]) if segs[:1] in (["r"], ["repository"]) else ("library/" + segs[1] if segs[:1] == ["_"] else "")
+    last = path.rsplit("/", 1)
