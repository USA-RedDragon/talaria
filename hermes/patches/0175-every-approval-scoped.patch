diff --git a/tests/tools/test_smart_provenance_image_source.py b/tests/tools/test_smart_provenance_image_source.py
new file mode 100644
index 00000000..0374954a
--- /dev/null
+++ b/tests/tools/test_smart_provenance_image_source.py
@@ -0,0 +1,212 @@
+"""Smart approval: a Code from External card for code out of a container image offers this chat and always.
+
+The live card (relift chat, a subagent): "The command runs binaries through the ld-linux loader and libc from a
+sysroot the agent unpacked this session out of the hashicorp/tfe-agent docker image, which is outside code the
+user never cleared (the user's approval covered only github.com/usa-reddragon/docgen)." It showed only Allow and
+Deny.
+
+Invariants:
+  1. The card offers once, this chat, always and deny, each scoped to the image (docker.io/hashicorp/tfe-agent),
+     whether the session shows the image (crane export | tar) or only the review model names it.
+  2. "This chat" records the source as cleared for the chat and its subagents: the review reads it as the user's
+     grant and does not ask again about that image, while another image or source is still held.
+  3. "Always" stores ``code_source:docker.io/hashicorp/tfe-agent`` in command_allowlist: a new chat runs code
+     from that image without a card.
+  4. A card that names no source scopes this chat and always to the exact action, never the broad rule.
+"""
+
+from __future__ import annotations
+
+import threading
+import time
+
+import pytest
+
+from hermes_state import SessionDB
+from tools import approval as approval_mod
+from tools import approval_automode as A
+from tools import approval_chat_grants as G
+from tools.approval_scope import offer
+from tools.delegate_tool import _bind_approval_review_root
+
+REASON = ("The command runs binaries through the ld-linux loader and libc from a sysroot the agent unpacked "
+          "this session out of the hashicorp/tfe-agent docker image, which is outside code the user never cleared "
+          "(the user's approval covered only github.com/usa-reddragon/docgen).")
+IMAGE = "docker.io/hashicorp/tfe-agent"
+UNPACK = "mkdir -p {d}/sysroot && crane export hashicorp/tfe-agent:1.20.1 - | tar -x -C {d}/sysroot"
+COPY = "docker create --name tfe hashicorp/tfe-agent:1.20.1 && docker cp tfe:/ {d}/sysroot"
+RUN = ("{d}/sysroot/lib64/ld-linux-x86-64.so.2 --library-path {d}/sysroot/usr/lib/x86_64-linux-gnu "
+       "{d}/sysroot/usr/bin/tfc-agent --version")
+
+
+@pytest.mark.parametrize("ref, want", [
+    ("docker.io/hashicorp/tfe-agent", IMAGE),
+    ("docker://docker.io/hashicorp/tfe-agent:1.20.1", IMAGE),
+    ("index.docker.io/hashicorp/tfe-agent@sha256:" + "a" * 64, IMAGE),
+    ("https://hub.docker.com/r/hashicorp/tfe-agent", IMAGE),
+    ("docker.io/ubuntu:24.04", "docker.io/library/ubuntu"),
+    ("ghcr.io/USA-RedDragon/talaria:v1", "ghcr.io/usa-reddragon/talaria"),
+    ("evil.example/hashicorp/tfe-agent", None),
+    ("docker.io.evil.example/hashicorp/tfe-agent", None),
+    ("docker.io/hashicorp/*", None),
+    ("docker.io/$IMG", None),
+    ("hashicorp/tfe-agent", None),
+])
+def test_image_identity(ref, want):
+    hit = G.image_source(ref)
+    assert (hit[0] if hit else None) == want
+
+
+def test_bare_image_name_resolves_only_from_the_sessions_own_commands():
+    assert G.bare_image_source("hashicorp/tfe-agent", [COPY])[0] == IMAGE
+    assert G.bare_image_source("hashicorp/tfe-agent", ["docker pull hashicorp/other"]) is None
+    assert G.bare_image_source("hashicorp/tfe-agent", []) is None
+    assert G.bare_image_source("hashicorp/tfe-agent",
+                               [COPY, "docker pull ghcr.io/hashicorp/tfe-agent:1"]) is None
+
+
+@pytest.fixture()
+def db(tmp_path):
+    database = SessionDB(db_path=tmp_path / "state.db")
+    database.create_session("root", source="cli")
+    database.append_message("root", "user", "Run docgen against the TFE agent and port the lanes")
+    database.append_message("root", "assistant", "Starting subagents for it.")
+    G.record_card_grant(database, "root", ["github.com/usa-reddragon/docgen"])
+    yield database
+    database.close()
+
+
+class Judge:
+    def __init__(self, source=""):
+        self.source = source
+
+    def __call__(self, stage, system, user, max_tokens):
+        if stage == 1:
+            return "<block>yes</block>"
+        tag = f"<source>{self.source}</source>" if self.source else ""
+        return f"<block>yes</block><category>Code from External</category><reason>{REASON}</reason>{tag}"
+
+
+@pytest.fixture()
+def judge():
+    j = Judge()
+    A.set_complete_override(j)
+    yield j
+    A.set_complete_override(None)
+
+
+class _Agent:
+    def __init__(self, session_id, db=None, messages=None):
+        self.session_id = session_id
+        self._session_db = db
+        self._approval_review_messages = messages
+
+
+def _root(db):
+    return _Agent("root", db, db.get_messages_as_conversation("root"))
+
+
+def _child(parent, db, earlier: str, tmp_path, goal="relift lane tfe-agent"):
+    messages = [{"role": "user", "content": goal}]
+    if earlier:
+        messages += [
+            {"role": "assistant", "content": "", "tool_calls": [
+                {"id": "c1", "type": "function",
+                 "function": {"name": "terminal", "arguments": {"command": earlier.format(d=tmp_path)}}}]},
+            {"role": "tool", "tool_call_id": "c1", "content": '{"output": "", "exit_code": 0}'}]
+    child = _Agent(f"{parent.session_id}-child", db, messages)
+    _bind_approval_review_root(child, parent, goal)
+    child._delegate_depth = getattr(parent, "_delegate_depth", 0) + 1
+    return child
+
+
+def _args(tmp_path, command=RUN):
+    return {"command": command.format(d=tmp_path)}
+
+
+@pytest.fixture()
+def gateway(monkeypatch, tmp_path):
+    key = "gw-relift"
+    cards: list = []
+    monkeypatch.setattr(approval_mod, "get_current_session_key", lambda default="": key)
+    monkeypatch.setattr(A, "_cwd", lambda: str(tmp_path))
+    monkeypatch.setattr(A.HeldReview, "INTERVAL", 0.0)
+    approval_mod.register_gateway_notify(key, cards.append)
+    yield key, cards
+    approval_mod.unregister_gateway_notify(key)
+    approval_mod.clear_session(key)
+
+
+def _ask(agent, monkeypatch, tmp_path, result, command=RUN):
+    monkeypatch.setattr(A, "_current_agent", lambda: agent)
+    result["value"] = approval_mod._provenance_decision(
+        approval_mod._ACTION_GATE, "terminal", _args(tmp_path, command), command="<terminal> " + command,
+        approval_callback=None, is_cli=False, is_gateway=True, is_ask=False)
+
+
+def _card(cards, limit=10.0):
+    end = time.monotonic() + limit
+    while not cards and time.monotonic() < end:
+        time.sleep(0.02)
+    assert cards, "no approval card was raised"
+    return cards[0]
+
+
+def _answer(agent, gateway, monkeypatch, tmp_path, choice, command=RUN):
+    key, cards = gateway
+    cards.clear()
+    result: dict = {}
+    worker = threading.Thread(target=lambda: _ask(agent, monkeypatch, tmp_path, result, command))
+    worker.start()
+    card = _card(cards)
+    approval_mod.resolve_gateway_approval(key, choice, request_id=card["request_id"])
+    worker.join(30)
+    return card, result["value"]
+
+
+@pytest.mark.parametrize("earlier, named", [(UNPACK, ""), (COPY, "hashicorp/tfe-agent"), (COPY, IMAGE)])
+def test_live_card_offers_this_chat_and_always_for_the_image(
+        db, judge, gateway, monkeypatch, tmp_path, earlier, named):
+    judge.source = named
+    root = _root(db)
+    card, result = _answer(_child(root, db, earlier, tmp_path), gateway, monkeypatch, tmp_path, "session")
+    assert card["rule"] == "Code from External"
+    assert REASON in card["reason"]
+    assert card["grant_source"] == IMAGE
+    assert offer(card) == ["once", "session", "always", "deny"]
+    assert card["scope_keys"] == ["code_source:" + IMAGE]
+    assert result["approved"] is True
+
+    leaf = _child(_child(root, db, "", tmp_path, "x"), db, earlier, tmp_path, "run it again")
+    assert A.review("terminal", _args(tmp_path), agent=leaf, cwd=str(tmp_path)).decision == "allow"
+    judge.source = named.replace("tfe-agent", "consul") if named else ""
+    other = earlier.replace("tfe-agent", "consul")
+    leaf = _child(_child(root, db, "", tmp_path, "x"), db, other, tmp_path, "another image")
+    if named:
+        assert A.review("terminal", _args(tmp_path), agent=leaf, cwd=str(tmp_path)).decision == "block"
+
+
+def test_always_clears_the_image_in_a_new_chat(db, judge, gateway, monkeypatch, tmp_path):
+    root = _root(db)
+    card, result = _answer(_child(root, db, UNPACK, tmp_path), gateway, monkeypatch, tmp_path, "always")
+    assert result["approved"] is True
+    assert "code_source:" + IMAGE in approval_mod.load_permanent_allowlist()
+    db.create_session("other", source="cli")
+    db.append_message("other", "user", "Something else")
+    fresh = _child(_Agent("other", db, db.get_messages_as_conversation("other")), db, UNPACK, tmp_path)
+    monkeypatch.setattr(approval_mod, "get_current_session_key", lambda default="": "gw-other")
+    assert A.review("terminal", _args(tmp_path), agent=fresh, cwd=str(tmp_path)).decision == "allow"
+
+
+def test_card_without_a_source_scopes_to_the_exact_action(db, judge, gateway, monkeypatch, tmp_path):
+    root = _root(db)
+    command = "cd {d} && ./build.sh"
+    card, result = _answer(_child(root, db, "", tmp_path), gateway, monkeypatch, tmp_path, "session", command)
+    assert offer(card) == ["once", "session", "always", "deny"]
+    assert card["scope_keys"] == [approval_mod.override_key("<terminal> " + command)]
+    assert result["approved"] is True
+    key, cards = gateway
+    cards.clear()
+    again: dict = {}
+    _ask(_child(root, db, "", tmp_path), monkeypatch, tmp_path, again, command)
+    assert again["value"]["approved"] is True and not cards
