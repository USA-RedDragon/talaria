 # ── Restart handoff ─────────────────────────────────────────────────────────
+def carry_to_boundaries(agent: Any) -> list:
+    """The per-turn restart carry (``gateway.restart_turn_handoff_per_turn``): each running child of the subagent that
+    is in a turn runs its model call and tool round on to its next step boundary and stops there, as the subagent
+    does (``delegate_tool_handoff._handoff_fn``), so the next gateway repeats no model call of it and runs no tool
+    call of it again. Stopping the children with the subagent cut them. Returns one event per child asked, set once
+    it stopped; its state is kept on the unit (``Unit.carried``) for ``hand_off``. A child with no resume record,
+    or not in a turn (it waits on its own processes), stops with the subagent as before."""
+    from agent import turn_boundary_handoff as boundary
+    from tools.delegate_tool_handoff import _child_state, _in_turn
+    events = []
+    for unit in running(agent):
+        if unit.spec is None:
+            continue
+        for child, index in zip(list(unit.children), unit.indexes):
+            if index in unit.carried or not _in_turn(child):
+                continue
+            event = threading.Event()
+
+            def at_boundary(u=unit, c=child, i=index, e=event) -> None:
+                try:
+                    u.carried[i] = _child_state(c)
+                finally:
+                    e.set()
+            child._delegate_restart_handoff = True  # a wait it starts now ends at once
+            child._handoff_capture = at_boundary  # its cleanup calls it once its run ended
+            unit.carried.setdefault(index, None)
+            boundary.request(child, tool_round=False)
+            events.append(event)
+    return events
+
