@@ -0,0 +1,116 @@
+"""The per-turn restart carry and a subagent's own subagents (its helpers, ``delegate_tool_subunits``).
+
+A subagent carried to its step boundary (0150) handed its helpers over by stopping them with it: a helper in a model
+call had that call cut and the next gateway made it again. Now each helper in a turn is carried the same way: it runs
+on to its own next step boundary, the subagent's stop waits for it, and its unit goes to the next gateway as
+unfinished (resumed there), not as a finished result, and does not wake the subagent here.
+"""
+
+import threading
+import time
+import weakref
+
+import pytest
+
+from agent import turn_boundary_handoff as boundary
+from tests.waiting import wait_until
+from tools import delegate_tool_handoff as handoff
+from tools import delegate_tool_subunits as subunits
+
+
+class _Agent:
+    """A subagent or helper inside a turn (a model call), with the cleanup hook its run calls once it returns."""
+
+    def __init__(self, name, in_turn=True):
+        self._execution_thread_id = 1000 if in_turn else None
+        self._tool_worker_threads, self._tool_worker_threads_lock = set(), threading.Lock()
+        self.session_id, self.stops, self._delegate_restart_handoff = name, [], False
+
+    def get_activity_summary(self):
+        return {"current_tool": None}
+
+    def hard_interrupt(self, message=None, *, tool_reason=None):
+        self.stops.append(tool_reason)
+
+    def reach_boundary(self):
+        assert boundary.stop_here(self)
+        self._execution_thread_id = None
+        self._handoff_capture()
+
+
+@pytest.fixture
+def quiet_state(monkeypatch):
+    monkeypatch.setattr(handoff, "_child_state", lambda child: {"session_id": child.session_id})
+    monkeypatch.setattr(subunits, "is_waiting", lambda _agent: False)
+
+
+def _helper_unit(subagent, helper):
+    unit = subunits.Unit("deleg-h", ["help"], [0], ["sa-h"], None, "leaf", "m",
+                         {"version": 1, "children": {"0": {"goal": "help"}}}, [helper])
+    unit.stop_fn = lambda: subunits._signal_child_stop(helper, "Stopped by its parent subagent")
+    subunits._add(subagent, unit)
+    return unit
+
+
+def _handed_off_result():
+    return {"results": [{"task_index": 0, "status": "interrupted", "exit_reason": "handed_off", "summary": None}]}
+
+
+@pytest.mark.parametrize("subagent_in_turn", [True, False])
+def test_a_helper_in_a_model_call_reaches_its_boundary_before_the_subagent_is_handed_off(quiet_state,
+                                                                                        subagent_in_turn):
+    subagent, helper = _Agent("sub", in_turn=subagent_in_turn), _Agent("helper")
+    unit = _helper_unit(subagent, helper)
+    woken = []
+    subunits._wake, original = (lambda agent: woken.append(agent)), subunits._wake
+    try:
+        state = {}
+        started = time.monotonic()
+        worker = threading.Thread(target=handoff._handoff_fn({0: subagent}), args=(started, state),
+                                  kwargs={"boundary_until": started + 10})
+        worker.start()
+        wait_until(lambda: boundary.requested(helper), what="the helper's boundary was requested")
+        if subagent_in_turn:
+            wait_until(lambda: boundary.requested(subagent), what="the subagent's boundary was requested")
+            threading.Thread(target=subagent.reach_boundary).start()
+        time.sleep(0.3)
+        # Neither is stopped while the helper's model call runs: the subagent's stop waits for it.
+        assert helper.stops == [] and subagent.stops == [] and state == {}
+        assert boundary.stop_here(helper, tool_round=True) is False  # its tool round runs
+        helper.reach_boundary()
+        subunits._finish(weakref.ref(subagent), unit, _handed_off_result())
+        worker.join(5)
+        assert not worker.is_alive()
+    finally:
+        subunits._wake = original
+    assert woken == []  # a helper stopped for the restart has nothing to deliver here
+    assert helper.stops == [] and subagent.stops == [handoff.RESTART_TOOL_REASON]
+    units = state["0"]["units"]
+    assert len(units) == 1 and units[0]["done"] is False and units[0]["kept"] == {}
+    assert units[0]["spec"]["children"]["0"]["session_id"] == "helper"
+
+
+def test_a_helper_not_in_a_turn_stops_with_the_subagent_as_before(quiet_state):
+    subagent, helper = _Agent("sub", in_turn=False), _Agent("helper", in_turn=False)
+    _helper_unit(subagent, helper)
+    state = {}
+    started = time.monotonic()
+    handoff._handoff_fn({0: subagent})(started, state, boundary_until=started + 10)
+    assert time.monotonic() - started < 2
+    assert not boundary.requested(helper) and helper._delegate_restart_handoff is True
+    assert state["0"]["units"][0]["done"] is False
+
+
+def test_a_helper_that_finished_normally_is_still_delivered():
+    subagent = _Agent("sub")
+    unit = _helper_unit(subagent, _Agent("helper"))
+    unit.carried[0] = None
+    woken = []
+    original, subunits._wake = subunits._wake, (lambda agent: woken.append(agent))
+    try:
+        subunits._finish(weakref.ref(subagent), unit, {"results": [{"task_index": 0, "status": "completed",
+                                                                     "exit_reason": "completed"}]})
+    finally:
+        subunits._wake = original
+    assert woken == [subagent]
+    assert subunits.hand_off(subagent)[0]["done"] is True
