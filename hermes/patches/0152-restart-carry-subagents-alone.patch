diff --git a/tests/gateway/test_restart_carry_subagent_command.py b/tests/gateway/test_restart_carry_subagent_command.py
new file mode 100644
index 00000000..ba90b934
--- /dev/null
+++ b/tests/gateway/test_restart_carry_subagent_command.py
@@ -0,0 +1,183 @@
+"""A background subagent's foreground command across a per-turn restart (gateway.restart_turn_handoff_per_turn with
+delegation.restart_handoff), with no chat turn running: the real child loop and the real terminal tool.
+
+The restart wait returned at once (no turn ran), so the carry never started; the stop then handed the subagent over
+with no grace: its running command was moved to the background (``yielded_to_background``), its next model call was
+started and cut, and the next gateway's subagent ran the command again. Now the carry runs the subagent on to its step
+boundary: the command ends and returns its real result, the subagent stops before its next model call, and the next
+gateway resumes it with that result in its transcript.
+"""
+import asyncio
+import json
+import os
+import threading
+import time
+
+import pytest
+
+from gateway import turn_boundary, turn_carry, turn_handoff
+from gateway.run_shutdown import GatewayShutdownMixin
+from tests.agent.test_turn_boundary_handoff import _agent as _bare_agent
+from tests.agent.test_turn_boundary_handoff import _response
+from tests.gateway.test_restart_turn_carry import _old_runner, _reserve_profile, _until
+from tests.tools.test_delegate_resume_action import (  # the seams fixture
+    CHILD, PARENT, SID, _Parent, _call, _completions, _finished_child, _record, seams,
+)
+from tests.waiting import wait_until
+from tools import async_delegation as ad
+from tools import delegate_tool_handoff as handoff
+from tools.delegate_tool_registry import _active_subagents, _active_subagents_lock
+
+pytestmark = pytest.mark.platforms("linux")
+
+
+@pytest.fixture(autouse=True)
+def _clean(monkeypatch, tmp_path):
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+    monkeypatch.setattr(turn_handoff, "_handing_off", False)
+    monkeypatch.setattr(turn_boundary, "_resuming", set())
+    monkeypatch.setattr(turn_boundary, "_handed_off", set())
+    monkeypatch.setattr(turn_carry, "_released", False)
+    monkeypatch.setattr(turn_carry, "_api_target", None)
+    monkeypatch.setattr(turn_carry, "_carrying", False)
+    monkeypatch.setattr("agent.title_generator.maybe_auto_title", lambda *a, **k: None)
+
+    async def noop(*_a, **_k):
+        return None
+    for name in ("_stop_cron", "_disconnect_messaging"):
+        monkeypatch.setattr(turn_carry, name, noop)
+    monkeypatch.setattr(GatewayShutdownMixin, "_stop_hand_off_processes", staticmethod(noop))
+    import tools.delegate_tool_config as config
+    monkeypatch.setattr(config, "_get_restart_handoff", lambda: True)
+    ad._reset_for_tests()
+    yield
+    ad._reset_for_tests()
+    with _active_subagents_lock:
+        _active_subagents.clear()
+
+
+def _terminal_call(command, call_id="call_t1"):
+    from types import SimpleNamespace
+    return SimpleNamespace(id=call_id, type="function",
+                           function=SimpleNamespace(name="terminal", arguments=json.dumps({"command": command})))
+
+
+def _real_child(db, model_calls):
+    """A real agent as the rebuilt subagent: its own loop, its stored session, a scripted model."""
+    child = _bare_agent(db, CHILD)
+    for name, value in (("_delegate_restart_handoff", False), ("_delegate_live_writer", None),
+                        ("_live_transcript_path", None), ("_delegate_output_schema", None), ("_delegate_images", []),
+                        ("_subagent_id", SID), ("model", "qwen"), ("_delegate_depth", 1),
+                        ("_parent_session_id", PARENT)):
+        setattr(child, name, value)
+    script = list(model_calls)
+    child.client.chat.completions.create.side_effect = lambda **kwargs: script.pop(0)(**kwargs)
+    child.valid_tool_names = {"terminal"}
+    return child
+
+
+@pytest.fixture
+def real_terminal(monkeypatch, tmp_path):
+    """The terminal tool for real (local backend), counted; every other tool refuses."""
+    from tools.terminal_tool import terminal_tool
+    runs = []
+
+    def call(name, args, *a, **k):
+        assert name == "terminal", name
+        runs.append(args["command"])
+        return terminal_tool(args["command"], task_id=SID, timeout=60)
+    monkeypatch.setattr("model_tools.handle_function_call", call)
+    monkeypatch.setenv("TERMINAL_CWD", str(tmp_path))
+    return runs
+
+
+def _idle(runner):
+    runner._active_work_count = lambda: 0
+    runner._awaitable_work_count = lambda: 0
+    runner._restart_safe_cron_count = lambda: 0
+    runner._wedged_agent_count = lambda: 0
+    runner._active_cron_job_count = lambda: 0
+    runner._running_agent_items = list
+    return runner
+
+
+async def _restart(runner):
+    """What a restart runs for the subagents: the restart wait (the per-turn carry), then the stop's handoff."""
+    await GatewayShutdownMixin._await_active_work_before_restart(runner)
+    ctx = GatewayShutdownMixin._StopContext(deferred_count=lambda: 0)
+    ctx.started_at = time.monotonic()
+    await GatewayShutdownMixin._stop_hand_off_delegations(runner, ctx)
+
+
+@pytest.mark.live_system_guard_bypass
+@pytest.mark.asyncio
+async def test_a_subagents_running_command_ends_here_and_is_not_run_again(owner, tmp_path, seams, real_terminal):
+    from hermes_state_registry import acquire
+    db = acquire()
+    record = _record()
+    record[handoff.RESUME_STATE_KEY]["cwd"] = str(tmp_path)
+    _finished_child(db, record=record)
+    marker = tmp_path / "runs.txt"
+    command = f"sleep 2; echo zd-s2-1 >> {marker}; echo zd-s2-1"
+    asked = threading.Event()
+
+    def first(**_kwargs):
+        asked.set()
+        return _response("", [_terminal_call(command)])
+
+    second_calls = []
+
+    def after_the_command(**kwargs):
+        second_calls.append(kwargs)
+        return _response("All four done.")
+
+    child = _real_child(db, [first, after_the_command])
+    seams(child)
+    handle = _call(_Parent(db), subagent_id=SID, message="run the commands")
+    run_id = handle["run_id"]
+    await asyncio.to_thread(wait_until, lambda: real_terminal, what="the command started")
+    await asyncio.sleep(0.3)  # the command is in flight when the restart begins
+
+    _reserve_profile(tmp_path)
+    runner = _idle(_old_runner(owner, restart_turn_carry_ceiling_seconds=1080.0))
+    await asyncio.wait_for(_restart(runner), 30.0)
+
+    # The command ran to its end on the old gateway and the subagent stopped before its next model call.
+    assert marker.read_text().splitlines() == ["zd-s2-1"]
+    rows = db.get_messages_as_conversation(CHILD)
+    tool_rows = [r for r in rows if r["role"] == "tool" and r.get("tool_call_id") == "call_t1"]
+    assert len(tool_rows) == 1
+    result = json.loads(tool_rows[0]["content"])
+    assert result.get("status") != "yielded_to_background" and result["exit_code"] == 0
+    assert "zd-s2-1" in result["output"]
+    assert asked.is_set() and second_calls == []
+    assert _completions(run_id) == []  # handed to the next gateway, not finished here
+    assert json.loads(_row(run_id))["handoff"]
+    if getattr(runner, "_turn_carry", None) is not None and runner._turn_carry.lock_fd is not None:
+        os.close(runner._turn_carry.lock_fd)
+
+    # The next gateway resumes it with the real result in its transcript: one model call, no command run again.
+    ad._reset_for_tests()
+    with _active_subagents_lock:
+        _active_subagents.clear()
+    resumed_calls = []
+
+    def resumed_model(**kwargs):
+        resumed_calls.append(kwargs)
+        return _response("All four done.")
+    resumed = _real_child(db, [resumed_model])
+    seams(resumed)
+    assert ad.adopt_handed_off_delegations(handoff._resume_unit) == 1
+    event = (await asyncio.to_thread(wait_until, lambda: _completions(run_id), timeout=30,
+                                     what="the resumed subagent's result"))[0]
+    assert event["results"][0]["status"] == "completed"
+    assert len(resumed_calls) == 1 and real_terminal == [command]
+    assert marker.read_text().splitlines() == ["zd-s2-1"]
+    sent = resumed_calls[0]["messages"]
+    assert any(m.get("role") == "tool" and m.get("tool_call_id") == "call_t1" and "zd-s2-1" in str(m.get("content"))
+               for m in sent)
+
+
+def _row(delegation_id):
+    from tests.tools.test_delegate_resume_action import _row_json
+    return _row_json(delegation_id)
