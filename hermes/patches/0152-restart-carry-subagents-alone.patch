+"""gateway.restart_turn_handoff_per_turn with delegation.restart_handoff and no chat turn running: the background
+subagents are still carried to their step boundaries. The restart wait used to return at once when no turn ran (the
+subagents are not work it waits for), so the carry never started and the stop handed the subagents over the 0016 way
+with no grace: a running foreground command was moved to the background and the subagent's next model call was cut.
+"""
+import asyncio
+import os
+import threading
+
+import pytest
+
+from gateway import turn_boundary, turn_carry, turn_handoff
+from gateway.run_shutdown import GatewayShutdownMixin
+
+from tests.gateway.test_restart_turn_carry import _old_runner, _reserve_profile, _until
+
+
+@pytest.fixture(autouse=True)
+def _clean(monkeypatch, tmp_path):
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+    monkeypatch.setattr(turn_handoff, "_handing_off", False)
+    monkeypatch.setattr(turn_boundary, "_resuming", set())
+    monkeypatch.setattr(turn_boundary, "_handed_off", set())
+    monkeypatch.setattr(turn_carry, "_released", False)
+    monkeypatch.setattr(turn_carry, "_api_target", None)
+    monkeypatch.setattr(turn_carry, "_carrying", False)
+
+    async def noop(*_a, **_k):
+        return None
+    for name in ("_stop_cron", "_disconnect_messaging"):
+        monkeypatch.setattr(turn_carry, name, noop)
+    monkeypatch.setattr(GatewayShutdownMixin, "_stop_hand_off_processes", staticmethod(noop))
+
+
+@pytest.fixture
+def subagent(monkeypatch):
+    """One live background delegation; the handoff returns once its subagent reached its boundary (``reach``)."""
+    import tools.async_delegation as ad
+    import tools.delegate_tool_config as config
+    monkeypatch.setattr(config, "_get_restart_handoff", lambda: True)
+    live = {"count": 1}
+    monkeypatch.setattr(ad, "active_count", lambda: live["count"])
+    reach, calls = threading.Event(), []
+
+    def hand_off_for_restart(grace, timeout, *, boundary_seconds=None, marked=None):
+        calls.append({"grace": grace, "boundary_seconds": boundary_seconds})
+        if marked is not None:
+            marked.set()
+        if boundary_seconds is not None:
+            reach.wait(10)
+        live["count"] = 0
+        return 1
+    monkeypatch.setattr(ad, "hand_off_for_restart", hand_off_for_restart)
+    return live, reach, calls
+
+
+def _idle(runner):
+    """No chat turn, cron run or API run: only the background subagent works."""
+    runner._active_work_count = lambda: 0
+    runner._awaitable_work_count = lambda: 0
+    runner._restart_safe_cron_count = lambda: 0
+    runner._wedged_agent_count = lambda: 0
+    runner._active_cron_job_count = lambda: 0
+    runner._running_agent_items = list
+    return runner
+
+
+@pytest.mark.asyncio
+async def test_a_subagent_with_no_turn_running_is_carried_to_its_boundary(owner, tmp_path, subagent):
+    _live, reach, calls = subagent
+    _reserve_profile(tmp_path)
+    runner = _idle(_old_runner(owner, restart_turn_carry_ceiling_seconds=1080.0))
+    wait = asyncio.ensure_future(GatewayShutdownMixin._await_active_work_before_restart(runner))
+    await _until(lambda: calls)
+    # Carried, not stopped at the release: its tool round and model call run on to their end here.
+    assert calls[0]["boundary_seconds"] == pytest.approx(1080.0 - turn_carry.SUBAGENT_STOP_RESERVE_S)
+    await _until(turn_carry.released)  # the next gateway serves the profile meanwhile
+    await asyncio.sleep(0.3)
+    assert not wait.done()
+    reach.set()
+    assert await asyncio.wait_for(wait, 5.0) is False
+    assert len(calls) == 1
+    os.close(runner._turn_carry.lock_fd)
+
+
+@pytest.mark.asyncio
+async def test_with_nothing_running_the_restart_does_not_carry(owner, tmp_path, subagent):
+    live, _reach, calls = subagent
+    live["count"] = 0
+    _reserve_profile(tmp_path)
+    runner = _idle(_old_runner(owner))
+    assert await GatewayShutdownMixin._await_active_work_before_restart(runner) is True
+    assert calls == [] and getattr(runner, "_turn_carry", None) is None and not turn_carry.released()
+
+
+@pytest.mark.asyncio
+async def test_without_subagent_handoff_a_subagent_does_not_start_a_carry(owner, tmp_path, subagent, monkeypatch):
+    import tools.delegate_tool_config as config
+    monkeypatch.setattr(config, "_get_restart_handoff", lambda: False)
+    _reserve_profile(tmp_path)
+    runner = _idle(_old_runner(owner))
+    assert await GatewayShutdownMixin._await_active_work_before_restart(runner) is True
+    assert subagent[2] == [] and getattr(runner, "_turn_carry", None) is None
