diff --git a/tests/tui_gateway/test_events_since_carried_from.py b/tests/tui_gateway/test_events_since_carried_from.py
new file mode 100644
index 00000000..c9fc0088
--- /dev/null
+++ b/tests/tui_gateway/test_events_since_carried_from.py
@@ -0,0 +1,47 @@
+"""A replayed event published by a carried turn names its carrier in ``carried_from``; the
+``session.events.since`` result contract must declare it."""
+
+import pytest
+
+from tui_gateway.contracts import registry as contracts
+
+
+def _event(**extra):
+    return {
+        "type": "message.delta",
+        "session_id": "s1",
+        "payload": {"text": "hi"},
+        "replay_epoch": "e1",
+        "seq": 2,
+        **extra,
+    }
+
+
+def _result(event):
+    return {
+        "events": [event],
+        "latest_seq": 2,
+        "last_sequence": 2,
+        "epoch": "e0",
+        "replay_epoch": "e1",
+        "truncated": False,
+        "snapshot_required": False,
+        "count": 1,
+    }
+
+
+def test_events_since_result_accepts_carried_from():
+    contract = contracts.CANONICAL_METHODS["session.events.since"]
+    contracts.check_result(contract, _result(_event(carried_from={"replay_epoch": "199e7ec", "seq": 105427})))
+
+
+def test_events_since_result_still_refuses_other_extra_keys():
+    contract = contracts.CANONICAL_METHODS["session.events.since"]
+    with pytest.raises(contracts.ContractViolation):
+        contracts.check_result(contract, _result(_event(bogus=1)))
+
+
+def test_events_since_result_rejects_malformed_carried_from():
+    contract = contracts.CANONICAL_METHODS["session.events.since"]
+    with pytest.raises(contracts.ContractViolation):
+        contracts.check_result(contract, _result(_event(carried_from={"seq": "x"})))
diff --git a/tui_gateway/contracts/canonical_sessions.py b/tui_gateway/contracts/canonical_sessions.py
index 3682edb1..c78485e7 100644
--- a/tui_gateway/contracts/canonical_sessions.py
+++ b/tui_gateway/contracts/canonical_sessions.py
@@ -368,6 +368,11 @@ class CanonicalEventsParams(CanonicalSessionParams):
     replay_epoch: str | None = None
 
 
+class CanonicalCarriedFrom(Result):
+    replay_epoch: str
+    seq: int
+
+
 class CanonicalReplayEvent(Result):
     type: str
     session_id: str
@@ -377,6 +382,9 @@ class CanonicalReplayEvent(Result):
     authority_epoch: int | None = None
     execution_generation: int | None = None
     admission_id: str | None = None
+    # Set on a frame a restarted gateway published for a turn it carried over: the carrier's own
+    # ``replay_epoch`` and ``seq`` for that frame, so a client that moved sockets drops the duplicate.
+    carried_from: CanonicalCarriedFrom | None = None
 
 
 class CanonicalEventsResult(Result):
