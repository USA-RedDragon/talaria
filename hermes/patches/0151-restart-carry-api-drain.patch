diff --git a/tests/gateway/test_restart_carry_api_drain.py b/tests/gateway/test_restart_carry_api_drain.py
new file mode 100644
index 00000000..1cc49945
--- /dev/null
+++ b/tests/gateway/test_restart_carry_api_drain.py
@@ -0,0 +1,272 @@
+"""gateway.restart_turn_handoff_per_turn: the old gateway's API port relays to the next gateway up to the end of its
+process, closes only a margin after its pod went unready, and lets the requests in flight on it finish.
+
+Before, the relay was cancelled as soon as the last carried turn ended: the process went on through its stop for
+seconds with the port closed (a client in the pod got ``Connection refused``), and a relayed request still in flight
+was cut (``RemoteDisconnected``)."""
+import asyncio
+import socket
+import time
+from types import SimpleNamespace
+
+import pytest
+from aiohttp import web
+
+from gateway import listener_relay, turn_boundary, turn_carry
+from gateway.config import Platform
+from gateway.listener_relay import _HttpExchanges, relay_api_listener
+
+
+@pytest.fixture(autouse=True)
+def _clean(monkeypatch, tmp_path):
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+    monkeypatch.setattr(turn_carry, "_released", False)
+    monkeypatch.setattr(turn_carry, "_api_target", None)
+    monkeypatch.setattr(turn_carry, "_carrying", False)
+
+
+async def _next_api(delay=0.0):
+    """The next gateway's API server: POST /v1/chat/completions answers after *delay* seconds."""
+    async def completions(request):
+        await request.read()
+        await asyncio.sleep(delay)
+        return web.json_response({"answer": "from the next gateway", "pad": "x" * 2000})
+
+    app = web.Application()
+    app.router.add_post("/v1/chat/completions", completions)
+    runner = web.AppRunner(app)
+    await runner.setup()
+    site = web.TCPSite(runner, "127.0.0.1", 0)
+    await site.start()
+    return runner, ("127.0.0.1", site._server.sockets[0].getsockname()[1])
+
+
+async def _old_api():
+    """The old gateway's API server and an adapter that names it, as ``_stop_api_listening`` reads it."""
+    app = web.Application()
+    runner = web.AppRunner(app)
+    await runner.setup()
+    site = web.TCPSite(runner, "127.0.0.1", 0)
+    await site.start()
+    port = site._server.sockets[0].getsockname()[1]
+    adapter = SimpleNamespace(_site=site, _port=port, _host="127.0.0.1")
+    return runner, adapter, port
+
+
+def _request(body=b'{"messages": []}', keep_alive=False) -> bytes:
+    return (b"POST /v1/chat/completions HTTP/1.1\r\nHost: x\r\nContent-Type: application/json\r\n"
+            + (b"" if keep_alive else b"Connection: close\r\n")
+            + b"Content-Length: " + str(len(body)).encode() + b"\r\n\r\n" + body)
+
+
+async def _post(port, timeout=10.0):
+    """One request on a new connection, as urllib sends it: (status line, whole response) or the error."""
+    reader, writer = await asyncio.open_connection("127.0.0.1", port)
+    try:
+        writer.write(_request())
+        await writer.drain()
+        data = await asyncio.wait_for(reader.read(), timeout)
+        return data
+    finally:
+        writer.close()
+
+
+def _complete(response: bytes) -> bool:
+    head, _, body = response.partition(b"\r\n\r\n")
+    if not head.startswith(b"HTTP/1.1 200"):
+        return False
+    length = next(int(line.split(b":")[1]) for line in head.split(b"\r\n") if line.lower().startswith(b"content-length"))
+    return len(body) == length
+
+
+def _refused(port) -> bool:
+    try:
+        socket.create_connection(("127.0.0.1", port), timeout=1).close()
+    except ConnectionRefusedError:
+        return True
+    return False
+
+
+def _carrier(adapter):
+    runner = SimpleNamespace(adapters={Platform.API_SERVER: adapter}, _carry_listener_task=None)
+    carry = SimpleNamespace(runner=runner, api_relay=None, api_stop=asyncio.Event(), unready_at=None, turns={},
+                            done=set(), started=time.monotonic(), processes_handed=asyncio.Event())
+    runner._turn_carry = carry
+    return runner, carry
+
+
+async def _carry_turns_with_nothing_left(monkeypatch, carry):
+    async def noop(*_a, **_k):
+        return None
+    monkeypatch.setattr(turn_carry, "_apply_controls", noop)
+    monkeypatch.setattr(turn_carry, "_hand_off_processes_when_idle", noop)
+    monkeypatch.setattr(turn_carry, "_end_kept_sockets", lambda *_a, **_k: None)
+    monkeypatch.setattr(turn_carry, "_cron_runs", lambda runner: 0)
+    monkeypatch.setattr(turn_carry, "_api_live", lambda runner: 0)
+    monkeypatch.setattr(turn_boundary, "_turns", lambda runner: [])
+    await asyncio.wait_for(turn_carry._carry_turns(carry), 5)
+
+
+# --- the carrier's API port --------------------------------------------------------------------------------------
+
+
+@pytest.mark.asyncio
+async def test_the_api_port_relays_past_the_end_of_the_carry_and_closes_after_the_margin(monkeypatch):
+    next_runner, target = await _next_api(delay=0.2)
+    old_runner, adapter, port = await _old_api()
+    monkeypatch.setattr(listener_relay, "successor_api_target", lambda marker: target)
+    monkeypatch.setattr(turn_carry, "API_ENDPOINTS_MARGIN_S", 0.6)
+    runner, carry = _carrier(adapter)
+    try:
+        await turn_carry._stop_api_listening(runner, carry)
+        assert _complete(await _post(port))
+        await _carry_turns_with_nothing_left(monkeypatch, carry)
+        # The last carried turn ended; the process goes on through its stop, and the port still relays.
+        assert _complete(await _post(port))
+        started = time.monotonic()
+        finish = asyncio.ensure_future(turn_carry.finish_api_relay(runner))
+        await asyncio.sleep(0.3)
+        assert not finish.done() and _complete(await _post(port))  # within the margin: the Service may route here
+        await asyncio.wait_for(finish, 10)
+        assert carry.unready_at is not None and carry.unready_at <= started
+        assert time.monotonic() - carry.unready_at >= 0.6  # the margin counts from the end of the listener relay
+        assert _refused(port)
+    finally:
+        await old_runner.cleanup()
+        await next_runner.cleanup()
+
+
+@pytest.mark.asyncio
+async def test_a_request_in_flight_when_the_port_closes_gets_its_whole_answer(monkeypatch):
+    next_runner, target = await _next_api(delay=1.5)
+    old_runner, adapter, port = await _old_api()
+    monkeypatch.setattr(listener_relay, "successor_api_target", lambda marker: target)
+    monkeypatch.setattr(turn_carry, "API_ENDPOINTS_MARGIN_S", 0.0)
+    runner, carry = _carrier(adapter)
+    try:
+        await turn_carry._stop_api_listening(runner, carry)
+        in_flight = asyncio.ensure_future(_post(port))
+        await asyncio.sleep(0.3)
+        carry.unready_at = time.monotonic()
+        await asyncio.wait_for(turn_carry.finish_api_relay(runner), 10)
+        assert _complete(await asyncio.wait_for(in_flight, 5))
+        assert _refused(port)
+    finally:
+        await old_runner.cleanup()
+        await next_runner.cleanup()
+
+
+# --- the relay itself --------------------------------------------------------------------------------------------
+
+
+def _listening():
+    sock = socket.socket()
+    sock.bind(("127.0.0.1", 0))
+    sock.listen(16)
+    sock.setblocking(False)
+    return sock
+
+
+@pytest.mark.asyncio
+async def test_an_idle_kept_alive_connection_closes_at_once_and_a_busy_one_after_its_answer():
+    next_runner, target = await _next_api(delay=1.0)
+    sock = _listening()
+    port = sock.getsockname()[1]
+    stop = asyncio.Event()
+    loop = asyncio.get_running_loop()
+    relay = asyncio.ensure_future(relay_api_listener(sock, target, stop, connect_timeout=5, drain_seconds=10))
+    try:
+        idle_reader, idle_writer = await asyncio.open_connection("127.0.0.1", port)
+        idle_writer.write(_request(keep_alive=True))
+        head = await asyncio.wait_for(idle_reader.readuntil(b"\r\n\r\n"), 5)
+        length = next(int(l.split(b":")[1]) for l in head.split(b"\r\n") if l.lower().startswith(b"content-length"))
+        await idle_reader.readexactly(length)  # answered; the connection stays open between two requests
+        busy = asyncio.ensure_future(_post(port))
+        await asyncio.sleep(0.3)
+        stop.set()
+        closed_at = loop.time()
+        assert await asyncio.wait_for(idle_reader.read(), 2) == b""
+        assert loop.time() - closed_at < 0.5
+        assert _complete(await asyncio.wait_for(busy, 5))
+        assert await asyncio.wait_for(relay, 5) == (2, 0)
+        idle_writer.close()
+    finally:
+        relay.cancel()
+        await next_runner.cleanup()
+
+
+@pytest.mark.asyncio
+async def test_a_connection_still_busy_after_the_drain_is_cut():
+    next_runner, target = await _next_api(delay=5.0)
+    sock = _listening()
+    port = sock.getsockname()[1]
+    stop = asyncio.Event()
+    relay = asyncio.ensure_future(relay_api_listener(sock, target, stop, connect_timeout=5, drain_seconds=0.3))
+    try:
+        slow = asyncio.ensure_future(_post(port))
+        await asyncio.sleep(0.2)
+        stop.set()
+        await asyncio.wait_for(relay, 3)
+        assert not _complete(await asyncio.wait_for(slow, 3))
+    finally:
+        await next_runner.cleanup()
+
+
+def test_exchanges_tell_when_a_connection_sits_between_two_answers():
+    ex = _HttpExchanges()
+    assert ex.idle
+    ex.from_client(b"POST /v1/chat/completions HTTP/1.1\r\n")
+    assert not ex.idle
+    ex.from_server(b"HTTP/1.1 100 Continue\r\n\r\n")
+    assert not ex.idle  # an interim answer
+    ex.from_server(b"HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\nContent-Type: text/event-stream\r\n\r\n5\r\nda")
+    ex.from_client(b"")
+    assert not ex.idle
+    ex.from_server(b"ta:\r\n")
+    ex.from_server(b"a;x=1\r\n0123456789\r\n0\r\n")
+    assert not ex.idle  # the last chunk's trailer is still open
+    ex.from_server(b"\r\n")
+    assert ex.idle and ex.answered == 1
+    ex.from_client(b"GET / HTTP/1.1\r\n\r\n")
+    ex.from_server(b"HTTP/1.1 200 OK\r\nContent-Length: 3\r\n\r\nab")
+    assert not ex.idle
+    ex.from_server(b"c")
+    assert ex.idle and ex.answered == 2
+    ex.from_client(b"DELETE /x HTTP/1.1\r\n\r\n")
+    ex.from_server(b"HTTP/1.1 204 No Content\r\n\r\n")
+    assert ex.idle
+    ex.from_client(b"GET /x HTTP/1.1\r\n\r\n")
+    ex.from_server(b"HTTP/1.1 200 OK\r\nConnection: close\r\n\r\nuntil the end")
+    assert not ex.idle  # no length: it ends with the connection
+    upgraded = _HttpExchanges()
+    upgraded.from_client(b"GET /ws HTTP/1.1\r\n\r\n")
+    upgraded.from_server(b"HTTP/1.1 101 Switching Protocols\r\nContent-Length: 0\r\n\r\n")
+    assert not upgraded.idle
+
+
+# --- the process tail --------------------------------------------------------------------------------------------
+
+
+@pytest.mark.asyncio
+async def test_the_shutdown_tail_closes_the_api_relay_last(monkeypatch):
+    import threading
+    import gateway.run as gateway_run
+    from gateway import run_bootstrap
+    calls = []
+
+    async def finish(runner):
+        calls.append(("finish_api_relay", runner))
+
+    async def mcp(**_k):
+        calls.append(("mcp",))
+    monkeypatch.setattr(turn_carry, "finish_api_relay", finish)
+    monkeypatch.setattr(gateway_run, "_shutdown_mcp_servers_nonblocking", mcp)
+    monkeypatch.setattr(gateway_run, "_resolve_gateway_exit_verdict", lambda runner, sig: True)
+    monkeypatch.setattr(gateway_run, "_stop_cron_provider", lambda provider: None)
+    done = threading.Thread(target=lambda: None)
+    done.start()
+    done.join()
+    runner = SimpleNamespace(config=None)
+    assert await run_bootstrap._start_gateway_shutdown_tail(runner, None, threading.Event(), None, done, done,
+                                                            threading.Event(), done, [False]) is True
+    assert calls == [("mcp",), ("finish_api_relay", runner)]
