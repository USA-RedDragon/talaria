+++ b/tests/gateway/test_restart_takeover_load.py
@@ -0,0 +1,120 @@
+"""Per-request and per-reconnect work that made API answers slow on a gateway right after a takeover, when it
+serves its own API clients, the old pod's relayed ones and the hub's reconnecting viewers at once:
+
+- every tracked mutation's end re-published the in-flight count on the event loop (a deep copy of the status
+  snapshot, a PID record and a file write) even when the count had not changed;
+- each CLI session's inventory (one per viewer that reconnects) scanned the skill trees again: the scan bypassed
+  the skill catalog cache to keep its Kanban view apart;
+- the log file handler formatted (and redacted) every record twice."""
+import logging
+from types import SimpleNamespace
+
+import pytest
+
+from gateway import status
+
+
+@pytest.fixture(autouse=True)
+def _home(tmp_path, monkeypatch):
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+    monkeypatch.setattr(status, "_runtime_status_state", None)
+    monkeypatch.setattr(status, "_runtime_status_state_path", None)
+    return tmp_path
+
+
+def test_an_unchanged_in_flight_count_is_not_published_again(monkeypatch):
+    import gateway.run as gateway_run
+    from gateway.run_agent_cache import GatewayAgentCacheMixin
+    published = []
+    real = gateway_run._write_runtime_status_quiet
+
+    def write(**fields):
+        published.append(fields)
+        real(**fields)
+    monkeypatch.setattr(gateway_run, "_write_runtime_status_quiet", write)
+    running = []
+    runner = SimpleNamespace(_active_work_count=lambda: len(running),
+                             _running_agent_items=lambda: [(key, object()) for key in running])
+    persist = lambda: GatewayAgentCacheMixin._persist_active_agents(runner)  # noqa: E731
+    running.append("a")
+    persist()
+    for _ in range(20):  # each tracked mutation's end
+        persist()
+    running.append("b")
+    persist()
+    persist()
+    running.clear()
+    persist()
+    assert published == [{"active_agents": 1}, {"active_agents": 2}, {"active_agents": 0}]
+    assert status._runtime_status_state["active_agents"] == 0
+
+
+def test_another_writer_s_count_is_published_over(monkeypatch):
+    status.publish_runtime_status(active_agents=3)
+    assert status.active_agents_published(3) and not status.active_agents_published(2)
+    status.publish_runtime_status(gateway_state="running")
+    assert status.active_agents_published(3)
+
+
+def _skills(home):
+    for name, extra in (("arxiv", ""), ("sdlc-review", "environments:\n  - kanban\n")):
+        skill = home / "skills" / "devops" / name
+        skill.mkdir(parents=True)
+        (skill / "SKILL.md").write_text(f"---\nname: {name}\ndescription: d.\n{extra}---\nBody.\n")
+
+
+def test_each_cli_inventory_reuses_the_skill_catalog_and_keeps_its_kanban_view(_home, monkeypatch):
+    import agent.skill_utils as skill_utils
+    from gateway.session_local_inventory import _cli_skills
+    from tools import skills_tool
+    monkeypatch.delenv("HERMES_KANBAN_BOARD", raising=False)
+    monkeypatch.delenv("HERMES_KANBAN_TASK", raising=False)
+    monkeypatch.setattr(skills_tool, "_SKILLS_CACHE", {})
+    _skills(_home)
+    scans = []
+    real = skill_utils.resolve_skill_catalog
+
+    def resolve(scanned):
+        scans.append(len(scanned))
+        return real(scanned)
+    monkeypatch.setattr(skill_utils, "resolve_skill_catalog", resolve)
+    for _ in range(5):  # five viewers reconnect after a takeover
+        assert sorted(_cli_skills()["devops"]) == ["arxiv", "sdlc-review"]
+    assert len(scans) == 1
+    assert [s["name"] for s in skills_tool.find_all_skills()] == ["arxiv"]  # the other surfaces' own view
+    assert sorted(_cli_skills()["devops"]) == ["arxiv", "sdlc-review"]
+    assert [s["name"] for s in skills_tool.find_all_skills()] == ["arxiv"]
+    assert len(scans) == 2
+
+
+def test_the_log_file_handler_formats_each_record_once(tmp_path):
+    from hermes_logging import _ManagedRotatingFileHandler
+    calls = []
+
+    class Counting(logging.Formatter):
+        def format(self, record):
+            calls.append(record.getMessage())
+            return super().format(record)
+    handler = _ManagedRotatingFileHandler(str(tmp_path / "x.log"), maxBytes=1 << 20, backupCount=1)
+    handler.setFormatter(Counting("%(message)s"))
+    try:
+        for n in range(3):
+            handler.handle(logging.LogRecord("t", logging.INFO, __file__, 1, f"line {n}", None, None))
+    finally:
+        handler.close()
+    assert calls == ["line 0", "line 1", "line 2"]
+    assert (tmp_path / "x.log").read_text() == "line 0\nline 1\nline 2\n"
+
+
+def test_the_standby_builds_the_session_socket_contracts_before_the_lock(_home, monkeypatch):
+    """The first resume after a takeover validated its params and result against contract models whose validators
+    pydantic builds on first use (``defer_build``): schema generation on the event loop, while API requests wait."""
+    from gateway import standby_warm
+    from tui_gateway.contracts.registry import CANONICAL_METHODS
+    steps = []
+    for name in ("_warm_config", "_warm_openai_client", "_warm_skill_index", "_warm_turn_machinery"):
+        monkeypatch.setattr(standby_warm, name, lambda _n=name: steps.append(_n))
+    standby_warm.warm_standby(_home)
+    for method in ("session.resume", "session.create", "session.list"):
+        for model in (CANONICAL_METHODS[method].params, CANONICAL_METHODS[method].result):
+            assert model.__pydantic_complete__ and type(model.__pydantic_validator__).__name__ == "SchemaValidator"
