+
+
+class _HttpExchanges:
+    """Follows both halves of a relayed HTTP/1.x connection far enough to tell whether it sits between two
+    exchanges: the client sent nothing since the last complete response, and no response is under way. A
+    response ends with its ``Content-Length``, its last chunk, or (no length, or an upgrade) the connection.
+    Pipelined requests are not told apart (HTTP clients do not pipeline)."""
+
+    def __init__(self):
+        self.awaiting = False  # the client sent bytes the successor has not answered completely yet
+        self.answered = 0  # complete responses
+        self._head = bytearray()
+        self._state = "head"  # head, length, chunk-size, chunk-data, chunk-crlf, trailer, stream
+        self._left = 0
+        self._line = bytearray()
+
+    @property
+    def idle(self) -> bool:
+        return not self.awaiting and self._state == "head" and not self._head
+
+    def from_client(self, data: bytes) -> None:
+        if data:
+            self.awaiting = True
+
+    def from_server(self, data: bytes) -> None:
+        data = memoryview(data)
+        while len(data):
+            if self._state == "stream":  # until the connection ends
+                return
+            if self._state == "head":
+                self._head += data
+                end = self._head.find(b"\r\n\r\n")
+                if end < 0:
+                    if len(self._head) > _HEAD_LIMIT:
+                        self._state = "stream"
+                    return
+                rest = memoryview(bytes(self._head[end + 4:]))
+                self._start_body(bytes(self._head[:end]))
+                self._head.clear()
+                data = rest
+                continue
+            if self._state == "length":
+                n = min(self._left, len(data))
+                self._left -= n
+                data = data[n:]
+                if not self._left:
+                    self._done()
+                continue
+            if self._state == "chunk-data":
+                n = min(self._left, len(data))
+                self._left -= n
+                data = data[n:]
+                if not self._left:
+                    self._state, self._left = "chunk-crlf", 2
+                continue
+            if self._state == "chunk-crlf":
+                n = min(self._left, len(data))
+                self._left -= n
+                data = data[n:]
+                if not self._left:
+                    self._state = "chunk-size"
+                continue
+            # chunk-size and trailer lines
+            nl = bytes(data).find(b"\n")
+            if nl < 0:
+                self._line += data
+                if len(self._line) > _HEAD_LIMIT:
+                    self._state = "stream"
+                return
+            self._line += data[:nl + 1]
+            data = data[nl + 1:]
+            line = bytes(self._line).strip()
+            self._line.clear()
+            if self._state == "trailer":
+                if not line:
+                    self._done()
+                continue
+            try:
+                size = int(line.split(b";", 1)[0], 16)
+            except ValueError:
+                self._state = "stream"
+                return
+            if size == 0:
+                self._state = "trailer"
+            else:
+                self._state, self._left = "chunk-data", size
+
+    def _start_body(self, head: bytes) -> None:
+        lines = head.split(b"\r\n")
+        status = lines[0].split()
+        code = int(status[1]) if len(status) > 1 and status[1].isdigit() else 0
+        headers = {}
+        for line in lines[1:]:
+            name, _, value = line.partition(b":")
+            headers[name.strip().lower()] = value.strip().lower()
+        chunked = b"chunked" in headers.get(b"transfer-encoding", b"")
+        if 100 <= code < 200 and code != 101:
+            self._state = "head"  # an interim response; the final one follows
+        elif code == 101:
+            self._state = "stream"  # upgraded: ends with the connection
+        elif code in (204, 304):
+            self._done()
+        elif chunked:
+            self._state = "chunk-size"
+        elif b"content-length" in headers:
+            try:
+                self._left = int(headers[b"content-length"])
+            except ValueError:
+                self._state = "stream"
+                return
+            self._state = "length"
+            if not self._left:
+                self._done()
+        else:
+            self._state = "stream"  # read until the successor closes
+
+    def _done(self) -> None:
+        self._state = "head"
+        self.awaiting = False
+        self.answered += 1
+
+
+async def _pipe_watched(reader, writer, feed) -> None:
+    try:
+        while data := await reader.read(65536):
+            feed(data)
+            writer.write(data)
+            await writer.drain()
+        if writer.can_write_eof():
+            writer.write_eof()
+    except (OSError, RuntimeError):
+        pass
+
+
+# A relayed API connection accepted shortly before the port closed may still have its first request on the way.
+FIRST_REQUEST_S = 1.0
+
+
+async def relay_api_listener(sock: socket.socket, target: tuple[str, int], stop: asyncio.Event, *,
+                             connect_timeout: float, drain_seconds: float) -> tuple[int, int]:
+    """``gateway.restart_turn_handoff_per_turn``: accept on the API port's listening *sock* until *stop* is set and
+    relay each connection to the next gateway's API server at *target*. Then the port closes and each open
+    connection ends at its next point between two exchanges (at once when it is idle), so a request in flight gets
+    its whole answer; one still open after *drain_seconds* is cut. Returns ``(relayed, unrelayed)``."""
+    loop = asyncio.get_running_loop()
+    conns: dict[asyncio.Task, tuple[_HttpExchanges, float]] = {}
+    counts = [0, 0]
+
+    async def handle(reader, writer):
+        task = asyncio.current_task()
+        exchanges = _HttpExchanges()
+        conns[task] = (exchanges, loop.time())
+        try:
+            deadline = loop.time() + connect_timeout
+            while True:
+                try:
+                    upstream_reader, upstream_writer = await asyncio.wait_for(
+                        asyncio.open_connection(*target), CONNECT_ATTEMPT_TIMEOUT_S)
+                    break
+                except (OSError, TimeoutError):
+                    if loop.time() + CONNECT_RETRY_S >= deadline:
+                        counts[1] += 1
+                        return
+                    await asyncio.sleep(CONNECT_RETRY_S)
+            counts[0] += 1
+            try:
+                await asyncio.gather(_pipe_watched(reader, upstream_writer, exchanges.from_client),
+                                     _pipe_watched(upstream_reader, writer, exchanges.from_server))
+            finally:
+                upstream_writer.close()
+        except Exception:
+            logger.debug("API relay connection failed", exc_info=True)
+        finally:
+            conns.pop(task, None)
+            writer.close()
+
+    server = await asyncio.start_server(handle, sock=sock)
+    try:
+        await stop.wait()
+    finally:
+        server.close()
+        deadline = loop.time() + drain_seconds
+        while conns and loop.time() < deadline:
+            for task, (exchanges, opened) in list(conns.items()):
+                # Between two exchanges its client opens the next connection elsewhere. A connection that has
+                # not sent its first request yet may have it on the way: it gets FIRST_REQUEST_S to show it.
+                if exchanges.idle and (exchanges.answered or loop.time() - opened >= FIRST_REQUEST_S):
+                    task.cancel()
+            await asyncio.sleep(0.02)
+        pending = list(conns)
+        for task in pending:
+            task.cancel()
+        if pending:
+            await asyncio.gather(*pending, return_exceptions=True)
+    return counts[0], counts[1]
