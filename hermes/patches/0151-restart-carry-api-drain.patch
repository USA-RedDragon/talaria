index 2702ac73..a42a0c31 100644
--- a/gateway/listener_relay.py
+++ b/gateway/listener_relay.py
@@ -358,3 +358,198 @@ async def relay_listener(sock: socket.socket, target: tuple[str, int], seconds:
             if pending:
                 await asyncio.gather(*pending, return_exceptions=True)
