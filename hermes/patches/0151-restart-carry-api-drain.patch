+def _mark_unready(carry, at: float | None = None) -> None:
+    """From *at* (monotonic, default now) on, this pod's readiness probe fails: the earliest time given wins."""
+    at = time.monotonic() if at is None else at
+    if carry.unready_at is None or at < carry.unready_at:
+        carry.unready_at = at
+
+
+async def finish_api_relay(runner) -> None:
+    """The last step of a carrier's process (``gateway.restart_turn_handoff_per_turn``): close the API port that
+    relays to the next gateway and let the requests in flight on it finish (``listener_relay.relay_api_listener``).
+
+    Not before :data:`API_ENDPOINTS_MARGIN_S` past the moment the listener stopped accepting (the end of its relay
+    window): the pod's readiness probe on the listener fails from then, and a load balancer (the Service) stops
+    sending it new connections only a probe period or two and an endpoint update later. Clients in this process's
+    container (a tool's ``curl``, a ``kubectl exec``) reach the port up to here and end with it; where the gateway
+    is the pod's sidecar, the other containers stopped before it exits, so no client in the pod outlives the port."""
+    carry = getattr(runner, "_turn_carry", None)
+    relay = getattr(carry, "api_relay", None)
+    if not isinstance(relay, asyncio.Future):
+        return
+    carry.api_relay = None
+    if not relay.done():
+        since = carry.unready_at if carry.unready_at is not None else time.monotonic()
+        wait = since + API_ENDPOINTS_MARGIN_S - time.monotonic()
+        if wait > 0:
+            logger.info("API port relays %.0fs more before it closes (the Service may still route here)", wait)
+            await asyncio.sleep(wait)
+        carry.api_stop.set()
+    try:
+        relayed, unrelayed = await asyncio.wait_for(asyncio.shield(relay), API_DRAIN_S + 5.0)
+        logger.info("API port closed: it relayed %d connection(s) to the next gateway (%d not reached)",
+                    relayed, unrelayed)
+    except Exception:
+        relay.cancel()
+        await asyncio.gather(relay, return_exceptions=True)
+        logger.debug("API relay ended with an error", exc_info=True)
 
 
 def _end_kept_sockets(runner, now: bool = False) -> None:
