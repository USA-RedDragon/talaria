+++ b/tools/delegate_tool_handoff.py
@@ -230,6 +230,11 @@ def _bind_session(snapshot: dict[str, str]) -> None:
     for var in _SESSION_VARS:
         if isinstance(snapshot.get(var.name), str):
             var.set(snapshot[var.name])
+    from tools.approval_yolo import restore_route_yolo
+    try:
+        restore_route_yolo(snapshot.get("HERMES_SESSION_KEY") or "")
+    except Exception:
+        logger.warning("Could not restore the chat's approval bypass for a resumed subagent", exc_info=True)
 
 
 # ── Restart: stop each child at a clean point ───────────────────────────────
