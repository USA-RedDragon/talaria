diff --git a/tests/agent/test_pooled_anthropic_client.py b/tests/agent/test_pooled_anthropic_client.py
new file mode 100644
index 00000000..751fc318
--- /dev/null
+++ b/tests/agent/test_pooled_anthropic_client.py
@@ -0,0 +1,124 @@
+"""A pooled-credential provider's Anthropic client sends through the transport its profile supplies.
+
+The provider's key is ``POOLED_KEY_PREFIX`` plus its name (and ``#<session>`` for a chat's client); the SDK
+client is built over the profile's httpx transport, so the transport picks the real key for each request and
+the placeholder never leaves the process. Real SDK client and real httpx; the upstream is a mock transport.
+"""
+from __future__ import annotations
+
+import json
+
+import httpx
+import pytest
+
+from agent.anthropic_adapter import POOLED_KEY_PREFIX, build_anthropic_client
+from providers import register_provider
+from providers.base import ProviderProfile
+
+
+class Recorder(httpx.BaseTransport):
+    def __init__(self, session_id, timeout):
+        self.session_id, self.timeout, self.seen = session_id, timeout, []
+
+    def handle_request(self, request):
+        self.seen.append(request)
+        body = {"id": "msg_1", "type": "message", "role": "assistant", "model": "claude-sonnet-5-5",
+                "content": [{"type": "text", "text": "hi"}], "stop_reason": "end_turn", "stop_sequence": None,
+                "usage": {"input_tokens": 3, "output_tokens": 1}}
+        return httpx.Response(200, json=body, request=request)
+
+
+class Pooled(ProviderProfile):
+    made = []
+
+    def anthropic_transport(self, *, session_id=None, timeout=None):
+        transport = Recorder(session_id, timeout)
+        self.made.append(transport)
+        return transport
+
+
+@pytest.fixture()
+def pooled():
+    Pooled.made = []
+    register_provider(Pooled(name="fake-pooled", api_mode="anthropic_messages", base_url="https://api.anthropic.com"))
+    register_provider(ProviderProfile(name="fake-plain", api_mode="anthropic_messages"))
+    return Pooled
+
+
+def _call(client):
+    return client.messages.create(model="claude-sonnet-5-5", max_tokens=8, messages=[{"role": "user", "content": "x"}])
+
+
+def test_the_client_sends_through_the_profiles_transport_and_the_sdk_holds_only_the_placeholder(pooled):
+    client = build_anthropic_client(POOLED_KEY_PREFIX + "fake-pooled", "https://api.anthropic.com", timeout=120)
+    reply = _call(client)
+    (transport,) = pooled.made
+    assert reply.content[0].text == "hi" and len(transport.seen) == 1
+    request = transport.seen[0]
+    assert str(request.url) == "https://api.anthropic.com/v1/messages" and json.loads(request.content)["model"]
+    assert request.headers["x-api-key"] == POOLED_KEY_PREFIX + "fake-pooled"
+    assert "authorization" not in request.headers
+    assert transport.session_id is None and transport.timeout == 120
+
+
+def test_a_chats_client_names_its_session_to_the_transport(pooled):
+    build_anthropic_client(POOLED_KEY_PREFIX + "fake-pooled#20261121_abc", "https://api.anthropic.com")
+    assert pooled.made[0].session_id == "20261121_abc"
+
+
+def test_the_sdk_does_not_retry_on_its_own(pooled):
+    client = build_anthropic_client(POOLED_KEY_PREFIX + "fake-pooled", "https://api.anthropic.com")
+    assert client.max_retries == 0
+
+
+@pytest.mark.parametrize("name", ["fake-plain", "no-such-provider"])
+def test_a_provider_without_a_transport_is_refused(pooled, name):
+    with pytest.raises(ValueError, match="no pooled credential transport"):
+        build_anthropic_client(POOLED_KEY_PREFIX + name, "https://api.anthropic.com")
+
+
+def test_an_ordinary_key_builds_the_ordinary_client(pooled):
+    client = build_anthropic_client("sk-ant-api03-plain", "https://api.anthropic.com")
+    assert client.api_key == "sk-ant-api03-plain" and pooled.made == []
+
+
+def test_the_chat_session_rides_on_the_key_the_agent_builds_its_request_client_from(pooled):
+    from unittest.mock import patch
+
+    from agent.client_lifecycle import ClientLifecycleMixin
+
+    class Stub:
+        session_id = "sess-1"
+
+    key = ("direct", POOLED_KEY_PREFIX + "fake-pooled", "https://api.anthropic.com", None, False)
+    with patch("agent.anthropic_adapter.build_anthropic_client") as build:
+        ClientLifecycleMixin._build_anthropic_client_for_key(Stub(), key)
+        assert build.call_args.args[0] == POOLED_KEY_PREFIX + "fake-pooled#sess-1"
+        Stub.session_id = ""
+        ClientLifecycleMixin._build_anthropic_client_for_key(Stub(), key)
+        assert build.call_args.args[0] == POOLED_KEY_PREFIX + "fake-pooled"
+        ClientLifecycleMixin._build_anthropic_client_for_key(Stub(), ("direct", "sk-ant-api03-x", None, None, False))
+        assert build.call_args.args[0] == "sk-ant-api03-x"
+
+
+def test_every_client_the_agent_builds_for_a_pooled_key_names_its_chat(pooled):
+    """Init, a fallback swap, the primary restore and a model switch all build from the provider's one key."""
+    from unittest.mock import MagicMock, patch
+
+    from agent.agent_runtime_helpers import _build_anthropic_client_from_runtime
+    from agent.client_lifecycle import _swap_fallback_clients
+
+    key = POOLED_KEY_PREFIX + "fake-pooled"
+    agent = MagicMock(session_id="sess-9", provider="custom", model="claude-sonnet-5-5")
+    with patch("agent.anthropic_adapter.build_anthropic_client") as build, \
+            patch("agent.client_lifecycle.get_provider_request_timeout", return_value=None), \
+            patch("agent.agent_runtime_helpers.get_provider_request_timeout", return_value=None):
+        fb_client = MagicMock(api_key=key)
+        fb_client.__dict__.pop("_api_key_provider", None)
+        _swap_fallback_clients(agent, fb_client, "fake-pooled", "claude-sonnet-5-5", "https://api.anthropic.com",
+                               "anthropic_messages")
+        assert build.call_args.args[0] == key + "#sess-9"
+        assert agent._anthropic_api_key == key  # the agent keeps the plain key; only the client's copy names the chat
+        _build_anthropic_client_from_runtime(agent, {"anthropic_api_key": key, "anthropic_base_url": "https://api.anthropic.com",
+                                                     "is_anthropic_oauth": False})
