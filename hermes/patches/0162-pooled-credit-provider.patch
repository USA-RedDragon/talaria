diff --git a/tests/agent/test_profile_fallback.py b/tests/agent/test_profile_fallback.py
new file mode 100644
index 00000000..2cd27b42
--- /dev/null
+++ b/tests/agent/test_profile_fallback.py
@@ -0,0 +1,208 @@
+"""A provider's own fallback route, and the way back to it.
+
+A provider profile can name where its calls go when it has nothing left to try (``fallback_route``) and say
+when it can serve again (``primary_ready``). The Claude account pool uses both: with every subscription
+account at its limit the call goes to the pooled API credits, same model, and the agent is back on the pool
+before the next model call as soon as an account frees up. Real ``AIAgent`` conversations; the route swap
+(client construction) is the only stubbed part.
+"""
+from __future__ import annotations
+
+import time
+from types import SimpleNamespace
+from unittest.mock import MagicMock, patch
+
+import pytest
+
+from providers import register_provider
+from providers.base import ProviderProfile
+
+LINE = "All Claude accounts are at their limit. The first frees up at 10:09 PM CST."
+BOTH = "No API credit is left and all Claude accounts are at their limit. The first frees up at 10:09 PM CST."
+
+
+class Exhausted(RuntimeError):
+    status_code = 429
+
+    def __init__(self, line=LINE):
+        super().__init__("raw upstream text")
+        self.hermes_user_message = line
+        self.hermes_resets_at = time.time() + 3600
+
+
+class Pool(ProviderProfile):
+    """Stands for claude-pool: a route only while it is exhausted, ready again once it is not."""
+
+    exhausted = True
+    route_model = "claude-sonnet-5-5"
+
+    def fallback_route(self, *, model):
+        return {"provider": "fake-credits", "model": self.route_model} if self.exhausted else None
+
+    def primary_ready(self, *, model):
+        return not self.exhausted
+
+
+@pytest.fixture()
+def pool():
+    profile = Pool(name="fake-pool")
+    register_provider(profile)
+    register_provider(ProviderProfile(name="fake-credits"))
+    profile.exhausted = True
+    return profile
+
+
+def _reply(text="from the other side"):
+    msg = SimpleNamespace(content=text, tool_calls=None)
+    return SimpleNamespace(choices=[SimpleNamespace(message=msg, finish_reason="stop")], model="m", usage=None)
+
+
+@pytest.fixture()
+def agent(pool):
+    from run_agent import AIAgent
+
+    with (
+        patch("model_tools.get_tool_definitions", return_value=[]),
+        patch("model_tools.check_toolset_requirements", return_value={}),
+        patch("agent.process_bootstrap.OpenAI"),
+    ):
+        agent = AIAgent(api_key="test-key-1234567890", base_url="https://openrouter.ai/api/v1", quiet_mode=True,
+                        skip_context_files=True, skip_memory=True)
+    agent.provider = agent.requested_provider = "fake-pool"
+    agent.model = "claude-sonnet-5-5[1m]"
+    agent._primary_runtime = {**(agent._primary_runtime or {}), "provider": "fake-pool", "requested_provider": "fake-pool",
+                              "model": agent.model}
+    agent.client = MagicMock()
+    agent._cached_system_prompt = "You are helpful."
+    agent._use_prompt_caching = False
+    agent.tool_delay = 0
+    agent.compression_enabled = False
+    agent.save_trajectories = False
+    agent._fallback_chain = []
+    agent.statuses = []
+    agent._emit_diagnostic_status = lambda message, *a, **k: agent.statuses.append(str(message))
+    agent.binds = []
+    agent.on_credits = MagicMock()
+    agent.on_credits.chat.completions.create.return_value = _reply()
+    return agent
+
+
+def _bind(agent):
+    """The route swap with its client construction stubbed: the agent now speaks to ``on_credits``."""
+    def bind(ag, entry, provider, model):
+        agent.binds.append((provider, model))
+        old = (ag.model, ag.provider)
+        ag.model, ag.provider, ag.requested_provider = model, provider, provider
+        ag.client = agent.on_credits
+        ag._fallback_activated = True
+        return old
+    return patch("agent.route_binding.bind_route_entry", side_effect=bind)
+
+
+def _run(agent, text="hello"):
+    with patch("agent.turn_recovery.interruptible_backoff_sleep", return_value=False), patch("time.sleep", return_value=None):
+        return agent.run_conversation(text)
+
+
+def test_an_exhausted_pool_falls_back_to_its_route_with_the_same_model_instead_of_ending_the_turn(agent):
+    agent.client.chat.completions.create.side_effect = Exhausted()
+    with _bind(agent):
+        result = _run(agent)
+    assert agent.binds == [("fake-credits", "claude-sonnet-5-5")]
+    assert result["final_response"] == "from the other side" and not result.get("failed")
+    assert agent.client.chat.completions.create.call_count == 1  # no retries on the exhausted pool first
+    assert agent.provider == "fake-credits" and agent._provider_fallback_active
+
+
+@pytest.mark.parametrize("kind", ["chat", "cron job", "subagent"])
+def test_a_scheduled_job_and_a_subagent_fall_back_the_same_way(agent, kind):
+    """The loop is the same for every agent that runs on the provider; only who owns the agent differs."""
+    if kind == "cron job":
+        agent.platform = "cron"
+        agent._session_db = None
+    if kind == "subagent":
+        agent._delegate_depth = 1
+        agent.platform = "delegate"
+        agent._fallback_chain = []  # a child starts with no chain of its own
+    agent.client.chat.completions.create.side_effect = Exhausted()
+    with _bind(agent):
+        result = _run(agent)
+    assert agent.binds == [("fake-credits", "claude-sonnet-5-5")]
+    assert result["final_response"] == "from the other side" and not result.get("failed")
+
+
+def test_without_a_route_the_line_still_ends_the_turn(agent, pool):
+    pool.exhausted = False  # nothing named: the 0099 behavior
+    agent.client.chat.completions.create.side_effect = Exhausted()
+    with _bind(agent):
+        result = _run(agent)
+    assert agent.binds == [] and result["failed"] is True and result["final_response"] == LINE
+
+
+def test_the_route_failing_with_its_own_line_ends_the_turn_with_that_line(agent):
+    agent.client.chat.completions.create.side_effect = Exhausted()
+    agent.on_credits.chat.completions.create.side_effect = Exhausted(BOTH)
+    with _bind(agent):
+        result = _run(agent)
+    assert agent.binds == [("fake-credits", "claude-sonnet-5-5")]  # tried once, not looped
+    assert result["failed"] is True and result["final_response"] == BOTH
+
+
+def test_a_provider_that_names_no_route_is_not_touched(agent):
+    agent.provider = "openrouter"
+    agent._fallback_chain = [{"provider": "other", "model": "m"}]
+    from agent.profile_fallback import sync_profile_fallback
+
+    assert sync_profile_fallback(agent) is False
+    assert agent._fallback_chain == [{"provider": "other", "model": "m"}]
+
+
+def test_the_route_goes_first_in_the_chain_once_and_leaves_with_the_exhaustion(agent, pool):
+    from agent.profile_fallback import ROUTE_FLAG, sync_profile_fallback
+
+    agent._fallback_chain = [{"provider": "other", "model": "m"}]
+    assert sync_profile_fallback(agent) and sync_profile_fallback(agent)
+    assert agent._fallback_chain == [{"provider": "fake-credits", "model": "claude-sonnet-5-5", ROUTE_FLAG: True},
+                                     {"provider": "other", "model": "m"}]
+    pool.exhausted = False
+    assert sync_profile_fallback(agent) is False
+    assert agent._fallback_chain == [{"provider": "other", "model": "m"}]
+
+
+def test_the_agent_goes_back_to_the_pool_before_the_next_call_once_it_can_serve(agent, pool):
+    agent.client.chat.completions.create.side_effect = Exhausted()
+    with _bind(agent):
+        _run(agent)
+    assert agent.provider == "fake-credits"
+    primary = agent._primary_runtime
+    assert primary["provider"] == "fake-pool"
+    from agent.profile_fallback import restore_when_ready
+
+    with patch.object(type(agent), "_restore_primary_runtime", autospec=True) as restore:
+        assert restore_when_ready(agent) is False and restore.call_count == 0  # still exhausted
+        pool.exhausted = False
+        agent._rate_limited_until = 10 ** 12  # the cooldown the fallback armed does not hold it back
+        restore.return_value = True
+        assert restore_when_ready(agent) is True and restore.call_count == 1
+        assert agent._rate_limited_until == 0
+
+
+def test_a_cooldown_does_not_hold_back_a_ready_pool_at_the_next_turn(agent, pool):
+    from agent.agent_runtime_helpers import restore_primary_runtime
+
+    agent.client.chat.completions.create.side_effect = Exhausted()
+    with _bind(agent):
+        _run(agent)
+    assert agent._rate_limited_until > 0  # armed until the pool's own reset time
+    assert restore_primary_runtime(agent) is False  # still exhausted: the cooldown holds
+    pool.exhausted = False
+    with patch("agent.route_binding.reinstall_primary_runtime") as reinstall:
+        assert restore_primary_runtime(agent) is True
+    assert reinstall.call_count == 1 and agent._provider_fallback_active is False
+
+
+def test_a_ready_pool_with_no_fallback_in_force_changes_nothing(agent, pool):
+    pool.exhausted = False
+    from agent.profile_fallback import primary_ready, restore_when_ready
+
+    assert primary_ready(agent) is False and restore_when_ready(agent) is False
