+def pooled_key_for_session(api_key: Any, session_id: Any) -> Any:
+    """``api_key`` with the chat's session id on it when it is a pooled provider's key, so that provider's
+    transport can keep its books per chat. Any other key, and a pooled key that already names a session, stay."""
+    if isinstance(api_key, str) and api_key.startswith(POOLED_KEY_PREFIX) and "#" not in api_key \
+            and isinstance(session_id, str) and session_id:
+        return f"{api_key}#{session_id}"
