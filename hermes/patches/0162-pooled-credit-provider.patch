+def _build_pooled_anthropic_client(api_key: str, base_url: str | None, timeout: float | None, *,
+                                   drop_context_1m_beta: bool = False):
+    """Client of a pooled-credential provider. ``api_key`` is ``POOLED_KEY_PREFIX`` + the provider's name, and
+    ``#<session id>`` after it when the client belongs to a chat. The provider's profile supplies the httpx
+    transport (``ProviderProfile.anthropic_transport``) that picks the real key for each request, so the key
+    never sits in the SDK client and every path that builds a client from the provider's key (the agent, a
+    fallback, auxiliary calls) is pooled the same way. The SDK's own key is the placeholder."""
