@@ -0,0 +1,51 @@
+"""A chat on the pooled API credit provider (``claude-credits``) is a chat on an Anthropic API-key provider: its
+``family: claude`` subagents run on ``claude-credits`` with their route's model, resumed ones follow it, and a chat
+on the account pool keeps its routes on the pool (which falls back to the credits by itself, not by routing)."""
+
+from unittest.mock import patch
+
+from tests.tools import test_delegation_claude_family as family
+from tests.tools.test_delegation_claude_family import API, POOL_URL, _parent, _spawn
+
+CREDITS = "claude-credits"
+_FAMILY_RUNTIME = family._runtime
+
+
+def _runtime(requested=None, target_model=None, **kw):
+    if requested == CREDITS:
+        return {"provider": requested, "base_url": API, "api_key": "hermes-pooled-key/claude-credits-keys",
+                "api_mode": "anthropic_messages"}
+    return _FAMILY_RUNTIME(requested=requested, target_model=target_model, **kw)
+
+
+def _spawn_credits(parent, options):
+    # _spawn patches the runtime provider with the family file's own answer; this one also knows claude-credits
+    with patch.object(family, "_runtime", _runtime):
+        return _spawn(parent, options)
+
+
+def test_a_chat_on_the_pooled_credits_runs_its_claude_routes_on_them_with_the_routes_model():
+    built, _ = _spawn_credits(_parent(CREDITS), ["sonnet", "opus", "plain"])
+    assert built == [(CREDITS, "claude-sonnet-5-5"), (CREDITS, "claude-opus-5-5"), ("claude-pool", "claude-haiku-5-5")]
+
+
+def test_a_chat_on_the_pool_keeps_its_routes_on_the_pool():
+    built, _ = _spawn_credits(_parent("claude-pool", base_url=POOL_URL), ["sonnet", "opus"])
+    assert built == [("claude-pool", "claude-sonnet-5-5"), ("claude-pool", "claude-opus-5-5")]
+
+
+def test_a_helper_on_another_route_hands_its_own_helpers_the_credits_choice():
+    from tools.delegate_tool_claude import parent_claude_account
+
+    assert parent_claude_account(_parent(CREDITS)) == CREDITS
+    under_kimi = _parent("deepinfra", "chat_completions", "https://api.deepinfra.com/v1/openai", account=CREDITS)
+    assert parent_claude_account(under_kimi) == CREDITS
+
+
+def test_a_subagent_resumed_after_the_chat_moved_to_the_credits_follows_it():
+    from tools.delegate_tool_claude import follow_chat_on_resume, stamp_chat_account
+
+    pool_route = {"provider": "claude-pool", "model": "claude-sonnet-5-5", "base_url": POOL_URL, "api_key": "k", "api_mode": "x"}
+    assert follow_chat_on_resume(pool_route, CREDITS) == {"provider": CREDITS, "model": "claude-sonnet-5-5"}
+    out = stamp_chat_account({"children": {"0": {"route": {"route": pool_route}}}}, _parent(CREDITS))
+    assert out["children"]["0"]["route"]["route"]["provider"] == CREDITS and out["parent"]["claude_account"] == CREDITS
