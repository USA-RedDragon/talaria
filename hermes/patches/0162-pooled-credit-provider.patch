+    kwargs["api_key"] = POOLED_KEY_PREFIX + name
+    kwargs["http_client"] = httpx.Client(transport=transport, timeout=kwargs["timeout"])
+    headers = _beta_header(_common_betas_for_base_url(normalized_base_url, drop_context_1m_beta=drop_context_1m_beta))
