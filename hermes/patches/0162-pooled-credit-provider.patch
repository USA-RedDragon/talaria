diff --git a/agent/profile_fallback.py b/agent/profile_fallback.py
new file mode 100644
index 00000000..4bf3f8b1
--- /dev/null
+++ b/agent/profile_fallback.py
@@ -0,0 +1,82 @@
+"""A provider's own fallback route, and the way back to the provider.
+
+A provider profile can name where its calls go when it has nothing left to try (``fallback_route``: the
+Claude account pool names the pooled API credits, same model) and say when it can serve again
+(``primary_ready``). The route is put first in the agent's fallback chain while the agent runs on the
+provider, so the usual fallback walk, notice and primary cooldown apply; and the agent goes back to the
+provider before the next model call as soon as the provider says it is ready, not only at the next turn.
+A provider that does not override the two hooks changes nothing.
+"""
+
+from __future__ import annotations
+
+import logging
+from typing import Any, Optional
+
+logger = logging.getLogger(__name__)
+
+ROUTE_FLAG = "_profile_route"
+
+
+def _profile(provider: Any) -> Any:
+    name = str(provider or "").strip()
+    if not name:
+        return None
+    try:
+        from providers import get_provider_profile
+        return get_provider_profile(name)
+    except Exception:
+        return None
+
+
+def _route_of(agent: Any) -> Optional[dict[str, Any]]:
+    profile = _profile(getattr(agent, "provider", ""))
+    ask = getattr(profile, "fallback_route", None)
+    if not callable(ask):
+        return None
+    try:
+        route = ask(model=str(getattr(agent, "model", "") or ""))
+    except Exception:
+        logger.debug("fallback_route failed for %s", getattr(agent, "provider", ""), exc_info=True)
+        return None
+    if not isinstance(route, dict) or not str(route.get("provider") or "").strip() or not str(route.get("model") or "").strip():
+        return None
+    return {"provider": str(route["provider"]).strip(), "model": str(route["model"]).strip()}
+
+
+def sync_profile_fallback(agent: Any) -> bool:
+    """Put the running provider's own fallback route first in ``agent._fallback_chain`` (and drop the one it
+    put there before). True when the provider names a route now. Only while the agent is on its primary route."""
+    chain = [e for e in (getattr(agent, "_fallback_chain", None) or []) if not (isinstance(e, dict) and e.get(ROUTE_FLAG))]
+    route = None if getattr(agent, "_fallback_activated", False) else _route_of(agent)
+    if route is not None:
+        chain.insert(0, {**route, ROUTE_FLAG: True})
+        agent._fallback_index = 0
+    if chain != list(getattr(agent, "_fallback_chain", None) or []):
+        agent._fallback_chain = chain
+    return route is not None
+
+
+def primary_ready(agent: Any) -> bool:
+    """Whether the primary provider of an agent that fell back says it can serve its model again."""
+    if not getattr(agent, "_fallback_activated", False):
+        return False
+    rt = getattr(agent, "_primary_runtime", None) or {}
+    profile = _profile(rt.get("provider"))
+    ask = getattr(profile, "primary_ready", None)
+    if not callable(ask):
+        return False
+    try:
+        return bool(ask(model=str(rt.get("model") or "")))
+    except Exception:
+        logger.debug("primary_ready failed for %s", rt.get("provider"), exc_info=True)
+        return False
+
+
+def restore_when_ready(agent: Any) -> bool:
+    """Before a model call: go back to the primary provider if it says it is ready, whatever the cooldown a
+    fallback armed. True when the agent moved back."""
+    if not primary_ready(agent):
+        return False
+    agent._rate_limited_until = 0
+    return bool(agent._restore_primary_runtime())
