+    for c, g in ((child, goal), (bare, "no context")):
+        _register_child(c, None, g, owner_session_id="ui-owner", owner_transport=transport, owner_session_record=owner)
+    try:
+        rows = {r["subagent_id"]: r for r in call("subagent.list")["result"]["subagents"]}
+        assert rows["child"]["goal"] == goal and rows["child"]["context"] == context
+        assert rows["bare"]["goal"] == "no context" and rows["bare"]["context"] is None
+    finally:
+        _unregister_subagent("child")
