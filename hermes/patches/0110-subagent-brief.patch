+def test_resumed_child_is_built_with_the_whole_goal_and_context_it_was_given(resume_seams):
+    goal = "first line\n" + "a long line of the goal " * 2000
+    context = "context\n\n  indented " + "z" * 40000
+    db = _session_db()
+    _stored_child(db, cut=True)
+    raw = _resume_unit()
+    raw["handoff"]["children"]["1"].update(goal=goal, context=context)
+    unit = handoff._ResumedUnit(raw)
+    parent = handoff._ResumeParent(unit.spec["parent"], db)
+    unit._build(1, unit.spec["children"]["1"], parent, db)
+    assert resume_seams["goal"] == goal and resume_seams["context"] == context
+
+
 def test_child_without_a_stored_session_is_not_resumed(resume_seams):
     db = _session_db()
