diff --git a/tools/delegate_tool_sessions.py b/tools/delegate_tool_sessions.py
index fb362a421d..f997d96357 100644
--- a/tools/delegate_tool_sessions.py
+++ b/tools/delegate_tool_sessions.py
@@ -13,6 +13,25 @@ import json
 from typing import Any, Iterable, Optional
 
 SUBAGENT_ID_KEY = "_subagent_id"
+# The goal and context the child was given, stamped beside the id so a viewer reads the whole brief after the
+# live record is gone (a finished child, a gateway restart).
+BRIEF_GOAL_KEY = "_delegate_goal"
+BRIEF_CONTEXT_KEY = "_delegate_context"
+
+
+def stored_child_brief(db: Any, session_id: str) -> tuple[Optional[str], Optional[str]]:
+    """``(goal, context)`` stamped on the child's stored session; None for one that was not stamped."""
+    row = db.get_session(session_id) if session_id else None
+    cfg = row.get("model_config") if row else None
+    if isinstance(cfg, str):
+        try:
+            cfg = json.loads(cfg)
+        except ValueError:
+            return None, None
+    if not isinstance(cfg, dict):
+        return None, None
+    goal, context = cfg.get(BRIEF_GOAL_KEY), cfg.get(BRIEF_CONTEXT_KEY)
+    return (goal if isinstance(goal, str) and goal else None), (context if isinstance(context, str) and context else None)
 
 
 def stored_child_session(db: Any, subagent_id: str, conversation_ids: Iterable[str]) -> Optional[str]:
