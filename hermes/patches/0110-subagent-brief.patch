+"""A delegated child keeps the whole brief it was given (goal and context): on its registry record, and on its
+stored session for a viewer that reads it after the live record is gone (a finished child, a gateway restart)."""
+from types import SimpleNamespace
+
+GOAL = "Fix the parser\n" + "check this case too\n" * 1500
+CONTEXT = "Background:\n\n  indented line\n" + "more background " * 3000
+
+
+def _spawn(tmp_path, monkeypatch, goal, context, **extra):
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+    from hermes_state import SessionDB
+    from run_agent import AIAgent
+    from tools import delegate_tool as dt
+    import tools.delegate_tool_config as dtc
+    cfg = {"max_spawn_depth": 3}
+    monkeypatch.setattr(dt, "_load_config", lambda: cfg)
+    monkeypatch.setattr(dtc, "_load_config", lambda: cfg)
+    db = SessionDB(db_path=tmp_path / "state.db")
+    kw = dict(api_key="k", base_url="https://openrouter.ai/api/v1", provider="openrouter",
+              api_mode="chat_completions", model="anthropic/claude-sonnet-4.6", platform="cli", quiet_mode=True,
+              skip_context_files=True, skip_memory=True, save_trajectories=False, enabled_toolsets=["file"])
+    parent = AIAgent(session_id="parent", session_db=db, **kw)
+    parent._ensure_db_session()
+    child = dt._build_child_agent(task_index=0, goal=goal, context=context, toolsets=["file"], model=None,
+                                  max_iterations=4, task_count=1, parent_agent=parent, **extra)
+    return db, parent, child
+
+
+def test_the_registry_record_and_the_stored_session_carry_the_whole_brief(tmp_path, monkeypatch):
+    from tools.delegate_tool_child_run import _register_child
+    from tools.delegate_tool_registry import _unregister_subagent, list_active_subagents
+    from tools.delegate_tool_sessions import stored_child_brief
+    db, parent, child = _spawn(tmp_path, monkeypatch, GOAL, CONTEXT)
+    try:
+        child._ensure_db_session()
+        _register_child(child, parent, GOAL, owner_session_id=None, owner_transport=None, owner_session_record=None)
+        record = next(r for r in list_active_subagents() if r["subagent_id"] == child._subagent_id)
+        assert record["goal"] == GOAL and record["context"] == CONTEXT
+        assert stored_child_brief(db, child.session_id) == (GOAL, CONTEXT)
+    finally:
+        _unregister_subagent(child._subagent_id, agent=child)
+        child.close()
+        parent.close()
+        db.close()
+
+
+def test_a_child_given_no_context_has_none_and_still_stores_its_goal(tmp_path, monkeypatch):
+    from tools.delegate_tool_sessions import stored_child_brief
+    db, parent, child = _spawn(tmp_path, monkeypatch, "just a goal", None)
+    try:
+        child._ensure_db_session()
+        assert stored_child_brief(db, child.session_id) == ("just a goal", None)
+    finally:
+        child.close()
+        parent.close()
+        db.close()
+
+
+def test_a_session_without_a_stamp_has_no_brief(tmp_path):
+    from hermes_state import SessionDB
+    from tools.delegate_tool_sessions import stored_child_brief
+    db = SessionDB(db_path=tmp_path / "state.db")
+    try:
+        db.create_session("old-child", source="subagent", parent_session_id=None,
+                          model_config={"_delegate_from": "p", "_subagent_id": "sa-0-old"})
+        db.create_session("plain", source="cli")
+        assert stored_child_brief(db, "old-child") == (None, None)
+        assert stored_child_brief(db, "plain") == (None, None)
+        assert stored_child_brief(db, "missing") == (None, None)
+    finally:
+        db.close()
