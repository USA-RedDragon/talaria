From 2e5b2fc996d31f0700714c097a2bce204bf43e5c Mon Sep 17 00:00:00 2001
From: USA-RedDragon <USA-RedDragon@users.noreply.github.com>
Date: Mon, 16 Nov 2026 21:40:00 +0000
Subject: [PATCH] feat(process): a background command's start and end times
 reach the hub

The launch result, poll, wait, log and list carry started_at (Unix
seconds) and, once exited, exited_at; a poll of an exited command reports
how long it ran, not the time since. The launch result also names the
folder. A normal finish notice says how long the command ran.

diff --git a/tests/tools/test_process_run_time.py b/tests/tools/test_process_run_time.py
new file mode 100644
index 00000000..3b774cde
--- /dev/null
+++ b/tests/tools/test_process_run_time.py
@@ -0,0 +1,101 @@
+"""A background command's start and end times reach the hub: the launch result, poll, wait, log, list and the notice."""
+
+import json
+import time
+
+import pytest
+
+from tests.waiting import wait_until
+from tools.process_registry import process_registry
+from tools.process_registry_notifications import format_process_notification, run_time
+from tools.terminal_tool_background import spawn_background_process
+
+pytestmark = [pytest.mark.platforms("linux"), pytest.mark.live_system_guard_bypass]
+
+
+def _finished(command="echo hi"):
+    session = process_registry.spawn_local(command, task_id="rt", owner_task_id="rt", session_key="rt")
+    wait_until(lambda: session.exited, what="the command to exit")
+    return session
+
+
+def test_launch_result_has_start_time_and_folder(tmp_path):
+    before = time.time()
+    result = json.loads(spawn_background_process(
+        command="sleep 5", env=None, env_type="local", effective_task_id="rt", task_id="rt", session_key="rt",
+        workdir=str(tmp_path), cwd=str(tmp_path), effective_pty=False, notify_on_complete=False,
+        watch_patterns=None, approval_note=None, pty_disabled_reason=None,
+    ))
+    try:
+        assert before - 1 <= result["started_at"] <= time.time() + 1
+        assert result["cwd"] == str(tmp_path)
+    finally:
+        process_registry.kill_process(result["session_id"])
+
+
+def test_poll_of_an_exited_command_reports_how_long_it_ran_not_the_time_since():
+    session = _finished()
+    session.exited_at = session.started_at + 134
+    session.started_at -= 500  # long ago: uptime must stop at the exit
+    session.exited_at -= 500
+    polled = process_registry.poll(session.id)
+    assert polled["uptime_seconds"] == 134
+    assert polled["started_at"] == session.started_at and polled["exited_at"] == session.exited_at
+
+
+def test_poll_of_a_running_command_has_its_start():
+    session = process_registry.spawn_local("sleep 30", task_id="rt", owner_task_id="rt", session_key="rt")
+    try:
+        polled = process_registry.poll(session.id)
+        assert polled["status"] == "running" and polled["started_at"] == session.started_at
+        assert "exited_at" not in polled
+        listed = [e for e in process_registry.list_sessions() if e["session_id"] == session.id][0]
+        assert listed["started_at_unix"] == session.started_at
+        assert listed["uptime_seconds"] <= 2
+    finally:
+        process_registry.kill_process(session.id)
+
+
+def test_wait_log_and_list_carry_the_times():
+    session = _finished()
+    waited = process_registry.wait(session.id, timeout=5)
+    assert waited["status"] == "exited"
+    assert waited["started_at"] == session.started_at and waited["exited_at"] == session.exited_at
+    logged = process_registry.read_log(session.id)
+    assert logged["started_at"] == session.started_at
+    listed = [e for e in process_registry.list_sessions(include_retained=True) if e["session_id"] == session.id]
+    assert listed and listed[0]["started_at_unix"] == session.started_at and listed[0]["exited_at"] == session.exited_at
+
+
+def test_wait_timeout_has_the_start():
+    session = process_registry.spawn_local("sleep 30", task_id="rt", owner_task_id="rt", session_key="rt")
+    try:
+        waited = process_registry.wait(session.id, timeout=1)
+        assert waited["status"] == "timeout" and waited["started_at"] == session.started_at
+    finally:
+        process_registry.kill_process(session.id)
+
+
+@pytest.mark.parametrize("seconds, text", [(0, "0s"), (41, "41s"), (134, "2m 14s"), (120, "2m"), (3900, "1h 5m")])
+def test_run_time_text(seconds, text):
+    assert run_time(seconds) == text
+
+
+def _event(**extra):
+    return {"type": "completion", "session_id": "proc_x", "command": "make build", "exit_code": 0,
+            "output": "ok", "started_at": 1000.0, **extra}
+
+
+def test_a_normal_finish_notice_says_how_long_it_ran():
+    text = format_process_notification(_event(exited_at=1134.4))
+    assert text.startswith("[IMPORTANT: Background process proc_x completed normally (exit code 0).\nRan for 2m 14s.\n")
+    assert "Command: make build\nOutput:\nok]" in text
+
+
+def test_a_failed_finish_notice_says_how_long_it_ran():
+    text = format_process_notification(_event(exit_code=2, exited_at=1041))
+    assert "exited (exit code 2).\nRan for 41s.\n" in text
+
+
+def test_a_notice_without_an_end_time_has_no_run_line():
+    assert "Ran for" not in format_process_notification(_event())
