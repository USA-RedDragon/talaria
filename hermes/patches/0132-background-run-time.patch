     """What an agent reads when the user stopped its background job from the hub."""
     text = (f"Stopped by the user from the hub: {str(command)[:200]} ({session_id}) (ran {ran_for(ran_seconds)}). "
@@ -589,6 +600,8 @@ def format_process_notification(evt: dict) -> str | None:
                 f"session_id=\"{_sid}\") has the full output)\n{_out}")
     if is_hub_stop(evt):
         attribution += stopped_text(_cmd, _sid, _hub_stop_ran(evt)).split("\nOutput tail:")[0] + "\n"
+    elif evt.get("started_at") and evt.get("exited_at"):
+        attribution += f"Ran for {run_time(float(evt['exited_at']) - float(evt['started_at']))}.\n"
     return (
         f"[IMPORTANT: Background process {_sid} {_completion_status(evt)} (exit code {_exit}{_signal}).\n"
         f"{attribution}Command: {_cmd}\nOutput:\n{_out}]")
