diff --git a/tools/process_registry_notifications.py b/tools/process_registry_notifications.py
index 3c5b1380..643ce07c 100644
--- a/tools/process_registry_notifications.py
+++ b/tools/process_registry_notifications.py
@@ -496,6 +496,17 @@ def ran_for(seconds: float) -> str:
     return f"{minutes // 60}h {minutes % 60}m" if minutes >= 60 else f"{minutes}m"
 
 
+def run_time(seconds: float) -> str:
+    """'2m 14s', '41s', '3h 5m': how long a job ran, to the second below an hour."""
+    seconds = int(max(seconds or 0, 0))
+    if seconds < 60:
+        return f"{seconds}s"
+    minutes, rest = divmod(seconds, 60)
+    if minutes < 60:
+        return f"{minutes}m {rest}s" if rest else f"{minutes}m"
+    return f"{minutes // 60}h {minutes % 60}m"
+
+
