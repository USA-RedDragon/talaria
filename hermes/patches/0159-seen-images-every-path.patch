--- a/tools/seen_images.py
+++ b/tools/seen_images.py
@@ -218,6 +218,31 @@ def collect(result: Any) -> list[dict]:
         return []
 
 
+def collect_files(paths: Any) -> list[dict]:
+    """Store the images in the local files a text-mode user message names (the auxiliary vision model looked
+    at them for the main model). Unreadable, blocked, oversized or non-image files are skipped; never raises."""
+    out: list[dict] = []
+    try:
+        from agent.file_safety import raise_if_read_blocked
+
+        for raw in paths if isinstance(paths, (list, tuple)) else ():
+            try:
+                path = Path(str(raw)).expanduser()
+                if not path.is_file() or path.stat().st_size > MAX_IMAGE_BYTES:
+                    continue
+                raise_if_read_blocked(str(path))
+                rec = store(path.read_bytes())
+            except Exception:
+                continue
+            if rec and all(rec["id"] != o["id"] for o in out):
+                out.append(rec)
+            if len(out) >= MAX_PER_RESULT:
+                break
+    except Exception as exc:
+        logger.warning("seen_images: could not keep a copy of an attachment: %s", exc)
+    return out
+
+
 def clean(records: Any) -> list[dict]:
     """The well-formed records of *records*, so metadata read back from a tool result is never trusted."""
     out: list[dict] = []
