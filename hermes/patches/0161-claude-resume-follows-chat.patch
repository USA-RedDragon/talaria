 from __future__ import annotations
 
+import json
+from types import SimpleNamespace
 from typing import Any, Mapping, Optional
 
 from utils import base_url_hostname
@@ -65,3 +67,58 @@ def follow_parent_claude(route: dict[str, Any], backend: str, config: Mapping[st
     if not account:
         return route
     return {**{k: v for k, v in route.items() if k not in _POOL_ROUTE_KEYS}, "provider": account}
+
+
+def _runtime_account(runtime: Any) -> Optional[str]:
+    """The API-key provider a chat's last turn recorded in its row (``gateway_runtime``), or None for the pool or
+    any other chat."""
+    if not isinstance(runtime, Mapping):
+        return None
+    provider = _name(runtime.get("provider"))
+    return parent_claude_account(SimpleNamespace(
+        provider=provider, requested_provider=provider, api_mode=runtime.get("api_mode"), base_url=runtime.get("base_url")))
+
+
+def _chat_row_runtime(db: Any, session_id: Any) -> Optional[Mapping[str, Any]]:
+    """The runtime the chat's row records for its latest turn, read at its compression tip; None when unreadable."""
+    if db is None or not isinstance(session_id, str) or not session_id:
+        return None
+    try:
+        tip = db.get_compression_tip(session_id)
+        row = db.get_session(tip if isinstance(tip, str) and tip else session_id) or {}
+        runtime = (json.loads(row.get("model_config") or "{}") or {}).get("gateway_runtime")
+    except Exception:
+        return None
+    return runtime if isinstance(runtime, Mapping) and _name(runtime.get("provider")) else None
+
+
+def resumed_claude_account(parent: Any) -> Optional[str]:
+    """The provider a carried subagent's chat runs its Claude routes on *now*. The record a restart carried holds the
+    answer from the spawn, so the chat's row (what its last turn ran on) is asked instead; the recorded answer stands
+    only when the row says nothing."""
+    runtime = _chat_row_runtime(getattr(parent, "_session_db", None), getattr(parent, "session_id", None))
+    return _runtime_account(runtime) if runtime is not None else parent_claude_account(parent)
+
+
+def follow_chat_on_resume(route: Mapping[str, Any], account: Optional[str]) -> dict[str, Any]:
+    """A route recorded on the account pool, on the chat's API-key provider when the chat moved to one after the
+    subagent was spawned: the user picked the account, so what comes back after the pick does not bill the pool. A
+    route on any other provider keeps it."""
+    if not account or route.get("profile") or _name(route.get("provider")) != CLAUDE_POOL:
+        return dict(route)
+    return {**{k: v for k, v in route.items() if k not in _POOL_ROUTE_KEYS}, "provider": account}
+
+
+def stamp_chat_account(spec: Mapping[str, Any], parent_agent: Any) -> dict[str, Any]:
+    """``spec`` for a resume the live chat asked for: each recorded pool route moved to the account the chat runs on,
+    and the parent record holding that answer (``claude_now``), so the later resume of the record does not ask the
+    chat's row again."""
+    account = parent_claude_account(parent_agent)
+    children = {}
+    for key, child in (spec.get("children") or {}).items():
+        saved = child.get("route") if isinstance(child, Mapping) else None
+        if isinstance(saved, Mapping) and isinstance(saved.get("route"), Mapping) and not saved.get("reask"):
+            child = {**child, "route": {**saved, "route": follow_chat_on_resume(saved["route"], account)}}
+        children[key] = child
+    parent = {**(spec.get("parent") or {}), "claude_account": account or "", "claude_now": True}
+    return {**spec, "parent": parent, "children": children}
