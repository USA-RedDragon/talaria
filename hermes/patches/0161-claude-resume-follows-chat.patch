diff --git a/tests/tools/test_delegation_claude_resume.py b/tests/tools/test_delegation_claude_resume.py
new file mode 100644
index 00000000..1b4c22bf
--- /dev/null
+++ b/tests/tools/test_delegation_claude_resume.py
@@ -0,0 +1,113 @@
+"""A resumed subagent whose stored provider is the Claude account pool follows its chat onto an Anthropic API-key
+provider when the chat has moved to one since the subagent was spawned. The account is the user's pick, so a subagent
+that comes back after the pick must not go on billing the pool. Real route resolution; the runtime provider answers for
+the providers named here."""
+
+import json
+from types import SimpleNamespace
+from unittest.mock import patch
+
+from tests.tools.test_delegation_claude_family import API, CFG, POOL_URL, _Backend, _parent, _runtime
+
+POOL_ROUTE = {"backend": "route-family", "label": "sonnet", "route": {"provider": "claude-pool", "model": "claude-sonnet-5-5"}}
+
+
+class _Db:
+    """The state of one chat row: the runtime its last turn recorded, as the gateway syncs it."""
+
+    def __init__(self, runtime=None, tip=None):
+        self.row = {"model_config": json.dumps({"gateway_runtime": runtime} if runtime else {})}
+        self.tip = tip
+
+    def get_session(self, session_id):
+        return self.row
+
+    def get_compression_tip(self, session_id):
+        return self.tip
+
+
+def _on(provider):
+    base_url = POOL_URL if provider == "claude-pool" else API
+    return {"provider": provider, "base_url": base_url,
+            "api_mode": "chat_completions" if provider == "claude-pool" else "anthropic_messages"}
+
+
+def _resume(snapshot_parent, db, saved=POOL_ROUTE, *, now=False):
+    from tools.delegate_tool_handoff import _ResumedUnit, _ResumeParent, _parent_snapshot
+
+    snap = json.loads(json.dumps(_parent_snapshot(snapshot_parent), default=str))
+    snap["session_id"] = "chat"
+    if now:
+        snap["claude_now"] = True
+    parent = _ResumeParent(snap, db)
+    with (patch("hermes_cli.runtime_provider.resolve_runtime_provider", side_effect=_runtime),
+          patch("tools.delegate_tool_routes._active_provider", return_value=_Backend())):
+        return _ResumedUnit._route(SimpleNamespace(), 0, {"route": saved}, parent, CFG), parent
+
+
+def test_a_carried_pool_subagent_resumes_on_the_provider_its_chat_moved_to():
+    spawned_on_pool = _parent("claude-pool", base_url=POOL_URL)
+    route, parent = _resume(spawned_on_pool, _Db(_on("claude-api-caam")))
+    assert route.creds["provider"] == "claude-api-caam" and route.creds["model"] == "claude-sonnet-5-5"
+    assert route.creds["api_key"] == "key-claude-api-caam" and parent._delegate_claude_account == "claude-api-caam"
+
+
+def test_a_carried_pool_subagent_stays_on_the_pool_while_its_chat_is_on_it():
+    route, _ = _resume(_parent("claude-pool", base_url=POOL_URL), _Db(_on("claude-pool")))
+    assert route.creds["provider"] == "claude-pool"
+
+
+def test_a_chat_that_moved_back_to_the_pool_is_not_followed_to_its_old_account():
+    spawned_on_account = _parent("claude-api-jaam")
+    route, _ = _resume(spawned_on_account, _Db(_on("claude-pool")))
+    assert route.creds["provider"] == "claude-pool"
+
+
+def test_the_chats_row_is_read_at_its_compression_tip():
+    class _Tip(_Db):
+        def get_session(self, session_id):
+            return self.row if session_id == "tip" else {"model_config": "{}"}
+
+    route, _ = _resume(_parent("claude-pool", base_url=POOL_URL), _Tip(_on("claude-api-jaam"), tip="tip"))
+    assert route.creds["provider"] == "claude-api-jaam"
+
+
+def test_a_row_that_cannot_be_read_leaves_the_recorded_answer_in_force():
+    route, _ = _resume(_parent("claude-pool", base_url=POOL_URL), _Db(None))
+    assert route.creds["provider"] == "claude-pool"
+
+
+def test_a_resume_the_chat_asked_for_follows_the_live_chat_and_ignores_the_row():
+    from tools.delegate_tool_claude import stamp_chat_account
+
+    def resumed_on(live, row):
+        spec = {"parent": {}, "children": {"0": {"route": POOL_ROUTE}}}
+        stamped = stamp_chat_account(spec, live)
+        saved = stamped["children"]["0"]["route"]
+        route, _ = _resume(live, _Db(_on(row)), saved, now=True)
+        return saved["route"]["provider"], route.creds["provider"]
+
+    assert resumed_on(_parent("claude-api-caam"), "claude-pool") == ("claude-api-caam", "claude-api-caam")
+    assert resumed_on(_parent("claude-pool", base_url=POOL_URL), "claude-api-caam") == ("claude-pool", "claude-pool")
+
+
+def test_a_stored_api_route_keeps_its_account_when_the_chat_is_on_another():
+    saved = {**POOL_ROUTE, "route": {"provider": "claude-api-jaam", "model": "claude-sonnet-5-5"}}
+    route, _ = _resume(_parent("claude-pool", base_url=POOL_URL), _Db(_on("claude-api-caam")), saved)
+    assert route.creds["provider"] == "claude-api-jaam"
+
+
+def test_the_resume_action_stamps_what_the_live_chat_runs_on_and_moves_only_pool_routes():
+    from tools.delegate_tool_claude import stamp_chat_account
+
+    api_route = {**POOL_ROUTE, "route": {"provider": "claude-api-jaam", "model": "m"}}
+    reask = {**POOL_ROUTE, "reask": True}
+    spec = {"parent": {"claude_account": "", "model": "m"},
+            "children": {"0": {"route": POOL_ROUTE}, "1": {"route": api_route}, "2": {"route": reask}}}
+    out = stamp_chat_account(spec, _parent("claude-api-caam"))
+    assert out["parent"] == {"claude_account": "claude-api-caam", "claude_now": True, "model": "m"}
+    assert [out["children"][k]["route"]["route"]["provider"] for k in "01"] == ["claude-api-caam", "claude-api-jaam"]
+    assert out["children"]["2"]["route"] == reask
+    pool = stamp_chat_account(spec, _parent("claude-pool", base_url=POOL_URL))
+    assert pool["parent"]["claude_account"] == "" and pool["children"]["0"]["route"] == POOL_ROUTE
+    assert spec["parent"] == {"claude_account": "", "model": "m"} and spec["children"]["0"]["route"] == POOL_ROUTE
