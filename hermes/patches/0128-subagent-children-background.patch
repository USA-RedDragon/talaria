@@ -0,0 +1,290 @@
+"""A subagent that delegates runs its children in the background, as a top-level chat does.
+
+Real agents, real stored sessions and the real delegation runtime; only the model is a scripted loopback server.
+A depth-1 orchestrator ("ORCH") spawns two leaves; each leaf's model call is held on a gate the test opens, so the
+leaves run for as long as the test needs.
+"""
+
+from __future__ import annotations
+
+import json
+import os
+import queue
+import threading
+import time
+from pathlib import Path
+
+import pytest
+
+from tests.fakes.fake_llm_provider import FakeLLMServer, Text, ToolCall, write_hermes_home
+from tests.waiting import wait_until
+from tools import async_delegation as ad
+from tools.delegate_tool_registry import _active_subagents, _active_subagents_lock, steer_outcome
+from tools.process_registry import process_registry
+
+LEAVES = ("LEAF-A", "LEAF-B")
+CONFIG = (
+    "delegation:\n  max_spawn_depth: 2\n  restart_handoff: true\n"
+    "updates:\n  check: false\nskills:\n  creation_nudge_interval: 0\nmemory:\n  nudge_interval: 0\n"
+)
+
+
+def _text(content) -> str:
+    if isinstance(content, str):
+        return content
+    return json.dumps(content, ensure_ascii=False)
+
+
+class Script:
+    """The scripted model of all three agents; who is asking is read off the first user message (the goal)."""
+
+    def __init__(self):
+        self.gates = {name: threading.Event() for name in LEAVES}
+        self.orch: list[str] = []  # the last message of every ORCH request
+        self.leaf_calls = {name: 0 for name in LEAVES}
+
+    def release_all(self):
+        for gate in self.gates.values():
+            gate.set()
+
+    def __call__(self, record):
+        msgs = record["body"]["messages"]
+        users = [m for m in msgs if m.get("role") == "user"]
+        first = _text(users[0]["content"]) if users else ""
+        last = msgs[-1]
+        last_text = _text(last.get("content"))
+        for name in LEAVES:
+            if first.startswith(name):
+                self.leaf_calls[name] += 1
+                self.gates[name].wait(60)
+                return Text(f"{name}-RESULT")
+        self.orch.append(f"{last.get('role')}: {last_text}")
+        if last.get("role") == "tool" and '"dispatched"' in last_text:
+            return Text("Dispatched both leaves; waiting for them.")
+        if last.get("role") == "user" and len(users) == 1:
+            return ToolCall("delegate_task", {"tasks": [{"goal": f"{n}: say hi"} for n in LEAVES]})
+        if "progress?" in last_text:
+            return Text("ORCH-PROGRESS: both leaves still run.")
+        seen = {n for n in LEAVES if any(f"{n}-RESULT" in _text(m.get("content")) for m in users)}
+        if seen == set(LEAVES):
+            return Text("ORCH-DONE: " + " ".join(sorted(f"{n}-RESULT" for n in seen)))
+        return Text("Got one result; waiting for the other.")
+
+
+@pytest.fixture
+def lab(monkeypatch):
+    ad._reset_for_tests()
+    home = Path(os.environ["HERMES_HOME"])
+    script = Script()
+    with FakeLLMServer(script) as srv:
+        write_hermes_home(home, srv.base_url, extra_config=CONFIG)
+        import hermes_cli.config as cfg
+        if hasattr(cfg, "_config_cache"):
+            monkeypatch.setattr(cfg, "_config_cache", None, raising=False)
+        monkeypatch.setattr("tools.delegate_tool._load_config",
+                            lambda: {"max_spawn_depth": 2, "restart_handoff": True, "max_iterations": 20})
+        monkeypatch.setattr("tools.delegate_tool_config._cfg",
+                            lambda: {"max_spawn_depth": 2, "restart_handoff": True, "max_iterations": 20})
+        try:
+            yield script, srv
+        finally:
+            script.release_all()
+            ad._reset_for_tests()
+            with _active_subagents_lock:
+                _active_subagents.clear()
+
+
+def _top_agent(srv):
+    from hermes_state import SessionDB
+    from run_agent import AIAgent
+    db = SessionDB(db_path=Path(os.environ["HERMES_HOME"]) / "state.db")
+    agent = AIAgent(provider="custom", base_url=srv.base_url, api_key="sk-fake-e2e", model="fake-model",
+                    session_db=db, quiet_mode=True, platform="cli",
+                    enabled_toolsets=["delegation", "terminal"])
+    db.create_session(session_id=agent.session_id, source="cli")
+    return agent
+
+
+def _orch_record():
+    with _active_subagents_lock:
+        return next((dict(r) for r in _active_subagents.values() if r.get("depth") == 1
+                     or str(r.get("goal", "")).startswith("ORCH")), None)
+
+
+def _by_goal(prefix):
+    with _active_subagents_lock:
+        return [dict(r) for r in _active_subagents.values() if str(r.get("goal", "")).startswith(prefix)]
+
+
+def _steer_orch(text):
+    rec = _orch_record()
+    assert rec is not None
+    return steer_outcome(rec["subagent_id"], text)
+
+
+def test_subagent_children_run_in_background_and_wake_it(lab):
+    script, srv = lab
+    top = _top_agent(srv)
+    out = {}
+
+    def run():
+        from tools.delegate_tool import delegate_task
+        out["raw"] = delegate_task(tasks=[{"goal": "ORCH: delegate two leaves and report"}], parent_agent=top,
+                                   background=False)
+
+    started = time.monotonic()
+    worker = threading.Thread(target=run, daemon=True)
+    worker.start()
+
+    # delegate_task returned to ORCH within seconds while both leaves are held: ORCH ended its turn and waits.
+    wait_until(lambda: any(line.startswith("tool:") and '"dispatched"' in line for line in script.orch), timeout=30,
+               what="ORCH's delegate_task returning")
+    returned_after = time.monotonic() - started
+    assert returned_after < 20
+    wait_until(lambda: (_orch_record() or {}).get("status") == "waiting", timeout=20, what="ORCH waiting")
+    rec = _orch_record()
+    assert rec["waiting_on"] and all("subagent" in line for line in rec["waiting_on"]) and len(rec["waiting_on"]) == 2
+    assert len(_by_goal("LEAF")) == 2 and all(r["status"] == "running" for r in _by_goal("LEAF"))
+
+    # A steer while the leaves run wakes ORCH at once and it answers; then it waits again.
+    assert _steer_orch("progress?") == "woke"
+    wait_until(lambda: any("progress?" in line for line in script.orch), timeout=20, what="the steer read")
+    wait_until(lambda: (_orch_record() or {}).get("status") == "waiting", timeout=20, what="ORCH waiting again")
+    assert not script.gates["LEAF-A"].is_set() and not script.gates["LEAF-B"].is_set()
+
+    # Each leaf's result wakes ORCH on its own; ORCH finishes after the second.
+    script.gates["LEAF-A"].set()
+    wait_until(lambda: any("LEAF-A-RESULT" in line for line in script.orch), timeout=30, what="LEAF-A's result")
+    assert not any("LEAF-B-RESULT" in line for line in script.orch)
+    wait_until(lambda: (_orch_record() or {}).get("status") == "waiting", timeout=20, what="waiting on LEAF-B")
+    assert len((_orch_record() or {}).get("waiting_on") or []) == 1
+    assert worker.is_alive()
+    script.gates["LEAF-B"].set()
+    worker.join(60)
+    assert not worker.is_alive()
+    result = json.loads(out["raw"])
+    (entry,) = result["results"]
+    assert entry["status"] == "completed"
+    assert entry["summary"].startswith("ORCH-DONE") and "LEAF-A-RESULT" in entry["summary"]
+    assert "LEAF-B-RESULT" in entry["summary"]
+
+
+def test_stopping_a_waiting_subagent_stops_its_children_and_reports_them(lab):
+    script, srv = lab
+    top = _top_agent(srv)
+    out = {}
+
+    def run():
+        from tools.delegate_tool import delegate_task
+        out["raw"] = delegate_task(tasks=[{"goal": "ORCH: delegate two leaves and report"}], parent_agent=top,
+                                   background=False)
+
+    worker = threading.Thread(target=run, daemon=True)
+    worker.start()
+    wait_until(lambda: (_orch_record() or {}).get("status") == "waiting", timeout=30, what="ORCH waiting")
+    from tools.delegate_tool_registry import interrupt_subagent
+    assert interrupt_subagent(_orch_record()["subagent_id"])
+    script.release_all()  # a stopped leaf's held model call returns; its turn ends interrupted
+    worker.join(90)
+    assert not worker.is_alive()
+    (entry,) = json.loads(out["raw"])["results"]
+    assert entry["status"] == "interrupted"
+    assert {c["goal"][:6] for c in entry.get("children") or []} == set(LEAVES)
+
+
+def test_restart_hands_the_subagent_and_its_children_to_the_next_gateway(lab, monkeypatch):
+    """The gateway's own restart path: ``hand_off_for_restart`` stops the background unit (ORCH waiting on two held
+    leaves), and the next gateway's ``resume_handed_off_delegations`` rebuilds ORCH from its stored session with its
+    children, which run on and wake it; the chat gets ORCH's one final result."""
+    from tools.delegate_tool_handoff import resume_handed_off_delegations
+    script, srv = lab
+    monkeypatch.setattr("tools.delegate_tool_dispatch._resolve_async_wake_sid", lambda *a, **k: "")
+    top = _top_agent(srv)
+    from tools.delegate_tool import delegate_task
+    handle = json.loads(delegate_task(tasks=[{"goal": "ORCH: delegate two leaves and report"}], parent_agent=top,
+                                      background=True))
+    assert handle["status"] == "dispatched"
+    unit_id = handle["delegation_id"]
+    wait_until(lambda: (_orch_record() or {}).get("status") == "waiting", timeout=30, what="ORCH waiting")
+    assert _steer_orch("progress?") == "woke"
+    wait_until(lambda: any("progress?" in line for line in script.orch), timeout=20, what="the steer read")
+    wait_until(lambda: (_orch_record() or {}).get("status") == "waiting", timeout=20, what="ORCH waiting again")
+    leaf_calls = dict(script.leaf_calls)
+
+    # Restart: hand off, let the held leaf calls go (the stopped leaves end interrupted), then a new gateway.
+    releaser = threading.Timer(1.0, script.release_all)
+    releaser.start()
+    assert ad.hand_off_for_restart(grace_seconds=2.0, timeout_seconds=30.0) == 1
+    releaser.join()
+    stale = [e for e in _drain() if e.get("delegation_id") == unit_id and not e.get("task_failure_notice")]
+    assert stale == []  # nothing delivered by the old gateway
+    with _active_subagents_lock:
+        _active_subagents.clear()
+    ad._reset_for_tests()
+    for gate in script.gates.values():
+        gate.clear()
+    assert resume_handed_off_delegations() == 1
+
+    # ORCH and both leaves run again in the new gateway; ORCH goes back to waiting.
+    wait_until(lambda: len(_by_goal("LEAF")) == 2, timeout=30, what="the leaves resumed")
+    wait_until(lambda: (_orch_record() or {}).get("status") == "waiting", timeout=30, what="resumed ORCH waiting")
+    script.release_all()
+    events = wait_until(lambda: [e for e in _drain() if e.get("delegation_id") == unit_id], timeout=60,
+                        what="the unit's final result")
+    (entry,) = events[0]["results"]
+    assert entry["status"] == "completed", entry
+    assert entry["summary"].startswith("ORCH-DONE")
+    assert all(script.leaf_calls[n] > leaf_calls[n] for n in LEAVES)  # each leaf ran again after the restart
+
+
+def _drain():
+    items = []
+    while True:
+        try:
+            items.append(process_registry.completion_queue.get_nowait())
+        except queue.Empty:
+            return [e for e in items if isinstance(e, dict) and e.get("type") == "async_delegation"]
+
+
+class _Child:
+    """A stand-in subagent agent for the process-wait tests."""
+
+
+@pytest.fixture
+def waiting_subagent(monkeypatch):
+    child = _Child()
+    sid = "sa-0-wait"
+    with _active_subagents_lock:
+        _active_subagents[sid] = {"subagent_id": sid, "agent": child, "status": "running", "accepting_steer": True}
+    session = process_registry.spawn_local("sleep 30", task_id=sid, owner_task_id=sid)
+    try:
+        yield child, sid, session
+    finally:
+        process_registry.kill_process(session.id)
+        with _active_subagents_lock:
+            _active_subagents.pop(sid, None)
+
+
+def _wait(session, sid, timeout):
+    from tools.process_registry import _handle_process
+    return json.loads(_handle_process({"action": "wait", "session_id": session.id, "timeout": timeout}, task_id=sid))
+
+
+def test_subagent_wait_never_blocks_past_its_bound(waiting_subagent, monkeypatch):
+    _child, sid, session = waiting_subagent
+    monkeypatch.setenv("TERMINAL_TIMEOUT", "3600")
+    monkeypatch.setattr("tools.process_registry.SUBAGENT_MAX_WAIT_SECONDS", 2)
+    started = time.monotonic()
+    result = _wait(session, sid, 3600)
+    assert time.monotonic() - started < 10
+    assert result["status"] == "timeout" and "resume_on_exit" in result["subagent_note"]
+
+
+def test_subagent_wait_is_released_by_a_message(waiting_subagent):
+    child, sid, session = waiting_subagent
+    threading.Timer(1.0, lambda: setattr(child, "_pending_steer", "progress?")).start()
+    started = time.monotonic()
+    result = _wait(session, sid, 100)
+    assert time.monotonic() - started < 10
+    assert result["status"] == "interrupted" and result["process_running"] is True
+    assert "message was sent to you" in result["note"] and "watches the process" in result["note"]
