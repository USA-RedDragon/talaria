diff --git a/tools/delegate_tool_subunits.py b/tools/delegate_tool_subunits.py
new file mode 100644
index 00000000..6d6222f2
--- /dev/null
+++ b/tools/delegate_tool_subunits.py
@@ -0,0 +1,360 @@
+"""A subagent's own children run in the background, as a top-level chat's do.
+
+A subagent (depth > 0) that calls ``delegate_task`` used to run its children inside that tool call: the call joined
+them, so the subagent sat in one tool call for as long as its slowest child ran (hours), and a steer or an
+``agent_send`` to it was read only when the call returned. Now each child of a subagent is a unit of its own: it runs
+on a background thread, ``delegate_task`` returns its ids at once, and the subagent goes on working. When the
+subagent ends its turn while a child runs, its unit stays open and it shows as ``waiting`` (``waiting_on`` names the
+children); each child's result wakes it as its next input (results that are ready together come in one message), and
+a steer or ``agent_send`` wakes it at once (``delegate_tool_wait.await_exit``). The subagent finishes, and its parent
+gets its result, only when it ends a turn with no child running and no watched job.
+
+A subagent that ends without waiting (it is stopped, or its run fails) stops the children that still run, waits up
+to ``SETTLE_SECONDS`` for them, and lists each one's status and partial summary under ``children`` on its own result.
+A child is never handed to the grandparent: the grandparent did not brief it and cannot steer it.
+
+A gateway restart that hands the subagent to the next gateway (``delegation.restart_handoff``) hands its running
+children with it: each unit's resume record rides the subagent's state, the children are stopped at the restart like
+the subagent, and the next gateway resumes them from their stored sessions under the resumed subagent. A child that
+had finished keeps its result, which is delivered to the subagent after the restart.
+"""
+
+from __future__ import annotations
+
+import contextvars
+import json
+import logging
+import threading
+import time
+import weakref
+from typing import Any, Optional
+
+logger = logging.getLogger("tools.delegate_tool")
+
+UNITS_ATTR = "_child_units"
+RESTORED_ATTR = "_restored_child_units"
+_LOCK = threading.Lock()
+SETTLE_SECONDS = 30.0
+_SUMMARY_CHARS = 1500
+
+BACKGROUND_NOTE = (
+    "Your subagent(s) run in the background and delegate_task has returned. Each one's result comes to you as a new "
+    "message when it finishes; results are delivered only BETWEEN your turns. Do anything that does not depend on "
+    "them, then END YOUR TURN with a one-line status: you are woken with each result, and a message sent to you "
+    "(a steer or agent_send) wakes you at once. You finish, and your parent gets your result, only when you end a "
+    "turn with none of them running. Do not poll their transcripts. To finish without one, stop it with "
+    "delegate_task(action='stop', subagent_id=...); its partial result still comes to you."
+)
+
+
+class Unit:
+    """One background child of a subagent (or, after a restart, one resumed group of them)."""
+
+    def __init__(self, delegation_id: str, goals: list, indexes: list, subagent_ids: list, context: Optional[str],
+                 role: str, model: Any, spec: Optional[dict], children: list):
+        self.delegation_id = delegation_id
+        self.goals, self.indexes, self.subagent_ids = goals, indexes, subagent_ids
+        self.context, self.role, self.model = context, role, model
+        self.spec = spec  # the restart handoff record (``delegate_tool_handoff._unit_spec``), or None
+        self.children = children  # the live child agents, for stop and the restart handoff
+        self.dispatched_at = time.time()
+        self.result: Optional[dict] = None
+        self.done = threading.Event()
+        self.delivered = False
+        self.handed_off = False
+        self.stop_fn: Any = None
+
+    def describe(self) -> str:
+        goal = next((self.goals[i] for i in self.indexes if i < len(self.goals) and self.goals[i]), "")
+        first = " ".join(str(goal).split())[:80]
+        sid = next((s for s in self.subagent_ids if s), "")
+        return f"subagent {sid}: {first}" if sid else f"a subagent: {first}"
+
+
+def units_of(agent: Any) -> list:
+    with _LOCK:
+        return list(vars(agent).get(UNITS_ATTR) or [])
+
+
+def _add(agent: Any, unit: Unit) -> None:
+    with _LOCK:
+        vars(agent).setdefault(UNITS_ATTR, []).append(unit)
+
+
+def pending(agent: Any) -> bool:
+    """Whether the subagent still has a child to wait for or a result to read."""
+    return any(not u.delivered and not u.handed_off for u in units_of(agent))
+
+
+def running(agent: Any) -> list:
+    return [u for u in units_of(agent) if not u.done.is_set() and not u.handed_off]
+
+
+def waiting_on(agent: Any) -> list:
+    """The ``waiting_on`` lines of the subagent's running children, as the hub shows them."""
+    return [u.describe() for u in running(agent)]
+
+
+def take_ready(agent: Any) -> list:
+    """The finished, unread units, marked read."""
+    with _LOCK:
+        ready = [u for u in vars(agent).get(UNITS_ATTR) or [] if u.done.is_set() and not u.delivered
+                 and not u.handed_off]
+        for u in ready:
+            u.delivered = True
+    return ready
+
+
+def capacity_error(parent: Any, requested: int, cap: int) -> Optional[str]:
+    busy = sum(len(u.indexes) for u in running(parent))
+    if busy and busy + requested > cap:
+        return (f"{busy} of your subagents still run and at most {cap} may run at once "
+                "(delegation.max_concurrent_children). End your turn to wait for them (each result wakes you), or "
+                "stop one with delegate_task(action='stop', subagent_id=...).")
+    return None
+
+
+def background_for(parent: Any) -> bool:
+    """A subagent run by ``_run_single_child`` (its unit waits for its children); any other nested agent joins."""
+    if not getattr(parent, "_delegate_depth", 0) > 0:
+        return False
+    sid = getattr(parent, "_subagent_id", None)
+    if not isinstance(sid, str) or not sid:
+        return False
+    from tools.delegate_tool_registry import _active_subagents, _active_subagents_lock
+    with _active_subagents_lock:
+        record = _active_subagents.get(sid)
+        return record is not None and record.get("agent") is parent
+
+
+def _wake(agent: Any) -> None:
+    from tools.delegate_tool_wait import _wake_event
+    _wake_event(agent).set()
+
+
+def _finish(agent_ref: Any, unit: Unit, result: dict) -> None:
+    unit.result = result
+    unit.done.set()
+    agent = agent_ref()
+    if agent is not None:
+        _wake(agent)
+
+
+def _crash_result(unit: Unit, error: str) -> dict:
+    from tools.delegate_tool_child_run import _fabricated_entry
+    return {"results": [_fabricated_entry(i, "error", error, None) for i in unit.indexes], "error": error}
+
+
+def _spec_for(batch: Any) -> Optional[dict]:
+    from tools.delegate_tool_config import _get_restart_handoff, _get_worktree_isolation
+    if not _get_restart_handoff() or _get_worktree_isolation():
+        return None
+    try:
+        from tools.delegate_tool_handoff import _unit_spec
+        return _unit_spec(batch, None)
+    except Exception:
+        logger.debug("delegate_task: no restart record for a subagent's child", exc_info=True)
+        return None
+
+
+def dispatch(batch: Any) -> str:
+    """Run each child of a subagent's ``delegate_task`` call as a background unit and return the dispatch handle."""
+    from dataclasses import replace
+    from tools.delegate_tool_dispatch import _dispatched_payload, _execute_and_aggregate
+    from tools.delegate_tool_child_run import _signal_child_stop
+    parent = batch.parent_agent
+    parent_ref = weakref.ref(parent)
+    units = []
+    for i, task, child in batch.children:
+        piece = replace(batch, children=[(i, task, child)], refused=[], unit_id=None)
+        unit_id = batch.live_deleg_id if len(batch.children) == 1 else f"{batch.live_deleg_id}-{i + 1}"
+        model = batch.creds.get("model") or getattr(child, "model", None)
+        unit = Unit(unit_id or f"sub-{i}", [t["goal"] for t in batch.task_list], [i],
+                    [getattr(child, "_subagent_id", None)], batch.context, batch.top_role, model, _spec_for(piece),
+                    [child])
+        unit.stop_fn = lambda c=child: _signal_child_stop(c, "Stopped by its parent subagent")
+        _add(parent, unit)
+        units.append((piece, unit))
+    for piece, unit in units:
+        def run(piece=piece, unit=unit):
+            try:
+                result = _execute_and_aggregate(piece, honor_parent_interrupt=False)
+            except Exception as exc:  # never leave the subagent waiting on a unit that died
+                logger.exception("delegate_task: a subagent's background child crashed")
+                result = _crash_result(unit, f"The child's runner crashed: {exc}")
+            _finish(parent_ref, unit, result)
+        ctx = contextvars.copy_context()
+        threading.Thread(target=ctx.run, args=(run,), daemon=True,
+                         name=f"subagent-child-{unit.delegation_id}").start()
+    payload = _dispatched_payload(batch, [(batch, batch.live_deleg_id or units[0][1].delegation_id)])
+    payload["note"] = BACKGROUND_NOTE
+    payload.pop("units", None)
+    return json.dumps(payload, ensure_ascii=False)
+
+
+def completion_text(units: list) -> str:
+    """The message that wakes the subagent with the results of ``units``, in the top-level completion format."""
+    from tools.process_registry_notifications import _format_async_delegation
+    blocks = []
+    for unit in units:
+        result = unit.result if isinstance(unit.result, dict) else {}
+        evt = {
+            "type": "async_delegation", "is_batch": True, "delegation_id": unit.delegation_id,
+            "goals": unit.goals, "context": unit.context, "role": unit.role, "model": unit.model,
+            "results": result.get("results") or [], "error": result.get("error"),
+            "total_duration_seconds": result.get("total_duration_seconds"),
+            "dispatched_at": unit.dispatched_at, "completed_at": time.time(),
+            **({"resumed": result["resumed"]} if result.get("resumed") else {})}
+        try:
+            blocks.append(_format_async_delegation(evt))
+        except Exception:
+            blocks.append(json.dumps({"delegation_id": unit.delegation_id, **result}, ensure_ascii=False, default=str))
+    return "\n\n".join(blocks)
+
+
+def still_running_text(agent: Any) -> str:
+    left = running(agent)
+    if not left:
+        return ""
+    return (f"{len(left)} of your subagents still run: " + "; ".join(u.describe() for u in left)
+            + ". End your turn again to wait for them; each result wakes you.")
+
+
+def stop_all(agent: Any, entry: Optional[dict] = None) -> None:
+    """The subagent ends without waiting: stop its running children, wait up to ``SETTLE_SECONDS`` for them, and
+    list every unread child result on ``entry`` (``children``). Nothing is stopped for a restart handoff."""
+    if getattr(agent, "_delegate_restart_handoff", False) is True:
+        return
+    for unit in running(agent):
+        try:
+            if callable(unit.stop_fn):
+                unit.stop_fn()
+        except Exception:
+            logger.debug("delegate_task: stopping a subagent's child failed", exc_info=True)
+    deadline = time.monotonic() + SETTLE_SECONDS
+    for unit in units_of(agent):
+        unit.done.wait(max(0.0, deadline - time.monotonic()))
+    if entry is None:
+        return
+    rows = []
+    for unit in units_of(agent):
+        if unit.delivered or unit.handed_off:
+            continue
+        unit.delivered = True
+        results = (unit.result or {}).get("results") if unit.done.is_set() else None
+        for i, sid in zip(unit.indexes, unit.subagent_ids):
+            r = next((x for x in results or [] if x.get("task_index") == i), None) or {}
+            rows.append({"subagent_id": sid, "goal": str(unit.goals[i] if i < len(unit.goals) else "")[:200],
+                         "status": r.get("status") or ("running" if not unit.done.is_set() else "unknown"),
+                         "summary": str(r.get("summary") or "")[:_SUMMARY_CHARS] or None,
+                         "error": r.get("error"), "live_transcript": r.get("live_transcript")})
+    if rows:
+        entry["children"] = rows
+        note = (f"[This subagent ended while {len(rows)} subagent(s) of its own ran; they were stopped. Their "
+                "statuses and partial summaries are under 'children'.]")
+        entry["summary"] = f"{entry['summary']}\n\n{note}" if entry.get("summary") else note
+
+
+# ── Restart handoff ─────────────────────────────────────────────────────────
+def hand_off(agent: Any) -> list:
+    """The subagent stops for a restart handoff: mark its running children as handed off (their tool state is kept for
+    the next gateway) and return each unit's resume record. Finished but unread results ride along as kept entries."""
+    from tools.delegate_tool_handoff import _child_state
+    records = []
+    for unit in units_of(agent):
+        if unit.delivered or unit.handed_off:
+            continue
+        done = unit.done.is_set()
+        kept = {}
+        if done:
+            for r in (unit.result or {}).get("results") or []:
+                if isinstance(r, dict) and isinstance(r.get("task_index"), int):
+                    kept[str(r["task_index"])] = r
+        if not done and unit.spec is None:
+            continue  # no resume record: it stops with the gateway and the subagent is told on resume
+        spec = json.loads(json.dumps(unit.spec, default=str)) if unit.spec else None
+        if not done and spec is not None:
+            for child, i in zip(unit.children, unit.indexes):
+                child._delegate_restart_handoff = True
+                try:
+                    state = _child_state(child)
+                except Exception:
+                    state = {}
+                (spec.get("children") or {}).setdefault(str(i), {}).update(
+                    {k: v for k, v in state.items() if v is not None})
+        unit.handed_off = True
+        records.append({"delegation_id": unit.delegation_id, "goals": unit.goals, "task_indexes": unit.indexes,
+                        "subagent_ids": unit.subagent_ids, "context": unit.context, "role": unit.role,
+                        "model": unit.model, "dispatched_at": unit.dispatched_at, "spec": spec, "kept": kept,
+                        "done": done})
+    return records
+
+
+def is_waiting(agent: Any) -> bool:
+    """Whether the subagent had ended its turn to wait (its registry row reads ``waiting``)."""
+    from tools.delegate_tool_registry import _active_subagents, _active_subagents_lock
+    sid = getattr(agent, "_subagent_id", None)
+    with _active_subagents_lock:
+        return (_active_subagents.get(sid) or {}).get("status") == "waiting" if isinstance(sid, str) else False
+
+
+def restore(agent: Any, records: Any, *, waiting: bool = False) -> None:
+    """The next gateway: the children a handed-off subagent had (started by ``start_restored``). ``waiting``: the
+    subagent had ended its turn to wait, so it goes straight back to waiting instead of continuing a turn."""
+    if isinstance(records, list):
+        vars(agent)[RESTORED_ATTR] = [r for r in records if isinstance(r, dict) and r.get("delegation_id")]
+        agent._restored_waiting = bool(waiting)
+
+
+def start_restored(agent: Any) -> None:
+    """In the next gateway: resume each handed-off child under ``agent`` (the resumed subagent), or deliver the
+    result it had already reached."""
+    records = vars(agent).pop(RESTORED_ATTR, None) or []
+    for rec in records:
+        unit = Unit(rec["delegation_id"], list(rec.get("goals") or []), list(rec.get("task_indexes") or []),
+                    list(rec.get("subagent_ids") or []), rec.get("context"), rec.get("role") or "leaf",
+                    rec.get("model"), rec.get("spec"), [])
+        unit.dispatched_at = float(rec.get("dispatched_at") or time.time())
+        _add(agent, unit)
+        kept = {int(k): v for k, v in (rec.get("kept") or {}).items()}
+        if rec.get("done") or not isinstance(rec.get("spec"), dict):
+            results = [kept.get(i) or {"task_index": i, "status": "interrupted", "summary": None, "api_calls": 0,
+                                       "duration_seconds": 0,
+                                       "error": "Stopped by a gateway restart and not resumed (no resume record)."}
+                       for i in unit.indexes]
+            _finish(weakref.ref(agent), unit, {"results": results})
+            continue
+        _start_resumed(agent, unit, kept)
+
+
+def _start_resumed(agent: Any, unit: Unit, kept: dict) -> None:
+    from tools.delegate_tool_handoff import _ResumedUnit
+
+    class _Resumed(_ResumedUnit):
+        """Resumed under the live subagent: its children answer to it (stop, list, steer) like fresh ones."""
+
+        def _build(self, index, spec, parent, db):
+            child = super()._build(index, spec, parent, db)
+            live = agent_ref()
+            if live is not None:
+                child._delegate_parent_ref = weakref.ref(live)
+            unit.children.append(child)
+            return child
+
+    agent_ref = weakref.ref(agent)
+    resumed = _Resumed({
+        "delegation_id": unit.delegation_id, "handoff": unit.spec, "kept": kept, "goals": unit.goals,
+        "task_indexes": unit.indexes, "dispatched_at": unit.dispatched_at,
+        "parent_session_id": str(getattr(agent, "session_id", "") or ""), "origin_ui_session_id": ""})
+    unit.stop_fn = resumed.interrupt
+
+    def run():
+        try:
+            result = resumed.run()
+        except Exception as exc:
+            logger.exception("delegate_task: resuming a subagent's child after a restart failed")
+            result = _crash_result(unit, f"Could not be resumed after a gateway restart: {exc}")
+        _finish(agent_ref, unit, result)
+
+    ctx = contextvars.copy_context()
+    threading.Thread(target=ctx.run, args=(run,), daemon=True, name=f"subagent-child-{unit.delegation_id}").start()
