+@pytest.mark.asyncio
+async def test_an_api_request_sent_to_the_old_gateway_during_the_restart_is_served_by_the_next(owner, tmp_path,
+                                                                                               monkeypatch):
+    """The old pod's API port keeps accepting and relays to the next gateway's API server (another network
+    namespace), which serves the request once it listens: no 503 and no refused connection meanwhile."""
+    from aiohttp import ClientSession, web
+    _reserve_profile(tmp_path)
+    def answer(who):
+        async def health(_request):
+            return web.json_response({"who": who})
+        return health
+    old_app = web.Application()
+    old_app.router.add_get("/health", answer("old"))
+    old_runner = web.AppRunner(old_app)
+    await old_runner.setup()
+    site = web.TCPSite(old_runner, "127.0.0.1", 0)
+    await site.start()
+    old_port = site._server.sockets[0].getsockname()[1]
+    new_app = web.Application()
+    new_app.router.add_get("/health", answer("next"))
+    new_runner = web.AppRunner(new_app)
+    await new_runner.setup()
+    new_site = web.TCPSite(new_runner, "127.0.0.1", 0)
+    await new_site.start()
+    new_port = new_site._server.sockets[0].getsockname()[1]
+    await new_site.stop()  # the next gateway binds its API port only once it owns the profile
+
+    adapter = SimpleNamespace(_site=site, _port=new_port)
+    runner = _old_runner(owner)
+    runner.adapters = {Platform.API_SERVER: adapter}
+    import gateway.listener_relay as relay
+    monkeypatch.setattr(relay, "successor_target", lambda _marker: ("127.0.0.1", 1))
+    row, live, _agent = _claimed_turn(owner, "api")
+    carry = asyncio.ensure_future(turn_carry.carry_restart(runner))
+    await _until(turn_carry.released)
+    assert adapter._site is None
+
+    async def ask():
+        async with ClientSession() as http:
+            async with http.get(f"http://127.0.0.1:{old_port}/health") as response:
+                return response.status, await response.json()
+    pending = asyncio.ensure_future(ask())
+    await asyncio.sleep(0.3)  # the next gateway is still starting: the request waits, it is not refused
+    assert not pending.done()
+    new_site = web.TCPSite(new_runner, "127.0.0.1", new_port)
+    await new_site.start()
+    assert await asyncio.wait_for(pending, 5.0) == (200, {"who": "next"})
+
+    settle_session_input(owner.db, epoch=owner.epoch, admission_id=row["admission_id"],
+                         generation=row["generation"], outcome="completed")
+    await asyncio.wait_for(carry, 10.0)
+    import os
+    os.close(runner._turn_carry.lock_fd)
+    await old_runner.cleanup()
+    await new_runner.cleanup()
+
