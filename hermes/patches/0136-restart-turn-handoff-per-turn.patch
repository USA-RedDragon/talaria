--- /dev/null
+++ b/tests/gateway/test_restart_turn_carry.py
@@ -0,0 +1,413 @@
+"""gateway.restart_turn_handoff_per_turn: a graceful restart releases the profile to the next gateway at once and
+each running turn moves over at its own step boundary, while the turns that did not reach theirs yet keep running
+on the old gateway (the carrier) under its own claims.
+
+The old owner (``owner``) and the next one share one state.db, as two gateways on one volume do."""
+import asyncio
+import json
+import time
+from types import SimpleNamespace
+
+import pytest
+
+from gateway import turn_boundary, turn_carry, turn_handoff
+from gateway.config import GatewayConfig, Platform
+from gateway.session import SessionSource
+from gateway.session_authority import LiveSession
+from hermes_state_runtime import (RuntimeStoreError, admit_session_input, begin_runtime_epoch, claim_session_input,
+                                  get_session_admission, recover_session_inputs, settle_session_input)
+
+
+@pytest.fixture(autouse=True)
+def _clean(monkeypatch, tmp_path):
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+    monkeypatch.setattr(turn_handoff, "_handing_off", False)
+    monkeypatch.setattr(turn_boundary, "_resuming", set())
+    monkeypatch.setattr(turn_boundary, "_handed_off", set())
+    monkeypatch.setattr(turn_carry, "_released", False)
+    monkeypatch.setattr(turn_carry, "_api_target", None)
+    monkeypatch.setattr(turn_carry, "_stop_cron", _noop)
+    monkeypatch.setattr(turn_carry, "_hand_off_background", _noop)
+    monkeypatch.setattr(turn_carry, "_disconnect_messaging", _noop)
+
+
+async def _noop(*_args, **_kwargs):
+    return None
+
+
+def _config(**overrides):
+    values = dict(restart_turn_handoff=True, restart_turn_handoff_boundary=True,
+                  restart_turn_handoff_wait_seconds=540.0, restart_turn_handoff_per_turn=True,
+                  restart_turn_carry_ceiling_seconds=30.0)
+    values.update(overrides)
+    return GatewayConfig(**values)
+
+
+def _claimed_turn(owner, session_id):
+    """A turn the old owner claimed and runs in this process (its agent at work)."""
+    owner.db.create_session(session_id, source="local")
+    admit_session_input(owner.db, epoch=owner.epoch, principal_id="p", session_id=session_id,
+                        request_id="r-" + session_id, payload={"text": "work on " + session_id})
+    row = claim_session_input(owner.db, epoch=owner.epoch, session_id=session_id)
+    live = LiveSession(SessionSource(platform=Platform.LOCAL, chat_id=session_id), "route-" + session_id)
+    live.event_stream.execution = {"authority_epoch": owner.epoch, "execution_generation": row["generation"],
+                                   "admission_id": row["admission_id"]}
+    owner.sessions[session_id] = live
+    agent = SimpleNamespace()
+    owner.adopted[session_id] = (row["generation"], agent)
+    owner.executing[session_id] = row["generation"]
+    return row, live, agent
+
+
+def _old_runner(owner, **config):
+    runner = owner.runner
+    runner.config = _config(**config)
+    runner._restart_requested = True
+    runner.session_authorities = None
+    runner.session_runtime_descriptor = {"state": "ready"}
+    runner._mark_api_runs_shutdown_requested = lambda: 0
+    runner._active_api_run_count = lambda: 0
+    return runner
+
+
+def _reserve_profile(tmp_path):
+    from gateway.runtime_ownership import process_ownership
+    process_ownership.reserve([tmp_path])
+    return process_ownership
+
+
+class _NextAuthority:
+    """The next gateway's authority, as far as the relay and the pick-up use it."""
+
+    def __init__(self, db, profile_id="default"):
+        self.db, self.profile_id = db, profile_id
+        self.epoch = begin_runtime_epoch(db, instance_id="second")
+        self.sessions, self.scheduled = {}, []
+
+    def _schedule(self, ref):
+        self.scheduled.append((ref.session_id, time.monotonic()))
+
+    def _publish_pending(self, _ref):
+        return None
+
+
+async def _until(predicate, timeout=5.0):
+    loop = asyncio.get_running_loop()
+    end = loop.time() + timeout
+    while not predicate():
+        assert loop.time() < end, "timed out"
+        await asyncio.sleep(0.01)
+
+
+async def _hand_off_at_boundary(owner, row, live):
+    """The turn's agent stopped at its boundary; the old owner's drain requeues it (turn_boundary.finish_handed_off)."""
+    await turn_boundary._commit(owner, live, get_session_admission(owner.db, admission_id=row["admission_id"]),
+                                {"prompts": []})
+
+
+@pytest.mark.asyncio
+async def test_early_boundary_turn_resumes_on_the_next_gateway_while_another_still_runs_on_the_old(owner, tmp_path):
+    ownership = _reserve_profile(tmp_path)
+    fast, fast_live, fast_agent = _claimed_turn(owner, "fast")
+    slow, slow_live, slow_agent = _claimed_turn(owner, "slow")
+    runner = _old_runner(owner)
+    carry = asyncio.ensure_future(turn_carry.carry_restart(runner))
+
+    # The profile is released while both turns still run: the next gateway can take over at once.
+    await _until(turn_carry.released)
+    assert not ownership.owns(tmp_path)
+    assert fast_agent._handoff_boundary and slow_agent._handoff_boundary
+    assert turn_carry.live_carry_epoch(owner.db) == owner.epoch
+
+    nxt = _NextAuthority(owner.db)
+    recover_session_inputs(owner.db, epoch=nxt.epoch, keep_epoch=turn_carry.live_carry_epoch(owner.db))
+    for sid, live in (("fast", fast_live), ("slow", slow_live)):
+        nxt.sessions[sid] = LiveSession(live.source, live.route)
+    from hermes_state_runtime import turn_carry_record
+    remote = turn_carry._Remote(SimpleNamespace(), nxt, turn_carry_record(owner.db), tmp_path)
+    nxt._turn_carrier = remote
+    watch = asyncio.ensure_future(turn_carry._watch(remote))
+
+    # The fast turn reaches its boundary: the next gateway picks it up within a poll, the slow one keeps running.
+    at_boundary = time.monotonic()
+    await _hand_off_at_boundary(owner, fast, fast_live)
+    await _until(lambda: any(sid == "fast" for sid, _ in nxt.scheduled))
+    picked = next(t for sid, t in nxt.scheduled if sid == "fast") - at_boundary
+    assert picked < 1.0
+    assert not any(sid == "slow" for sid, _ in nxt.scheduled)
+    resumed = claim_session_input(owner.db, epoch=nxt.epoch, session_id="fast")
+    assert resumed["admission_id"] == fast["admission_id"] and resumed["resume"] == {"prompts": []}
+    assert get_session_admission(owner.db, admission_id=slow["admission_id"])["status"] == "started"
+    assert not carry.done()
+
+    # The slow turn's model call was its last step: it completes and settles on the old gateway. Its viewers, now on
+    # the next gateway, get its frames up to the reply, published right after the settlement.
+    seen = []
+    nxt.sessions["slow"].event_stream.observers.add(lambda frame: seen.append(frame["params"]["type"]))
+    with slow_live.event_stream.lock:
+        slow_live.event_stream.publish("slow", {"text": "almost"}, event_type="message.delta")
+    await _until(lambda: "message.delta" in seen)
+    assert nxt.sessions["slow"].event_stream.execution["admission_id"] == slow["admission_id"]
+    settle_session_input(owner.db, epoch=owner.epoch, admission_id=slow["admission_id"],
+                         generation=slow["generation"], outcome="completed")
+    await asyncio.sleep(0.2)
+    with slow_live.event_stream.lock:
+        slow_live.event_stream.publish("slow", {"text": "almost done"}, event_type="message.complete")
+    await _until(lambda: "message.complete" in seen)
+    assert nxt.sessions["slow"].event_stream.execution == {}  # it shows as idle there
+    await asyncio.wait_for(carry, 5.0)
+    assert carry.result() is True
+    import os
+    os.close(runner._turn_carry.lock_fd)  # the carrier process exits
+    await asyncio.wait_for(watch, 5.0)
+    assert turn_carry_record(owner.db) is None
+
+
+@pytest.mark.asyncio
+async def test_the_next_gateway_does_not_touch_a_session_the_carrier_runs(owner, tmp_path):
+    import fcntl
+    import os
+    from hermes_state_runtime import begin_turn_carry
+    row, _live, _agent = _claimed_turn(owner, "busy")
+    begin_turn_carry(owner.db, epoch=owner.epoch, record={"turns": {}})
+    fd = os.open(turn_carry.lock_path(tmp_path), os.O_RDWR | os.O_CREAT, 0o600)
+    fcntl.flock(fd, fcntl.LOCK_EX)
+    try:
+        carrying = turn_carry.live_carry_epoch(owner.db)
+        assert carrying == owner.epoch
+        new_epoch = begin_runtime_epoch(owner.db, instance_id="second")
+        assert recover_session_inputs(owner.db, epoch=new_epoch, keep_epoch=carrying) == 0
+        assert get_session_admission(owner.db, admission_id=row["admission_id"])["status"] == "started"
+        # New input for that conversation queues behind the carried turn; nothing is claimed.
+        admit_session_input(owner.db, epoch=new_epoch, principal_id="p", session_id="busy", request_id="r2",
+                            payload={"text": "next"})
+        assert claim_session_input(owner.db, epoch=new_epoch, session_id="busy") is None
+        # The carrier settles its own claim under its old epoch; any other stale writer is still refused.
+        settle_session_input(owner.db, epoch=owner.epoch, admission_id=row["admission_id"],
+                             generation=row["generation"], outcome="completed")
+        with pytest.raises(RuntimeStoreError):
+            admit_session_input(owner.db, epoch=owner.epoch, principal_id="p", session_id="busy",
+                                request_id="r3", payload={"text": "late"})
+        assert claim_session_input(owner.db, epoch=new_epoch, session_id="busy")["request_id"] == "r2"
+    finally:
+        os.close(fd)
+    # Once the carrier is gone its record no longer protects anything.
+    assert turn_carry.live_carry_epoch(owner.db) is None
+
