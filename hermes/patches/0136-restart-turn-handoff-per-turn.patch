diff --git a/gateway/turn_carry.py b/gateway/turn_carry.py
new file mode 100644
index 00000000..4b9400c0
--- /dev/null
+++ b/gateway/turn_carry.py
@@ -0,0 +1,893 @@
+"""``gateway.restart_turn_handoff_per_turn`` (false = off): each running turn moves to the next gateway at its
+own step boundary, while the next gateway already serves everything else.
+
+``gateway.restart_turn_handoff_boundary`` (0131) waits on the old gateway until every running turn reached a
+boundary, then the next gateway takes the profile over and resumes them all at once: a turn that reached its
+boundary early waits for the slowest one (up to ``restart_turn_handoff_wait_seconds``), and new input and API
+runs wait for the takeover. With this key both gateways serve for a while:
+
+The old gateway (the *carrier*), at the restart:
+
+* asks every running turn to stop at its next step boundary, hands a turn parked on its own clarify or
+  approval over at once (0131's withdraw), closes admission and asks the tool workers of the running turns to
+  yield (a foreground terminal command moves to the background, so the process handoff takes it along);
+* hands background subagents and processes over as a restart stop does, stops cron, and records itself as
+  the carrier of its claims in state.db (``hermes_state_runtime.CARRY_KEY``, its runtime epoch and turns) and
+  holds ``$HERMES_HOME/.turn-carry.lock`` (flock) for the rest of its life;
+* then releases the profile (PID file, lock, host role, socket tickets) and relays its listeners to the next
+  gateway (``gateway.restart_listener_relay_seconds``; the API server's port too, for the whole carry), while
+  it keeps running only the turns it had claimed;
+* each of those turns ends at its own boundary: it is handed off with the carried epoch fence
+  (``_epoch(..., carried=True)``: only the carrier, only its own claims) and the next gateway resumes it at
+  once; a turn whose model call is the last one completes here and is settled here; an API run finishes here
+  on its open HTTP connection. Every frame those turns publish is written to
+  ``$HERMES_HOME/.turn-carry/<epoch>.events`` for the next gateway to relay;
+* ``gateway.restart_turn_carry_ceiling_seconds`` after the restart, a turn still running is stopped the
+  0048 way (``restart_turn_handoff``); then the stop runs as before and the process exits.
+
+The next gateway:
+
+* boots as soon as the profile is released; its startup recovery leaves the carrier's started claims alone
+  (``recover_session_inputs(keep_epoch=...)``) while the carrier's lock is held, and its claims never take a
+  session whose claim is still started, so it never runs a turn the carrier runs;
+* relays the carrier's frames to its own viewers (the hub's socket now talks to it): the turn shows as
+  running, its deltas, tool calls and prompts arrive as if it ran here, a prompt it raised is answerable here
+  (the answer goes to the carrier), and Stop and steer reach the carrier's turn
+  (``$HERMES_HOME/.turn-carry/<epoch>.control``);
+* within ``POLL_S`` of a handoff claims the requeued admission and resumes the turn (0131's resume record);
+* once the carrier exited (its lock is free) it settles what the carrier left the 0048 way, reattaches the
+  processes the carrier handed over late, and drops the carry record.
+"""
+from __future__ import annotations
+
+import asyncio
+import json
+import logging
+import os
+import time
+from pathlib import Path
+
+logger = logging.getLogger(__name__)
+
+LOCK_NAME = ".turn-carry.lock"
+RELAY_DIR = ".turn-carry"
+# How often the next gateway reads the carrier's frames and its handoffs, and the carrier its controls.
+POLL_S = 0.05
+# How long the frames of a turn that ended on the carrier are still relayed after its settlement.
+ENDING_RELAY_S = 5.0
+# How long the carrier waits, before it releases the profile, for the tool rounds of its turns to end (a foreground
+# terminal command was asked to move to the background first). A tool call on a device connection must not be in
+# flight when that connection moves to the next gateway; any other tool call still running after this goes on here.
+YIELD_SETTLE_S = 5.0
+# Platforms whose running turns can be carried: their viewers reach the next gateway (LOCAL) or their run
+# finishes on its own HTTP connection here (API_SERVER). A turn of any other platform makes the restart fall back
+# to restart_turn_handoff_boundary's single handover.
+_CARRIED_PLATFORMS = ("local", "api_server")
+
+_released = False
+
+
+def released() -> bool:
+    """This process released the profile to the next gateway and only carries its in-flight turns: nothing
+    of the profile's process-level state (PID file, runtime status, markers) is its to write any more."""
+    return _released
+
+
+def configured(runner) -> bool:
+    cfg = getattr(runner, "config", None)
+    return bool(getattr(cfg, "restart_turn_handoff", False) and getattr(cfg, "restart_turn_handoff_boundary", False)
+                and getattr(cfg, "restart_turn_handoff_per_turn", False))
+
+
+def enabled(runner) -> bool:
+    from gateway import turn_boundary
+    return bool(turn_boundary.enabled(runner) and configured(runner))
+
+
+def ceiling_seconds(runner) -> float:
+    try:
+        return max(0.0, float(getattr(getattr(runner, "config", None), "restart_turn_carry_ceiling_seconds", 1080.0)))
+    except (TypeError, ValueError):
+        return 1080.0
+
+
+def _home_of(db) -> Path:
+    return Path(db.db_path).resolve().parent
+
+
+def lock_path(home) -> Path:
+    return Path(home) / LOCK_NAME
+
+
+def events_path(home, epoch) -> Path:
+    return Path(home) / RELAY_DIR / f"{int(epoch)}.events"
+
+
+def control_path(home, epoch) -> Path:
+    return Path(home) / RELAY_DIR / f"{int(epoch)}.control"
+
+
+def carrier_alive(home) -> bool:
+    """Whether a carrier holds ``.turn-carry.lock`` in *home* (a flock: it ends with that process)."""
+    import fcntl
+    path = lock_path(home)
+    try:
+        fd = os.open(path, os.O_RDONLY)
+    except FileNotFoundError:
+        return False
+    except OSError:
+        return True  # unreadable: never treat a live carrier's claims as lost
+    try:
+        try:
+            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
+        except BlockingIOError:
+            return True
+        except OSError:
+            return True
+        fcntl.flock(fd, fcntl.LOCK_UN)
+        return False
+    finally:
+        os.close(fd)
+
+
+def live_carry_epoch(db) -> int | None:
+    """At startup: the runtime epoch of a carrier that still runs its claims, or None."""
+    from hermes_state_runtime import turn_carry_record
+    record = turn_carry_record(db)
+    if not record or type(record.get("epoch")) is not int:
+        return None
+    return record["epoch"] if carrier_alive(_home_of(db)) else None
+
+
+# ── the carrier (the gateway that restarts) ──────────────────────────────────────────────────────────────
+
+
+class _Carry:
+    def __init__(self, runner, authority, turns, home):
+        self.runner, self.authority, self.home = runner, authority, home
+        self.epoch = authority.epoch
+        self.turns = {t.admission_id: t for t in turns}
+        self.done: set[str] = set()
+        self.started = time.monotonic()
+        self.events = None
+        self.control_offset = 0
+        self.lock_fd = None
+        self.api_relay = None
+
+
+def _platform(turn) -> str:
+    source = getattr(turn.live, "source", None)
+    platform = getattr(source, "platform", None)
+    return str(getattr(platform, "value", platform) or "")
+
+
+def _ineligible(runner, turns) -> str | None:
+    """Why this restart cannot carry its turns (it then hands them over the 0131 way), or None."""
+    from gateway import turn_handoff
+    from gateway.session_authorities import all_authorities
+    if len(all_authorities(runner)) != 1:
+        return "the gateway serves several profiles"
+    if len(turn_handoff.running_turns(runner)) != len(turns):
+        return "a turn runs in a managed worker"
+    try:
+        cron = int(runner._active_cron_job_count()) - int(runner._restart_safe_cron_count())
+    except Exception:
+        cron = 0
+    if cron > 0:
+        return "a cron job runs in this process"
+    for turn in turns:
+        if _platform(turn) not in _CARRIED_PLATFORMS:
+            return f"a turn runs on {_platform(turn) or 'an unknown platform'}"
+    carried = {id(t.agent) for t in turns}
+    items = getattr(runner, "_running_agent_items", None)
+    from gateway.run import _AGENT_PENDING_SENTINEL
+    for _key, agent in (items() if callable(items) else []):
+        if agent is not None and agent is not _AGENT_PENDING_SENTINEL and id(agent) not in carried:
+            return "a turn runs outside a canonical session"
+    return None
+
+
+async def carry_restart(runner) -> bool:
+    """The restart wait with the key: release the profile now and carry the running turns to their own
+    boundaries. False when this restart cannot carry them (the caller falls back to 0131)."""
+    from gateway import turn_boundary
+    from gateway.session_authorities import all_authorities
+    from agent import turn_boundary_handoff as boundary
+    turns = turn_boundary._turns(runner)
+    reason = _ineligible(runner, turns)
+    if reason is not None:
+        logger.info("Restart: turns not carried (%s); handing them over at their boundaries first "
+                    "(gateway.restart_turn_handoff_per_turn)", reason)
+        return False
+    authority = all_authorities(runner)[0]
+    from gateway.run import get_hermes_home
+    carry = _Carry(runner, authority, turns, get_hermes_home())
+    runner._turn_carry = carry
+    for turn in turns:
+        if _platform(turn) != "api_server":  # an API turn finishes here, on its own HTTP connection
+            boundary.request(turn.agent)
+    for turn in turns:
+        if turn_boundary._parked_prompts(turn):
+            try:
+                await turn_boundary._withdraw(turn)
+            except Exception:
+                logger.warning("Could not hand off the parked turn of %s", turn.session_id, exc_info=True)
+    from gateway.drain_control import begin_restart_drain
+    begin_restart_drain(runner)
+    await _yield_tools(carry)
+    await _hand_off_background(runner)
+    await _stop_cron(runner)
+    await _disconnect_messaging(runner)
+    await _record(carry)
+    _mirror(carry)
+    await _release(carry)
+    await _carry_turns(carry)
+    return True
+
+
+async def _yield_tools(carry) -> None:
+    """A foreground terminal command of a carried turn moves to the background now: its device or remote shell
+    reconnects to the next gateway, which reattaches the process (``terminal.process_handoff_backends``)."""
+    asked = []
+    for turn in carry.turns.values():
+        request = getattr(turn.agent, "request_tool_yield", None)
+        if callable(request):
+            try:
+                if request():
+                    asked.append(turn.agent)
+            except Exception:
+                logger.debug("Tool yield request failed", exc_info=True)
+    deadline = time.monotonic() + YIELD_SETTLE_S
+    while time.monotonic() < deadline:
+        if not any(getattr(t.agent, "_executing_tools", False) for t in carry.turns.values()):
+            break
+        await asyncio.sleep(POLL_S)
+    if asked:
+        logger.info("Restart: asked the tool calls of %d carried turn(s) to move to the background", len(asked))
+
+
+async def _disconnect_messaging(runner) -> None:
+    """Platform connections (a bot's polling, its token lock) belong to the next gateway now. The local adapter
+    (the carried turns deliver through it) and the API server (its open runs finish here) stay."""
+    from gateway.config import Platform
+    for platform, adapter in list((getattr(runner, "adapters", None) or {}).items()):
+        if platform in (Platform.LOCAL, Platform.API_SERVER):
+            continue
+        try:
+            await runner._bounded_adapter_teardown(adapter, platform)
+        except Exception:
+            logger.warning("Could not disconnect %s before the carry", platform, exc_info=True)
+        runner.adapters.pop(platform, None)
+
+
+async def _hand_off_background(runner) -> None:
+    from gateway.run_shutdown import GatewayShutdownMixin
+    ctx = GatewayShutdownMixin._StopContext(deferred_count=lambda: 0)
+    ctx.started_at = time.monotonic()
+    for step in (lambda: GatewayShutdownMixin._stop_hand_off_delegations(runner, ctx),
+                 lambda: GatewayShutdownMixin._stop_hand_off_processes(runner)):
+        try:
+            await step()
+        except Exception:
+            logger.warning("Background handoff before the carry failed", exc_info=True)
+
+
+async def _stop_cron(runner) -> None:
+    stop = getattr(runner, "_cron_stop_event", None)
+    if stop is not None:
+        stop.set()
+    provider = getattr(runner, "_cron_provider", None)
+    if provider is not None:
+        from gateway.run import _stop_cron_provider
+        await asyncio.to_thread(_stop_cron_provider, provider)
+
+
+async def _record(carry) -> None:
+    import fcntl
+    from hermes_state_runtime import begin_turn_carry
+    path = lock_path(carry.home)
+    fd = os.open(path, os.O_RDWR | os.O_CREAT, 0o600)
+    fcntl.flock(fd, fcntl.LOCK_EX)  # held until this process exits
+    carry.lock_fd = fd
+    (Path(carry.home) / RELAY_DIR).mkdir(mode=0o700, exist_ok=True)
+    for path in (events_path(carry.home, carry.epoch), control_path(carry.home, carry.epoch)):
+        os.close(os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600))
+    carry.events = open(events_path(carry.home, carry.epoch), "a", encoding="utf-8")  # noqa: SIM115
+    record = {"pid": os.getpid(), "since": time.time(),
+              "turns": {aid: {"session_id": t.session_id, "generation": t.generation}
+                        for aid, t in carry.turns.items()}}
+    await asyncio.to_thread(begin_turn_carry, carry.authority.db, epoch=carry.epoch, record=record)
+
+
+def _write_frame(carry, params) -> None:
+    line = json.dumps(params, ensure_ascii=False, default=str)
+    carry.events.write(line + "\n")
+    carry.events.flush()
+
+
+def _mirror(carry) -> None:
+    """Every frame of a carried session goes to the events file; the prompts already open go first."""
+    for turn in carry.turns.values():
+        stream = turn.live.event_stream
+        with stream.lock:
+            stream.mirror = lambda params, _c=carry: _write_frame(_c, params)
+            for _pid, (_route, prompt) in list(turn.live.controls.pending.items()):
+                _write_frame(carry, {"type": prompt["kind"] + ".request", "session_id": turn.session_id,
+                                     "payload": prompt, "background": _pid in turn.live.controls.background})
+
+
+async def _release(carry) -> None:
+    """Give the profile to the next gateway: PID file, tickets, lock, host role; then the listeners relay."""
+    global _released
+    runner = carry.runner
+    from gateway.run_bootstrap import _export_tickets_for_successor, _listener_relay_target
+    from gateway.status import remove_pid_file
+    relay_to = _listener_relay_target_for(runner, _listener_relay_target)
+    _export_tickets_for_successor(runner)
+    await _stop_api_listening(runner, carry)
+    remove_pid_file()
+    from gateway.runtime_ownership import process_ownership
+    for home in process_ownership.homes:
+        process_ownership.release(home)
+    _released = True
+    try:
+        from gateway import host_rendezvous as hr
+        hr.release_role(hr.ROLE_GATEWAY)
+    except Exception:
+        logger.debug("Host gateway role release failed", exc_info=True)
+    logger.info("Restart: profile released to the next gateway; carrying %d running turn(s) to their step "
+                "boundaries (gateway.restart_turn_handoff_per_turn)", len(carry.turns))
+    from gateway.run_shutdown import GatewayShutdownMixin
+    GatewayShutdownMixin._begin_listener_handover(runner)
+    if getattr(runner, "_listener_handover", None):
+        ctx = GatewayShutdownMixin._StopContext(deferred_count=lambda: 0)
+        ctx.started_at = time.monotonic()
+        await GatewayShutdownMixin._stop_end_listener_reads(runner, ctx)
+        runner._carry_listener_task = asyncio.ensure_future(runner.stop_handover_listener(relay_to))
+
+
+def _listener_relay_target_for(runner, read):
+    try:
+        if not getattr(runner, "_listener_handover", None):
+            from gateway.run_shutdown import GatewayShutdownMixin
+            GatewayShutdownMixin._begin_listener_handover(runner)
+        return read(runner)
+    except Exception:
+        logger.debug("No listener relay target", exc_info=True)
+        return None
+
+
+async def _stop_api_listening(runner, carry) -> None:
+    """The API server stops accepting here; the requests and runs already open finish on their own connections,
+    and every new request (a new connection, or one more request on a kept-alive connection) goes to the next
+    gateway's API server (``api_forward_middleware``). When the next gateway runs in another network namespace
+    (the new pod of a rolling update) the port keeps accepting and relays new connections to it, so a client the
+    Service still routes here is served there; on the same host the next gateway binds the port itself."""
+    import socket
+    global _api_target
+    from gateway.config import Platform
+    adapter = (getattr(runner, "adapters", None) or {}).get(Platform.API_SERVER)
+    site = getattr(adapter, "_site", None)
+    if site is None:
+        return
+    port = int(getattr(adapter, "_port", 0) or 0)
+    successor = None
+    try:
+        from gateway.listener_relay import successor_target
+        from gateway.run import get_hermes_home
+        from gateway.run_bootstrap import STANDBY_MARKER
+        successor = successor_target(get_hermes_home() / STANDBY_MARKER)
+    except Exception:
+        logger.debug("No API relay target", exc_info=True)
+    if port:
+        host = getattr(adapter, "_host", None) or "127.0.0.1"
+        _api_target = (successor[0], port) if successor is not None else (
+            "127.0.0.1" if host in ("0.0.0.0", "", "::") else host, port)
+    sock = None
+    if successor is not None and port:
+        try:
+            listening = list(getattr(getattr(site, "_server", None), "sockets", None) or ())
+            if listening:
+                sock = socket.socket(fileno=os.dup(listening[0].fileno()))
+        except Exception:
+            logger.debug("API listener could not be kept for the relay", exc_info=True)
+            sock = None
+    try:
+        await site.stop()
+        adapter._site = None
+    except Exception:
+        logger.warning("API server did not stop accepting before the carry", exc_info=True)
+    if sock is not None:
+        from gateway.listener_relay import relay_listener
+        sock.setblocking(False)
+        carry.api_relay = asyncio.ensure_future(relay_listener(sock, _api_target, ceiling_seconds(runner)))
+        logger.info("API port relays new connections to the next gateway at %s:%d", *_api_target)
+
+
+_api_target: tuple[str, int] | None = None
+# How long a forwarded API request waits for the next gateway's API server to listen.
+API_FORWARD_CONNECT_S = 30.0
+_HOP_HEADERS = frozenset({"connection", "keep-alive", "proxy-authenticate", "proxy-authorization", "te", "trailers",
+                          "transfer-encoding", "upgrade", "host", "content-length"})
+
+
+def _local_run(request) -> bool:
+    """A request about a run this carrier still runs (its events, status or stop) stays here."""
+    parts = request.path.strip("/").split("/")
+    if len(parts) >= 3 and parts[0] == "v1" and parts[1] == "runs":
+        from gateway.config import Platform
+        from gateway.run import _gateway_runner_ref
+        runner = _gateway_runner_ref()
+        adapter = (getattr(runner, "adapters", None) or {}).get(Platform.API_SERVER) if runner else None
+        statuses = getattr(adapter, "_run_statuses", None) or {}
+        return parts[2] in statuses
+    return False
+
+
+async def _forward(request, target):
+    import aiohttp
+    from aiohttp import web
+    url = f"http://{target[0]}:{target[1]}{request.rel_url}"
+    headers = {k: v for k, v in request.headers.items() if k.lower() not in _HOP_HEADERS}
+    body = await request.read()
+    loop = asyncio.get_running_loop()
+    deadline = loop.time() + API_FORWARD_CONNECT_S
+    session = aiohttp.ClientSession(timeout=aiohttp.ClientTimeout(total=None, sock_connect=2))
+    try:
+        while True:
+            try:
+                upstream = await session.request(request.method, url, headers=headers, data=body,
+                                                 allow_redirects=False)
+                break
+            except aiohttp.ClientConnectorError:
+                if loop.time() >= deadline:
+                    raise
+                await asyncio.sleep(0.1)
+        async with upstream:
+            response = web.StreamResponse(status=upstream.status, reason=upstream.reason)
+            for key, value in upstream.headers.items():
+                if key.lower() not in _HOP_HEADERS:
+                    response.headers.add(key, value)
+            await response.prepare(request)
+            async for chunk in upstream.content.iter_any():
+                await response.write(chunk)
+            await response.write_eof()
+            return response
+    finally:
+        await session.close()
+
+
+def api_forward_middleware():
+    """``gateway.restart_turn_handoff_per_turn``: on a carrier, every API request but those about its own open
+    runs is served by the next gateway, so API clients succeed throughout the restart (a kept-alive connection
+    to the old gateway included)."""
+    from aiohttp import web
+
+    @web.middleware
+    async def forward(request, handler):
+        target = _api_target
+        if not _released or target is None or _local_run(request):
+            return await handler(request)
+        try:
+            return await _forward(request, target)
+        except Exception:
+            logger.warning("Could not forward an API request to the next gateway", exc_info=True)
+            return await handler(request)
+    return forward
+
+
+def _api_live(runner) -> int:
+    try:
+        return int(runner._active_api_run_count())
+    except Exception:
+        return 0
+
+
+async def _carry_turns(carry) -> None:
+    """Run until every carried turn handed off or ended (and every open API run finished), or the ceiling."""
+    from agent import turn_boundary_handoff as boundary
+    from gateway import turn_boundary
+    from hermes_state_runtime import get_session_admission
+    runner = carry.runner
+    deadline = carry.started + ceiling_seconds(runner)
+    last_log = 0.0
+    while True:
+        await _apply_controls(carry)
+        for turn in turn_boundary._turns(runner):
+            if turn.admission_id in carry.turns and turn_boundary._parked_prompts(turn):
+                try:
+                    await turn_boundary._withdraw(turn)
+                except Exception:
+                    logger.warning("Could not hand off the parked turn of %s", turn.session_id, exc_info=True)
+        for aid in list(set(carry.turns) - carry.done):
+            row = await asyncio.to_thread(get_session_admission, carry.authority.db, admission_id=aid)
+            if row is None or row["status"] != "started" or row["owner_epoch"] != carry.epoch:
+                carry.done.add(aid)
+                logger.info("Carried turn of %s %s after %.1fs", carry.turns[aid].session_id,
+                            "handed over" if (row or {}).get("status") == "queued" else "ended",
+                            time.monotonic() - carry.started)
+        left = set(carry.turns) - carry.done
+        api = _api_live(runner)
+        now = time.monotonic()
+        if not left and not api:
+            break
+        if now >= deadline:
+            logger.warning("Restart: %d carried turn(s) and %d API run(s) still running at the ceiling of %.0fs; "
+                           "stopping them (gateway.restart_turn_carry_ceiling_seconds)", len(left), api,
+                           ceiling_seconds(runner))
+            for aid in left:
+                boundary.cancel(carry.turns[aid].agent)
+            break
+        if now - last_log >= 30.0:
+            logger.info("Restart: carrying %d turn(s) and %d API run(s) to their ends", len(left), api)
+            last_log = now
+        await asyncio.sleep(POLL_S)
+    # The listeners relay to the next gateway for their window (gateway.restart_listener_relay_seconds), so a
+    # client routed here before the new pod is ready still reaches it; the API port relays as long.
+    listener = getattr(runner, "_carry_listener_task", None)
+    if listener is not None:
+        try:
+            await listener
+        except Exception:
+            logger.debug("Listener relay ended with an error", exc_info=True)
+    if carry.api_relay is not None:
+        carry.api_relay.cancel()
+        await asyncio.gather(carry.api_relay, return_exceptions=True)
+
+
+async def _apply_controls(carry) -> None:
+    """Stop, steer and prompt answers the next gateway forwarded for a carried turn."""
+    path = control_path(carry.home, carry.epoch)
+    try:
+        with open(path, encoding="utf-8") as fh:
+            fh.seek(carry.control_offset)
+            chunk = fh.read()
+    except OSError:
+        return
+    if not chunk:
+        return
+    complete = chunk[:chunk.rfind("\n") + 1]
+    carry.control_offset += len(complete.encode("utf-8"))
+    for line in complete.splitlines():
+        try:
+            op = json.loads(line)
+            _apply(carry, op)
+        except Exception:
+            logger.warning("Could not apply a forwarded control", exc_info=True)
+
+
+def _carried_turn(carry, session_id, generation=None):
+    for turn in carry.turns.values():
+        if turn.session_id == session_id and (generation is None or turn.generation == generation):
+            return turn
+    return None
+
+
+def _apply(carry, op) -> None:
+    turn = _carried_turn(carry, op.get("session_id"))
+    if turn is None:
+        return
+    kind = op.get("op")
+    if kind == "interrupt" and op.get("generation") == turn.generation:
+        from agent.interrupt_compat import request_hard_interrupt
+        from agent import turn_boundary_handoff as boundary
+        boundary.cancel(turn.agent)  # a Stop ends the turn here; it is not handed over
+        request_hard_interrupt(turn.agent)
+    elif kind in ("steer", "redirect") and op.get("generation") == turn.generation:
+        method = getattr(turn.agent, kind, None)
+        if callable(method):
+            method(str(op.get("text") or ""))
+    elif kind == "respond":
+        field = "answer" if op.get("kind") == "clarify" else "choice"
+        turn.live.controls.respond(turn.session_id, turn.generation, op.get("prompt_id"),
+                                   {field: op.get("value")}, kind=op.get("kind") or "approval",
+                                   prune_generation=turn.generation)
+
+
+# ── the next gateway ─────────────────────────────────────────────────────────────────────────────────────
+
+
+class _Remote:
+    """The next gateway's view of a carrier: its turns, the frames read so far and the controls it sends."""
+
+    def __init__(self, runner, authority, record, home):
+        self.runner, self.authority, self.home = runner, authority, home
+        self.epoch = record["epoch"]
+        self.turns = {aid: dict(t) for aid, t in (record.get("turns") or {}).items()}
+        self.offset = 0
+        self.pending = b""
+        self.open = {aid for aid in self.turns}
+        # A turn that ended on the carrier: its last frames (the reply's message.complete is published right
+        # after the settlement commits) are still relayed for a moment.
+        self.ending: dict[str, float] = {}
+        self.prompts: dict[str, set] = {}
+
+    def session_turn(self, session_id, *, ending=False):
+        for aid in (*self.open, *(self.ending if ending else ())):
+            if self.turns[aid]["session_id"] == session_id:
+                return aid, self.turns[aid]
+        return None, None
+
+    def send(self, op: dict) -> None:
+        line = json.dumps(op, ensure_ascii=False, default=str) + "\n"
+        fd = os.open(control_path(self.home, self.epoch), os.O_WRONLY | os.O_APPEND | os.O_CREAT, 0o600)
+        try:
+            os.write(fd, line.encode("utf-8"))
+        finally:
+            os.close(fd)
+
+
+def _remote(authority) -> _Remote | None:
+    return getattr(authority, "_turn_carrier", None)
+
+
+def start_watch(runner) -> bool:
+    """After the startup recovery: watch a live carrier's turns (no-op without one). True when watching."""
+    from gateway.session_authorities import serving_authorities
+    from hermes_state_runtime import turn_carry_record
+    if not configured(runner):
+        return False
+    for authority in serving_authorities(runner):
+        record = turn_carry_record(authority.db)
+        home = _home_of(authority.db)
+        if not record or type(record.get("epoch")) is not int or record["epoch"] == authority.epoch:
+            continue
+        remote = _Remote(runner, authority, record, home)
+        authority._turn_carrier = remote
+        task = asyncio.ensure_future(_watch(remote))
+        retain = getattr(runner, "_retain_background_task", None)
+        if callable(retain):
+            retain(task)
+        logger.info("Carrying gateway (epoch %d) still runs %d turn(s); relaying them here "
+                    "(gateway.restart_turn_handoff_per_turn)", remote.epoch, len(remote.open))
+        return True
+    return False
+
+
+async def _watch(remote: _Remote) -> None:
+    try:
+        for aid in list(remote.open):
+            _live(remote.authority, remote.turns[aid]["session_id"])
+        while True:
+            _relay_frames(remote)
+            await _pick_up(remote)
+            if not await asyncio.to_thread(carrier_alive, remote.home):
+                _relay_frames(remote)
+                await _pick_up(remote)
+                await _finish(remote)
+                return
+            await asyncio.sleep(POLL_S)
+    except asyncio.CancelledError:
+        raise
+    except Exception:
+        logger.exception("Relay of the carrying gateway's turns failed")
+
+
+def _live(authority, session_id):
+    live = (getattr(authority, "sessions", None) or {}).get(session_id)
+    if live is not None:
+        return live
+    try:
+        from gateway.session_local_recovery import restore_local_session
+        restore_local_session(authority, session_id)
+    except Exception:
+        logger.debug("Carried session %s not restored here yet", session_id, exc_info=True)
+    return (getattr(authority, "sessions", None) or {}).get(session_id)
+
+
+def _relay_frames(remote: _Remote) -> None:
+    path = events_path(remote.home, remote.epoch)
+    try:
+        with open(path, "rb") as fh:
+            fh.seek(remote.offset)
+            chunk = fh.read()
+    except OSError:
+        return
+    if not chunk:
+        return
+    data = remote.pending + chunk
+    remote.offset += len(chunk)
+    cut = data.rfind(b"\n") + 1
+    remote.pending = data[cut:]
+    for line in data[:cut].splitlines():
+        try:
+            params = json.loads(line)
+        except ValueError:
+            continue
+        try:
+            _relay_one(remote, params)
+        except Exception:
+            logger.debug("Could not relay a carried frame", exc_info=True)
+
+
+def _relay_one(remote: _Remote, params: dict) -> None:
+    authority = remote.authority
+    session_id = params.get("session_id")
+    event_type = params.get("type")
+    payload = params.get("payload") if isinstance(params.get("payload"), dict) else {}
+    aid, turn = remote.session_turn(session_id, ending=True)
+    if turn is None:
+        return
+    running = aid in remote.open
+    live = _live(authority, session_id)
+    if live is None:
+        return
+    generation = turn["generation"]
+    stream, controls = live.event_stream, live.controls
+    from gateway.session_contract import SessionRef
+    with stream.lock:
+        if event_type == "session.info":
+            authority._publish_pending(SessionRef(authority.profile_id, session_id))
+            return
+        if event_type in ("approval.request", "clarify.request"):
+            pid = payload.get("prompt_id")
+            if not pid:
+                return
+            controls.pending[pid] = (None, dict(payload))
+            controls.background.add(pid)  # answerable whatever generation this gateway reads as running
+            controls.remote_responders[pid] = _forward_answer(remote, session_id, generation)
+            remote.prompts.setdefault(session_id, set()).add(pid)
+            stream.publish(session_id, payload, event_type=event_type)
+            return
+        if event_type in ("approval.settled", "clarify.settled"):
+            pid = payload.get("prompt_id")
+            if pid in controls.pending and pid in controls.remote_responders:
+                controls.pending.pop(pid, None)
+                controls.background.discard(pid)
+                controls.remote_responders.pop(pid, None)
+            remote.prompts.get(session_id, set()).discard(pid)
+            stream.publish(session_id, payload, event_type=event_type)
+            return
+        execution = {k: params[k] for k in ("authority_epoch", "execution_generation", "admission_id") if k in params}
+        if execution:
+            # Served by this gateway now: its viewers check frames against the epoch they attached under.
+            execution["authority_epoch"] = authority.epoch
+        if running and execution.get("execution_generation") == generation and execution.get("admission_id") == aid:
+            stream.execution = execution
+            stream.note_progress(generation, event_type, payload)
+            stream.publish(session_id, payload, event_type=event_type, execution=execution)
+            stream.note_reply(generation, event_type, payload)
+            stream.note_turn(generation, event_type, payload)
+        else:
+            stream.publish(session_id, payload, event_type=event_type, execution=execution or None)
+
+
+def _forward_answer(remote, session_id, generation):
+    def respond(kind, prompt_id, value):
+        remote.send({"op": "respond", "session_id": session_id, "generation": generation,
+                     "prompt_id": prompt_id, "kind": kind, "value": value})
+    return respond
+
+
+async def _pick_up(remote: _Remote) -> None:
+    """A carried turn the carrier handed off is claimed here now; one that ended clears its running state."""
+    from gateway import turn_boundary
+    from gateway.session_contract import SessionRef
+    from hermes_state_runtime import get_session_admission, resume_record
+    authority = remote.authority
+    now = time.monotonic()
+    for aid, until in list(remote.ending.items()):
+        if now >= until:
+            del remote.ending[aid]
+    for aid in list(remote.open):
+        row = await asyncio.to_thread(get_session_admission, authority.db, admission_id=aid)
+        if row is not None and row["status"] == "started" and row["owner_epoch"] == remote.epoch:
+            continue
+        remote.open.discard(aid)
+        if row is None or row["status"] != "queued":
+            remote.ending[aid] = now + ENDING_RELAY_S
+        session_id = remote.turns[aid]["session_id"]
+        live = _live(authority, session_id)
+        _clear_remote(remote, live, session_id)
+        if live is None:
+            continue
+        ref = SessionRef(authority.profile_id, session_id)
+        if row is not None and row["status"] == "queued":
+            record = await asyncio.to_thread(resume_record, authority.db, admission_id=aid)
+            if isinstance(record, dict):
+                turn_boundary._resuming.add(aid)
+                for prompt in record.get("prompts") or []:
+                    turn_boundary._register_waiter(prompt)
+                turn_boundary.show_record(authority, session_id, record)
+            logger.info("Carried turn of %s handed over; resuming it here", session_id)
+        try:
+            authority._publish_pending(ref)
+        except Exception:
+            logger.debug("Pending publish after a carried turn failed", exc_info=True)
+        authority._schedule(ref)
+
+
+def _clear_remote(remote: _Remote, live, session_id) -> None:
+    if live is None:
+        return
+    with live.event_stream.lock:
+        if any(live.event_stream.execution.get("admission_id") == aid for aid in remote.turns):
+            live.event_stream.execution = {}
+        for pid in remote.prompts.pop(session_id, set()):
+            if pid in live.controls.remote_responders:
+                live.controls.pending.pop(pid, None)
+                live.controls.background.discard(pid)
+                live.controls.remote_responders.pop(pid, None)
+
+
+async def _finish(remote: _Remote) -> None:
+    """The carrier exited: what it left running is lost work, continued the 0048 way; the processes it
+    handed over late are reattached here; the carry record goes."""
+    from gateway.session_contract import SessionRef
+    from hermes_state_runtime import end_turn_carry, recover_session_inputs
+    authority, runner = remote.authority, remote.runner
+    left = list(remote.open)
+    for aid in left:
+        session_id = remote.turns[aid]["session_id"]
+        _clear_remote(remote, _live(authority, session_id), session_id)
+    await asyncio.to_thread(recover_session_inputs, authority.db, epoch=authority.epoch)
+    try:
+        from gateway import turn_handoff
+        await turn_handoff.continue_handed_off_turns(runner, remote.home)
+    except Exception:
+        logger.warning("Continuation of the turns the carrier left failed", exc_info=True)
+    for aid in left:
+        try:
+            authority._schedule(SessionRef(authority.profile_id, remote.turns[aid]["session_id"]))
+        except Exception:
+            logger.debug("Schedule after the carrier left failed", exc_info=True)
+    await _reattach_processes(runner)
+    await asyncio.to_thread(end_turn_carry, authority.db, epoch=remote.epoch)
+    for path in (events_path(remote.home, remote.epoch), control_path(remote.home, remote.epoch)):
+        path.unlink(missing_ok=True)
+    authority._turn_carrier = None
+    logger.info("Carrying gateway exited (%d turn(s) left to the 0048 continuation)", len(left))
+
+
+async def _reattach_processes(runner) -> None:
+    try:
+        from tools.process_registry import process_registry
+        recovered = await asyncio.to_thread(process_registry.recover_from_checkpoint)
+        watchers = process_registry.pending_watchers
+        process_registry.pending_watchers = []
+        for watcher in watchers:
+            runner._spawn_supervised(lambda w=watcher: runner._run_process_watcher(w),
+                                     f"process_watcher:{watcher.get('session_id')}", restart=False)
+        if recovered:
+            logger.info("Reattached %d process(es) the carrying gateway handed over", recovered)
+    except Exception:
+        logger.warning("Reattach of the carrier's late process handoff failed", exc_info=True)
+
+
+def forward_interrupt(authority, ref, generation) -> bool:
+    """A Stop for a turn the carrier runs goes to it; True when forwarded."""
+    remote = _remote(authority)
+    if remote is None:
+        return False
+    aid, turn = remote.session_turn(ref.session_id)
+    if turn is None or turn["generation"] != generation:
+        return False
+    remote.send({"op": "interrupt", "session_id": ref.session_id, "generation": generation})
+    return True
+
+
+class _RemoteAgent:
+    """What ``steer_agent`` returns for a turn the carrier runs: its steer goes to the carrier."""
+
+    def __init__(self, remote, session_id, generation):
+        self._remote, self._session_id, self._generation = remote, session_id, generation
+
+    def steer(self, text) -> bool:
+        self._remote.send({"op": "steer", "session_id": self._session_id, "generation": self._generation,
+                           "text": text})
+        return True
+
+    def redirect(self, text) -> bool:
+        self._remote.send({"op": "redirect", "session_id": self._session_id, "generation": self._generation,
+                           "text": text})
+        return True
+
+
+def remote_agent(authority, ref, generation):
+    remote = _remote(authority)
+    if remote is None:
+        return None
+    aid, turn = remote.session_turn(ref.session_id)
+    if turn is None or turn["generation"] != generation:
+        return None
+    return _RemoteAgent(remote, ref.session_id, generation)
