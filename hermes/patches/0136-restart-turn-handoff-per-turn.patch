+@pytest.mark.asyncio
+async def test_prompts_and_stop_of_a_carried_turn_are_answerable_on_the_next_gateway(owner, tmp_path):
+    ownership = _reserve_profile(tmp_path)
+    row, live, agent = _claimed_turn(owner, "ask")
+    answers = []
+    agent.interrupts = 0
+
+    def hard_interrupt(*_a, **_k):
+        agent.interrupts += 1
+    agent.hard_interrupt = hard_interrupt
+    runner = _old_runner(owner)
+    carry = asyncio.ensure_future(turn_carry.carry_restart(runner))
+    await _until(turn_carry.released)
+    assert not ownership.owns(tmp_path)
+
+    nxt = _NextAuthority(owner.db)
+    nxt.sessions["ask"] = LiveSession(live.source, live.route)
+    from hermes_state_runtime import turn_carry_record
+    remote = turn_carry._Remote(SimpleNamespace(), nxt, turn_carry_record(owner.db), tmp_path)
+    nxt._turn_carrier = remote
+
+    # On the carrier, a subagent of the turn asks a question (its turn's own prompts are handed over at once).
+    with live.event_stream.lock:
+        live.controls.remote_responders["q1"] = lambda kind, pid, value: answers.append((kind, pid, value))
+        live.controls.background.add("q1")
+        live.controls.pending["q1"] = (None, {"kind": "clarify", "prompt_id": "q1",
+                                              "execution_generation": row["generation"], "question": "which?",
+                                              "choices": ["a", "b"], "multi_select": False})
+        live.event_stream.publish("ask", live.controls.pending["q1"][1], event_type="clarify.request")
+        live.event_stream.publish("ask", {"text": "thinking"}, event_type="message.delta")
+
+    # The next gateway relays both frames: the viewer sees the running turn and the open question there.
+    nxt_live = nxt.sessions["ask"]
+    await _until(lambda: (turn_carry._relay_frames(remote) or True) and "q1" in nxt_live.controls.pending)
+    snapshot = nxt_live.controls.snapshot("ask", row["generation"])
+    assert [p["prompt_id"] for p in snapshot] == ["q1"]
+    assert any(e for e in nxt_live.event_stream.turn_for(row["generation"]))
+    assert nxt_live.event_stream.execution["authority_epoch"] == nxt.epoch
+
+    assert nxt_live.controls.respond("ask", row["generation"], "q1", {"answer": "b"}, kind="clarify")["status"] == "resolved"
+    await _until(lambda: answers == [("clarify", "q1", "b")])
+
+    # A Stop on the next gateway reaches the carried turn.
+    from gateway.session_contract import SessionRef
+    assert turn_carry.forward_interrupt(nxt, SessionRef("default", "ask"), row["generation"]) is True
+    await _until(lambda: agent.interrupts == 1)
+    assert agent._handoff_boundary is False  # a stopped turn ends there; it is not handed over
+
+    settle_session_input(owner.db, epoch=owner.epoch, admission_id=row["admission_id"],
+                         generation=row["generation"], outcome="interrupted")
+    await asyncio.wait_for(carry, 5.0)
+    import os
+    os.close(runner._turn_carry.lock_fd)
+
