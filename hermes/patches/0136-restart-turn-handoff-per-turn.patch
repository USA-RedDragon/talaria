+@pytest.mark.asyncio
+async def test_an_api_request_on_a_kept_alive_connection_to_the_carrier_runs_on_the_next_gateway(monkeypatch):
+    """A client that keeps its connection to the old gateway's API server open sends its next request there: the
+    carrier forwards it to the next gateway (waiting for it to listen) instead of answering 503 draining."""
+    from aiohttp import ClientSession, web
+
+    async def old_handler(_request):
+        return web.json_response({"error": "Gateway is draining existing work; retry shortly."}, status=503)
+
+    async def new_handler(request):
+        return web.json_response({"who": "next", "body": await request.json()})
+    old_app = web.Application(middlewares=[turn_carry.api_forward_middleware()])
+    old_app.router.add_post("/v1/chat/completions", old_handler)
+    old_runner = web.AppRunner(old_app)
+    await old_runner.setup()
+    old_site = web.TCPSite(old_runner, "127.0.0.1", 0)
+    await old_site.start()
+    old_port = old_site._server.sockets[0].getsockname()[1]
+    new_app = web.Application()
+    new_app.router.add_post("/v1/chat/completions", new_handler)
+    new_runner = web.AppRunner(new_app)
+    await new_runner.setup()
+    probe = web.TCPSite(new_runner, "127.0.0.1", 0)
+    await probe.start()
+    new_port = probe._server.sockets[0].getsockname()[1]
+    await probe.stop()
+    try:
+        async with ClientSession() as http:
+            url = f"http://127.0.0.1:{old_port}/v1/chat/completions"
+            async with http.post(url, json={"n": 1}) as response:
+                assert response.status == 503  # before the restart released the profile: this gateway answers
+            monkeypatch.setattr(turn_carry, "_released", True)
+            monkeypatch.setattr(turn_carry, "_api_target", ("127.0.0.1", new_port))
+            pending = asyncio.ensure_future(http.post(url, json={"n": 2}))  # the same kept-alive connection
+            await asyncio.sleep(0.3)
+            assert not pending.done()  # waits for the next gateway's API server instead of failing
+            site = web.TCPSite(new_runner, "127.0.0.1", new_port)
+            await site.start()
+            response = await asyncio.wait_for(pending, 5.0)
+            assert response.status == 200 and await response.json() == {"who": "next", "body": {"n": 2}}
+            response.release()
+    finally:
+        await old_runner.cleanup()
+        await new_runner.cleanup()
+
