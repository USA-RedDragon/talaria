 from tools.approval import list_gateway_approvals, resolve_gateway_approval
 
 
+def _clarify_record(entry, prompt):
+    """What a settled question keeps for its card, as ``clarify.settled`` carries it: the question as it was
+    asked (so a viewer that never saw it can draw the card), how the wait ended and the answer with its time and
+    the client that gave it. ``outcome`` is ``answered`` / ``skipped`` / ``timed_out`` / ``cancelled``; ``answer``
+    is the text the user gave, or a JSON array of the picks of a multi-select question."""
+    from tools.clarify_gateway import CANCELLED, SKIPPED
+    response = getattr(entry, 'response', None)
+    if response == CANCELLED:
+        outcome = 'cancelled'
+    elif response == SKIPPED or (response == '' and getattr(entry, 'answered_at', 0)):
+        outcome = 'skipped'  # an empty answer is a skip (clarify.respond)
+    elif response in (None, ''):
+        outcome = 'timed_out'
+    else:
+        outcome = 'answered'
+    record = {'question': prompt.get('question', ''), 'choices': list(prompt.get('choices') or []),
+              'multi_select': bool(prompt.get('multi_select')), 'outcome': outcome}
+    if prompt.get('subagent'):
+        record['subagent'] = prompt['subagent']
+    if prompt.get('timeout_s') is not None:
+        record['timeout_s'] = prompt['timeout_s']
+    if outcome == 'answered':
+        record['answer'] = response
+    if getattr(entry, 'ended_at', 0):
+        record['ended_at'] = entry.ended_at
+    if outcome == 'answered':
+        record['answered_at'] = entry.answered_at
+        if entry.answered_via:
+            record['answered_via'] = entry.answered_via
+    return record
+
+
