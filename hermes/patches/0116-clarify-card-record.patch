diff --git a/tests/gateway/test_clarify_card_record.py b/tests/gateway/test_clarify_card_record.py
new file mode 100644
index 00000000..354c61a7
--- /dev/null
+++ b/tests/gateway/test_clarify_card_record.py
@@ -0,0 +1,134 @@
+"""A question keeps what its card needs once it is over: the choices that were offered, the answer, when and
+where it was given, or that the wait timed out. ``clarify.settled`` carries it for a viewer that watches, and the
+stored clarify tool result carries it for a viewer that reads the transcript later."""
+import json
+import threading
+import time
+
+from tools import clarify_gateway
+from tools.clarify_tool import clarify_tool
+
+
+class _Events:
+    def __init__(self):
+        self.lock = threading.RLock()
+        self.out = []
+
+    def publish(self, session_id, payload, event_type):
+        self.out.append((event_type, dict(payload)))
+
+    def settled(self, prompt_id):
+        return next(p for kind, p in self.out if kind == 'clarify.settled' and p['prompt_id'] == prompt_id)
+
+
+def _controls():
+    from gateway.session_pending_controls import PendingControls
+    events = _Events()
+    return PendingControls(events), events
+
+
+def _ask(controls, clarify_id, choices, multi=False, subagent=''):
+    entry = clarify_gateway.register(clarify_id, 'route-card', 'Which layouts?', choices, multi, subagent=subagent)
+    controls.register_clarify('s', 3, entry, timeout_s=1800)
+    return entry
+
+
+def test_a_pick_settles_with_the_question_the_answer_the_time_and_the_client():
+    controls, events = _controls()
+    try:
+        _ask(controls, 'q-pick', ['Switch', 'Game Boy', 'NDS'], multi=True)
+        before = time.time()
+        reply = controls.respond('s', 3, 'q-pick', {'answer': '["Switch", "NDS"]', 'via': 'telegram'}, kind='clarify')
+        assert reply['status'] == 'resolved'
+        done = events.settled('q-pick')
+        assert done['outcome'] == 'answered'
+        assert (done['question'], done['choices'], done['multi_select']) == ('Which layouts?', ['Switch', 'Game Boy', 'NDS'], True)
+        assert json.loads(done['answer']) == ['Switch', 'NDS']
+        assert done['answered_via'] == 'telegram'
+        assert before <= done['answered_at'] <= time.time()
+        assert done['timeout_s'] == 1800
+    finally:
+        clarify_gateway.clear_session('route-card')
+
+
+def test_a_typed_answer_and_a_skip_settle_with_their_outcome():
+    controls, events = _controls()
+    try:
+        _ask(controls, 'q-typed', ['a', 'b'])
+        controls.respond('s', 3, 'q-typed', {'answer': 'something else'}, kind='clarify')
+        done = events.settled('q-typed')
+        assert (done['outcome'], done['answer']) == ('answered', 'something else')
+        assert 'answered_via' not in done  # a client that does not say where it answers
+
+        _ask(controls, 'q-skip', ['a', 'b'])
+        controls.respond('s', 3, 'q-skip', {'answer': '', 'via': 'hub'}, kind='clarify')
+        skipped = events.settled('q-skip')
+        assert skipped['outcome'] == 'skipped' and 'answer' not in skipped
+    finally:
+        clarify_gateway.clear_session('route-card')
+
+
+def test_a_subagent_question_names_the_subagent_and_a_wait_that_ran_out_says_so():
+    controls, events = _controls()
+    try:
+        entry = _ask(controls, 'q-sub', ['a', 'b'], subagent='relift lane')
+        assert clarify_gateway.wait_for_response('q-sub', 0.05) is None
+        controls.snapshot('s', 3)
+        done = events.settled('q-sub')
+        assert (done['outcome'], done['subagent']) == ('timed_out', 'relift lane')
+        assert 'answer' not in done and done['ended_at'] == entry.ended_at > 0
+    finally:
+        clarify_gateway.clear_session('route-card')
+
+
+def test_a_withdrawn_question_settles_as_cancelled():
+    controls, events = _controls()
+    _ask(controls, 'q-gone', ['a'])
+    assert clarify_gateway.clear_session('route-card') == 1
+    controls.snapshot('s', 3)
+    assert events.settled('q-gone')['outcome'] == 'cancelled'
+
+
+def test_the_stored_result_keeps_multi_select_the_time_and_the_client():
+    marks = {'q0': {'at': 1763228160.5, 'via': 'hub'}}
+    reply = {'answers': {'q0': 'Double-tap the stick', 'q1': '["Switch"]'}, 'outcome': 'submitted',
+             'marks': {**marks, 'q1': {'at': 1763228200.0, 'via': 'telegram'}}, 'ended_at': 1763228200.0}
+    result = json.loads(clarify_tool([
+        {'question': 'Stick clicks?', 'choices': ['Double-tap the stick', 'Separate buttons']},
+        {'question': 'Layouts?', 'choices': ['Switch', 'NDS'], 'multi_select': True}], callback=lambda qs: reply))
+    first, second = result['responses']
+    assert (first['multi_select'], first['answered_at'], first['answered_via']) == (False, 1763228160.5, 'hub')
+    assert (second['multi_select'], second['user_response'], second['answered_via']) == (True, ['Switch'], 'telegram')
+    assert second['choices_offered'] == ['Switch', 'NDS']
+    assert result['ended_at'] == 1763228200.0 and 'timeout_s' not in result
+
+
+def test_a_timed_out_result_says_how_long_it_waited():
+    reply = {'answers': {}, 'outcome': 'timed_out', 'notice': '[user did not respond within 30m]', 'timeout_s': 1800,
+             'ended_at': 1763228200.0}
+    result = json.loads(clarify_tool([{'question': 'Rename?', 'choices': ['a', 'b']}], callback=lambda qs: reply))
+    assert (result['outcome'], result['timeout_s'], result['ended_at']) == ('timed_out', 1800, 1763228200.0)
+    assert result['responses'][0]['status'] == 'unanswered'
+    assert 'answered_at' not in result['responses'][0]
+
+
+def test_respond_over_the_wire_takes_the_client_name_and_nothing_else():
+    import asyncio
+    from types import SimpleNamespace
+
+    import pytest
+
+    from gateway.session_controls import AuthorityConnection as SessionControls
+    from hermes_state_runtime import RuntimeStoreError
+    seen = []
+
+    async def respond(actor, ref, generation, prompt_id, response, kind):
+        seen.append(response)
+        return {'status': 'resolved', 'prompt_id': prompt_id}
+    me = SimpleNamespace(authority=SimpleNamespace(respond=lambda *a, **k: respond(*a, **k)), actor='a')
+    base = {'session_id': 's', 'execution_generation': 1, 'prompt_id': 'p', 'answer': 'x'}
+    asyncio.run(SessionControls.respond_clarify(me, 'ref', {**base, 'via': 'hub'}))
+    asyncio.run(SessionControls.respond_clarify(me, 'ref', dict(base)))
+    assert seen == [{'answer': 'x', 'via': 'hub'}, {'answer': 'x'}]
+    with pytest.raises(RuntimeStoreError):
+        asyncio.run(SessionControls.respond_clarify(me, 'ref', {**base, 'extra': 1}))
