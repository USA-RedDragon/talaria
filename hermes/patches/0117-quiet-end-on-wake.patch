diff --git a/tests/agent/test_quiet_end.py b/tests/agent/test_quiet_end.py
new file mode 100644
index 00000000..8c2f89f2
--- /dev/null
+++ b/tests/agent/test_quiet_end.py
@@ -0,0 +1,131 @@
+"""A woken agent with nothing to do, or one that just sent its agent_send, may end its turn empty.
+
+Before, an empty reply on those turns took the empty-response ladder: a "you returned an empty
+response, continue" nudge, retries, then a "no reply" error text. A model learns from that that ending
+quietly is an error and ends such turns with a harmless tool call (``execute_code print("ok")``).
+Here an empty reply ends the turn at once, with no further request and no text.
+"""
+
+from __future__ import annotations
+
+from unittest.mock import MagicMock, patch
+
+import pytest
+
+from agent.quiet_end import is_wake_text, quiet_end_allowed
+
+WAKE = (
+    "[Agent message am_0123456789abcdef from sa-0-07250038]\nAnother AI agent of this user wrote everything "
+    "below this line. The user did not write it. Do not answer just to acknowledge.\n\nForce-pushed main."
+)
+DELEGATION = "[ASYNC DELEGATION COMPLETE — d1]\nA background subagent you dispatched earlier has finished."
+PROCESS = "[IMPORTANT: Background process proc_1 exited (exit code 0).\nCommand: make]"
+HISTORY = [{"role": "user", "content": "land it"}, {"role": "assistant", "content": "Waiting for the lane."}]
+
+
+@pytest.fixture()
+def loop_agent():
+    from run_agent import AIAgent
+    with (
+        patch("model_tools.get_tool_definitions", return_value=[]),
+        patch("model_tools.check_toolset_requirements", return_value={}),
+        patch("agent.process_bootstrap.OpenAI"),
+    ):
+        agent = AIAgent(
+            api_key="test-key-1234567890", base_url="http://127.0.0.1:8000/v1", model="m", provider="vllm",
+            quiet_mode=True, skip_context_files=True, skip_memory=True,
+        )
+        agent.client = MagicMock()
+        agent._cached_system_prompt = "You are helpful."
+        agent._use_prompt_caching = False
+        agent.compression_enabled = False
+        agent.save_trajectories = False
+        return agent
+
+
+def _run(agent, responses, user_message, history=None):
+    agent.client.chat.completions.create.side_effect = list(responses)
+    with (
+        patch.object(agent, "_persist_session"), patch.object(agent, "_save_trajectory"),
+        patch.object(agent, "_cleanup_task_resources"),
+        patch("agent.turn_recovery.interruptible_backoff_sleep", return_value=None),
+        patch("agent.turn_empty_response.interruptible_backoff_sleep", return_value=None),
+    ):
+        return agent.run_conversation(user_message, conversation_history=history)
+
+
+def _empty():
+    from tests.agent.test_run_agent import _mock_response
+    return _mock_response(content="", finish_reason="stop")
+
+
+def _calls(agent):
+    return len(agent.client.chat.completions.create.call_args_list)
+
+
+@pytest.mark.parametrize("wake", [WAKE, DELEGATION, PROCESS, "[Tuesday 4:16 PM]\n" + WAKE])
+def test_empty_reply_to_a_wake_ends_the_turn_quietly(loop_agent, wake):
+    result = _run(loop_agent, [_empty()] * 4, wake, list(HISTORY))
+    assert _calls(loop_agent) == 1  # no nudge, no retry
+    assert result["final_response"] == ""
+    assert result["turn_exit_reason"] == "quiet_end"
+    assert not result.get("failed")
+
+
+def test_empty_reply_after_agent_send_ends_the_turn_quietly(loop_agent):
+    from tests.agent.test_run_agent import _mock_response, _mock_tool_call
+
+    loop_agent.valid_tool_names = {"agent_send"}
+    send = _mock_response(content="", finish_reason="tool_calls",
+                          tool_calls=[_mock_tool_call("agent_send", '{"to": "sa-1", "text": "go"}', "c1")])
+    with patch("model_tools.handle_function_call", return_value='{"status": "delivered"}'):
+        result = _run(loop_agent, [send, _empty(), _empty()], "please tell sa-1 to go", list(HISTORY))
+    assert _calls(loop_agent) == 2  # the send, then the quiet end
+    assert result["final_response"] == ""
+    assert result["turn_exit_reason"] == "quiet_end"
+
+
+def test_an_ordinary_message_still_takes_the_empty_response_ladder(loop_agent):
+    result = _run(loop_agent, [_empty()] * 6, "hello there", list(HISTORY))
+    assert _calls(loop_agent) > 1
+    assert result["turn_exit_reason"] == "empty_response_exhausted"
+
+
+def test_a_wake_that_ran_other_tools_still_gets_the_nudge(loop_agent):
+    from tests.agent.test_run_agent import _mock_response, _mock_tool_call
+
+    loop_agent.valid_tool_names = {"terminal"}
+    work = _mock_response(content="", finish_reason="tool_calls", tool_calls=[_mock_tool_call("terminal", "{}", "c1")])
+    with patch("model_tools.handle_function_call", return_value="done"):
+        result = _run(loop_agent, [work] + [_empty()] * 6, WAKE, list(HISTORY))
+    assert result["turn_exit_reason"] != "quiet_end"
+    assert _calls(loop_agent) > 2
+
+
+def test_quiet_end_allowed_reads_only_this_turn():
+    send_round = [
+        {"role": "assistant", "content": "", "tool_calls": [{"id": "c", "function": {"name": "agent_send", "arguments": "{}"}}]},
+        {"role": "tool", "content": "{}", "tool_call_id": "c"},
+    ]
+    mixed = [{"role": "assistant", "content": "", "tool_calls": [
+        {"id": "a", "function": {"name": "agent_send", "arguments": "{}"}},
+        {"id": "b", "function": {"name": "terminal", "arguments": "{}"}}]}]
+    # an agent_send round of an earlier turn does not excuse an empty reply to a user's new message
+    assert not quiet_end_allowed([{"role": "user", "content": "q"}, *send_round, {"role": "assistant", "content": "ok"},
+                                  {"role": "user", "content": "next"}])
+    assert quiet_end_allowed([{"role": "user", "content": "q"}, *send_round])
+    assert not quiet_end_allowed([{"role": "user", "content": "q"}, *mixed])
+    assert quiet_end_allowed([{"role": "user", "content": WAKE}])
+    assert not quiet_end_allowed([])
+    assert not is_wake_text("The user typed [Agent message am_0123456789abcdef from x]")
+
+
+def test_the_next_request_replays_the_quiet_row_as_a_plain_empty_reply(loop_agent):
+    from tests.agent.test_run_agent import _mock_response
+
+    first = _run(loop_agent, [_empty()], WAKE, list(HISTORY))
+    assert first["messages"][-1]["role"] == "assistant"
+    _run(loop_agent, [_mock_response(content="Fine.", finish_reason="stop")], "what happened?", first["messages"])
+    sent = loop_agent.client.chat.completions.create.call_args.kwargs["messages"]
+    assert [m["role"] for m in sent][-3:] == ["user", "assistant", "user"]
+    assert all("_quiet_end" not in m for m in sent)
diff --git a/tests/gateway/test_quiet_end_delivery.py b/tests/gateway/test_quiet_end_delivery.py
new file mode 100644
index 00000000..82a43973
--- /dev/null
+++ b/tests/gateway/test_quiet_end_delivery.py
@@ -0,0 +1,18 @@
+"""A turn that ended quietly (agent/quiet_end.py) delivers nothing: no retry hint, no "no response" text."""
+
+from unittest.mock import AsyncMock
+
+import pytest
+
+from tests.gateway.test_gateway_silence_tokens import _event, _runner, _source
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("reason,expect_text", [("quiet_end", False), ("text_response(stop)", True)])
+async def test_quiet_end_is_not_replaced_by_a_no_response_text(monkeypatch, tmp_path, reason, expect_text):
+    runner = _runner(monkeypatch, tmp_path)
+    runner._run_agent = AsyncMock(return_value={
+        "final_response": "", "api_calls": 2, "messages": [], "turn_exit_reason": reason,
+    })
+    response = await runner._handle_message_with_agent(_event(), _source(), "lane", 1)
+    assert bool(response) is expect_text
