diff --git a/agent/quiet_end.py b/agent/quiet_end.py
new file mode 100644
index 00000000..84cefb5d
--- /dev/null
+++ b/agent/quiet_end.py
@@ -0,0 +1,78 @@
+"""A turn that has nothing to say may end with no text and no tool call.
+
+Two shapes end this way without being a model failure:
+
+* a wake: the turn's input is a message from another agent, a background process result or a
+  background subagent result, and the model has not run a tool yet. Whether to act on it is the
+  model's call; "nothing to do" is a valid answer.
+* an ``agent_send`` round: the model sent its message and has nothing more to add. The send's own
+  result ("delivered") is the whole outcome.
+
+Both used to take the empty-response ladder (a "you returned an empty response, continue" nudge,
+then retries, then a "no reply" error bubble), so models learned to end such turns with a harmless
+tool call such as ``execute_code print("ok")``. ``quiet_end_allowed`` names the two shapes so the
+ladder can accept an empty reply there.
+"""
+
+from __future__ import annotations
+
+import re
+from typing import Any
+
+QUIET_END_EXIT_REASON = "quiet_end"
+
+# What opens the input of a machinery wake (after an optional gateway timestamp line): an agent message,
+# a background process result, heartbeat or watch match, an async delegation result or batch of them.
+_WAKE_RE = re.compile(
+    r"\[(?:Agent message am_|ASYNC DELEGATION|Background process |IMPORTANT: (?:Background process |\d+ background |"
+    r"\d+ async))")
+_QUIET_AFTER_TOOLS = frozenset({"agent_send"})
+
+
+def _text(content: Any) -> str:
+    if isinstance(content, str):
+        return content
+    if isinstance(content, list):
+        return "\n".join(
+            str(p.get("text") or "") for p in content
+            if isinstance(p, dict) and p.get("type") in ("text", "input_text")
+        )
+    return ""
+
+
+def is_wake_text(text: str) -> bool:
+    head = text.lstrip()
+    if _WAKE_RE.match(head):
+        return True
+    first, _, rest = head.partition("\n")
+    # a gateway timestamp or note line in front of the wake header
+    return first.startswith("[") and first.endswith("]") and bool(_WAKE_RE.match(rest.lstrip()))
+
+
+def _tool_names(msg: dict) -> list[str]:
+    names = []
+    for tc in msg.get("tool_calls") or []:
+        fn = tc.get("function") if isinstance(tc, dict) else getattr(tc, "function", None)
+        name = fn.get("name") if isinstance(fn, dict) else getattr(fn, "name", None)
+        names.append(str(name or ""))
+    return names
+
+
+def quiet_end_allowed(messages: list[dict[str, Any]]) -> bool:
+    """True when an empty reply may end the turn quietly (see the module docstring)."""
+    # Only rows of this turn count: stop at its input, the last user row that is not recovery scaffolding.
+    i = len(messages) - 1
+    while i >= 0:
+        m = messages[i]
+        if m.get("role") == "user" and not m.get("_empty_recovery_synthetic"):
+            break
+        i -= 1
+    if i < 0:
+        return False
+    rows = messages[i + 1:]
+    assistants_with_tools = [m for m in rows if m.get("role") == "assistant" and m.get("tool_calls")]
+    if not assistants_with_tools:
+        return is_wake_text(_text(messages[i].get("content")))
+    # Mid-turn: the newest tool round was only agent_send calls.
+    names = _tool_names(assistants_with_tools[-1])
+    return bool(names) and all(n in _QUIET_AFTER_TOOLS for n in names)
diff --git a/agent/turn_empty_response.py b/agent/turn_empty_response.py
index 48842383..b6c7f23f 100644
--- a/agent/turn_empty_response.py
+++ b/agent/turn_empty_response.py
@@ -204,6 +204,22 @@ def recover_empty_response(
         agent._response_was_previewed = False
         return _verdict("break")
 
+    # A wake with nothing to do, or a turn that ended on its agent_send: an empty reply is the answer.
+    # No nudge, no retries and no "no reply" text (see agent/quiet_end.py).
+    if not agent._strip_think_blocks(final_response or "").strip():
+        from agent.quiet_end import QUIET_END_EXIT_REASON, quiet_end_allowed
+        if quiet_end_allowed(messages):
+            logger.info("Empty reply on a wake or after agent_send — ending the turn quietly")
+            _turn_exit_reason = QUIET_END_EXIT_REASON
+            final_response = ""
+            agent._empty_content_retries = 0
+            # Close the transcript with the model's own empty reply, so a tool row never ends it.
+            _quiet_msg = agent._build_assistant_message(assistant_message, finish_reason)
+            _quiet_msg["content"] = ""
+            _quiet_msg["_quiet_end"] = True
+            append_message(messages, _quiet_msg)
+            return _verdict("break")
+
     # Prior turn had real content + ONLY housekeeping tools: model is done, reuse it.
     # With substantive tools it was mid-task narration and the empty reply is a choke;
     # let the post-tool nudge handle it.
