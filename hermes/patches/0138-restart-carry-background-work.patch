+def defers_delegations(runner, home) -> bool:
+    """At startup: whether the handed-off background subagents wait for the carrier's process handoff instead of
+    being adopted now. The carrier hands its subagents over at the restart but its background processes only once
+    no carried turn is in a tool round (a carried foreground command keeps the device's connection); a subagent
+    adopted before that finds no record of the process it waits on and ends as if it were lost. The watch adopts
+    them right after it reattached the processes (``PROCESSES_HANDED``), or once the carrier exited."""
+    return configured(runner) and carrier_alive(home)
+
+
+def _adopt_delegations() -> None:
+    try:
+        from tools.delegate_tool_handoff import resume_handed_off_delegations
+        resumed = resume_handed_off_delegations()
+    except Exception:
+        logger.warning("Could not resume the background delegations the carrier handed off", exc_info=True)
+        return
+    if resumed:
+        logger.info("Resumed %d background delegation(s) handed off by the carrying gateway", resumed)
+
