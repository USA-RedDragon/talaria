+"""gateway.restart_turn_handoff_per_turn and the work that is not a turn:
+
+- background subagents the carrier hands over at the restart are adopted by the next gateway only once the
+  carrier handed over the background processes they wait on (a carried foreground command defers that), so a
+  subagent waiting on a process finds it instead of "no record of it";
+- a new session on the next gateway does not wait for the device backend's probe while the device is still
+  connected to the carrier: the last probe is kept, and a probe that does not answer is waited for 5 s at most.
+"""
+import asyncio
+import json
+import threading
+import time
+
+import pytest
+
+from gateway import turn_boundary, turn_carry, turn_handoff
+
+from tests.gateway.test_restart_turn_carry import (_NextAuthority, _claimed_turn, _old_runner, _reserve_profile,
+                                                   _until)
+
+
+@pytest.fixture(autouse=True)
+def _clean(monkeypatch, tmp_path):
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+    monkeypatch.setattr(turn_handoff, "_handing_off", False)
+    monkeypatch.setattr(turn_boundary, "_resuming", set())
+    monkeypatch.setattr(turn_boundary, "_handed_off", set())
+    monkeypatch.setattr(turn_carry, "_released", False)
+    monkeypatch.setattr(turn_carry, "_api_target", None)
+    monkeypatch.setattr(turn_carry, "_carrying", False)
+
+    async def noop(*_a, **_k):
+        return None
+    for name in ("_stop_cron", "_hand_off_background", "_disconnect_messaging"):
+        monkeypatch.setattr(turn_carry, name, noop)
+
+
+def _next_gateway(monkeypatch, owner, tmp_path):
+    """The next gateway's watch of the carrier, with its process reattach and subagent adoption recorded."""
+    from hermes_state_runtime import turn_carry_record
+    log = []
+
+    async def reattach(_runner):
+        log.append("reattach")
+    monkeypatch.setattr(turn_carry, "_reattach_processes", reattach)
+    import tools.delegate_tool_handoff as handoff
+    monkeypatch.setattr(handoff, "resume_handed_off_delegations", lambda: log.append("adopt") or 1)
+    nxt = _NextAuthority(owner.db)
+    remote = turn_carry._Remote(owner.runner, nxt, turn_carry_record(owner.db), tmp_path)
+    nxt._turn_carrier = remote
+    return log, asyncio.ensure_future(turn_carry._watch(remote))
+
+
+@pytest.mark.asyncio
+async def test_handed_off_subagents_are_adopted_after_the_processes_a_carried_command_held_back(
+        owner, tmp_path, monkeypatch):
+    _reserve_profile(tmp_path)
+    row, _live, agent = _claimed_turn(owner, "cmd")
+    agent._executing_tools = True  # a carried turn's foreground command runs on the device
+    from gateway.run_shutdown import GatewayShutdownMixin
+    handed = []
+
+    async def hand_off(_runner):
+        handed.append(time.monotonic())
+    monkeypatch.setattr(GatewayShutdownMixin, "_stop_hand_off_processes", staticmethod(hand_off))
+    runner = _old_runner(owner)
+    carry = asyncio.ensure_future(turn_carry.carry_restart(runner))
+    await _until(turn_carry.released)
+    # The next gateway's startup leaves the handed-off subagents for its watch while the carrier lives.
+    assert turn_carry.defers_delegations(runner, tmp_path) is True
+    log, watch = _next_gateway(monkeypatch, owner, tmp_path)
+    await asyncio.sleep(0.4)
+    assert handed == [] and log == []  # their processes are still the carrier's: nothing adopted yet
+    agent._executing_tools = False  # the command ends; the processes go over
+    await _until(lambda: "adopt" in log)
+    assert log == ["reattach", "adopt"]  # adopted right after the processes it waits on were reattached
+    from hermes_state_runtime import settle_session_input
+    settle_session_input(owner.db, epoch=owner.epoch, admission_id=row["admission_id"],
+                         generation=row["generation"], outcome="completed")
+    await asyncio.wait_for(carry, 5.0)
+    import os
+    os.close(runner._turn_carry.lock_fd)  # the carrier exits
+    await asyncio.wait_for(watch, 5.0)
+    assert turn_carry.defers_delegations(runner, tmp_path) is False
+
+
+@pytest.mark.asyncio
+async def test_processes_handed_before_the_release_let_the_next_gateway_adopt_the_subagents_at_once(
+        owner, tmp_path, monkeypatch):
+    _reserve_profile(tmp_path)
+    row, _live, agent = _claimed_turn(owner, "model")
+    agent._executing_tools = False  # in a model call: the processes go over before the release
+    from gateway.run_shutdown import GatewayShutdownMixin
+
+    async def hand_off(_runner):
+        return None
+    monkeypatch.setattr(GatewayShutdownMixin, "_stop_hand_off_processes", staticmethod(hand_off))
+    runner = _old_runner(owner)
+    carry = asyncio.ensure_future(turn_carry.carry_restart(runner))
+    await _until(turn_carry.released)
+    frames = [json.loads(line) for line in turn_carry.events_path(tmp_path, owner.epoch).read_text().splitlines()]
+    assert frames[0]["type"] == turn_carry.PROCESSES_HANDED
+    log, watch = _next_gateway(monkeypatch, owner, tmp_path)
+    await _until(lambda: "adopt" in log, timeout=1.0)  # not only once the carrier exits
+    assert not carry.done()
+    from hermes_state_runtime import settle_session_input
+    settle_session_input(owner.db, epoch=owner.epoch, admission_id=row["admission_id"],
+                         generation=row["generation"], outcome="completed")
+    await asyncio.wait_for(carry, 5.0)
+    import os
+    os.close(runner._turn_carry.lock_fd)
+    await asyncio.wait_for(watch, 5.0)
+    assert log.count("adopt") >= 1
+
+
+@pytest.mark.asyncio
+async def test_a_turn_still_starting_at_the_restart_is_carried_with_the_rest(owner, tmp_path):
+    """An API request (or a message) claimed a moment before the SIGTERM still builds its agent: the restart waits
+    for it and carries it, instead of reading it as a managed worker's turn and falling back to the single
+    handover (new API requests then got 503 until the old gateway exited)."""
+    _reserve_profile(tmp_path)
+    row, _live, _agent = _claimed_turn(owner, "starting")
+    adopted = owner.adopted.pop("starting")  # claimed; its agent is being built
+    runner = _old_runner(owner)
+    carry = asyncio.ensure_future(turn_carry.carry_restart(runner))
+    await asyncio.sleep(0.3)
+    assert not carry.done() and not turn_carry.released()
+    owner.adopted["starting"] = adopted  # it has its agent
+    await _until(turn_carry.released)
+    assert row["admission_id"] in runner._turn_carry.turns
+    from hermes_state_runtime import settle_session_input
+    settle_session_input(owner.db, epoch=owner.epoch, admission_id=row["admission_id"],
+                         generation=row["generation"], outcome="completed")
+    await asyncio.wait_for(carry, 5.0)
+    assert carry.result() is True
+    import os
+    os.close(runner._turn_carry.lock_fd)
+
+
+def test_without_a_carrier_the_startup_adopts_them_as_before(tmp_path):
+    from types import SimpleNamespace
+    from tests.gateway.test_restart_turn_carry import _config
+    runner = SimpleNamespace(config=_config())
+    assert turn_carry.defers_delegations(runner, tmp_path) is False
+    runner.config.restart_turn_handoff_per_turn = False
+    assert turn_carry.defers_delegations(runner, tmp_path) is False
+
+
+# --- the device backend's probe on the next gateway ----------------------------------------------------------
+
+
+@pytest.fixture
+def _probe(monkeypatch):
+    """The prompt's backend probe against a device: answers at once while ``connected`` is set, else it waits for the
+    device like the plugin does (3 s here, 60 s live) and fails."""
+    import agent.prompt_builder as pb
+    monkeypatch.setenv("TERMINAL_ENV", "device")
+    connected = threading.Event()
+    runs = []
+
+    def run(env_type, _terminal_tool):
+        runs.append(env_type)
+        if connected.wait(3.0):
+            return "os=Linux\nkernel=7.2.9-arch1-1\n"
+        return ""
+    monkeypatch.setattr(pb, "_run_backend_probe", run)
+    pb._clear_backend_probe_cache()
+    yield pb, connected, runs
+    connected.set()
+    pb._clear_backend_probe_cache()
+
+
+def test_the_next_gateway_uses_the_kept_probe_while_the_device_is_still_on_the_carrier(_probe):
+    pb, connected, runs = _probe
+    connected.set()  # the old gateway probed its device once
+    assert pb._probe_remote_backend("device") == "  OS: Linux 7.2.9-arch1-1"
+    pb._BACKEND_PROBE_CACHE.clear()  # a new process: the next gateway
+    connected.clear()  # its device is still connected to the carrier
+    started = time.monotonic()
+    assert pb._probe_remote_backend("device") == "  OS: Linux 7.2.9-arch1-1"
+    assert time.monotonic() - started < 0.5
+
+
+def test_a_probe_that_does_not_answer_holds_the_prompts_no_longer_than_the_window(_probe, monkeypatch):
+    pb, connected, runs = _probe
+    monkeypatch.setattr(pb, "_BACKEND_PROBE_WAIT_S", 0.5, raising=False)
+    results, times = [], []
+
+    def build():
+        t = time.monotonic()
+        results.append(pb._probe_remote_backend("device"))
+        times.append(time.monotonic() - t)
+    threads = [threading.Thread(target=build) for _ in range(4)]
+    for thread in threads:
+        thread.start()
+    for thread in threads:
+        thread.join(10)
+    assert results == [None] * 4
+    assert max(times) < 1.0  # not the device's reconnect wait
+    assert runs == ["device"]  # the prompts share one probe
+    connected.set()  # the device came over: the probe answers and is kept for the next prompts
+    deadline = time.monotonic() + 3
+    while pb._probe_remote_backend("device") is None and time.monotonic() < deadline:
+        time.sleep(0.05)
+    assert pb._probe_remote_backend("device") == "  OS: Linux 7.2.9-arch1-1"
