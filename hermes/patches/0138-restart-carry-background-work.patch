+# Why a restart waits before it decides whether it can carry its turns: a turn claimed a moment ago still builds its
+# agent (an API request, a message), so it is not among the turns yet. It is carried with them once it has its
+# agent; it used to read as a managed worker's turn, and the whole restart fell back to the single handover.
+STARTING = "a turn is still starting"
+# How long a restart waits for such turns.
+STARTING_TURN_WAIT_S = 5.0
+
+
+def _other_turns(runner, turns) -> tuple[list, list]:
+    """``(starting, workers)``: the claimed turns not among *turns*: those whose agent is still being built here,
+    and those a managed worker runs."""
+    from gateway import turn_handoff
+    from gateway.session_authorities import all_authorities
+    from gateway.turn_boundary import _in_process
+    carried = {t.admission_id for t in turns}
+    authorities = {getattr(a, "profile_id", None): a for a in all_authorities(runner)}
+    starting, workers = [], []
+    for item in turn_handoff.running_turns(runner):
+        if item["admission_id"] in carried:
+            continue
+        authority = authorities.get(item["profile_id"])
+        generation, agent = (getattr(authority, "adopted", None) or {}).get(item["session_id"], (None, None))
+        if generation == item["generation"] and agent is not None and not _in_process(agent):
+            workers.append(item)
+        else:
+            starting.append(item)
+    return starting, workers
+
+
