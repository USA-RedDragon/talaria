diff --git a/tests/tools/test_plugin_login_grant_approval.py b/tests/tools/test_plugin_login_grant_approval.py
new file mode 100644
index 00000000..17a27e86
--- /dev/null
+++ b/tests/tools/test_plugin_login_grant_approval.py
@@ -0,0 +1,285 @@
+"""A device plugin's approval can carry a ``login_grant`` (ask to use a saved login on a host).
+
+  1. The approve directive of ``pre_tool_call`` keeps the ``login_grant`` dict and hands it to the gate.
+  2. The pending card carries the sanitized object and the choices once/device/deny.
+  3. ``device`` approves this one call like ``once`` and writes nothing; it is refused on a normal prompt.
+  4. Only a human answers: yolo, approvals.mode off, smart approval and allowlisted rules do not skip the card;
+     with no human the call is blocked.
+"""
+import threading
+import time
+from unittest.mock import patch
+
+import pytest
+
+import tools.approval as approval_mod
+from tools import approval_context
+
+KEY = "login-grant-session"
+GRANT = {"device_id": "d_abc", "device_name": "upstairs-pc", "host": "portal.example.com", "saved_logins": 1,
+         "methods": ["Password", "Email link"], "method": "", "existing": "", "job_id": ""}
+
+
+@pytest.fixture()
+def gateway(monkeypatch):
+    """A gateway session whose cards are recorded; the test answers them."""
+    cards = []
+    monkeypatch.setattr(approval_mod, "get_current_session_key", lambda default="": KEY)
+    monkeypatch.setattr(approval_mod, "_presence", lambda cb=None: (None, False, True, False))
+    monkeypatch.setattr(approval_context, "_get_approval_mode", lambda: "manual")
+    monkeypatch.setattr(approval_mod, "_yolo_active", lambda: False)
+    saved_session = {k: set(v) for k, v in approval_mod._session_approved.items()}
+    saved_permanent = set(approval_mod._permanent_approved)
+    approval_mod.register_gateway_notify(KEY, cards.append)
+    yield cards
+    approval_mod.unregister_gateway_notify(KEY)
+    approval_mod._session_approved.clear()
+    approval_mod._session_approved.update(saved_session)
+    approval_mod._permanent_approved.clear()
+    approval_mod._permanent_approved.update(saved_permanent)
+
+
+def _ask(**kwargs):
+    """Run the gate on a worker thread: ``(thread, result dict)``."""
+    result = {}
+
+    def run():
+        result["value"] = approval_mod.request_tool_approval(
+            "browser_login", "Sign in on portal.example.com", rule_key="browser:login-grant:d_abc:portal.example.com",
+            login_grant=dict(GRANT), **kwargs)
+
+    worker = threading.Thread(target=run)
+    worker.start()
+    return worker, result
+
+
+def _wait_card(cards, limit=10.0):
+    end = time.monotonic() + limit
+    while not cards and time.monotonic() < end:
+        time.sleep(0.02)
+    assert cards, "no approval card was raised"
+    return cards[0]
+
+
+def _persisted():
+    return (any(approval_mod._session_approved.values()), bool(approval_mod._permanent_approved))
+
+
+# --- 1. the directive ------------------------------------------------------------------------------------
+
+def _directive(hook_result):
+    from hermes_cli.plugins import _get_pre_tool_call_directive_details
+    with patch("hermes_cli.lifecycle.invoke_hook", return_value=[hook_result]):
+        return _get_pre_tool_call_directive_details("browser_login", {"url": "https://portal.example.com"})
+
+
+def test_directive_carries_login_grant():
+    details = _directive({"action": "approve", "message": "m", "rule_key": "k", "login_grant": GRANT})
+    assert details.action == "approve" and details.rule_key == "k"
+    assert details.login_grant == GRANT
+
+
+def test_directive_without_login_grant_has_none():
+    assert _directive({"action": "approve", "message": "m"}).login_grant is None
+    assert _directive({"action": "approve", "message": "m", "login_grant": "x"}).login_grant is None
+
+
+def test_resolve_hands_login_grant_to_the_gate():
+    from hermes_cli.plugins import _resolve_block_from_details
+    details = _directive({"action": "approve", "message": "m", "rule_key": "k", "login_grant": GRANT})
+    seen = {}
+
+    def fake(tool_name, reason, **kwargs):
+        seen.update(kwargs)
+        return {"approved": True}
+
+    with patch("tools.approval.request_tool_approval", fake):
+        assert _resolve_block_from_details(details, "browser_login") is None
+    assert seen == {"rule_key": "k", "login_grant": GRANT}
+
+
+def test_resolve_without_login_grant_keeps_the_old_call():
+    from hermes_cli.plugins import _resolve_block_from_details
+    details = _directive({"action": "approve", "message": "m", "rule_key": "k"})
+    seen = {}
+
+    def fake(tool_name, reason, **kwargs):
+        seen.update(kwargs)
+        return {"approved": True}
+
+    with patch("tools.approval.request_tool_approval", fake):
+        _resolve_block_from_details(details, "browser_login")
+    assert seen == {"rule_key": "k"}
+
+
+# --- sanitizing -----------------------------------------------------------------------------------------
+
+def test_sanitize_keeps_only_known_bounded_keys():
+    raw = {**GRANT, "evil": "x", "saved_logins": 3, "host": "h" * 1000, "methods": ["a" * 200, 5, "b"] + ["c"] * 20,
+           "device_name": ["nope"], "job_id": None}
+    out = approval_mod.sanitize_login_grant(raw)
+    assert set(out) <= {"device_id", "device_name", "host", "saved_logins", "methods", "method", "existing", "job_id"}
+    assert len(out["host"]) == 256 and out["saved_logins"] == 3
+    assert len(out["methods"]) == 12 and out["methods"][0] == "a" * 80 and 5 not in out["methods"]
+    assert "device_name" not in out and "job_id" not in out
+    assert approval_mod.sanitize_login_grant({"saved_logins": True}) == {}
+    assert approval_mod.sanitize_login_grant("x") == {}
+
+
+# --- 2. the card ----------------------------------------------------------------------------------------
+
+def test_card_has_the_object_and_three_choices(gateway):
+    worker, result = _ask()
+    card = _wait_card(gateway)
+    assert card["login_grant"] == GRANT and card["allow_session"] is False and card["allow_permanent"] is False
+    from gateway.session_pending_controls import PendingControls
+
+    class _Events:
+        lock = threading.RLock()
+
+        def publish(self, *a, **k):
+            pass
+
+    controls = PendingControls(_Events())
+    controls.register("s", object(), 1, {**card, "login_grant": {**GRANT, "evil": 1}})
+    prompt = controls.pending[card["request_id"]][1]
+    assert prompt["choices"] == ["once", "device", "deny"]
+    assert prompt["login_grant"] == GRANT
+    approval_mod.resolve_gateway_approval(KEY, "deny", request_id=card["request_id"])
+    worker.join(30)
+    assert result["value"]["approved"] is False
+
+
+def test_normal_prompt_has_no_device_choice():
+    from gateway.session_pending_controls import PendingControls
+
+    class _Events:
+        lock = threading.RLock()
+
+        def publish(self, *a, **k):
+            pass
+
+    controls = PendingControls(_Events())
+    controls.register("s", object(), 1, {"request_id": "r", "command": "c", "description": "d"})
+    prompt = controls.pending["r"][1]
+    assert "device" not in prompt["choices"] and "login_grant" not in prompt
+
+
+# --- 3. device ------------------------------------------------------------------------------------------
+
+@pytest.mark.parametrize("choice", ["once", "device"])
+def test_once_and_device_approve_one_call_and_persist_nothing(gateway, choice):
+    worker, result = _ask()
+    card = _wait_card(gateway)
+    assert approval_mod.resolve_gateway_approval(KEY, choice, request_id=card["request_id"]) == 1
+    worker.join(30)
+    assert result["value"]["approved"] is True
+    assert _persisted() == (False, False)
+    # the next call asks again
+    gateway.clear()
+    worker, result = _ask()
+    _wait_card(gateway)
+    approval_mod.resolve_gateway_approval(KEY, "deny", request_id=gateway[0]["request_id"])
+    worker.join(30)
+    assert result["value"]["approved"] is False
+
+
+@pytest.mark.parametrize("choice", ["session", "always", "source", "bogus"])
+def test_login_grant_card_refuses_other_choices(gateway, choice):
+    worker, result = _ask()
+    card = _wait_card(gateway)
+    approval_mod.resolve_gateway_approval(KEY, choice, request_id=card["request_id"])
+    worker.join(30)
+    assert result["value"]["approved"] is False
+    assert _persisted() == (False, False)
+
+
+def test_device_is_refused_on_a_normal_prompt(gateway):
+    result = {}
+
+    def run():
+        result["value"] = approval_mod.request_tool_approval("some_tool", "needs a human", rule_key="r")
+
+    worker = threading.Thread(target=run)
+    worker.start()
+    card = _wait_card(gateway)
+    assert "login_grant" not in card
+    # the resolver leaves the prompt pending
+    assert approval_mod.resolve_gateway_approval(KEY, "device", request_id=card["request_id"]) == 0
+    assert approval_mod.resolve_gateway_approval(KEY, "device") == 0
+    assert approval_mod.resolve_gateway_approval(KEY, "device", resolve_all=True) == 0
+    assert worker.is_alive()
+    approval_mod.resolve_gateway_approval(KEY, "deny", request_id=card["request_id"])
+    worker.join(30)
+    assert result["value"]["approved"] is False
+
+
+def test_normal_gate_denies_a_device_answer_that_gets_through(monkeypatch):
+    """A client that smuggles ``device`` past the resolver still approves nothing."""
+    monkeypatch.setattr(approval_mod, "_presence", lambda cb=None: (lambda *a, **k: "device", True, False, False))
+    monkeypatch.setattr(approval_mod, "_yolo_active", lambda: False)
+    monkeypatch.setattr(approval_context, "_get_approval_mode", lambda: "manual")
+    monkeypatch.setattr(approval_mod, "get_current_session_key", lambda default="": KEY)
+    result = approval_mod.request_tool_approval("some_tool", "needs a human", rule_key="r2")
+    assert result["approved"] is False
+
+
+# --- 4. human only --------------------------------------------------------------------------------------
+
+def test_yolo_mode_off_and_smart_do_not_skip_the_card(gateway, monkeypatch):
+    monkeypatch.setattr(approval_mod, "_yolo_active", lambda: True)
+    monkeypatch.setattr(approval_context, "_get_approval_mode", lambda: "off")
+    monkeypatch.setattr(approval_mod, "_smart_verdict", lambda *a, **k: "approve")
+    worker, result = _ask()
+    card = _wait_card(gateway)
+    assert "value" not in result
+    approval_mod.resolve_gateway_approval(KEY, "deny", request_id=card["request_id"])
+    worker.join(30)
+    assert result["value"]["approved"] is False
+
+    monkeypatch.setattr(approval_context, "_get_approval_mode", lambda: "smart")
+    gateway.clear()
+    worker, result = _ask()
+    card = _wait_card(gateway)
+    assert "value" not in result
+    approval_mod.resolve_gateway_approval(KEY, "deny", request_id=card["request_id"])
+    worker.join(30)
+
+
+def test_allowlisted_rule_does_not_skip_the_card(gateway):
+    rule = "browser:login-grant:d_abc:portal.example.com"
+    for key in (f"plugin_rule:{rule}", "plugin_login_grant:d_abc:portal.example.com", "plugin_rule:browser_login"):
+        approval_mod.approve_session(KEY, key)
+        approval_mod._permanent_approved.add(key)
+    worker, result = _ask()
+    card = _wait_card(gateway)
+    assert "value" not in result
+    approval_mod.resolve_gateway_approval(KEY, "deny", request_id=card["request_id"])
+    worker.join(30)
+    assert result["value"]["approved"] is False
+
+
+def test_cli_prompt_offers_once_and_deny_only(monkeypatch):
+    seen = {}
+
+    def callback(command, description, **kwargs):
+        seen.update(kwargs)
+        return "once"
+
+    monkeypatch.setattr(approval_mod, "_presence", lambda cb=None: (callback, True, False, False))
+    monkeypatch.setattr(approval_mod, "get_current_session_key", lambda default="": KEY)
+    result = approval_mod.request_tool_approval("browser_login", "r", login_grant=dict(GRANT))
+    assert result["approved"] is True
+    assert seen.get("allow_permanent") is False and seen.get("allow_session") is False
+    assert _persisted() == (False, False)
+
+
+@pytest.mark.parametrize("mode", ["off", "manual", "smart"])
+def test_no_human_is_blocked(monkeypatch, mode):
+    monkeypatch.setattr(approval_mod, "_presence", lambda cb=None: (None, False, False, False))
+    monkeypatch.setattr(approval_mod, "_yolo_active", lambda: True)
+    monkeypatch.setattr(approval_context, "_get_approval_mode", lambda: mode)
+    monkeypatch.setattr(approval_mod, "get_current_session_key", lambda default="": KEY)
+    result = approval_mod.request_tool_approval("browser_login", "r", login_grant=dict(GRANT))
+    assert result["approved"] is False
+    assert "BLOCKED" in result["message"] and "portal.example.com" in result["message"]
