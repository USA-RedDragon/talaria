-    """Excerpt of the job's most recent saved output file for the background completion
-    block (parent sees what the job produced). Never raises."""
+def _run_output_excerpt(job_id: str, since: float, max_chars: int = 2000) -> Optional[str]:
+    """Excerpt of the output file THIS run saved, for the background completion block (parent
+    sees what the run produced). Only a file written at or after ``since`` (the run's dispatch
+    time) counts: a cancelled or crashed run saves none, and the job's newest file is then an
+    earlier run's report, which must never be shown as this run's. Never raises."""
     try:
         from cron.jobs import get_cron_output_dir
 
         out_dir = get_cron_output_dir() / job_id
-        files = sorted(out_dir.glob("*.md"))
+        files = sorted(f for f in out_dir.glob("*.md") if f.is_file() and f.stat().st_mtime >= since)
         if not files:
             return None
         text = files[-1].read_text(encoding="utf-8-sig", errors="replace").strip()
@@ -544,9 +546,11 @@ def _manual_run_completion(
     ]
     if refreshed.get("next_run_at"):
         lines.append(f"Next scheduled run: {refreshed['next_run_at']}")
-    excerpt = _latest_job_output_excerpt(job_id)
+    excerpt = _run_output_excerpt(job_id, started_at)
     if excerpt:
         lines += ["--- JOB OUTPUT ---", excerpt]
+    else:
+        lines.append("Job output: none saved by this run.")
     return {
         "status": "completed" if res.get("success") else "error", "summary": "\n".join(lines),
         "error": res.get("error"), "duration_seconds": duration, **_run_session_usage(job_id, execution_id),
