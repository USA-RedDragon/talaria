@@ -0,0 +1,88 @@
+"""A manual cron run's completion notice shows only the output THIS run saved.
+
+The background ``cronjob(action='run')`` completion attached the job's newest output file. A
+cancelled run saves none, so its notice carried the previous completed run's report (its Run
+Time, Run Context and file path) as if the cancelled run had produced it.
+"""
+import os
+import time
+from unittest.mock import patch
+
+import pytest
+
+from cron import jobs
+from tests.fakes.cron_owner import cron_owner
+from tools.cronjob_tools import _try_dispatch_background_run
+
+EARLIER_REPORT = "# Earlier run\n\n**Run Time:** 2026-11-17 03:11:28\n\nEARLIER RUN BODY"
+
+
+@pytest.fixture()
+def owner(tmp_path, monkeypatch):
+    authority = cron_owner(tmp_path / "home", monkeypatch)
+    yield authority
+    authority.db.close()
+
+
+def _completion(job, run_one_job):
+    """Dispatch ``job`` through the real background path and return its completion event."""
+    from tools.approval_context import _approval_session_key
+    from tools.process_registry import process_registry
+
+    token = _approval_session_key.set("agent:main:telegram:dm:4242")
+    others = []
+    try:
+        with patch("tools.cronjob_tools.claim_job_for_fire", side_effect=lambda jid, **kw: dict(job)), \
+             patch("cron.scheduler.run_one_job", side_effect=run_one_job):
+            res = _try_dispatch_background_run(dict(job))
+            assert res["dispatched"] is True
+            while True:  # a blocking get is the signal; Empty after the deadline fails the test
+                evt = process_registry.completion_queue.get(timeout=10)
+                if evt.get("delegation_id") == res["delegation_id"]:
+                    return evt
+                others.append(evt)
+    finally:
+        for evt in others:
+            process_registry.completion_queue.put(evt)
+        _approval_session_key.reset(token)
+
+
+def _earlier_completed_run(job_id):
+    """The output file a scheduled run saved before this manual run started."""
+    out_dir = jobs.get_cron_output_dir() / job_id
+    out_dir.mkdir(parents=True, exist_ok=True)
+    earlier = out_dir / "2026-11-17_03-11-31.md"
+    earlier.write_text(EARLIER_REPORT, encoding="utf-8")
+    past = time.time() - 600
+    os.utime(earlier, (past, past))
+    return earlier
+
+
+def test_cancelled_run_notice_never_shows_an_earlier_runs_output(owner):
+    job = jobs.create_job(prompt="report", schedule="every 1h", deliver="local")
+    earlier = _earlier_completed_run(job["id"])
+
+    def run_one_job(claimed, **kw):  # an operator cancel: booked, no output file saved
+        jobs.mark_job_run(claimed["id"], False, "Cancelled: cancelled on request", status="cancelled")
+        return True
+
+    summary = _completion(job, run_one_job)["summary"]
+    assert "EARLIER RUN BODY" not in summary
+    assert "03:11:28" not in summary
+    assert str(earlier) not in summary
+    assert "Job output: none saved by this run." in summary
+
+
+def test_completed_run_notice_shows_its_own_output(owner):
+    job = jobs.create_job(prompt="report", schedule="every 1h", deliver="local")
+    _earlier_completed_run(job["id"])
+
+    def run_one_job(claimed, **kw):
+        jobs.save_job_output(claimed["id"], "# This run\n\nTHIS RUN BODY")
+        jobs.mark_job_run(claimed["id"], True)
+        return True
+
+    summary = _completion(job, run_one_job)["summary"]
+    assert "--- JOB OUTPUT ---" in summary
+    assert "THIS RUN BODY" in summary
+    assert "EARLIER RUN BODY" not in summary
