@@ -0,0 +1,203 @@
+"""gateway.restart_turn_handoff_per_turn with a client that moves its own socket (make before break):
+
+- a kept hub socket whose dial asked for it (``?successor_hint=1``) gets a ``gateway.successor_ready`` event, with the
+  next gateway's listener address, once that gateway is ready, and stays open while idle until its client closes it
+  (a request on it or the end of the relay window still ends it as before);
+- a socket that did not ask is closed as before;
+- each frame the next gateway relays for a carried turn names the carrier's frame (``carried_from``), live and in its
+  replay, so a client that moved drops the frames it already got from the carrier.
+"""
+import asyncio
+import json
+from types import SimpleNamespace
+
+import pytest
+
+from gateway import turn_boundary, turn_carry, turn_handoff
+
+
+@pytest.fixture(autouse=True)
+def _clean(monkeypatch, tmp_path):
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+    monkeypatch.setattr(turn_handoff, "_handing_off", False)
+    monkeypatch.setattr(turn_boundary, "_resuming", set())
+    monkeypatch.setattr(turn_boundary, "_handed_off", set())
+    monkeypatch.setattr(turn_carry, "_released", False)
+    monkeypatch.setattr(turn_carry, "_api_target", None)
+    monkeypatch.setattr(turn_carry, "_carrying", False)
+
+
+async def _open(monkeypatch, runner, query):
+    """test_restart_carry_no_pause._open with the dial's query string *query*."""
+    from gateway.run_api import GatewayRuntimeAPI
+    monkeypatch.setattr("hermes_cli.web_server_boundary._gateway_ws_ticket_from_subprotocol",
+                        lambda ws: ("abc", "ok"))
+    monkeypatch.setattr("hermes_cli.web_server_surface.policy", lambda state: SimpleNamespace(gateway_ticket=True))
+    got, opened, ended, app_send = [], asyncio.Event(), asyncio.Event(), []
+
+    async def dashboard(scope, receive, send):
+        app_send.append(send)
+        await send({"type": "websocket.accept"})
+        opened.set()
+        while True:
+            message = await receive()
+            got.append(message)
+            if message["type"] == "websocket.disconnect":
+                ended.set()
+                await send({"type": "websocket.close", "code": 1000})
+                return
+
+    api = GatewayRuntimeAPI(dashboard, runner, SimpleNamespace(state=SimpleNamespace()))
+    to_app: asyncio.Queue = asyncio.Queue()
+    from_app: asyncio.Queue = asyncio.Queue()
+    scope = {"type": "websocket", "path": "/api/ws", "raw_path": b"/api/ws", "query_string": query,
+             "headers": [(b"host", b"hermes:9120"), (b"origin", b"http://hermes:9120"),
+                         (b"sec-websocket-protocol", b"hermes.v1, ticket.abc"), (b"sec-websocket-key", b"x")],
+             "subprotocols": ["hermes.v1", "ticket.abc"], "client": ("10.0.0.9", 1),
+             "server": ("10.0.0.1", 9120), "scheme": "ws"}
+    task = asyncio.ensure_future(api(scope, to_app.get, from_app.put))
+    await asyncio.wait_for(opened.wait(), 2)
+    assert from_app.get_nowait() == {"type": "websocket.accept"}
+    return SimpleNamespace(api=api, task=task, scope=scope, to_app=to_app, from_app=from_app, got=got, ended=ended,
+                           app_send=app_send)
+
+
+async def _kept(monkeypatch, query=b"native_dial=browser&successor_hint=1", window=None):
+    from tests.gateway.test_restart_carry_no_pause import _carrier_runner
+    from tests.gateway.test_restart_socket_close_delay import _seal, _wait
+    runner = _carrier_runner()
+    if window is not None:
+        runner.config.restart_listener_relay_seconds = window
+    s = await _open(monkeypatch, runner, query)
+    _wait(runner)
+    runner._running = False  # the stop begins (the carrier released the profile)
+    assert _seal(s.api, s.scope) == []
+    return runner, s
+
+
+async def _hint(s):
+    message = await asyncio.wait_for(s.from_app.get(), 3)
+    assert message["type"] == "websocket.send"
+    return json.loads(message["text"])
+
+
+@pytest.mark.asyncio
+async def test_a_hinted_socket_learns_the_successor_and_stays_open_until_its_client_closes_it(monkeypatch):
+    from gateway.run_api import KEPT_IDLE_S
+    from tests.gateway.test_restart_socket_close_delay import _successor
+    _runner, s = await _kept(monkeypatch)
+    successor, target, _asked = await _successor(ready_after=0.2)
+    try:
+        s.api.forward_to(target, 10)
+        frame = await _hint(s)
+        assert frame["method"] == "event"
+        assert frame["params"]["type"] == "gateway.successor_ready"
+        assert frame["params"]["payload"] == {"host": target[0], "port": target[1]}
+        # Idle for longer than a kept socket may be: the client moves at its own pace, so it is not closed.
+        await asyncio.sleep(KEPT_IDLE_S + 0.5)
+        assert not s.ended.is_set()
+        assert s.from_app.empty()
+        # The carried turn still streams here meanwhile.
+        await s.app_send[0]({"type": "websocket.send", "text": "delta"})
+        assert await asyncio.wait_for(s.from_app.get(), 2) == {"type": "websocket.send", "text": "delta"}
+        # The client opened its next socket and closes this one.
+        await s.to_app.put({"type": "websocket.disconnect", "code": 1000})
+        await asyncio.wait_for(s.ended.wait(), 2)
+        await asyncio.wait_for(s.task, 3)
+    finally:
+        await successor.cleanup()
+
+
+@pytest.mark.asyncio
+async def test_a_request_on_a_hinted_socket_still_ends_it(monkeypatch):
+    from tests.gateway.test_restart_socket_close_delay import _successor
+    _runner, s = await _kept(monkeypatch)
+    successor, target, _asked = await _successor()
+    try:
+        s.api.forward_to(target, 10)
+        await _hint(s)
+        await s.to_app.put({"type": "websocket.receive", "text": '{"method": "prompt.submit"}'})
+        await asyncio.wait_for(s.ended.wait(), 2)
+        assert all(m.get("text") != '{"method": "prompt.submit"}' for m in s.got)  # sent again on the next gateway
+        assert await asyncio.wait_for(s.from_app.get(), 2) == {"type": "websocket.close", "code": 1012}
+    finally:
+        await successor.cleanup()
+
+
+@pytest.mark.asyncio
+async def test_a_hinted_socket_ends_with_the_relay_window(monkeypatch):
+    from tests.gateway.test_restart_socket_close_delay import _successor
+    _runner, s = await _kept(monkeypatch, window=0.5)
+    successor, target, _asked = await _successor()
+    try:
+        loop = asyncio.get_running_loop()
+        s.api.forward_to(target, 10)
+        await _hint(s)
+        hinted = loop.time()
+        await asyncio.wait_for(s.ended.wait(), 4)
+        from gateway.run_api import KEPT_IDLE_S
+        assert loop.time() - hinted >= KEPT_IDLE_S - 0.2  # max(window, KEPT_IDLE_S) after the gate opened
+        assert await asyncio.wait_for(s.from_app.get(), 2) == {"type": "websocket.close", "code": 1012}
+    finally:
+        await successor.cleanup()
+
+
+@pytest.mark.asyncio
+async def test_a_socket_that_did_not_ask_gets_no_hint_and_closes_as_before(monkeypatch):
+    from tests.gateway.test_restart_socket_close_delay import _successor
+    _runner, s = await _kept(monkeypatch, query=b"native_dial=browser")
+    successor, target, _asked = await _successor()
+    try:
+        s.api.forward_to(target, 10)
+        await asyncio.wait_for(s.ended.wait(), 4)
+        assert await asyncio.wait_for(s.from_app.get(), 2) == {"type": "websocket.close", "code": 1012}
+    finally:
+        await successor.cleanup()
+
+
+@pytest.mark.asyncio
+async def test_no_hint_when_the_successor_never_answered_ready(monkeypatch):
+    _runner, s = await _kept(monkeypatch)
+    s.api.forward_to(("127.0.0.1", 9), 0.3)  # nothing listens there
+    await asyncio.wait_for(s.ended.wait(), 4)
+    assert await asyncio.wait_for(s.from_app.get(), 2) == {"type": "websocket.close", "code": 1012}
+
+
+def test_relayed_frames_name_the_carriers_frame(owner, tmp_path):
+    from tests.gateway.test_restart_turn_carry import _NextAuthority, _claimed_turn
+    from gateway.session_authority import LiveSession
+    from hermes_state_runtime import begin_turn_carry, turn_carry_record
+    row, live, _agent = _claimed_turn(owner, "carried")
+    begin_turn_carry(owner.db, epoch=owner.epoch, record={
+        "turns": {row["admission_id"]: {"session_id": "carried", "generation": row["generation"]}}})
+    nxt = _NextAuthority(owner.db)
+    nxt.sessions["carried"] = LiveSession(live.source, live.route)
+    stream = nxt.sessions["carried"].event_stream
+    seen = []
+    stream.observers.add(lambda frame: seen.append(frame["params"]))
+    remote = turn_carry._Remote(SimpleNamespace(), nxt, turn_carry_record(owner.db), tmp_path)
+    execution = {"authority_epoch": owner.epoch, "execution_generation": row["generation"],
+                 "admission_id": row["admission_id"]}
+    turn_carry._relay_one(remote, {**execution, "type": "message.delta", "session_id": "carried",
+                                   "payload": {"text": "a"}, "replay_epoch": "old-epoch", "seq": 41})
+    prompt = {"kind": "clarify", "prompt_id": "q1", "execution_generation": row["generation"], "question": "which?",
+              "choices": ["a"], "multi_select": False}
+    turn_carry._relay_one(remote, {"type": "clarify.request", "session_id": "carried", "payload": prompt,
+                                   "replay_epoch": "old-epoch", "seq": 42})
+    turn_carry._relay_one(remote, {"type": "message.delta", "session_id": "carried", "payload": {"text": "b"}})
+    assert [(p["type"], p.get("carried_from")) for p in seen] == [
+        ("message.delta", {"replay_epoch": "old-epoch", "seq": 41}),
+        ("clarify.request", {"replay_epoch": "old-epoch", "seq": 42}),
+        ("message.delta", None),  # a frame that names no carrier frame
+    ]
+    assert stream.origin is None
