+"""Smart approval: a Code from External card for a build in a tree unpacked from a tarball or zip the session
+downloaded from a known forge offers that repo as the source.
+
+Invariants:
+  1. A command that builds or runs in (or names) a folder the session unpacked from an archive it downloaded from a
+     forge repo (``github.com/owner/repo``: an archive, codeload, API tarball or release asset URL) gets the repo's
+     source on its card, as a clone of the repo does. The unpack is ``tar -x``/``bsdtar -x``/``unzip`` into a folder
+     (``-C``, ``-d`` or after ``cd``), of the downloaded file or of the download piped into it.
+  2. The grant then covers later builds in that tree (clang++, cmake, make) and an unpack of the same repo; never a
+     folder unpacked from another repo, from an archive of an unknown or non-forge origin, or from a look-alike host.
+  3. The source the review model names without a host (``owner/repo``) counts as the forge the session downloaded
+     that repo from, never as a guess: no download of that repo from a known forge, or two forges, offers nothing.
+"""
+
+from __future__ import annotations
+
+import json
+
+import pytest
+
+from hermes_state import SessionDB
+from tools import approval_automode as A
+from tools import approval_chat_grants as G
+from tools.delegate_tool import _bind_approval_review_root
+
+SOURCE = "github.com/Themaister/parallel-rdp-standalone"
+ARCHIVE = "https://github.com/Themaister/parallel-rdp-standalone/archive/refs/heads/master.tar.gz"
+CODELOAD = "https://codeload.github.com/Themaister/parallel-rdp-standalone/tar.gz/refs/heads/master"
+ZIP = "https://codeload.github.com/Themaister/parallel-rdp-standalone/zip/refs/heads/master"
+API = "https://api.github.com/repos/Themaister/parallel-rdp-standalone/tarball/master"
+RELEASE = "https://github.com/Themaister/parallel-rdp-standalone/releases/download/v1/src.tar.gz"
+
+# What the card in the report ran, in the unpacked folder.
+BUILD = ("cd {d}/x && mkdir -p out && time (for f in parallel-rdp/*.cpp vulkan/*.cpp; do echo $f; done | "
+         "xargs -P 16 -I{{}} sh -c 'clang++ -std=c++17 -c {{}} -o out/$(echo {{}} | tr / _).o')")
+
+
+class _Agent:
+    def __init__(self, session_id, db=None, messages=None):
+        self.session_id = session_id
+        self._session_db = db
+        self._approval_review_messages = messages
+
+
+@pytest.fixture()
+def db(tmp_path):
+    database = SessionDB(db_path=tmp_path / "state.db")
+    database.create_session("root", source="cli")
+    database.append_message("root", "user", "Relift the N64 RDP")
+    database.append_message("root", "assistant", "Starting a subagent for it.")
+    yield database
+    database.close()
+
+
+def _judge(source=None):
+    def complete(stage, system, user, max_tokens):
+        if stage == 1:
+            return "<block>yes</block>"
+        tail = f"<source>{source}</source>" if source else ""
+        return ("<block>yes</block><category>Code from External</category>"
+                f"<reason>builds a tarball downloaded this session</reason>{tail}")
+    return complete
+
+
+@pytest.fixture()
+def strict_judge():
+    A.set_complete_override(_judge())
+    yield
+    A.set_complete_override(None)
+
+
+def _calls(*commands):
+    out = [{"role": "user", "content": "go"}]
+    for i, command in enumerate(commands):
+        out.append({"role": "assistant", "content": "", "tool_calls": [
+            {"id": f"t{i}", "type": "function", "function": {"name": "terminal", "arguments": json.dumps({"command": command})}}]})
+        out.append({"role": "tool", "tool_call_id": f"t{i}", "content": json.dumps({"output": "ok"})})
+    return out
+
+
+def _child(db, messages):
+    root = _Agent("root", db, db.get_messages_as_conversation("root"))
+    child = _Agent("root-child", db, messages)
+    _bind_approval_review_root(child, root, "build the RDP")
+    child._delegate_depth = 1
+    return child
+
+
+def _review(child, command, cwd):
+    return A.review("terminal", {"command": command}, agent=child, cwd=str(cwd), messages=child._approval_review_messages)
+
+
+@pytest.mark.parametrize("fetch", [
+    "cd {d} && curl -fsSL -o a.tgz " + ARCHIVE + " && mkdir x && tar -xzf a.tgz -C x --strip-components=1",
+    "cd {d} && mkdir x && curl -fsSL " + CODELOAD + " | tar -xz -C x --strip-components=1",
+    "cd {d} && mkdir x && wget -qO- " + API + " | tar xz -C x --strip-components=1",
+    "cd {d} && curl -fsSLO " + RELEASE + " && mkdir x && tar xzf src.tar.gz -C x",
+    "cd {d} && curl -fsSL -o a.tgz " + ARCHIVE + "; mkdir -p x; cd x && tar xzf ../a.tgz --strip-components=1",
+    "cd {d} && wget -q -O a.zip " + ZIP + " && unzip -q a.zip -d x",
+    "cd {d} && curl -fsSL -o a.tgz " + ARCHIVE + " && mkdir x && bsdtar -xf a.tgz -C x",
+    "cd {d} && curl -fsSL -o a.tgz " + ARCHIVE + " && mkdir x && tar --extract --file=a.tgz --directory=x",
+    "cd {d} && curl -fsSL -o a.tgz " + ARCHIVE + " && mkdir x && tar -x -z -f a.tgz -C x",
+    "cd {d} && curl -fsSL -o a.tgz " + ARCHIVE + " && mkdir x && cd x && unzip ../a.tgz",
+])
+def test_build_in_an_unpacked_archive_offers_the_repo_source(db, strict_judge, tmp_path, fetch):
+    child = _child(db, _calls(fetch.format(d=tmp_path)))
+    verdict = _review(child, BUILD.format(d=tmp_path), tmp_path)
+    assert verdict.decision == "block", fetch
+    assert verdict.detail["grant_sources"] == [SOURCE], fetch
+
