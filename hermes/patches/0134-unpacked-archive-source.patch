+def forge_repo(url: str) -> str | None:
+    """The ``host/owner/repo`` identity of a URL on a known forge (GitHub, GitLab, Codeberg, ...: an archive, a
+    release asset, a clone URL), or ``None`` for every other host, a package host included. A tree unpacked from
+    an archive is that repo's code only when the archive came from there."""
+    ident = url_source(url) if isinstance(url, str) else None
+    parts = (ident or "").split("/")
+    if len(parts) >= 3 and parts[0] in _GITHUB_HOSTS | _FORGE_HOSTS and all(parts):
+        return ident
+    return None
+
+
+_BARE_REPO = re.compile(r"[\w.-]+/[\w.-]+")
+
