+def _tar_unpack(args: list[str]) -> tuple[str | None, str | None, bool] | None:
+    """``(archive, directory, extracts_stdin)`` of a tar or bsdtar call that extracts (``-x``, ``--extract``,
+    ``xzf`` and the like); ``archive`` is ``None`` when it reads standard input. ``None`` for a call that lists or
+    creates."""
+    extract, archive, directory = False, None, None
+    i = 0
+    while i < len(args):
+        word = args[i]
+        nxt = args[i + 1] if i + 1 < len(args) else None
+        if word in ("--extract", "--get"):
+            extract = True
+        elif word.startswith("--file="):
+            archive = word.split("=", 1)[1]
+        elif word == "--file" and nxt:
+            archive, i = nxt, i + 1
+        elif word.startswith("--directory="):
+            directory = word.split("=", 1)[1]
+        elif word == "--directory" and nxt:
+            directory, i = nxt, i + 1
+        elif word == "-C" and nxt:
+            directory, i = nxt, i + 1
+        elif word.startswith("--"):
+            pass
+        elif word.startswith("-") or (i == 0 and re.fullmatch(r"[A-Za-z]+", word)):
+            letters = word.lstrip("-")
+            if "x" in letters:
+                extract = True
+            if "f" in letters and nxt and not letters.endswith(("C",)):
+                archive, i = nxt, i + 1
+            elif letters.endswith("C") and nxt:
+                directory, i = nxt, i + 1
+        i += 1
+    if not extract:
+        return None
+    return (None if archive in (None, "-") else archive), directory, archive in (None, "-")
+
+
+def _unzip_args(args: list[str]) -> tuple[str | None, str | None]:
+    """``(archive, directory)`` of an unzip call that extracts (not ``-l``, ``-t`` or ``-p``)."""
+    archive, directory, skip = None, None, False
+    for i, word in enumerate(args):
+        if skip:
+            skip = False
+        elif word == "-d" and i + 1 < len(args):
+            directory, skip = args[i + 1], True
+        elif word.startswith("-d") and len(word) > 2:
+            directory = word[2:]
+        elif word.startswith("-"):
+            if re.fullmatch(r"-[A-Za-z]*[ltpvz][A-Za-z]*", word):
+                return None, None
+            skip = word == "-x"
+        elif archive is None:
+            archive = word
+    return archive, directory
