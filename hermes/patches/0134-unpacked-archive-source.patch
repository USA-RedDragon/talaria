+    "cd {d} && curl -fsSL -o a.tgz https://github.com/Themaister/parallel-rdp-standalone/archive/m.tar.gz && mkdir x && tar -czf b.tgz x",
+    "cd {d} && curl -fsSL -o a.tgz https://github.com/Themaister/parallel-rdp-standalone/archive/m.tar.gz && mkdir x && tar -xzf a.tgz -C x2",
+    "cd {d} && curl -fsSL https://pypi.org/simple/x/ -o a.tgz && mkdir x && tar xzf a.tgz -C x",
+    "cd {d} && curl -fsSL -o a.tgz https://github.com/Themaister/parallel-rdp-standalone/archive/m.tar.gz; curl -fsSL -o a.tgz https://dl.example.com/b.tgz; mkdir x; tar xzf a.tgz -C x",
+])
+def test_unpack_without_a_forge_source_offers_nothing(db, strict_judge, tmp_path, fetch):
+    child = _child(db, _calls(fetch.format(d=tmp_path)))
+    verdict = _review(child, BUILD.format(d=tmp_path), tmp_path)
+    assert "grant_sources" not in verdict.detail, fetch
+
+
+def test_the_source_named_without_a_host_follows_the_session_download(db, tmp_path):
+    # The unpack is not one the harness reads (python zipfile), so only the review model's field can name it.
+    child = _child(db, _calls(f"cd {tmp_path} && curl -fsSL -o a.tgz {ARCHIVE} && python3 -c 'import tarfile;tarfile.open(\"a.tgz\").extractall(\"x\")'",
+                              f"cd {tmp_path} && git clone https://gitlab.com/g/other-repo && curl -fsSL -o o.tgz https://gitlab.com/ns/dup/-/archive/m/dup-m.tar.gz"))
+    other = f"cd {tmp_path}/elsewhere && make"
+    for named, want in (("Themaister/parallel-rdp-standalone", [SOURCE]), ("themaister/PARALLEL-rdp-standalone", [SOURCE]),
+                        ("github.com/Themaister/parallel-rdp-standalone", [SOURCE]),
+                        ("Themaister/other-repo", None), ("g/other-repo", ["gitlab.com/g/other-repo"]),
+                        ("ns/dup", ["gitlab.com/ns/dup"]), ("Themaister/*", None), ("Themaister/parallel-rdp-standalone, o/r", None),
+                        ("evil.example/Themaister/parallel-rdp-standalone", None), ("Themaister", None)):
+        A.set_complete_override(_judge(named))
+        try:
+            verdict = _review(child, other, tmp_path)
+        finally:
+            A.set_complete_override(None)
+        assert verdict.detail.get("grant_sources") == want, named
+
+
+def test_a_bare_name_is_not_a_source_without_any_download(db, tmp_path):
+    child = _child(db, _calls(f"cd {tmp_path} && ls"))
+    A.set_complete_override(_judge("Themaister/parallel-rdp-standalone"))
+    try:
+        verdict = _review(child, f"cd {tmp_path}/elsewhere && make", tmp_path)
+    finally:
+        A.set_complete_override(None)
+    assert "grant_sources" not in verdict.detail
