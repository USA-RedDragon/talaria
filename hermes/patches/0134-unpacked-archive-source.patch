+def bare_repo_source(text: str, fetched: list[str]) -> tuple[str, str] | None:
+    """``(identity, display)`` for a source the review model named as ``owner/repo`` without a host, when exactly
+    one forge repo the session fetched (``fetched``: clone and download URLs) has that owner and repo; never a
+    guess: no match, two forges, or a wildcard give ``None``."""
+    ref = text.strip() if isinstance(text, str) else ""
+    if not _BARE_REPO.fullmatch(ref) or ".." in ref.split("/"):
+        return None
+    want = ref.lower()
+    found: dict[str, str] = {}
+    for url in fetched:
+        ident = forge_repo(url)
+        if ident and ident.split("/", 1)[1] == want:
+            found[ident] = forge_repo_display(url) or ident
+    return next(iter(found.items())) if len(found) == 1 else None
+
+
+def forge_repo_display(url: str) -> str | None:
+    return url_source(url, display=True) if forge_repo(url) else None
+
+
 def fetch_identity(ref: str) -> str | None:
     """The identity of a source a command or a clone names (see ``url_source``)."""
     return url_source(ref)
