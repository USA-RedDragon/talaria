diff --git a/tests/tui_gateway/test_tui_gateway_server.py b/tests/tui_gateway/test_tui_gateway_server.py
index 2ce61623..fbb79c4e 100644
--- a/tests/tui_gateway/test_tui_gateway_server.py
+++ b/tests/tui_gateway/test_tui_gateway_server.py
@@ -3009,6 +3009,7 @@ def test_history_to_messages_projects_a_skill_turn_to_its_invocation():
             "role": "user",
             "text": "/work fix the title leak",
             "display_kind": "skill_invocation",
+            "skill_text": scaffolded,
         },
         {"role": "assistant", "text": "on it"},
     ]
@@ -3022,10 +3023,30 @@ def test_history_to_messages_projects_a_bare_skill_turn_to_the_command():
     )
 
     assert server._history_to_messages([{"role": "user", "content": scaffolded}]) == [
-        {"role": "user", "text": "/work", "display_kind": "skill_invocation"}
+        {"role": "user", "text": "/work", "display_kind": "skill_invocation", "skill_text": scaffolded}
     ]
 
 
+def test_history_to_messages_keeps_a_stacked_skill_turn_body_in_skill_text():
+    stacked = (
+        '[IMPORTANT: The user has invoked the "/a /b" stacked skill bundle, loading 2 skills together. '
+        "Treat every skill below as active guidance for this turn.]\n\n"
+        "Skills loaded: a, b\n\nUser instruction: compare them\n\n"
+        '[Loaded as part of the stacked skill invocation "a".]\n\n# A\n\n'
+        '[Loaded as part of the stacked skill invocation "b".]\n\n# B'
+    )
+
+    assert server._history_to_messages([{"role": "user", "content": stacked}]) == [
+        {"role": "user", "text": "/a /b compare them", "display_kind": "skill_invocation", "skill_text": stacked}
+    ]
+
+
+def test_history_to_messages_gives_ordinary_user_rows_no_skill_text():
+    rows = server._history_to_messages([{"role": "user", "content": "/work fix it"}])
+
+    assert rows == [{"role": "user", "text": "/work fix it"}]
+
+
 def test_expand_skill_invocation_for_replay_round_trips_the_projection(
     tmp_path, monkeypatch
 ):
