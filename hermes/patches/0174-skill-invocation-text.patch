+++ b/tui_gateway/contracts/common.py
@@ -169,6 +169,8 @@ class TranscriptMessage(OpenModel):
     """One transcript row as the gateway PROJECTS it for renderers (``session_history._project_history``):
     ``text``, display-only ``timestamp`` / ``display_kind`` / ``display_metadata``, the durable ``row_id``
     rewind targets, and for tool rows raw ``content``, ``tool_call_id``, ``name``, ``context`` and ``args``.
+    A ``display_kind: "skill_invocation"`` row's ``text`` is the command the user typed and ``skill_text`` the
+    expanded skill message the model got, so a client can show it apart from the user's words.
     Assistant detail sidecars (``reasoning``, …) ride as extra keys."""
 
     role: str
@@ -179,6 +181,7 @@ class TranscriptMessage(OpenModel):
     row_id: int | None = None
     display_kind: str | None = None
     display_metadata: JsonValue | None = None
+    skill_text: str | None = None
     name: str | None = None
     context: str | None = None
     args: dict[str, JsonValue] | None = None
diff --git a/tui_gateway/session_history.py b/tui_gateway/session_history.py
index 5b8c8a25..2aae36c7 100644
--- a/tui_gateway/session_history.py
+++ b/tui_gateway/session_history.py
@@ -406,10 +406,11 @@ def _history_to_messages(history: list[dict], *, profile_home=None, image_urls:
         # Durable row identity (_rows_to_conversation); reactions etc. address persisted messages by it.
         if m.get("_row_id") is not None:
             msg["row_id"] = m["_row_id"]
-        # A user turn shows its skill invocation, never the expanded body (rewind re-sends by ordinal).
+        # A user turn shows its skill invocation, never the expanded body (rewind re-sends by ordinal);
+        # the body rides apart in ``skill_text`` for a client that shows it as its own card.
         invocation = _skill_scaffold_projection(content_text) if role == "user" else ""
         if invocation:
-            msg.update(text=invocation, display_kind="skill_invocation")
+            msg.update(text=invocation, display_kind="skill_invocation", skill_text=content_text)
         if role == "assistant":
             msg.update((key, m[key]) for key in _HISTORY_ASSISTANT_DETAIL_KEYS if m.get(key) is not None)
         # Display-only timeline metadata (model switches, delegation events).
