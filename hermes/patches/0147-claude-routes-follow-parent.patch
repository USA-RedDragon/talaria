+"""A route marked ``family: claude`` runs on its parent chat's Anthropic API-key provider when the chat is on one,
+and on its own provider (the account pool) otherwise. Real ``delegate_task`` and route resolution; the child's
+construction is stubbed, and the runtime provider answers for the providers named here."""
+
+import json
+import threading
+from types import SimpleNamespace
+from unittest.mock import MagicMock, patch
+
+import pytest
+
+from agent.delegation_provider import DelegationProvider
+
+API = "https://api.anthropic.com"
+POOL_URL = "process://claude-pool"
+OPTIONS = [
+    {"name": "local", "provider": "custom", "base_url": "http://ollama:11434/v1", "model": "qwen3:27b"},
+    {"name": "sonnet", "provider": "claude-pool", "model": "claude-sonnet-5-5", "family": "claude"},
+    {"name": "opus", "provider": "claude-pool", "model": "claude-opus-5-5", "family": "claude"},
+    {"name": "plain", "provider": "claude-pool", "model": "claude-haiku-5-5"},
+    {"name": "kimi", "provider": "deepinfra", "model": "moonshotai/Kimi-K3"},
+]
+CFG = {"backends": {"route-family": {"options": OPTIONS}}}
+
+
+class _Backend(DelegationProvider):
+    @property
+    def name(self):
+        return "route-family"
+
+    def task_parameters(self, config):
+        return {"option": {"type": "string", "enum": [o["name"] for o in OPTIONS] + ["opus (help)"]}}
+
+    def route_task(self, task, config):
+        entry = next(o for o in OPTIONS if o["name"] == task["option"].split(" ")[0])
+        route = {k: v for k, v in entry.items() if k in ("provider", "model", "base_url")}
+        return {**route, "label": task["option"]}
+
+
+def _runtime(requested=None, target_model=None, **_):
+    urls = {"claude-pool": POOL_URL, "claude-api-caam": API, "claude-api-jaam": API,
+            "deepinfra": "https://api.deepinfra.com/v1/openai"}
+    return {"provider": requested, "base_url": urls[requested], "api_key": f"key-{requested}",
+            "api_mode": "anthropic_messages" if requested.startswith("claude") else "chat_completions"}
+
+
+def _parent(provider, api_mode="anthropic_messages", base_url=API, account=None):
+    parent = MagicMock()
+    parent.provider, parent.requested_provider, parent.api_mode, parent.base_url = provider, provider, api_mode, base_url
+    parent.api_key, parent.model, parent.platform = "parent-key", "claude-sonnet-5-5", "cli"
+    parent.request_overrides = {}
+    parent.reasoning_config = {"enabled": True, "effort": "medium"}
+    parent.providers_allowed = parent.providers_ignored = parent.providers_order = parent.provider_sort = None
+    parent._session_db, parent._delegate_depth, parent._active_children = None, 0, []
+    parent._active_children_lock = threading.Lock()
+    parent._print_fn = parent.tool_progress_callback = parent.thinking_callback = None
+    if account is not None:
+        parent._delegate_claude_account = account
+    return parent
+
+
+def _construct(**kwargs):
+    child = MagicMock()
+    child.request_overrides = dict(kwargs.get("request_overrides") or {})
+    child.provider, child.model = kwargs.get("provider"), kwargs.get("model")
+    child.reasoning_config, child.service_tier = kwargs.get("reasoning_config"), kwargs.get("service_tier")
+    return child
+
+
+def _spawn(parent, options):
+    batches = []
+    with (
+        patch("tools.delegate_tool._load_config", return_value=CFG),
+        patch("tools.delegate_tool_routes._active_provider", return_value=_Backend()),
+        patch("hermes_cli.runtime_provider.resolve_runtime_provider", side_effect=_runtime),
+        patch("run_agent.AIAgent", side_effect=_construct) as agent,
+        patch("tools.delegate_tool._run_batch",
+              side_effect=lambda batch, background: batches.append(batch) or json.dumps({"status": "built"})),
+    ):
+        from tools.delegate_tool import delegate_task
+        result = json.loads(delegate_task(tasks=[{"goal": f"investigate failing build number {i} in the repo", "option": o} for i, o in enumerate(options)],
+                                          parent_agent=parent))
+    assert result == {"status": "built"}
+    return [(c.kwargs["provider"], c.kwargs["model"]) for c in agent.call_args_list], [c for _, _, c in batches[0].children]
+
+
+def test_a_chat_on_an_api_key_provider_runs_its_claude_routes_on_that_provider_with_the_routes_model():
+    built, _ = _spawn(_parent("claude-api-caam"), ["sonnet", "opus"])
+    assert built == [("claude-api-caam", "claude-sonnet-5-5"), ("claude-api-caam", "claude-opus-5-5")]
+
+
+def test_a_chat_on_the_pool_keeps_the_routes_own_provider():
+    built, _ = _spawn(_parent("claude-pool", base_url=POOL_URL), ["sonnet"])
+    assert built == [("claude-pool", "claude-sonnet-5-5")]
+
+
+def test_routes_not_marked_claude_keep_their_provider_for_an_api_parent():
+    built, _ = _spawn(_parent("claude-api-caam"), ["local", "plain", "kimi", "sonnet"])
+    assert built == [("custom", "qwen3:27b"), ("claude-pool", "claude-haiku-5-5"),
+                     ("deepinfra", "moonshotai/Kimi-K3"), ("claude-api-caam", "claude-sonnet-5-5")]
+
+
+@pytest.mark.parametrize("parent", [
+    _parent("openrouter", "chat_completions", "https://openrouter.ai/api/v1"),
+    _parent("minimax", "anthropic_messages", "https://api.minimax.io/anthropic"),
+])
+def test_only_an_anthropic_api_key_chat_is_followed(parent):
+    built, _ = _spawn(parent, ["sonnet"])
+    assert built == [("claude-pool", "claude-sonnet-5-5")]
+
+
+def test_a_help_label_follows_its_routes_family():
+    built, _ = _spawn(_parent("claude-api-jaam"), ["opus (help)"])
+    assert built == [("claude-api-jaam", "claude-opus-5-5")]
+
+
+def test_the_route_line_names_the_account_that_ran():
+    from tools.delegate_tool_child_run import route_text
+
+    _, (child,) = _spawn(_parent("claude-api-caam"), ["sonnet"])
+    child._delegate_route = {"backend": "route-family", "label": "sonnet"}
+    assert route_text(child) == "route sonnet: claude-sonnet-5-5 via claude-api-caam"
+
+
+def test_a_nested_child_keeps_the_chats_choice_even_under_a_helper_on_another_route():
+    _, (kimi,) = _spawn(_parent("claude-api-caam"), ["kimi"])
+    assert kimi._delegate_claude_account == "claude-api-caam"
+    under_kimi = _parent("deepinfra", "chat_completions", "https://api.deepinfra.com/v1/openai",
+                         account=kimi._delegate_claude_account)
+    built, (grandchild,) = _spawn(under_kimi, ["opus"])
+    assert built == [("claude-api-caam", "claude-opus-5-5")] and grandchild._delegate_claude_account == "claude-api-caam"
+    _, (pool_child,) = _spawn(_parent("claude-pool", base_url=POOL_URL), ["kimi"])
+    assert pool_child._delegate_claude_account == ""
+    built, _ = _spawn(_parent("deepinfra", "chat_completions", "x", account=pool_child._delegate_claude_account), ["opus"])
+    assert built == [("claude-pool", "claude-opus-5-5")]
+
+
+def test_a_nested_child_of_an_api_child_follows_it_directly():
+    built, _ = _spawn(_parent("claude-api-caam"), ["sonnet"])
+    nested, _ = _spawn(_parent(built[0][0]), ["opus"])
+    assert nested == [("claude-api-caam", "claude-opus-5-5")]
+
+
+def test_a_resumed_subagent_keeps_the_provider_it_ran_on_even_when_the_chat_moved_to_the_pool():
+    from tools.delegate_tool_handoff import _ResumedUnit, _ResumeParent, _parent_snapshot, _route_spec
+    from tools.delegate_tool_routes import resolve_task_routes
+
+    with (patch("hermes_cli.runtime_provider.resolve_runtime_provider", side_effect=_runtime),
+          patch("tools.delegate_tool_routes._active_provider", return_value=_Backend())):
+        (route,), _ = resolve_task_routes([{"goal": "g", "option": "sonnet"}], CFG, _parent("claude-api-caam"))
+        saved = _route_spec(route)
+        assert saved["route"]["provider"] == "claude-api-caam" and "reask" not in saved
+        snap = _parent_snapshot(_parent("claude-pool", base_url=POOL_URL))
+        parent = _ResumeParent(snap, None)
+        resumed = _ResumedUnit._route(SimpleNamespace(), 0, {"route": saved}, parent, CFG)
+    assert resumed.creds["provider"] == "claude-api-caam" and resumed.creds["model"] == "claude-sonnet-5-5"
+    assert resumed.creds["api_key"] == "key-claude-api-caam"
+
+
+def test_a_resumed_parent_keeps_the_chats_choice():
+    from tools.delegate_tool_handoff import _ResumeParent, _parent_snapshot
+    from tools.delegate_tool_claude import parent_claude_account
+
+    under_kimi = _parent("deepinfra", "chat_completions", "https://api.deepinfra.com/v1/openai", account="claude-api-jaam")
+    snap = json.loads(json.dumps(_parent_snapshot(under_kimi), default=str))
+    assert parent_claude_account(_ResumeParent(snap, None)) == "claude-api-jaam"
+
+
+def test_a_stored_subagent_resumed_by_id_keeps_the_provider_it_ran_on():
+    from tools.delegate_tool_resume import _stored_route
+
+    row = {"model": "claude-sonnet-5-5", "billing_provider": "claude-api-caam", "billing_base_url": API}
+    route = _stored_route(row, _parent("claude-pool", base_url=POOL_URL))["route"]
+    assert route == {"model": "claude-sonnet-5-5", "provider": "claude-api-caam", "base_url": API}
