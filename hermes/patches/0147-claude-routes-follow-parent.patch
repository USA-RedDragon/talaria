+++ b/tools/delegate_tool_claude.py
@@ -0,0 +1,67 @@
+"""A Claude route runs on the same Claude provider as its parent chat when that chat is on an Anthropic API key.
+
+A ``delegation.backends.<backend>.options`` entry marked ``family: claude`` is a Claude route: it names the account
+pool (or any one provider) for the chats that run there, and keeps its model. A chat on an Anthropic API-key
+provider (``api_mode: anthropic_messages`` on api.anthropic.com, not the pool) pays for its own subagents: the route
+takes that provider instead, so the account the user picked is the one billed. Nothing else changes, and nothing
+falls back from one side to the other: a route that fails keeps its error.
+"""
+
+from __future__ import annotations
+
+from typing import Any, Mapping, Optional
+
+from utils import base_url_hostname
+
+FAMILY_KEY = "family"
+CLAUDE_FAMILY = "claude"
+CLAUDE_POOL = "claude-pool"
+ANTHROPIC_API_HOST = "api.anthropic.com"
+_POOL_ROUTE_KEYS = ("base_url", "api_key", "api_mode")
+
+
+def _name(value: Any) -> str:
+    return value.strip() if isinstance(value, str) else ""
+
+
+def parent_claude_account(parent_agent: Any) -> Optional[str]:
+    """The Anthropic API-key provider a chat's Claude subagents run on, or None for any other chat. A subagent
+    carries its parent's answer (``_delegate_claude_account``, ``""`` for none), so a helper on another route still
+    hands its own helpers the chat's choice."""
+    inherited = getattr(parent_agent, "_delegate_claude_account", None)
+    if isinstance(inherited, str):
+        return inherited or None
+    provider = _name(getattr(parent_agent, "requested_provider", None)) or _name(getattr(parent_agent, "provider", None))
+    if not provider or CLAUDE_POOL in (provider.lower(), _name(getattr(parent_agent, "provider", None)).lower()):
+        return None
+    if _name(getattr(parent_agent, "api_mode", None)).lower() != "anthropic_messages":
+        return None
+    if base_url_hostname(_name(getattr(parent_agent, "base_url", None))) != ANTHROPIC_API_HOST:
+        return None
+    return provider
+
+
+def _claude_option(label: Any, settings: Any) -> bool:
+    """Whether ``label`` (an option's name, or ``<name> (help)``) is an option marked ``family: claude``."""
+    options = settings.get("options") if isinstance(settings, Mapping) else None
+    if not isinstance(label, str) or not isinstance(options, list):
+        return False
+    best: Optional[Mapping[str, Any]] = None
+    for entry in options:
+        name = _name(entry.get("name")) if isinstance(entry, Mapping) else ""
+        if name and (label == name or label.startswith(name + " ")) and (best is None or len(name) > len(best["name"])):
+            best = entry
+    return best is not None and _name(best.get(FAMILY_KEY)).lower() == CLAUDE_FAMILY
+
+
+def follow_parent_claude(route: dict[str, Any], backend: str, config: Mapping[str, Any], parent_agent: Any,
+                         ) -> dict[str, Any]:
+    """``route`` on the parent's API-key provider when it is a Claude route and the parent runs on one; else as is."""
+    backends = config.get("backends") if isinstance(config, Mapping) else None
+    settings = backends.get(backend) if isinstance(backends, Mapping) else None
+    if route.get("profile") or not _claude_option(route.get("label"), settings):
+        return route
+    account = parent_claude_account(parent_agent)
+    if not account:
+        return route
+    return {**{k: v for k, v in route.items() if k not in _POOL_ROUTE_KEYS}, "provider": account}
