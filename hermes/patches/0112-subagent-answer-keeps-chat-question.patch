diff --git a/tests/gateway/fixtures/subagent_answer_peer.py b/tests/gateway/fixtures/subagent_answer_peer.py
new file mode 100644
index 00000000..74df0e0b
--- /dev/null
+++ b/tests/gateway/fixtures/subagent_answer_peer.py
@@ -0,0 +1,173 @@
+"""Owned loopback model, real gateway, one hub-shaped viewer: a subagent asks in turn 1, the chat's own agent
+asks in turn 2, and the viewer answers the subagent's card with that card's own (older) generation."""
+import asyncio
+from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
+import json
+import os
+from pathlib import Path
+import threading
+import time
+import traceback
+
+
+def _call(name, args):
+    return {'index': 0, 'id': f'call-{name}', 'type': 'function',
+            'function': {'name': name, 'arguments': json.dumps(args)}}
+
+
+def _script(messages):
+    """The model: the subagent asks once; the chat delegates in turn 1 and asks in turn 2."""
+    users = [i for i, m in enumerate(messages) if m['role'] == 'user']
+    tail = messages[users[-1]:] if users else messages
+    called = [c['function']['name'] for m in tail if m['role'] == 'assistant' for c in (m.get('tool_calls') or [])]
+    if any('CHILDGOAL' in str(m.get('content', '')) for m in messages if m['role'] == 'user'):
+        return None if 'clarify' in called else _call('clarify', {'questions': [
+            {'question': 'Which lane?', 'choices': ['lane-a', 'lane-b']}]})
+    if len(users) < 2:
+        return None if 'delegate_task' in called else _call('delegate_task', {'goal': 'CHILDGOAL ask the user'})
+    return None if 'clarify' in called else _call('clarify', {'questions': [
+        {'question': 'Ship it?', 'choices': ['ship', 'hold']}]})
+
+
+class ModelPeer(BaseHTTPRequestHandler):
+    def log_message(self, *args):
+        pass
+
+    def do_GET(self):
+        self.send_response(200)
+        self.end_headers()
+        self.wfile.write(b'{"data": []}')
+
+    def do_POST(self):
+        body = json.loads(self.rfile.read(int(self.headers['Content-Length'])))
+        messages = body.get('messages', [])
+        call = _script(messages) if body.get('tools') else None
+        if body.get('tools'):
+            self.server.requests.append(messages)
+        message = ({'role': 'assistant', 'content': None, 'tool_calls': [call]} if call
+                   else {'role': 'assistant', 'content': 'DONE'})
+        finish = 'tool_calls' if call else 'stop'
+        self.send_response(200)
+        self.send_header('Content-Type', 'text/event-stream' if body.get('stream') else 'application/json')
+        self.end_headers()
+        if body.get('stream'):
+            for delta, fin in [(message, None), ({}, finish)]:
+                frame = {'id': 'local', 'object': 'chat.completion.chunk', 'created': 1, 'model': 'local',
+                         'choices': [{'index': 0, 'delta': delta, 'finish_reason': fin}]}
+                self.wfile.write(('data: ' + json.dumps(frame) + '\n\n').encode())
+            self.wfile.write(b'data: [DONE]\n\n')
+        else:
+            self.wfile.write(json.dumps({'id': 'local', 'choices': [
+                {'index': 0, 'message': message, 'finish_reason': finish}]}).encode())
+        self.wfile.flush()
+
+
+async def probe(peer):
+    import websockets
+    from gateway.run import GatewayRunner
+    from gateway.run_api import start_gateway_api, stop_gateway_api
+    from gateway.session_authority import initialize_session_authority
+    from hermes_cli import web_server
+    from tools import clarify_gateway
+
+    runner = GatewayRunner()
+    authority = await initialize_session_authority(runner, profile_id='fixture', instance_id='subagent-answer')
+    api = await start_gateway_api(runner)
+    url = api.api_origin.replace('http:', 'ws:') + '/api/ws?token=' + web_server._SESSION_TOKEN
+    ws = await websockets.connect(url, max_size=None)
+    frames, waiters, ids = [], {}, iter(range(1, 1000))
+
+    async def reader():
+        async for raw in ws:
+            frame = json.loads(raw)
+            if frame.get('id') in waiters and 'method' not in frame:
+                waiters.pop(frame['id']).set_result(frame)
+            else:
+                frames.append(frame.get('params') or {})
+
+    task = asyncio.create_task(reader())
+
+    async def rpc(method, **params):
+        rid = next(ids)
+        waiters[rid] = asyncio.get_running_loop().create_future()
+        await ws.send(json.dumps({'jsonrpc': '2.0', 'id': rid, 'method': method, 'params': params}))
+        return await asyncio.wait_for(waiters[rid], 20)
+
+    async def until(pred, what, timeout=30):
+        deadline = time.monotonic() + timeout
+        while not (found := pred()):
+            if time.monotonic() > deadline:
+                raise AssertionError(f'{what} never came')
+            await asyncio.sleep(.05)
+        return found
+
+    def requests(subagent):
+        return [f['payload'] for f in frames if f.get('type') == 'clarify.request'
+                and bool(f['payload'].get('subagent')) == subagent]
+
+    sid = None
+    try:
+        sid = (await rpc('session.create', request_id='fixture-create', source='gui'))['result']['session_id']
+        await rpc('session.resume', session_id=sid)
+        await rpc('prompt.submit', session_id=sid, text='start the lane', submission_id='turn-1')
+        child = (await until(lambda: requests(True), "the subagent's question"))[0]
+        await until(lambda: any(f.get('type') == 'message.complete' for f in frames), 'the end of turn 1')
+        await rpc('prompt.submit', session_id=sid, text='now ask me', submission_id='turn-2')
+        main = (await until(lambda: requests(False), "the chat's own question"))[0]
+        assert child['execution_generation'] < main['execution_generation'], (child, main)
+        mark = len(frames)
+        answered = await rpc('clarify.respond', session_id=sid, prompt_id=child['prompt_id'],
+                             execution_generation=child['execution_generation'], answer='lane-a')
+        assert answered['result']['status'] == 'resolved', answered
+        await until(lambda: any('lane-a' in json.dumps(m) for ms in peer.requests for m in ms if m['role'] == 'tool'),
+                    "the subagent's answer reaching its model")
+        await asyncio.sleep(1)
+        settled = [f['payload']['prompt_id'] for f in frames[mark:] if f.get('type') == 'clarify.settled']
+        assert main['prompt_id'] not in settled, f"the chat's question was withdrawn: {settled}"
+        listed = [p['prompt_id'] for p in (await rpc('session.resume', session_id=sid))['result']['prompts']]
+        assert listed == [main['prompt_id']], listed
+        done = await rpc('clarify.respond', session_id=sid, prompt_id=main['prompt_id'],
+                         execution_generation=main['execution_generation'], answer='ship')
+        assert done['result']['status'] == 'resolved', done
+        await until(lambda: any('ship' in json.dumps(m) for ms in peer.requests for m in ms if m['role'] == 'tool'),
+                    "the chat's answer reaching its model")
+        Path(os.environ['HERMES_HOME'], 'subagent-answer-passed').write_text('chat question kept and answered')
+    finally:
+        for live in authority.sessions.values():
+            clarify_gateway.clear_session(live.route)
+        for live in list(authority.sessions.values()):
+            if live.task is not None:
+                try:
+                    await asyncio.wait_for(live.task, 15)
+                except Exception:
+                    pass
+        task.cancel()
+        await ws.close()
+        await stop_gateway_api(api)
+
+
+def main():
+    peer = ThreadingHTTPServer(('127.0.0.1', 0), ModelPeer)
+    peer.requests = []
+    threading.Thread(target=peer.serve_forever, daemon=True).start()
+    url = f'http://127.0.0.1:{peer.server_port}/v1'
+    os.environ.update(OPENAI_API_KEY='loopback-only', OPENAI_BASE_URL=url)
+    Path(os.environ['HERMES_HOME'], 'config.yaml').write_text(
+        f'model:\n  default: local\n  provider: custom\n  base_url: {url}\n'
+        'agent:\n  clarify_timeout: 60\nauxiliary:\n  title_generation:\n    enabled: false\n'
+        'delegation:\n  gateway_mode: background\n')
+    try:
+        asyncio.run(probe(peer))
+    finally:
+        peer.shutdown()
+        peer.server_close()
+
+
+if __name__ == '__main__':
+    status = 0
+    try:
+        main()
+    except BaseException:
+        traceback.print_exc()
+        status = 1
+    os._exit(status)
