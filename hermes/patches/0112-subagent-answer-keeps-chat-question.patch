+"""A subagent's prompt answered with its own (older) generation keeps the chat's open question on the viewers,
+and a question a local chat's viewers cannot be shown returns at once instead of waiting the clarify timeout."""
+import asyncio
+import os
+from pathlib import Path
+import subprocess
+import sys
+import threading
+import time
+from types import SimpleNamespace
+
+import pytest
+
