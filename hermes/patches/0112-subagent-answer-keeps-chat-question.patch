+class _Runner:
+    """Just enough of a TurnRunner to drive one real ``_ask_clarify_question`` through the real delivery chain."""
+
+    def __init__(self, adapter, owner, loop):
+        from gateway.run_turn_runner import TurnRunner
+        self._approval_owner = owner
+        self._ctx = SimpleNamespace(_status_adapter=adapter, session_key='route-local', _status_chat_id='chat',
+                                    _status_thread_metadata=None, _loop_for_step=loop,
+                                    source=SimpleNamespace(platform=Platform.LOCAL, chat_id='chat'),
+                                    stream_consumer_holder=[None])
+        self._send_shared_clarify = TurnRunner._send_shared_clarify.__get__(self)
+        self.ask = TurnRunner._ask_clarify_question.__get__(self)
+
+    def _schedule(self, coro, _message):
+        return asyncio.run_coroutine_threadsafe(coro, self._ctx._loop_for_step)
+
+    def _close_native_stream_boundary(self, *args, **kwargs):
+        return True
+
+    def _stream_consumer(self):
+        return None
+
