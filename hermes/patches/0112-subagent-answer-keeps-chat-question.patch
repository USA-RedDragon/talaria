+@pytest.mark.parametrize('case', ['registration_fails', 'no_owner'])
+def test_a_local_question_no_viewer_can_see_returns_at_once(case, loop, monkeypatch):
+    """A local chat's question reaches a person only as its viewers' card. When that card cannot be
+    registered, the plain-text re-ask went to ``LocalSessionAdapter.send`` (which publishes nothing), was
+    acknowledged, and the agent waited the whole clarify timeout for an answer nobody could give."""
+    from gateway.run_turn_runner_clarify_delivery import UNDELIVERED_NOT_SHOWN
+    from hermes_state_runtime import RuntimeStoreError
+    monkeypatch.setattr(clarify_gateway, 'get_clarify_timeout', lambda: 30)
+
+    def refuse(*args, **kwargs):
+        raise RuntimeStoreError('stale_generation')
+    authority = SimpleNamespace(sessions={}, register_clarify=refuse)
+    owner = None if case == 'no_owner' else (authority, 'chat', 7)
+    runner = _Runner(_local_adapter(), owner, loop)
+    started = time.monotonic()
+    response, answered = runner.ask('Ship it?', ['ship', 'hold'], False)
+    assert (response, answered) == (UNDELIVERED_NOT_SHOWN, False)
+    assert time.monotonic() - started < 10, 'the agent waited for an answer nobody could give'
+    assert 'could not be shown to the user' in response
+    assert not clarify_gateway.has_pending('route-local')
+
