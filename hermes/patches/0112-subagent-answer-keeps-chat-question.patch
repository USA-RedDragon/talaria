+@pytest.mark.parametrize('kind', ['clarify', 'approval'])
+def test_answering_an_older_subagent_prompt_prunes_by_the_running_generation(kind, monkeypatch):
+    from gateway.session_authority import SessionAuthority
+    from gateway.session_pending_controls import PendingControls
+    events = _Events()
+    controls = PendingControls(events)
+    main = clarify_gateway.register('main-q', 'route-k', 'Ship it?', ['ship', 'hold'])
+    try:
+        if kind == 'clarify':
+            sub = clarify_gateway.register('sub-q', 'route-k', 'Which lane?', ['a', 'b'], subagent='lane')
+            controls.register_clarify('s', 4, sub, background=True)
+            answer = {'answer': 'a'}
+        else:
+            import tools.approval as approval
+            monkeypatch.setattr(approval, 'resolve_gateway_approval', lambda *a, **k: True)
+            import gateway.session_pending_controls as spc
+            monkeypatch.setattr(spc, 'list_gateway_approvals', lambda route: [{'request_id': 'sub-q'}])
+            monkeypatch.setattr(spc, 'resolve_gateway_approval', lambda *a, **k: True, raising=False)
+            controls.register('s', 'route-k', 4, {'request_id': 'sub-q', 'command': 'rm x', 'subagent': 'lane'},
+                              background=True)
+            answer = {'choice': 'once'}
+        controls.register_clarify('s', 5, main)
+        actor = object()
+        fake = SimpleNamespace(
+            authorize=lambda *a: None,
+            sessions={'s': SimpleNamespace(event_stream=events, subscribers={'v': actor}, controls=controls)},
+            check_approval_generation=lambda *a: pytest.fail('a subagent prompt is not fenced to a turn'),
+            _handle=lambda ref: SimpleNamespace(execution_generation=5, execution_state='running'))
+        ref = SimpleNamespace(session_id='s')
+        reply = asyncio.run(SessionAuthority.respond(fake, actor, ref, 4, 'sub-q', answer, kind=kind))
+        assert reply['status'] == 'resolved'
+        assert 'main-q' in controls.pending, events.out
+        assert ('clarify.settled', 'main-q') not in events.out
+    finally:
+        clarify_gateway.clear_session('route-k')
+
