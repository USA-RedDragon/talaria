+def test_real_gateway_subagent_answer_keeps_the_chat_question(tmp_path):
+    """Turn 1 spawns a subagent that asks; turn 2's agent asks too. Answering the subagent's card with the
+    generation it carries took the turn's question off every viewer (``clarify.settled``, gone from
+    ``session.resume``) while its clarify tool kept waiting: a running tool card with no form."""
+    home, state = tmp_path / 'home', tmp_path / 'state'
+    home.mkdir()
+    state.mkdir()
+    repo = Path(__file__).resolve().parents[2]
+    env = {key: os.environ[key] for key in ('PATH', 'LANG', 'TZ') if key in os.environ}
+    env.update(HOME=str(home), USERPROFILE=str(home), HERMES_HOME=str(state), PYTHONPATH=str(repo))
+    result = subprocess.run(
+        [sys.executable, str(Path(__file__).parent / 'fixtures' / 'subagent_answer_peer.py')],
+        cwd=repo, env=env, stdin=subprocess.DEVNULL, capture_output=True, text=True, timeout=120, check=False)
+    assert result.returncode == 0, result.stdout + result.stderr
+    assert (state / 'subagent-answer-passed').read_text() == 'chat question kept and answered'
+
