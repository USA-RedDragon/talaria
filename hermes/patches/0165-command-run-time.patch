diff --git a/tools/process_registry_notifications.py b/tools/process_registry_notifications.py
index 643ce07c..2bfafd60 100644
--- a/tools/process_registry_notifications.py
+++ b/tools/process_registry_notifications.py
@@ -497,8 +497,12 @@ def ran_for(seconds: float) -> str:
 
 
 def run_time(seconds: float) -> str:
-    """'2m 14s', '41s', '3h 5m': how long a job ran, to the second below an hour."""
-    seconds = int(max(seconds or 0, 0))
+    """'0.4s', '41s', '2m 14s', '3h 5m': how long a job ran, to a tenth of a second below 10s,
+    to the second below an hour."""
+    seconds = max(float(seconds or 0), 0.0)
+    if seconds < 9.95:
+        return f"{seconds:.1f}s"
+    seconds = round(seconds)
     if seconds < 60:
         return f"{seconds}s"
     minutes, rest = divmod(seconds, 60)
diff --git a/tools/terminal_tool.py b/tools/terminal_tool.py
