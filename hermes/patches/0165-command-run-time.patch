     listed = [e for e in process_registry.list_sessions(include_retained=True) if e["session_id"] == session.id]
@@ -72,11 +73,13 @@ def test_wait_timeout_has_the_start():
     try:
         waited = process_registry.wait(session.id, timeout=1)
         assert waited["status"] == "timeout" and waited["started_at"] == session.started_at
+        assert "ran_for" not in waited
     finally:
         process_registry.kill_process(session.id)
 
 
-@pytest.mark.parametrize("seconds, text", [(0, "0s"), (41, "41s"), (134, "2m 14s"), (120, "2m"), (3900, "1h 5m")])
+@pytest.mark.parametrize("seconds, text", [(0, "0.0s"), (0.04, "0.0s"), (0.43, "0.4s"), (9.94, "9.9s"), (9.96, "10s"),
+                                           (41, "41s"), (134, "2m 14s"), (120, "2m"), (3900, "1h 5m")])
 def test_run_time_text(seconds, text):
     assert run_time(seconds) == text
 
@@ -99,3 +102,37 @@ def test_a_failed_finish_notice_says_how_long_it_ran():
 
 def test_a_notice_without_an_end_time_has_no_run_line():
     assert "Ran for" not in format_process_notification(_event())
+
+
+def _env_config(cwd):
+    return {
+        "env_type": "local", "timeout": 180, "cwd": str(cwd), "host_cwd": None, "modal_mode": "auto",
+        "docker_image": "", "modal_image": "", "daytona_image": "",
+    }
+
+
+@pytest.mark.parametrize("command, low, high", [("true", 0.0, 0.9), ("sleep 1.3", 1.2, 2.4)])
+def test_a_foreground_command_result_says_how_long_it_ran(tmp_path, monkeypatch, command, low, high):
+    from unittest.mock import patch
+
+    from tools.terminal_tool import terminal_tool
+
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path / "hh"))
+    with patch("tools.terminal_tool._get_env_config", return_value=_env_config(tmp_path)), \
+         patch("tools.terminal_tool._start_cleanup_thread"), \
+         patch("tools.terminal_tool._check_all_guards", return_value={"approved": True}):
+        result = json.loads(terminal_tool(command=command, task_id="rt-fg"))
+    assert result["exit_code"] == 0
+    assert result["ran_for"].endswith("s") and low <= float(result["ran_for"][:-1]) <= high
+
+
+def test_a_gateway_completion_event_carries_the_end_time():
+    from types import SimpleNamespace
+
+    from gateway.run_notifications import GatewayNotificationsMixin
+
+    proc = SimpleNamespace(command="make build", output_buffer="ok", exit_code=0, completion_reason="exited",
+                           termination_source="", started_at=1000.0, exited_at=1134.4, owner_task_id="", task_id="")
+    evt = GatewayNotificationsMixin._build_process_completion_event({}, proc, "proc_x")
+    assert evt["exited_at"] == 1134.4
+    assert "Ran for 2m 14s." in format_process_notification(evt)
