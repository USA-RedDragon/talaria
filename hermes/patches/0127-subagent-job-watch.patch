+def _ic_child_tids(agent) -> set:
+    """Thread ids that run this agent's live subagents: their execution threads and tool workers."""
+    lock = getattr(agent, "_active_children_lock", None)
+    children = getattr(agent, "_active_children", None)
+    if lock is None or not isinstance(children, (list, tuple, set)):
