--- a/tools/delegate_tool_child_run.py
+++ b/tools/delegate_tool_child_run.py
@@ -173,6 +173,8 @@ def _attach_child(parent_agent: Any, child: Any) -> None:
     if hard is None or hard.is_set():
         _signal_child_stop(child, message or "parent agent interrupted",
                            tool_reason=getattr(parent_agent, "_tool_interrupt_reason", None) or "parent agent interrupted")
+    elif getattr(parent_agent, "_interrupt_spares_children", False) is True:
+        return  # a user's new message stops the parent's own turn, never its subagents
     else:
         with _quiet("Failed to propagate interrupt to late child: %s"):
             child.interrupt(message)
@@ -962,6 +964,8 @@ class _ChildRun:
             return (getattr(child, "_interrupt_requested", False) is True
                     or getattr(child, "_delegate_restart_handoff", False) is True)
 
+        if failure_entry is None and not stopped() and isinstance(result, dict) and result.get("interrupted"):
+            self.watch_running_jobs()
         while failure_entry is None and waits_of(child):
             message = await_exit(child, self.subagent_id, stopped)
             if message is None:
@@ -972,6 +976,22 @@ class _ChildRun:
                 message=message, history=(result or {}).get("messages"))
         return result, failure_entry, close_deferred
 
+    def watch_running_jobs(self) -> None:
+        """A child whose turn was cut short (an interrupted model call) while a background job of its own still runs
+        would end with nobody watching the job, and its result would be lost. Watch each such job as a
+        ``resume_on_exit`` handoff does, so the child is woken with the exit. A job it chose to keep past its
+        own lifecycle (``persist_on_release``) is left alone."""
+        from tools.delegate_tool_config import _get_max_wait_hours
+        from tools.delegate_tool_wait import watch
+        from tools.process_registry import process_registry
+        if not self.subagent_id:
+            return
+        for session in process_registry.running_owned_by(self.subagent_id):
+            if session.persist_on_release or session.handed_off:
+                continue
+            with _quiet("Failed to watch a running job of a child: %s"):
+                watch(self.child, session, "turn ended while the job was running", _get_max_wait_hours())
+
     def close_steering(self) -> Optional[str]:
         """Close steer acceptance (see ``_merge_late_steer``); returns late steer text, if any."""
         return _close_subagent_steering(self.subagent_id, self.child) if self.subagent_id else None
diff --git a/tools/process_registry.py b/tools/process_registry.py
index c7981535..d1a2213e 100644
--- a/tools/process_registry.py
+++ b/tools/process_registry.py
@@ -2867,6 +2867,30 @@ def _watch_process(session_id: str, args: dict, task_id: str, child: Any) -> dic
             "command": entry["command"], "max_wait_hours": _get_max_wait_hours(), "note": WAIT_NOTE}
 
 
+def _watch_released_wait(session_id: str, result: dict, task_id: Optional[str]) -> dict:
+    """A released ``wait`` promises "you will be notified on exit", which holds only for a process of a top-level
+    chat. A subagent's job is watched only through ``handoff`` with ``resume_on_exit``, so a subagent whose wait was
+    released gets that watch here: the job it was waiting on is then watched when its turn ends, and the subagent is
+    woken with the exit."""
+    if not (isinstance(result, dict) and result.get("status") == "interrupted" and result.get("process_running")):
+        return result
+    from tools.delegate_tool_registry import _active_subagents, _active_subagents_lock
+    with _active_subagents_lock:
+        record = _active_subagents.get(str(task_id or ""))
+    child = record.get("agent") if record else None
+    if child is None:
+        return result
+    watched = _watch_process(session_id, {"data": "released wait"}, str(task_id), child)
+    if watched.get("error"):
+        result["note"] = ("User sent a new message -- wait released; the process is still running. Respond to the "
+                          "user now, and check the process again with process_manage before you finish.")
+        return result
+    result["note"] = ("User sent a new message -- wait released; the process is still running and Hermes watches it "
+                      "for you. Respond to the user now; when you end your turn you are woken with its exit code "
+                      "and output.")
+    return result
+
+
 def _handle_process(args, **kw):
     action = args.get("action", "")
     # Coerce to string — some models send session_id as an integer
@@ -2882,7 +2906,10 @@ def _handle_process(args, **kw):
             return tool_error(f"session_id is required for {action}")
         handler, redact = _SESSION_ACTIONS[action]
         from tools.process_registry_wait_policy import apply_wait_poll_policy
-        result = apply_wait_poll_policy(action, session_id, handler(session_id, args))
+        result = handler(session_id, args)
+        if action == "wait":
+            result = _watch_released_wait(session_id, result, kw.get("task_id"))
+        result = apply_wait_poll_policy(action, session_id, result)
         return json.dumps(_redact_process_result(result) if redact else result, ensure_ascii=False)
     return tool_error(f"Unknown process action: {action}. Use: list, poll, log, wait, kill, write, submit, close, handoff")
 
