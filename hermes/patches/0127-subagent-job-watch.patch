diff --git a/tests/tools/test_subagent_job_watch.py b/tests/tools/test_subagent_job_watch.py
new file mode 100644
index 00000000..a6b15c18
--- /dev/null
+++ b/tests/tools/test_subagent_job_watch.py
@@ -0,0 +1,225 @@
+"""A user message to a chat never stops its subagents, and a subagent's running job is never left unwatched.
+
+A message to the parent chat interrupted the parent's whole spawn tree: a subagent's ``process_manage wait`` was
+released with a note that promised a notification on exit (false for a subagent job), its model call was cut, and its
+turn ended with the job still running and nobody watching it. The subagent then showed as waiting for hours.
+"""
+
+import json
+import threading
+import time
+
+import pytest
+
+from agent.interrupt_control import NEW_MESSAGE_INTERRUPT_REASON, InterruptControlMixin
+from tests.tools.test_delegate_resume_action import (  # noqa: F401  (fixtures)
+    PARENT, SID, _Parent, _call, _clean_state, _completions, _db, _fake_child, _finished_child, seams,
+)
+from tests.waiting import wait_until
+from tools import delegate_tool_wait as wait
+from tools import interrupt as interrupt_mod
+from tools.delegate_tool_registry import _active_subagents
+from tools.process_registry import _handle_process, process_registry
+
+pytestmark = pytest.mark.platforms("linux")
+
+
+class _Agent(InterruptControlMixin):
+    _executing_tools = False
+    _interrupt_requested = False
+    _pending_steer = None
+    _pending_redirect = None
+    api_mode = "chat_completions"
+
+    def __init__(self):
+        self.session_id = "job-watch"
+        self._pending_steer_lock = threading.Lock()
+        self._pending_redirect_lock = threading.Lock()
+        self._tool_worker_threads = set()
+        self._tool_worker_threads_lock = threading.Lock()
+        self._execution_thread_id = None
+        self._active_children = []
+        self._active_children_lock = threading.Lock()
+        self._hard_interrupt_requested = threading.Event()
+        self.quiet_mode = True
+
+
+@pytest.fixture
+def waiting_child(monkeypatch, tmp_path):
+    """A child agent whose tool worker sits in ``process_registry.wait`` on a running job."""
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+    parent, child = _Agent(), _Agent()
+    parent._active_children.append(child)
+    session = process_registry.spawn_local("sleep 30", task_id="child-task", owner_task_id="child-task")
+    out = {}
+
+    def worker():
+        tid = threading.current_thread().ident
+        with child._tool_worker_threads_lock:
+            child._tool_worker_threads.add(tid)
+        out["tid"] = tid
+        out["result"] = process_registry.wait(session.id, timeout=6)
+
+    thread = threading.Thread(target=worker, daemon=True)
+    thread.start()
+    wait_until(lambda: "tid" in out, what="the child's wait to start")
+    time.sleep(0.5)
+    yield parent, child, thread, out
+    process_registry.kill_process(session.id)
+    thread.join(timeout=10)
+
+
+def test_user_message_interrupt_of_the_parent_does_not_release_a_childs_wait(waiting_child):
+    parent, child, thread, out = waiting_child
+    from tui_gateway.session_auto_continue import _interrupt_for_new_message
+
+    _interrupt_for_new_message(parent)  # what the gateway does when a user sends a message to a busy chat
+    time.sleep(1.5)
+    assert parent._interrupt_requested is True
+    assert thread.is_alive() and "result" not in out, out.get("result")
+    assert child._interrupt_requested is False
+    assert not interrupt_mod.is_thread_interrupted(out["tid"])
+
+
+def test_new_message_reason_interrupt_does_not_stop_a_child_either(waiting_child):
+    parent, child, thread, out = waiting_child
+    parent.interrupt("are you there?", tool_reason=NEW_MESSAGE_INTERRUPT_REASON)
+    time.sleep(1.5)
+    assert thread.is_alive() and "result" not in out, out.get("result")
+    assert child._interrupt_requested is False
+
+
+def test_parent_redirect_during_its_tools_does_not_yield_a_childs_wait(waiting_child):
+    parent, child, thread, out = waiting_child
+    parent._executing_tools = True
+    # The child's tool worker also appears among the parent's workers (a child run on the parent's thread).
+    with parent._tool_worker_threads_lock:
+        parent._tool_worker_threads.add(out["tid"])
+    assert parent.redirect("are you there?") is True
+    time.sleep(1.5)
+    assert thread.is_alive() and "result" not in out, out.get("result")
+    assert not interrupt_mod.is_thread_yield_requested(out["tid"])
+
+
+def test_explicit_stop_of_the_parent_still_stops_its_children(waiting_child):
+    parent, child, thread, out = waiting_child
+    parent.hard_interrupt("stop")
+    thread.join(timeout=5)
+    assert not thread.is_alive()
+    assert out["result"]["status"] == "interrupted"
+    assert child._interrupt_requested is True
+
+
+# ── a subagent's job is always watched ─────────────────────────────────────────
+
+
+def _job_child(command, *, interrupted, release_wait=False, persist=False):
+    """First round starts ``command`` as its own job and ends its turn (optionally cut short, optionally after a
+    released wait); every later round records its input and ends."""
+    child = _fake_child()
+    child._interrupt_requested = False
+    child.interrupt.side_effect = lambda *a, **k: setattr(child, "_interrupt_requested", True)
+    seen = {}
+
+    def converse(**kwargs):
+        child.conversations.append(kwargs)
+        if len(child.conversations) == 1:
+            session = process_registry.spawn_local(command, task_id=SID, owner_task_id=SID, persist_on_release=persist)
+            seen["session"] = session
+            if release_wait:
+                interrupt_mod.request_yield(threading.current_thread().ident)
+                seen["wait"] = json.loads(_handle_process({"action": "wait", "session_id": session.id, "timeout": 5},
+                                                          task_id=SID))
+            if interrupted:
+                return {"final_response": "Operation interrupted: waiting for model response (0.0s elapsed).",
+                        "completed": False, "interrupted": True, "api_calls": 1, "messages": []}
+        return {"final_response": "done", "completed": True, "interrupted": False, "api_calls": 1, "messages": []}
+
+    child.run_conversation.side_effect = converse
+    child.seen = seen
+    return child
+
+
+def _run(seams, child):
+    db = _db()
+    _finished_child(db)
+    seams(child)
+    return _call(_Parent(db), subagent_id=SID, message="go")["run_id"]
+
+
+def _waiting() -> bool:
+    return any(r.get("status") == "waiting" for r in _active_subagents.values())
+
+
+def _stop(child):
+    session = child.seen.get("session")
+    if session is not None and not session.exited:
+        process_registry.kill_process(session.id)
+
+
+def test_child_whose_turn_was_cut_short_with_a_job_running_is_woken_on_its_exit(seams):
+    child = _job_child("sleep 2; echo job-output", interrupted=True)
+    run_id = _run(seams, child)
+    try:
+        wait_until(_waiting, what="the child waiting on its job")
+        assert len(child.conversations) == 1 and not child.seen["session"].exited
+        wait_until(lambda: len(child.conversations) == 2, timeout=20, what="the wake-up round")
+        message = child.conversations[1]["user_message"]
+        assert "finished" in message and "exited with code 0" in message and "job-output" in message
+        wait_until(lambda: _completions(run_id), timeout=20, what="completion")
+        assert not _waiting()
+    finally:
+        _stop(child)
+
+
+def test_child_waits_only_while_its_job_runs(seams):
+    child = _job_child("sleep 60", interrupted=True)
+    run_id = _run(seams, child)
+    try:
+        wait_until(_waiting, what="waiting")
+        time.sleep(1.2)
+        assert _waiting() and _completions(run_id) == []
+        process_registry.kill_process(child.seen["session"].id)
+        wait_until(lambda: len(child.conversations) == 2, timeout=20, what="the wake-up round")
+        wait_until(lambda: _completions(run_id), timeout=20, what="completion")
+        assert not _waiting()
+    finally:
+        _stop(child)
+
+
+def test_released_wait_of_a_child_keeps_the_job_watched_and_tells_the_truth(seams):
+    child = _job_child("sleep 2; echo released-output", interrupted=False, release_wait=True)
+    run_id = _run(seams, child)
+    try:
+        wait_until(lambda: "wait" in child.seen, what="the released wait")
+        released = child.seen["wait"]
+        assert released["status"] == "interrupted" and released["process_running"] is True
+        assert "Hermes watches it" in released["note"] and "woken" in released["note"]
+        # The turn ended normally with the job running: the child is woken with the exit, not finished.
+        wait_until(lambda: len(child.conversations) == 2, timeout=20, what="the wake-up round")
+        assert "released-output" in child.conversations[1]["user_message"]
+        wait_until(lambda: _completions(run_id), timeout=20, what="completion")
+    finally:
+        _stop(child)
+
+
+def test_released_wait_of_a_top_level_agent_keeps_the_promise_of_a_notification(tmp_path, monkeypatch):
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+    session = process_registry.spawn_local("sleep 30", task_id="top-task", owner_task_id="top-task")
+    try:
+        interrupt_mod.request_yield(threading.current_thread().ident)
+        result = json.loads(_handle_process({"action": "wait", "session_id": session.id, "timeout": 5},
+                                            task_id="top-task"))
+        assert result["status"] == "interrupted" and "you will be notified on exit" in result["note"]
+    finally:
+        process_registry.kill_process(session.id)
+
+
+def test_child_that_finishes_with_a_job_it_kept_is_not_held_back(seams):
+    child = _job_child("sleep 60", interrupted=False, persist=True)
+    run_id = _run(seams, child)
+    try:
+        wait_until(lambda: _completions(run_id), timeout=20, what="completion")
+        assert wait.waits_of(child) == [] and len(child.conversations) == 1
+    finally:
+        _stop(child)
