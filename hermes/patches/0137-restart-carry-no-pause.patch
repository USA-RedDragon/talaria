+@pytest.mark.asyncio
+async def test_a_relayed_connection_waits_no_longer_than_its_connect_timeout():
+    dead = socket.socket()
+    dead.bind(("127.0.0.1", 0))  # bound, never listening: refused
+    target = dead.getsockname()[:2]
+    sock = _listening()
+    port = sock.getsockname()[1]
+    loop = asyncio.get_running_loop()
+    relay = asyncio.ensure_future(relay_listener(sock, target, 60, connect_timeout=0.5))
+    try:
+        reader, writer = await asyncio.open_connection("127.0.0.1", port)
+        started = loop.time()
+        assert await asyncio.wait_for(reader.read(), 5) == b""
+        assert loop.time() - started < 2.0  # not until the end of the window
+        writer.close()
+    finally:
+        relay.cancel()
+        await asyncio.gather(relay, return_exceptions=True)
+        dead.close()
+
