+        hub_reader, _hw = await _relayed_client(port, "/api/ws?native_dial=browser")
+        (device_code, _), (hub_code, _) = await asyncio.gather(_until_close(device_reader), _until_close(hub_reader))
+        assert device_code == 1001  # the device parks its commands and resumes them on the next gateway
+        assert hub_code == 1012
