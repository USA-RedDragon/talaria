+def test_a_relayed_question_then_restored_here_is_announced_once(owner, tmp_path):
+    from tests.gateway.test_restart_turn_carry import _NextAuthority
+    from gateway.session_authority import LiveSession
+    from hermes_state_runtime import turn_carry_record, begin_turn_carry
+    row, live, _agent = _claimed_turn(owner, "ask")
+    begin_turn_carry(owner.db, epoch=owner.epoch, record={
+        "turns": {row["admission_id"]: {"session_id": "ask", "generation": row["generation"]}}})
+    nxt = _NextAuthority(owner.db)
+    nxt.sessions["ask"] = LiveSession(live.source, live.route)
+    seen = []
+    nxt.sessions["ask"].event_stream.observers.add(lambda frame: seen.append(frame["params"]["type"]))
+    remote = turn_carry._Remote(SimpleNamespace(), nxt, turn_carry_record(owner.db), tmp_path)
+    prompt = {"kind": "clarify", "prompt_id": "q1", "execution_generation": row["generation"], "question": "which?",
+              "choices": ["a"], "multi_select": False}
+    for _ in range(2):  # the open prompt the carrier mirrors first, then the frame it published
+        turn_carry._relay_one(remote, {"type": "clarify.request", "session_id": "ask", "payload": dict(prompt)})
+    # The turn is handed over: its prompt leaves the relay and is listed here under the same id.
+    turn_carry._clear_remote(remote, nxt.sessions["ask"], "ask")
+    entry = SimpleNamespace(clarify_id="q1", question="which?", choices=["a"], multi_select=False,
+                            event=SimpleNamespace(is_set=lambda: False))
+    nxt.sessions["ask"].controls.register_clarify("ask", row["generation"], entry, background=True)
+    assert seen.count("clarify.request") == 1
