+@pytest.mark.asyncio
+async def test_the_hub_socket_keeps_streaming_the_carried_turn_past_the_seal(monkeypatch):
+    from gateway.run_api import KEPT_SCOPE_KEY
+    from tests.gateway.test_restart_socket_close_delay import _successor
+    runner, s = await _kept_socket(monkeypatch)
+    assert s.scope[KEPT_SCOPE_KEY].is_set()
+    await asyncio.sleep(0.3)
+    assert not s.ended.is_set()  # its session (and its subscriptions) live on: no close, no reconnect
+    successor, target, _asked = await _successor(ready_after=0.2)
+    try:
+        loop = asyncio.get_running_loop()
+        s.api.forward_to(target, 10)
+        # The carried turn streams: a frame every 0.3 s for 3 s. The socket stays while it streams.
+        started = loop.time()
+        while loop.time() - started < 3.0:
+            await _send_through(s, {"type": "websocket.send", "text": "delta"})
+            last = loop.time()
+            await asyncio.sleep(0.3)
+            assert not s.ended.is_set()
+        await asyncio.wait_for(s.ended.wait(), 5)
+        from gateway.run_api import KEPT_IDLE_S
+        assert loop.time() - last >= KEPT_IDLE_S - 0.1  # it ended once idle
+        assert s.got[-1] == {"type": "websocket.disconnect", "code": 1012}
+    finally:
+        await successor.cleanup()
+
+
+async def _send_through(s, message):
+    """A frame the session socket's handler sends (a carried turn's event), through the parked send."""
+    await s.app_send[0](message)
+    assert await asyncio.wait_for(s.from_app.get(), 2) == message  # it reaches the client
