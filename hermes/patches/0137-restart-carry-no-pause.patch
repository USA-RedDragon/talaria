+@pytest.mark.asyncio
+async def test_the_standby_opens_its_api_port_early_and_serves_the_waiting_connections(monkeypatch, tmp_path):
+    from aiohttp import web
+    from gateway.config import Platform, PlatformConfig
+    from gateway.platforms import tcp_site
+    from gateway import run_bootstrap
+    monkeypatch.setattr(tcp_site, "_prebound", {})
+    probe = socket.socket()
+    probe.bind(("127.0.0.1", 0))
+    port = probe.getsockname()[1]
+    probe.close()
+    config = GatewayConfig(restart_turn_handoff_per_turn=True)
+    config.platforms[Platform.API_SERVER] = PlatformConfig(enabled=True, extra={"host": "127.0.0.1", "port": port})
+    run_bootstrap._prebind_api_listener(config)
+    assert tcp_site.prebound("127.0.0.1", port)
+    # Another standby in this namespace cannot take the port twice; the gateway being replaced would hold it.
+    assert tcp_site.prebind("127.0.0.1", port + 0) is True  # already ours
+
+    # What the old pod relays now connects and waits; it is not refused.
+    reader, writer = await asyncio.open_connection("127.0.0.1", port)
+    writer.write(b"GET /health HTTP/1.1\r\nHost: x\r\nConnection: close\r\n\r\n")
+    await writer.drain()
+    answer = asyncio.ensure_future(reader.read())
+    await asyncio.sleep(0.3)
+    assert not answer.done()
+
+    async def health(_request):
+        return web.json_response({"ok": True})
+    app = web.Application()
+    app.router.add_get("/health", health)
+    runner = web.AppRunner(app)
+    await runner.setup()
+    try:
+        await tcp_site.start_tcp_site(runner, "127.0.0.1", port, log_tag="test")
+        assert b"200 OK" in await asyncio.wait_for(answer, 5)
+        assert not tcp_site.prebound("127.0.0.1", port)
+    finally:
+        writer.close()
+        await runner.cleanup()
+
