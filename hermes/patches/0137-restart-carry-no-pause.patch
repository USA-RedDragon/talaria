+@pytest.mark.asyncio
+async def test_an_api_request_between_the_restart_and_the_release_waits_and_is_served_by_the_next(monkeypatch):
+    """The carry drains the API server a moment before it releases the profile: a request in between is not
+    answered 503 draining but waits for the release and goes to the next gateway."""
+    from aiohttp import ClientSession, web
+
+    async def old_handler(_request):
+        return web.json_response({"error": "Gateway is draining existing work; retry shortly."}, status=503)
+
+    async def new_handler(_request):
+        return web.json_response({"who": "next"})
+    old_app = web.Application(middlewares=[turn_carry.api_forward_middleware()])
+    old_app.router.add_get("/v1/models", old_handler)
+    old_runner = web.AppRunner(old_app)
+    await old_runner.setup()
+    old_site = web.TCPSite(old_runner, "127.0.0.1", 0)
+    await old_site.start()
+    old_port = old_site._server.sockets[0].getsockname()[1]
+    new_app = web.Application()
+    new_app.router.add_get("/v1/models", new_handler)
+    new_runner = web.AppRunner(new_app)
+    await new_runner.setup()
+    new_site = web.TCPSite(new_runner, "127.0.0.1", 0)
+    await new_site.start()
+    new_port = new_site._server.sockets[0].getsockname()[1]
+    try:
+        monkeypatch.setattr(turn_carry, "_carrying", True)  # the carry began; the profile is not released yet
+        async with ClientSession() as http:
+            pending = asyncio.ensure_future(http.get(f"http://127.0.0.1:{old_port}/v1/models"))
+            await asyncio.sleep(0.3)
+            assert not pending.done()
+            monkeypatch.setattr(turn_carry, "_api_target", ("127.0.0.1", new_port))
+            monkeypatch.setattr(turn_carry, "_released", True)
+            response = await asyncio.wait_for(pending, 5)
+            assert response.status == 200 and await response.json() == {"who": "next"}
+            response.release()
+    finally:
+        await old_runner.cleanup()
+        await new_runner.cleanup()
