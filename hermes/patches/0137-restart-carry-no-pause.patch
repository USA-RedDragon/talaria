+async def _pipe_from_client(reader: asyncio.StreamReader, writer: asyncio.StreamWriter, request: dict) -> None:
+    """:func:`_pipe` that notes the path of the client's request line in ``request["path"]``."""
+    head = bytearray()
+    try:
+        while data := await reader.read(65536):
+            if "path" not in request:
+                head += data
+                if b"\r\n" in head or len(head) > _HEAD_LIMIT:
+                    parts = bytes(head[:head.find(b"\r\n")]).split()
+                    request["path"] = parts[1].split(b"?", 1)[0] if len(parts) > 1 else b""
+                    head.clear()
+            writer.write(data)
+            await writer.drain()
+        if writer.can_write_eof():
+            writer.write_eof()
+    except (OSError, RuntimeError):
+        pass
