+# --- the relay of the old pod's listener ---------------------------------------------------------------------
+
+
+async def _ws_upstream(stream_for=0.0):
+    """The next gateway: answers a WebSocket upgrade with 101, then sends a text frame every 0.2 s for *stream_for*."""
+    async def handle(reader, writer):
+        await reader.readuntil(b"\r\n\r\n")
+        writer.write(b"HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\n\r\n")
+        await writer.drain()
+        loop = asyncio.get_running_loop()
+        end = loop.time() + stream_for
+        try:
+            while loop.time() < end:
+                writer.write(b"\x81\x05delta")
+                await writer.drain()
+                await asyncio.sleep(0.2)
+            await reader.read()  # idle until the relay goes
+        except (OSError, asyncio.CancelledError):
+            pass
+        finally:
+            writer.close()
+    server = await asyncio.start_server(handle, "127.0.0.1", 0)
+    return server, server.sockets[0].getsockname()[:2]
+
+
+async def _relayed_client(port, path):
+    reader, writer = await asyncio.open_connection("127.0.0.1", port)
+    writer.write(f"GET {path} HTTP/1.1\r\nHost: x\r\nUpgrade: websocket\r\nConnection: Upgrade\r\n\r\n".encode())
+    await writer.drain()
+    await reader.readuntil(b"\r\n\r\n")
+    return reader, writer
+
+
+async def _until_close(reader, timeout=10.0):
+    """Read frames until a close frame; returns ``(close code, loop time)``."""
+    loop = asyncio.get_running_loop()
+    buf = b""
+    end = loop.time() + timeout
+    while loop.time() < end:
+        data = await asyncio.wait_for(reader.read(65536), end - loop.time())
+        if not data:
+            return None, loop.time()
+        buf += data
+        while len(buf) >= 2:
+            size = buf[1] & 0x7F
+            if len(buf) < 2 + size:
+                break
+            if buf[0] & 0x0F == 0x8:
+                return int.from_bytes(buf[2:4], "big"), loop.time()
+            buf = buf[2 + size:]
+    raise AssertionError("no close frame")
+
+
+def _listening():
+    sock = socket.socket()
+    sock.bind(("127.0.0.1", 0))
+    sock.listen(16)
+    sock.setblocking(False)
+    return sock
+
