+def test_a_question_listed_again_under_its_id_is_announced_once():
+    live, seen = _controls()
+    entry = SimpleNamespace(clarify_id="q1", question="which?", choices=["a", "b"], multi_select=False,
+                            event=SimpleNamespace(is_set=lambda: False))
+    # The handed-over turn's question restored at startup, then asked again by the resumed turn (new generation).
+    live.controls.register_clarify("c", 4, entry, timeout_s=300, background=True)
+    live.controls.register_clarify("c", 5, entry, timeout_s=290)
+    assert seen.count("clarify.request") == 1
+    assert live.controls.pending["q1"][1]["execution_generation"] == 5  # listed under the running turn
