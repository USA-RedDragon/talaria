diff --git a/gateway/platforms/tcp_site.py b/gateway/platforms/tcp_site.py
index 77c9f698..646e8cde 100644
--- a/gateway/platforms/tcp_site.py
+++ b/gateway/platforms/tcp_site.py
@@ -17,6 +17,51 @@ from gateway.platforms.shared_ingress import is_wildcard_host
 
 logger = logging.getLogger(__name__)
 
+# ``gateway.restart_turn_handoff_per_turn``: listening sockets a standby gateway in its own network namespace (the
+# next pod of a rolling update) opened before it owns the profile, by ``(host, port)``. Connections queue in the
+# backlog until the adapter serves them (:func:`start_tcp_site`), instead of being refused while it starts.
+_prebound: dict[tuple[str, int], socket.socket] = {}
+
+
+def prebind(host: Optional[str], port: int) -> bool:
+    """Open a listening socket on ``host:port`` for :func:`start_tcp_site` to serve later; False when the address
+    is taken (the gateway being replaced holds it in this network namespace) or cannot be bound."""
+    key = (host or "", int(port))
+    if not port or key in _prebound:
+        return key in _prebound
+    try:
+        infos = socket.getaddrinfo(host or None, port, type=socket.SOCK_STREAM, flags=socket.AI_PASSIVE)
+        family, kind, proto, _name, addr = infos[0]
+        sock = socket.socket(family, kind, proto)
+    except OSError:
+        return False
+    try:
+        if sys.platform != "darwin":
+            sock.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
+        sock.bind(addr)
+        sock.listen(256)
+    except OSError:
+        sock.close()
+        return False
+    sock.setblocking(False)
+    _prebound[key] = sock
+    return True
+
+
+def prebound(host: Optional[str], port: int) -> bool:
+    return (host or "", int(port)) in _prebound
+
+
+def close_prebound() -> None:
+    """Close the sockets :func:`prebind` opened and no adapter took (a standby that never took over)."""
+    while _prebound:
+        _key, sock = _prebound.popitem()
+        try:
+            sock.close()
+        except OSError:
+            pass
+
+
 def has_live_listener(host: str, port: int) -> bool:
     """Blocking probe: True when something accepts connections on ``host:port``. Refused = nobody listens;
     any other failure (timeout, unroutable) is treated as live so the caller stays exclusive."""
@@ -47,6 +92,16 @@ async def start_tcp_site(runner: web.BaseRunner, host: Optional[str], port: int,
     foreign listener on a non-loopback interface could not be probed, so it must keep winning."""
     from aiohttp import web
 
+    sock = _prebound.pop((host or "", int(port)), None)
+    if sock is not None:
+        site = web.SockSite(runner, sock)
+        try:
+            await site.start()
+        except OSError:
+            sock.close()
+            raise
+        logger.info("[%s] serving %s:%d on the socket the standby opened", log_tag, host, port)
+        return site
     exclusive = sys.platform == "darwin"
     site = web.TCPSite(runner, host, port, reuse_address=False if exclusive else None)
     try:
