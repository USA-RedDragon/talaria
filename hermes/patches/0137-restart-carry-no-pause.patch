+"""gateway.restart_turn_handoff_per_turn without a pause at the takeover:
+
+- a carried turn's foreground command finishes on the old gateway (it is not moved to the background at SIGTERM),
+  and the background processes go to the next gateway once no carried turn is in a tool round;
+- the hub's socket on the old gateway keeps its session past the seal, so the carried turns' frames reach it without
+  a gap, and it ends once the next gateway is ready and the socket is idle (or the client sends a request, or a turn
+  moved over);
+- a relayed device leg ends with 1001 (the device parks and resumes its commands) instead of 1012 (it kills them),
+  and a relayed session socket is closed only when idle;
+- the standby opens its API port early and publishes it, so API connections relayed by the old pod wait in the
+  backlog instead of being refused or dropped;
+- a prompt listed again under the same id is announced once.
+"""
+import asyncio
+import json
+import socket
+import time
+from types import SimpleNamespace
+
+import pytest
+
+from gateway import turn_boundary, turn_carry, turn_handoff
+from gateway.config import GatewayConfig
+from gateway.listener_relay import relay_listener, successor_api_target, successor_target
+
+from tests.gateway.test_restart_turn_carry import _claimed_turn, _old_runner, _reserve_profile, _until
+
+
+@pytest.fixture(autouse=True)
+def _clean(monkeypatch, tmp_path):
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+    monkeypatch.setattr(turn_handoff, "_handing_off", False)
+    monkeypatch.setattr(turn_boundary, "_resuming", set())
+    monkeypatch.setattr(turn_boundary, "_handed_off", set())
+    monkeypatch.setattr(turn_carry, "_released", False)
+    monkeypatch.setattr(turn_carry, "_api_target", None)
+    monkeypatch.setattr(turn_carry, "_carrying", False)
+
+    async def noop(*_a, **_k):
+        return None
+    for name in ("_stop_cron", "_hand_off_background", "_disconnect_messaging"):
+        monkeypatch.setattr(turn_carry, name, noop)
+
+
+# --- the foreground command of a carried turn ------------------------------------------------------------------
+
+
+@pytest.mark.asyncio
+async def test_a_foreground_command_finishes_on_the_carrier_and_processes_move_after_it(owner, tmp_path, monkeypatch):
+    _reserve_profile(tmp_path)
+    row, live, agent = _claimed_turn(owner, "cmd")
+    agent._executing_tools = True  # a 40 s foreground command runs
+    yields = []
+    agent.request_tool_yield = lambda *a, **k: yields.append(a) or 1
+    handed = []
+    from gateway.run_shutdown import GatewayShutdownMixin
+
+    async def hand_off(runner):
+        handed.append(time.monotonic())
+    monkeypatch.setattr(GatewayShutdownMixin, "_stop_hand_off_processes", staticmethod(hand_off))
+    runner = _old_runner(owner)
+    carry = asyncio.ensure_future(turn_carry.carry_restart(runner))
+    await _until(turn_carry.released)
+    await asyncio.sleep(0.3)
+    # Not moved to the background (its result would be a lie and its device leg would move under it), and the
+    # background processes stay until the command ends: handing them over closes the device's legs.
+    assert yields == []
+    assert handed == []
+    assert turn_carry.keeps_socket(runner, {"type": "websocket", "path": "/api/plugins/device/ws"}) is False  # no key
+    runner.config.restart_wait_plugin_sockets = ["device"]
+    assert turn_carry.keeps_socket(runner, {"type": "websocket", "path": "/api/plugins/device/ws"}) is True
+    assert turn_carry.keeps_socket(runner, {"type": "websocket", "path": "/api/ws"}) is False
+    ended = time.monotonic()
+    agent._executing_tools = False  # the command ends; its real result goes to the model
+    await _until(lambda: handed)
+    assert handed[0] - ended < 1.0
+    assert turn_carry.keeps_socket(runner, {"type": "websocket", "path": "/api/plugins/device/ws"}) is False
+    # The next gateway learns at once that it can reattach them.
+    frames = [json.loads(line) for line in turn_carry.events_path(tmp_path, owner.epoch).read_text().splitlines()]
+    assert any(f.get("type") == turn_carry.PROCESSES_HANDED for f in frames)
+    from hermes_state_runtime import settle_session_input
+    settle_session_input(owner.db, epoch=owner.epoch, admission_id=row["admission_id"],
+                         generation=row["generation"], outcome="completed")
+    await asyncio.wait_for(carry, 5.0)
+    assert len(handed) == 1
+    import os
+    os.close(runner._turn_carry.lock_fd)
+
+
+@pytest.mark.asyncio
+async def test_with_no_tool_round_the_processes_move_before_the_release(owner, tmp_path, monkeypatch):
+    _reserve_profile(tmp_path)
+    row, _live, agent = _claimed_turn(owner, "model")
+    agent._executing_tools = False  # in a model call
+    order = []
+    from gateway.run_shutdown import GatewayShutdownMixin
+
+    async def hand_off(runner):
+        order.append(("processes", turn_carry.released()))
+    monkeypatch.setattr(GatewayShutdownMixin, "_stop_hand_off_processes", staticmethod(hand_off))
+    runner = _old_runner(owner)
+    carry = asyncio.ensure_future(turn_carry.carry_restart(runner))
+    await _until(turn_carry.released)
+    assert order == [("processes", False)]
+    from hermes_state_runtime import settle_session_input
+    settle_session_input(owner.db, epoch=owner.epoch, admission_id=row["admission_id"],
+                         generation=row["generation"], outcome="completed")
+    await asyncio.wait_for(carry, 5.0)
+    import os
+    os.close(runner._turn_carry.lock_fd)
