diff --git a/gateway/standby_warm.py b/gateway/standby_warm.py
new file mode 100644
index 00000000..301fb6e7
--- /dev/null
+++ b/gateway/standby_warm.py
@@ -0,0 +1,184 @@
+"""``gateway.runtime_lock_wait_seconds``: what a standby warms before it takes the profile over.
+
+The gateway that owns the profile records which modules it has imported (its boot, its turns, its
+API server and plugins) in ``$HERMES_HOME/cache/gateway_warm_modules.json``. A standby imports them
+before it waits for the lock, and builds the process-wide state the first turns would otherwise build
+after the takeover (the OpenAI SDK's lazy resources, an HTTP client's TLS context, the parsed
+config). Nothing here opens a profile store, writes in the profile, or caches what the profile may
+still change without a signature check: the config cache is keyed on the file's signature.
+"""
+from __future__ import annotations
+
+import importlib
+import json
+import logging
+import re
+import sys
+import threading
+import time
+from pathlib import Path
+from typing import Iterable, Optional
+
+logger = logging.getLogger(__name__)
+
+WARM_MODULES_FILE = "gateway_warm_modules.json"
+# The owner records once it has served a while, then again whenever it imported more.
+RECORD_FIRST_AFTER_S = 30.0
+RECORD_EVERY_S = 600.0
+MAX_RECORDED_MODULES = 8000
+_NAME = re.compile(r"[A-Za-z_]\w*(\.[A-Za-z_]\w*)*\Z")
+# Never imported by name: the entry point, test and harness modules, interpreter hooks.
+_SKIP_TOP = frozenset({"__main__", "__mp_main__", "tests", "test", "conftest", "_pytest", "pytest",
+                       "sitecustomize", "usercustomize", "pydevd", "_pydevd_bundle", "debugpy"})
+# Imported whether or not a record exists: what the first turns of a fresh gateway import.
+FIRST_TURN_MODULES = (
+    "openai", "openai.types", "openai.resources.chat", "httpx", "agent.agent_init", "agent.conversation_loop",
+    "agent.chat_completion_helpers", "agent.relay_llm", "agent.transports.chat_completions", "agent.system_prompt",
+    "agent.turn_context", "agent.tool_executor", "gateway.run_turn_runner", "gateway.session_execution",
+    "gateway.stream_consumer", "gateway.session_api", "gateway.session_api_turn", "gateway.session_controls",
+    "gateway.session_local_recovery", "gateway.session_admission", "gateway.session_ingress", "gateway.turn_carry",
+    "gateway.turn_boundary", "gateway.turn_handoff", "tui_gateway.ws", "hermes_cli.runtime_provider",
+)
+
+
+def warm_modules_path(home) -> Path:
+    return Path(home) / "cache" / WARM_MODULES_FILE
+
+
+def _recordable(name: str, module) -> bool:
+    if not _NAME.match(name) or name.split(".", 1)[0] in _SKIP_TOP:
+        return False
+    spec = getattr(module, "__spec__", None)
+    # A module a plugin loader built from a file path has no importable name.
+    return spec is not None and getattr(spec, "name", None) == name
+
+
+def record_warm_modules(home, *, previous: int = 0) -> int:
+    """Write the names of the modules this process imported, in import order, when there are more
+    than *previous*. Returns the count recorded (or *previous* when nothing was written)."""
+    names = [name for name, module in list(sys.modules.items()) if _recordable(name, module)]
+    names = names[:MAX_RECORDED_MODULES]
+    if len(names) <= previous:
+        return previous
+    from utils import atomic_json_write
+    path = warm_modules_path(home)
+    path.parent.mkdir(parents=True, exist_ok=True)
+    atomic_json_write(path, {"recorded_at": time.time(), "modules": names}, indent=None)
+    return len(names)
+
+
+def recorded_warm_modules(home) -> list[str]:
+    """The module names the last owner recorded; empty when there is no usable record."""
+    try:
+        data = json.loads(warm_modules_path(home).read_text(encoding="utf-8"))
+    except (OSError, ValueError):
+        return []
+    names = data.get("modules") if isinstance(data, dict) else None
+    if not isinstance(names, list):
+        return []
+    return [n for n in names[:MAX_RECORDED_MODULES]
+            if isinstance(n, str) and _NAME.match(n) and n.split(".", 1)[0] not in _SKIP_TOP]
+
+
+def import_modules(names: Iterable[str]) -> tuple[int, int]:
+    """Import each module not imported yet; (imported, failed). A module that fails or exits at
+    import is left for the boot or the turn that needs it to report."""
+    imported = failed = 0
+    for name in names:
+        if name in sys.modules:
+            continue
+        try:
+            importlib.import_module(name)
+            imported += 1
+        except (Exception, SystemExit):
+            failed += 1
+            logger.debug("Standby warm import of %s failed", name, exc_info=True)
+    return imported, failed
+
+
+def _warm_openai_client() -> None:
+    """The SDK's client class, its lazily built chat resources and an HTTP client's TLS context:
+    the first turn of a fresh gateway builds all three. No request is sent."""
+    from agent.process_bootstrap import _load_openai_cls
+    client = _load_openai_cls()(api_key="standby-warm", base_url="http://127.0.0.1:9/v1", max_retries=0)
+    try:
+        client.chat.completions  # noqa: B018 - builds the cached resource tree
+    finally:
+        client.close()
+
+
+def _warm_config() -> None:
+    """Parse config.yaml into the signature-keyed cache; a later edit changes the signature."""
+    from hermes_cli.config import load_config_readonly
+    load_config_readonly()
+
+
+def _warm_turn_machinery() -> None:
+    """The boot's own turn-machinery warm-up (tool schemas, toolchain probe, the default route's
+    context window). The boot runs it again after the lock and finds its caches filled."""
+    from gateway.run import _warm_turn_machinery_sync
+    _warm_turn_machinery_sync()
+
+
+def _warm_skill_index() -> None:
+    """Parse every skill's frontmatter once (agent.skill_utils keeps the parse by its text): each
+    session a client opens or resumes after the takeover lists the skills."""
+    from gateway.session_local_inventory import _cli_skills
+    from tools.skills_tool import find_all_skills
+    find_all_skills()
+    _cli_skills()
+
+
+def warm_standby(home, config=None) -> dict:
+    """Everything a standby warms beyond the boot imports. Never raises. Under multiplex the turn
+    machinery is left to the boot, which warms it in the launch profile's scope."""
+    started = time.monotonic()
+    result = {"recorded": 0, "imported": 0, "failed": 0}
+    try:
+        recorded = recorded_warm_modules(home)
+        result["recorded"] = len(recorded)
+        imported, failed = import_modules([*FIRST_TURN_MODULES, *recorded])
+        result.update(imported=imported, failed=failed)
+    except Exception:
+        logger.debug("Standby warm imports failed", exc_info=True)
+    steps = [_warm_config, _warm_openai_client, _warm_skill_index]
+    if not getattr(config, "multiplex_profiles", False):
+        steps.append(_warm_turn_machinery)
+    for step in steps:
+        try:
+            step()
+        except (Exception, SystemExit):
+            logger.debug("Standby warm step %s failed", step.__name__, exc_info=True)
+    result["seconds"] = round(time.monotonic() - started, 3)
+    return result
+
+
+def _owns(home) -> bool:
+    from gateway import turn_carry
+    from gateway.runtime_ownership import process_ownership
+    return process_ownership.owns(Path(home)) and not turn_carry.released()
+
+
+def start_warm_module_recorder(home, *, first_after_s: float = RECORD_FIRST_AFTER_S,
+                               every_s: float = RECORD_EVERY_S,
+                               stop: Optional[threading.Event] = None) -> threading.Thread:
+    """The owner's recorder: a daemon thread that writes the record while this process owns the
+    profile, first after *first_after_s*, then every *every_s* when it imported more."""
+    stop = stop or threading.Event()
+
+    def _run() -> None:
+        count = 0
+        delay = first_after_s
+        while not stop.wait(delay):
+            delay = every_s
+            try:
+                if not _owns(home):
+                    return  # released: the profile is the next gateway's now
+                count = record_warm_modules(home, previous=count)
+            except Exception:
+                logger.debug("Could not record the warm module list", exc_info=True)
+
+    thread = threading.Thread(target=_run, daemon=True, name="standby-warm-recorder")
+    thread.stop_event = stop
+    thread.start()
+    return thread
