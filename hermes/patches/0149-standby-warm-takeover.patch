+_FRONTMATTER_MEMO: dict[str, Any] = {}
+_FRONTMATTER_MEMO_MAX = 4096
+_FRONTMATTER_MEMO_LOCK = threading.Lock()
+
+
+def _parse_frontmatter_yaml(yaml_content: str):
+    with _FRONTMATTER_MEMO_LOCK:
+        hit = _FRONTMATTER_MEMO.get(yaml_content, _FRONTMATTER_MEMO)
+    if hit is _FRONTMATTER_MEMO:
+        hit = yaml_load(yaml_content)  # raises on malformed YAML: never memoized
+        with _FRONTMATTER_MEMO_LOCK:
+            if len(_FRONTMATTER_MEMO) >= _FRONTMATTER_MEMO_MAX:
+                _FRONTMATTER_MEMO.pop(next(iter(_FRONTMATTER_MEMO)))
+            _FRONTMATTER_MEMO[yaml_content] = hit
+    return copy.deepcopy(hit)
+
