+async def _max_loop_gap_while(coro):
+    """Run *coro* beside a ticker; the longest the event loop went without running the ticker."""
+    import asyncio
+    stamps = []
+    done = asyncio.Event()
+
+    async def tick():
+        while not done.is_set():
+            stamps.append(time.monotonic())
+            await asyncio.sleep(0)
+    ticker = asyncio.ensure_future(tick())
+    await asyncio.sleep(0)
+    try:
+        await coro
+    finally:
+        done.set()
+        await ticker
+    return max(b - a for a, b in zip(stamps, stamps[1:])), len(stamps)
+
