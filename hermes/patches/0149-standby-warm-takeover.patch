+"""gateway.runtime_lock_wait_seconds: a standby is warm before it takes over (gateway.standby_warm)."""
+import json
+import sys
+import threading
+import time
+
+import pytest
+
+from gateway import run_bootstrap, standby_warm
+
+
+@pytest.fixture
+def home(tmp_path, monkeypatch):
+    home = tmp_path / "home"
+    home.mkdir()
