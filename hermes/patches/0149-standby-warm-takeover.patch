+    from gateway import session_local_recovery as recovery
+    ids = [f"s{i}" for i in range(40)]
+    recovered = []
+    monkeypatch.setattr(recovery, "local_receipt_ids", lambda authority: ids)
+
+    def slow_recover(authority, sid, schedule, orphans):
+        time.sleep(0.01)  # a session's blocking store reads
+        recovered.append(sid)
+    monkeypatch.setattr(recovery, "_recover_local_session", slow_recover)
+    gap, ticks = await _max_loop_gap_while(recovery.recover_local_sessions_yielding(object(), slice_s=0.02))
+    assert recovered == ids  # the same work, in the same order
+    assert gap < 0.1 and ticks > 10
