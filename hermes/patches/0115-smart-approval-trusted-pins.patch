+# Clone options that fetch only the named ref of the named repo; any other option (``--reference``, ``--bundle-uri``,
+# ``--recurse-submodules``, ...) can bring in objects or repos the URL does not name.
+_PINNABLE_CLONE_OPTS = frozenset({"-q", "--quiet", "-v", "--verbose", "--progress", "--depth", "--single-branch",
+                                  "--no-single-branch", "--no-tags", "--tags", "-b", "--branch", "-c", "--config"})
+# git subcommands that move a clone off the ref it was cloned at or change where it fetches from.
+_GIT_MOVES_CLONE = frozenset({"checkout", "switch", "fetch", "pull", "reset", "merge", "rebase", "cherry-pick",
+                              "remote", "submodule", "config", "update-ref", "symbolic-ref", "replace"})
+
+
+def _clone_ref(words: list[str]) -> str:
+    """The branch or tag a git clone checks out (``--branch v0.23.1``), or ``""`` when it names none or has an
+    option that is not a plain fetch of that ref."""
+    ref, skip = "", False
+    for i, w in enumerate(words):
+        if skip:
+            skip = False
+            continue
+        if w == "--":
+            continue
+        if w.startswith("--branch="):
+            ref = w.split("=", 1)[1]
+        elif w.startswith("-"):
+            name = w.split("=", 1)[0]
+            if name not in _PINNABLE_CLONE_OPTS and not re.fullmatch(r"-[qv]+", w):
+                return ""
+            if w in ("-b", "--branch") and i + 1 < len(words):
+                ref = words[i + 1]
+            skip = w in _CLONE_OPTS_WITH_VALUE
+    return ref
+
+
+def _moved_clones(args: list[str], cwd: str | None, refs: dict[str, str]) -> None:
+    """Forget the ref of every recorded clone that a ``git`` command (``args`` after ``git``) moves."""
+    where, i = cwd, 0
+    while i < len(args) and args[i].startswith("-"):
+        if args[i] == "-C" and i + 1 < len(args):
+            where = _abs_path(args[i + 1], where)
+            i += 1
+        elif args[i] in ("-c", "--git-dir", "--work-tree") and i + 1 < len(args):
+            i += 1
+        i += 1
+    if i < len(args) and args[i] in _GIT_MOVES_CLONE and where:
+        for target in [t for t in refs if _inside(where, [t])]:
+            del refs[target]
+
+
