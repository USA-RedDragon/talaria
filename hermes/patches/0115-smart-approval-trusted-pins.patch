+def trusted_pins() -> list[tuple[str, str]]:
+    """``approvals.trusted_pins``: ``<repo URL>@<branch or tag>`` entries (``https://github.com/NousResearch/hermes-agent@v0.23.1``)
+    naming the one ref of an outside repo that is the operator's own variant (a pinned upstream release plus the
+    operator's patches). Only a session clone of that repo at exactly that ref counts; another ref, branch or fork
+    does not. There is no default."""
+    from tools.approval_chat_grants import url_source
+    value = _config().get("trusted_pins")
+    if isinstance(value, str):
+        value = [value]
+    out: list[tuple[str, str]] = []
+    for item in value if isinstance(value, (list, tuple)) else []:
+        url, _, ref = item.strip().rpartition("@") if isinstance(item, str) else ("", "", "")
+        ident = url_source(url, clone=True) if url else None
+        if ident and ref and re.fullmatch(r"[\w][\w./+-]*", ref):
+            out.append((ident, ref))
+    return out
+
+
+def _trusted_pin(url: str, ref: str, pins: list[tuple[str, str]]) -> bool:
+    if not url or not ref or not pins:
+        return False
+    from tools.approval_chat_grants import url_source
+    return (url_source(url, clone=True), ref) in pins
+
+
