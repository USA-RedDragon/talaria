diff --git a/hermes_cli/web_routers/seen_images.py b/hermes_cli/web_routers/seen_images.py
new file mode 100644
index 00000000..7e6a5a63
--- /dev/null
+++ b/hermes_cli/web_routers/seen_images.py
@@ -0,0 +1,32 @@
+"""GET /api/seen-images/{id}: the kept copy of an image Hermes loaded for the model (tools/seen_images.py).
+
+Content-addressed (sha256 of the bytes), so a copy never changes and a client may cache it for good. The id
+is the only input: no path reaches the disk. The caller is authenticated like the other /api routes."""
+
+import asyncio
+
+from fastapi import APIRouter, HTTPException, Request
+from fastapi.responses import Response
+
+from hermes_cli.web_deps import late
+
+router = APIRouter()
+_require_token = late("_require_token")
+
+
+@router.get("/api/seen-images/{image_id}")
+async def get_seen_image(image_id: str, request: Request, size: str = "full"):
+    """The stored copy of image *image_id*; with ``size=thumb`` its thumbnail when it has one."""
+    _require_token(request)
+    from tools import seen_images
+
+    got = await asyncio.to_thread(seen_images.read, image_id, "thumb" if size == "thumb" else "full")
+    if got is None:
+        raise HTTPException(status_code=404, detail="No such image")
+    mime, data = got
+    return Response(content=data, media_type=mime, headers={
+        "Cache-Control": "private, max-age=31536000, immutable",
+        "X-Content-Type-Options": "nosniff",
+        "Content-Disposition": "inline",
+        "Content-Security-Policy": "default-src 'none'; sandbox",
+    })
