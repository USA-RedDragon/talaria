diff --git a/tests/tools/test_seen_images.py b/tests/tools/test_seen_images.py
new file mode 100644
index 00000000..f49dc229
--- /dev/null
+++ b/tests/tools/test_seen_images.py
@@ -0,0 +1,181 @@
+"""Every image Hermes loads for the model keeps a copy, and the tool row records its id.
+
+A client that draws the tool card (the Talaria hub) shows that copy when the file the model looked at is gone,
+outside the chat's folder, on another machine or a subagent's.
+"""
+
+from __future__ import annotations
+
+import asyncio
+import base64
+import hashlib
+import json
+import os
+import time
+from io import BytesIO
+from pathlib import Path
+from types import SimpleNamespace
+from unittest.mock import patch
+
+import pytest
+
+from tests.agent.test_tool_call_incremental_persistence import (
+    _attach_real_session_db, _durable_messages, _make_agent, _mock_tool_call,
+)
+from tools import seen_images
+
+PIL = pytest.importorskip("PIL.Image")
+
+
+@pytest.fixture(autouse=True)
+def _home(tmp_path, monkeypatch):
+    home = tmp_path / "hermes-home"
+    home.mkdir()
+    monkeypatch.setenv("HERMES_HOME", str(home))
+    monkeypatch.setattr(seen_images, "_last_prune", time.time())
+    return home
+
+
+def _png(size=(32, 32), color=(200, 30, 30)) -> bytes:
+    out = BytesIO()
+    PIL.new("RGB", size, color).save(out, "PNG")
+    return out.getvalue()
+
+
+def _noise_png(size) -> bytes:
+    out = BytesIO()
+    PIL.frombytes("RGB", size, os.urandom(size[0] * size[1] * 3)).save(out, "PNG")
+    return out.getvalue()
+
+
+def _envelope(data: bytes, mime="image/png") -> dict:
+    url = f"data:{mime};base64,{base64.b64encode(data).decode()}"
+    return {"_multimodal": True, "content": [{"type": "text", "text": "Image loaded into your context"},
+                                             {"type": "image_url", "image_url": {"url": url}}],
+            "text_summary": "Image attached natively."}
+
+
+def test_collect_keeps_exactly_the_bytes_the_model_got():
+    data = _png()
+    got = seen_images.collect(_envelope(data))
+    assert [g["id"] for g in got] == [hashlib.sha256(data).hexdigest()]
+    assert got[0]["mime"] == "image/png" and got[0]["bytes"] == len(data) and (got[0]["w"], got[0]["h"]) == (32, 32)
+    assert seen_images.read(got[0]["id"]) == ("image/png", data)
+    # Content-addressed: the same bytes again are the same record and one stored copy.
+    assert seen_images.collect(_envelope(data)) == got
+    assert len(list(seen_images.root().rglob("*.img"))) == 1
+
+
+def test_a_large_image_has_a_capped_thumbnail_and_the_full_image():
+    data = _noise_png((1400, 900))
+    rec = seen_images.collect(_envelope(data))[0]
+    assert rec["thumb"] is True
+    mime, thumb = seen_images.read(rec["id"], "thumb")
+    assert mime == "image/jpeg" and len(thumb) <= seen_images.THUMB_BYTES
+    with PIL.open(BytesIO(thumb)) as im:
+        assert max(im.size) <= seen_images.THUMB_EDGE
+    assert seen_images.read(rec["id"]) == ("image/png", data)
+
+
+def test_anthropic_style_parts_non_images_and_bad_ids_are_handled():
+    data = _png(color=(1, 2, 3))
+    part = {"type": "image", "source": {"type": "base64", "media_type": "image/png",
+                                         "data": base64.b64encode(data).decode()}}
+    assert seen_images.collect([part])[0]["id"] == hashlib.sha256(data).hexdigest()
+    assert seen_images.collect(_envelope(b"not an image at all")) == []
+    assert seen_images.collect("plain text") == [] and seen_images.collect(None) == []
+    assert seen_images.read("../../etc/passwd") is None
+    assert seen_images.read("0" * 64) is None
+
+
+def test_the_json_result_of_the_auxiliary_vision_path_names_its_copies():
+    data = _png(color=(9, 9, 9))
+    rec = seen_images.collect(_envelope(data))[0]
+    text = json.dumps({"success": True, "analysis": "a red square", "seen_images": [rec, {"id": "../x"}]})
+    assert seen_images.collect(text) == seen_images.clean([rec])
+    assert [r["id"] for r in seen_images.collect(text)] == [rec["id"]]
+
+
+def test_prune_drops_old_copies_and_keeps_the_total_under_the_cap(monkeypatch):
+    old, new = seen_images.store(_png(color=(1, 1, 1))), seen_images.store(_png(color=(2, 2, 2)))
+    for p in seen_images._paths(old["id"]):
+        if p.exists():
+            os.utime(p, (time.time() - 500 * 86400,) * 2)
+    assert seen_images.prune() == 1
+    assert seen_images.read(old["id"]) is None and seen_images.read(new["id"]) is not None
+    monkeypatch.setenv("HERMES_SEEN_IMAGES_MAX_BYTES", "1")
+    assert seen_images.prune() == 1
+    assert seen_images.read(new["id"]) is None
+
+
+def test_vision_analyze_on_a_device_file_outside_the_chat_folder_records_a_copy(tmp_path, monkeypatch):
+    """The card of this call must show the image after the file is deleted and for a subagent's call."""
+    from tools import vision_tools
+
+    elsewhere = tmp_path / "cache" / "relift" / "work" / "sheet.png"
+    elsewhere.parent.mkdir(parents=True)
+    data = _png((64, 48), (10, 120, 200))
+    elsewhere.write_bytes(data)
+    monkeypatch.setattr(vision_tools, "_should_use_native_vision_fast_path", lambda: True)
+    result = asyncio.run(vision_tools._handle_vision_analyze({"image_url": str(elsewhere), "question": "what"}))
+    assert isinstance(result, dict) and result["_multimodal"] is True
+    sent = result["content"][1]["image_url"]["url"]
+
+    agent = _make_agent()
+    agent._append_guardrail_observation = lambda name, args, res, **kw: res
+    db_path = Path(tmp_path) / "state.db"
+    db = _attach_real_session_db(agent, db_path, "seen")
+    messages = [{"role": "user", "content": "look"},
+                {"role": "assistant", "content": "", "tool_calls": [
+                    {"id": "call-1", "type": "function", "function": {"name": "vision_analyze", "arguments": "{}"}}]}]
+    agent._flush_messages_to_session_db(messages)
+    try:
+        with (patch("model_tools.handle_function_call", return_value=result),
+              patch("agent.tool_executor.maybe_persist_tool_result", side_effect=lambda **kw: kw["content"])):
+            agent._execute_tool_calls_sequential(
+                SimpleNamespace(content="", tool_calls=[_mock_tool_call(call_id="call-1")]), messages, "task-1")
+    finally:
+        db.close()
+    elsewhere.unlink()
+    live, durable = messages[-1], _durable_messages(db_path, "seen")[-1]
+    for row in (live, durable):
+        seen = row["display_metadata"]["seen_images"]
+        assert len(seen) == 1 and seen[0]["mime"] in ("image/png", "image/jpeg")
+    seen = durable["display_metadata"]["seen_images"][0]
+    mime, stored = seen_images.read(seen["id"])
+    assert base64.b64encode(stored).decode() in sent  # exactly the bytes the model received
+    assert hashlib.sha256(stored).hexdigest() == seen["id"]
+    # The model never sees the record.
+    assert "seen_images" not in json.dumps(durable["content"])
+
+
+def test_the_route_serves_a_stored_copy_only_to_an_authenticated_caller_and_only_by_id():
+    from starlette.testclient import TestClient
+
+    from hermes_cli.web_server import _SESSION_HEADER_NAME, _SESSION_TOKEN, app
+
+    data = _noise_png((900, 700))
+    rec = seen_images.collect(_envelope(data))[0]
+    client = TestClient(app)
+    url = f"/api/seen-images/{rec['id']}"
+    assert client.get(url, headers={_SESSION_HEADER_NAME: "wrong"}).status_code == 401
+    ok = client.get(url, headers={_SESSION_HEADER_NAME: _SESSION_TOKEN})
+    assert ok.status_code == 200 and ok.content == data and ok.headers["content-type"] == "image/png"
+    assert "immutable" in ok.headers["cache-control"]
+    thumb = client.get(url + "?size=thumb", headers={_SESSION_HEADER_NAME: _SESSION_TOKEN})
+    assert thumb.status_code == 200 and thumb.headers["content-type"] == "image/jpeg" and len(thumb.content) < len(data)
+    for bad in ("0" * 64, "..%2f..%2fetc%2fpasswd", "short"):
+        assert client.get(f"/api/seen-images/{bad}", headers={_SESSION_HEADER_NAME: _SESSION_TOKEN}).status_code == 404
+
+
+def test_images_the_user_sent_natively_are_kept_on_the_user_row():
+    from agent.turn_context import _stage_turn_user_message
+
+    data = _png(color=(5, 6, 7))
+    content = [{"type": "text", "text": "what is this"}, _envelope(data)["content"][1]]
+    agent = SimpleNamespace(_pending_cli_user_message=None)
+    row, _ = _stage_turn_user_message(agent, content, "what is this", None, None, None, {"submission_id": "s1"})
+    seen = row["display_metadata"]["seen_images"]
+    assert seen[0]["id"] == hashlib.sha256(data).hexdigest() and row["display_metadata"]["submission_id"] == "s1"
+    plain, _ = _stage_turn_user_message(agent, "hello", "hello", None, None, None, None)
+    assert "display_metadata" not in plain
diff --git a/tools/seen_images.py b/tools/seen_images.py
new file mode 100644
index 00000000..9d327287
--- /dev/null
+++ b/tools/seen_images.py
@@ -0,0 +1,307 @@
+"""A kept copy of every image Hermes loads for the model.
+
+A client that draws a tool card (the Talaria hub, a desktop app) must be able to show the image the model
+saw even when the file it came from is gone, outside the chat's folder, on another machine, or only a
+subagent's. So when a tool result carries image content, ``collect`` stores exactly those bytes here,
+content-addressed by sha256, and returns the ids to record in the tool row's ``display_metadata``
+(``seen_images``). ``GET /api/seen-images/<id>`` serves a copy to an authenticated caller.
+
+Layout: ``$HERMES_HOME/seen_images/<id[:2]>/<id>.img`` (the full image), ``<id>.thumb`` (a JPEG of at most
+``THUMB_EDGE`` px and ``THUMB_BYTES``) and ``<id>.json`` (mime, sizes). Copies are kept ``RETENTION_DAYS``
+days after the last write or read (longer than any chat is displayed for) and at most ``MAX_TOTAL_BYTES`` in
+all, oldest first. ``HERMES_SEEN_IMAGES_RETENTION_DAYS`` and ``HERMES_SEEN_IMAGES_MAX_BYTES`` override both.
+"""
+
+from __future__ import annotations
+
+import base64
+import binascii
+import hashlib
+import json
+import logging
+import os
+import re
+import threading
+import time
+from io import BytesIO
+from pathlib import Path
+from typing import Any, Optional
+
+logger = logging.getLogger(__name__)
+
+DIR_NAME = "seen_images"
+ID_RE = re.compile(r"[0-9a-f]{64}")
+MIME_TYPES = ("image/png", "image/jpeg", "image/gif", "image/webp")
+MAX_IMAGE_BYTES = 24 * 1024 * 1024
+MAX_PER_RESULT = 8
+THUMB_EDGE = 640
+THUMB_BYTES = 96 * 1024
+RETENTION_DAYS = 400
+MAX_TOTAL_BYTES = 4 * 1024 ** 3
+_PRUNE_EVERY_S = 3600
+_TOUCH_EVERY_S = 86400
+
+_DATA_URL = re.compile(r"data:(image/[a-z0-9.+-]+);base64,([A-Za-z0-9+/=\s]+)", re.I)
+_prune_lock = threading.Lock()
+_last_prune = 0.0
+
+
+def _env_number(name: str, default: float) -> float:
+    try:
+        value = float(os.environ.get(name, ""))
+    except ValueError:
+        return default
+    return value if value > 0 else default
+
+
+def root() -> Path:
+    from hermes_constants import get_hermes_home
+
+    return Path(get_hermes_home()) / DIR_NAME
+
+
+def _paths(image_id: str, base: Optional[Path] = None) -> tuple[Path, Path, Path]:
+    d = (base or root()) / image_id[:2]
+    return d / f"{image_id}.img", d / f"{image_id}.thumb", d / f"{image_id}.json"
+
+
+def _sniff(data: bytes) -> Optional[str]:
+    if data.startswith(b"\x89PNG\r\n\x1a\n"):
+        return "image/png"
+    if data.startswith(b"\xff\xd8\xff"):
+        return "image/jpeg"
+    if data[:6] in (b"GIF87a", b"GIF89a"):
+        return "image/gif"
+    if data[:4] == b"RIFF" and data[8:12] == b"WEBP":
+        return "image/webp"
+    return None
+
+
+def _write(path: Path, data: bytes) -> None:
+    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
+    tmp = path.with_name(f".{path.name}.{os.getpid()}.{threading.get_ident()}.tmp")
+    fd = os.open(str(tmp), os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
+    with os.fdopen(fd, "wb") as handle:
+        handle.write(data)
+    os.replace(tmp, path)
+
+
+def _thumb(data: bytes) -> tuple[Optional[bytes], int, int]:
+    """(JPEG thumbnail or None, width, height) of the image; None when it is small already or Pillow cannot
+    read it."""
+    try:
+        from PIL import Image
+    except Exception:
+        return None, 0, 0
+    try:
+        with Image.open(BytesIO(data)) as im:
+            width, height = im.size
+            if max(width, height) <= THUMB_EDGE and len(data) <= THUMB_BYTES:
+                return None, width, height
+            im.seek(0)
+            im = im.convert("RGBA") if im.mode in ("P", "LA", "RGBA") else im.convert("RGB")
+            if im.mode == "RGBA":
+                from PIL import Image as _I
+
+                bg = _I.new("RGB", im.size, (255, 255, 255))
+                bg.paste(im, mask=im.getchannel("A"))
+                im = bg
+            im.thumbnail((THUMB_EDGE, THUMB_EDGE))
+            for quality in (82, 70, 58, 46, 34):
+                out = BytesIO()
+                im.save(out, "JPEG", quality=quality, optimize=True)
+                if out.tell() <= THUMB_BYTES:
+                    break
+            return out.getvalue(), width, height
+    except Exception as exc:
+        logger.debug("seen_images: no thumbnail: %s", exc)
+        return None, 0, 0
+
+
+def store(data: bytes, mime: Optional[str] = None) -> Optional[dict]:
+    """Keep *data* (the image bytes the model got) and return its record, or None when it is not an image
+    or too large. Storing the same bytes again only refreshes its age."""
+    if not data or len(data) > MAX_IMAGE_BYTES:
+        return None
+    kind = _sniff(data)  # the bytes decide the type, never a declared one
+    if kind is None:
+        return None
+    image_id = hashlib.sha256(data).hexdigest()
+    full, thumb, meta = _paths(image_id)
+    record = None
+    try:
+        if meta.is_file() and full.is_file():
+            record = json.loads(meta.read_text())
+            _touch(full, thumb, meta)
+    except Exception:
+        record = None
+    if not isinstance(record, dict) or record.get("id") != image_id:
+        small, width, height = _thumb(data)
+        record = {"id": image_id, "mime": kind, "bytes": len(data), "w": width, "h": height,
+                  "thumb": small is not None}
+        _write(full, data)
+        if small is not None:
+            _write(thumb, small)
+            record["thumb_bytes"] = len(small)
+        _write(meta, json.dumps(record).encode())
+    _maybe_prune()
+    return {k: record[k] for k in ("id", "mime", "bytes", "w", "h", "thumb") if k in record}
+
+
+def _touch(*paths: Path) -> None:
+    now = time.time()
+    for p in paths:
+        try:
+            if now - p.stat().st_mtime > _TOUCH_EVERY_S:
+                os.utime(p, (now, now))
+        except OSError:
+            pass
+
+
+def _data_url_bytes(url: Any) -> Optional[tuple[bytes, str]]:
+    if not isinstance(url, str) or not url.startswith("data:"):
+        return None
+    m = _DATA_URL.fullmatch(url.strip())
+    if not m:
+        return None
+    try:
+        return base64.b64decode(re.sub(r"\s+", "", m.group(2)), validate=False), m.group(1).lower()
+    except (binascii.Error, ValueError):
+        return None
+
+
+def _part_images(part: Any):
+    """The (bytes, mime) of one content part that carries an image inline."""
+    if not isinstance(part, dict):
+        return
+    kind = part.get("type")
+    if kind in ("image_url", "input_image"):
+        v = part.get("image_url")
+        got = _data_url_bytes(v.get("url") if isinstance(v, dict) else v)
+        if got:
+            yield got
+    elif kind == "image":
+        src = part.get("source")
+        if isinstance(src, dict) and src.get("type") == "base64" and isinstance(src.get("data"), str):
+            try:
+                yield base64.b64decode(src["data"]), str(src.get("media_type") or "")
+            except (binascii.Error, ValueError):
+                pass
+
+
+def collect(result: Any) -> list[dict]:
+    """Store the images a tool result gives the model and return their records (at most MAX_PER_RESULT).
+
+    Reads a multimodal envelope (``{"_multimodal": True, "content": [...]}``) or a bare content list, and the
+    ``seen_images`` a tool put in its own JSON result when the image never reached the main model (the
+    auxiliary-model path of vision_analyze). Never raises: a failure to keep a copy must not fail the call."""
+    try:
+        parts: Any = None
+        if isinstance(result, dict):
+            parts = result.get("content") if result.get("_multimodal") else None
+        elif isinstance(result, list):
+            parts = result
+        elif isinstance(result, str) and result.lstrip().startswith("{") and "\"seen_images\"" in result[:200000]:
+            data = json.loads(result)
+            return clean(data.get("seen_images")) if isinstance(data, dict) else []
+        out: list[dict] = []
+        for part in parts if isinstance(parts, list) else ():
+            for data, mime in _part_images(part):
+                rec = store(data, mime)
+                if rec and all(rec["id"] != o["id"] for o in out):
+                    out.append(rec)
+                if len(out) >= MAX_PER_RESULT:
+                    return out
+        return out
+    except Exception as exc:
+        logger.warning("seen_images: could not keep a copy: %s", exc)
+        return []
+
+
+def clean(records: Any) -> list[dict]:
+    """The well-formed records of *records*, so metadata read back from a tool result is never trusted."""
+    out: list[dict] = []
+    for r in records if isinstance(records, list) else ():
+        if isinstance(r, dict) and isinstance(r.get("id"), str) and ID_RE.fullmatch(r["id"]):
+            out.append({"id": r["id"], "mime": r.get("mime") if r.get("mime") in MIME_TYPES else "image/png",
+                        **{k: r[k] for k in ("bytes", "w", "h") if isinstance(r.get(k), int)},
+                        "thumb": bool(r.get("thumb"))})
+    return out[:MAX_PER_RESULT]
+
+
+def read(image_id: str, size: str = "full") -> Optional[tuple[str, bytes]]:
+    """(mime, bytes) of a kept copy: the thumbnail for size "thumb" when there is one, else the full image.
+    None when the id is not a stored copy."""
+    if not isinstance(image_id, str) or not ID_RE.fullmatch(image_id):
+        return None
+    full, thumb, meta = _paths(image_id)
+    try:
+        if size == "thumb" and thumb.is_file():
+            data = thumb.read_bytes()
+            _touch(full, thumb, meta)
+            return "image/jpeg", data
+        data = full.read_bytes()
+        mime = _sniff(data) or "image/png"
+        _touch(full, thumb, meta)
+        return mime, data
+    except OSError:
+        return None
+
+
+def _maybe_prune() -> None:
+    global _last_prune
+    now = time.time()
+    if now - _last_prune < _PRUNE_EVERY_S or not _prune_lock.acquire(blocking=False):
+        return
+    try:
+        if now - _last_prune < _PRUNE_EVERY_S:
+            return
+        _last_prune = now
+        threading.Thread(target=_prune_safely, daemon=True, name="seen-images-prune").start()
+    finally:
+        _prune_lock.release()
+
+
+def _prune_safely() -> None:
+    try:
+        prune()
+    except Exception as exc:
+        logger.debug("seen_images: prune failed: %s", exc)
+
+
+def prune(now: Optional[float] = None) -> int:
+    """Drop copies unused for RETENTION_DAYS, then the oldest until the total fits MAX_TOTAL_BYTES. Returns
+    how many images it removed."""
+    base = root()
+    if not base.is_dir():
+        return 0
+    now = time.time() if now is None else now
+    keep_s = _env_number("HERMES_SEEN_IMAGES_RETENTION_DAYS", RETENTION_DAYS) * 86400
+    cap = int(_env_number("HERMES_SEEN_IMAGES_MAX_BYTES", MAX_TOTAL_BYTES))
+    entries: list[tuple[float, int, str]] = []
+    for shard in base.iterdir():
+        if not shard.is_dir():
+            continue
+        for meta in shard.glob("*.json"):
+            image_id = meta.stem
+            if not ID_RE.fullmatch(image_id):
+                continue
+            full, thumb, _ = _paths(image_id)
+            try:
+                age = max(p.stat().st_mtime for p in (meta, full) if p.exists())
+                size = sum(p.stat().st_size for p in (meta, full, thumb) if p.exists())
+            except (OSError, ValueError):
+                continue
+            entries.append((age, size, image_id))
+    removed, total = 0, sum(e[1] for e in entries)
+    for age, size, image_id in sorted(entries):
+        if now - age <= keep_s and total <= cap:
+            break
+        for p in _paths(image_id):
+            try:
+                p.unlink()
+            except OSError:
+                pass
+        total -= size
+        removed += 1
+    return removed
