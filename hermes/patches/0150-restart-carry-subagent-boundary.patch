+# How long, at most, the carried subagents leave of the carry ceiling for the stop that follows a child that never
+# reached its boundary: the yield and its settle (``delegate_tool_handoff.YIELD_SETTLE_SECONDS``) and the record.
+SUBAGENT_STOP_RESERVE_S = 60.0
+
+
+async def _carry_subagents(carry) -> bool:
+    """Carry the background subagents like the turns (``delegation.restart_handoff``): each runs on to its next step
+    boundary here, its model call and tool round included, then stops and goes to the next gateway, which resumes it
+    from its stored transcript. Stopping them at the release cut their model calls, so the next gateway made those
+    calls again. Runs alongside the carry; returns once every unit is recorded as handed off. False when there is
+    nothing to carry this way."""
+    from tools.delegate_tool_config import _get_restart_handoff
+    if not getattr(carry.runner, "_restart_requested", False) or not _get_restart_handoff():
+        return False
+    from tools.async_delegation import hand_off_for_restart
+    from tools.delegate_tool_handoff import YIELD_SETTLE_SECONDS
+    from gateway.run_shutdown import GatewayShutdownMixin
+    boundary_s = max(0.0, ceiling_seconds(carry.runner) - SUBAGENT_STOP_RESERVE_S)
+    settle = YIELD_SETTLE_SECONDS + GatewayShutdownMixin._DELEGATION_HANDOFF_SETTLE_S
+    marked = threading.Event()
+
+    def run() -> int:
+        try:
+            return hand_off_for_restart(0.0, settle, boundary_seconds=boundary_s, marked=marked)
+        finally:
+            marked.set()
+
+    carry.subagents = asyncio.ensure_future(asyncio.to_thread(run))
+    # The units are handed off in the ledger before the profile is released, as at a stop.
+    await asyncio.to_thread(marked.wait, 30.0)
+    return True
+
