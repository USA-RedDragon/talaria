@@ -0,0 +1,244 @@
+"""The per-turn carry (gateway.restart_turn_handoff_per_turn) and the background subagents it hands over.
+
+- An agent whose turn ended no longer names the thread that ran it: thread idents are reused at once, so a subagent
+  stopped for the restart while it waited aimed its interrupt at whatever ran on that ident next (another chat's
+  foreground device command ended with ``[Command interrupted]``, exit 130).
+- A subagent in a turn is carried to its next step boundary like a chat turn: its model call and its tool round
+  finish on the old gateway and it stops at the top of its next iteration, so the next gateway repeats no call.
+- A unit whose children all finished during the carry is still handed over: the next gateway owns the chats.
+"""
+
+import threading
+import time
+
+import pytest
+
+import run_agent
+from agent import conversation_loop, turn_boundary_handoff as boundary
+from agent.turn_context import _bind_interrupt_scope
+from tests.waiting import wait_until
+from tools import async_delegation as ad
+from tools import delegate_tool_handoff as handoff
+from tools.interrupt import is_interrupted, is_thread_interrupted, set_interrupt
+
+
+def _bare_agent():
+    from run_agent import AIAgent
+    agent = AIAgent.__new__(AIAgent)
+    agent._interrupt_requested = False
+    agent._interrupt_message = None
+    agent._hard_interrupt_requested = threading.Event()
+    agent._execution_thread_id = None
+    agent._interrupt_thread_signal_pending = False
+    agent._active_children = []
+    agent._active_children_lock = threading.Lock()
+    agent.quiet_mode = True
+    agent.provider, agent.model, agent._base_url = "openrouter", "test/model", "http://localhost:1234"
+    agent.session_id = "child-0"
+    return agent
+
+
+@pytest.fixture
+def one_turn(monkeypatch):
+    """``run_conversation`` around a turn body that only binds its thread, as the real one does first."""
+    import agent.turn_context as turn_context
+    import agent.turn_finalizer as turn_finalizer
+    import agent.voice_turn_route as voice_turn_route
+
+    def turn(agent, *_a, **_k):
+        _bind_interrupt_scope(agent, lambda: run_agent)
+        return {"final_response": "", "messages": [], "completed": True}
+    monkeypatch.setattr(conversation_loop, "_run_conversation_turn", turn)
+    monkeypatch.setattr(turn_context, "export_current_turn_boundary", lambda _a, result, _m: result)
+    monkeypatch.setattr(turn_finalizer, "settle_held_final", lambda *_a: None)
+    monkeypatch.setattr(voice_turn_route, "end_voice_turn_route", lambda *_a: None)
+    monkeypatch.setattr(conversation_loop, "_close_durable_failed_turn", lambda *_a: None)
+    monkeypatch.setattr(conversation_loop, "_hand_back_leftover_steer", lambda *_a: None)
+
+    def run(agent):
+        seen = {}
+
+        def body():
+            seen["tid"] = threading.get_ident()
+            conversation_loop.run_conversation(agent, "go")
+        worker = threading.Thread(target=body)
+        worker.start()
+        worker.join(5)
+        return seen["tid"]
+    return run
+
+
+def test_a_finished_turn_releases_its_thread(one_turn):
+    agent = _bare_agent()
+    tid = one_turn(agent)
+    assert agent._execution_thread_id is None
+    agent.hard_interrupt(tool_reason="gateway restart")
+    assert agent._interrupt_requested is True  # the next turn still sees the stop
+    assert not is_thread_interrupted(tid)
+
+
+def test_a_waiting_subagent_stopped_by_the_restart_leaves_another_chats_command_running(one_turn, monkeypatch):
+    """The j3 case: the subagent's turn ended (it waits on its processes); a chat's foreground command then runs on a
+    thread with the same ident. The restart handoff stops the subagent at once and the command runs on."""
+    monkeypatch.setattr(handoff, "_child_state", lambda child: {"session_id": child.session_id})
+    import tools.delegate_tool_subunits as subunits
+    monkeypatch.setattr(subunits, "hand_off", lambda _agent: [])
+    child = _bare_agent()
