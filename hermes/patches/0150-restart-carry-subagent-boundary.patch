+@contextmanager
+def interrupt_scope_of_turn(agent: Any):
+    """Unbind the execution thread when the outermost ``run_conversation`` of *agent* returns. Thread
+    idents are reused at once (a new thread gets the ident of the last one that ended) and gateway turn
+    threads are pooled, so an agent that kept the ident of a turn it already finished aimed a later
+    ``interrupt()`` (a subagent stopped for a restart handoff while it waited) at whatever that thread
+    ran next: another chat's foreground command ended with ``[Command interrupted]``. A stop between
+    turns still reaches the next one through ``_interrupt_requested`` (``_bind_interrupt_scope``)."""
+    depth = getattr(agent, "_execution_scope_depth", 0)
+    depth = depth if isinstance(depth, int) else 0
+    agent._execution_scope_depth = depth + 1
+    try:
+        yield
+    finally:
+        agent._execution_scope_depth = depth
+        if depth == 0 and getattr(agent, "_execution_thread_id", None) == threading.current_thread().ident:
+            agent._execution_thread_id = None
+
