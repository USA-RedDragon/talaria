+"""gateway.restart_turn_handoff_per_turn with delegation.restart_handoff: the background subagents are carried like
+the turns. The release does not wait for them; the carrier runs them on to their step boundaries, and the next
+gateway is told to adopt them (``PROCESSES_HANDED``) and gets the background processes only once they stopped."""
+import asyncio
+import json
+import os
+import threading
+import time
+
+import pytest
+
+from gateway import turn_boundary, turn_carry, turn_handoff
+
+from tests.gateway.test_restart_turn_carry import _claimed_turn, _old_runner, _reserve_profile, _until
+
+
+@pytest.fixture(autouse=True)
+def _clean(monkeypatch, tmp_path):
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+    monkeypatch.setattr(turn_handoff, "_handing_off", False)
+    monkeypatch.setattr(turn_boundary, "_resuming", set())
+    monkeypatch.setattr(turn_boundary, "_handed_off", set())
+    monkeypatch.setattr(turn_carry, "_released", False)
+    monkeypatch.setattr(turn_carry, "_api_target", None)
+    monkeypatch.setattr(turn_carry, "_carrying", False)
+
+    async def noop(*_a, **_k):
+        return None
+    for name in ("_stop_cron", "_disconnect_messaging"):
+        monkeypatch.setattr(turn_carry, name, noop)
+
+
+@pytest.fixture
+def subagents(monkeypatch):
+    """A background subagent in a model call: the handoff returns once it reached its boundary (``reach``)."""
+    import tools.async_delegation as ad
+    import tools.delegate_tool_config as config
+    monkeypatch.setattr(config, "_get_restart_handoff", lambda: True)
+    reach, calls = threading.Event(), []
+
+    def hand_off_for_restart(grace, timeout, *, boundary_seconds=None, marked=None):
+        calls.append({"grace": grace, "boundary_seconds": boundary_seconds})
+        if marked is not None:
+            marked.set()
+        reach.wait(10)
+        return 1
+    monkeypatch.setattr(ad, "hand_off_for_restart", hand_off_for_restart)
+    return reach, calls
+
+
+def _frames(tmp_path, epoch):
+    path = turn_carry.events_path(tmp_path, epoch)
+    return [json.loads(line) for line in path.read_text().splitlines()] if path.exists() else []
+
+
+@pytest.mark.asyncio
+async def test_subagents_run_on_to_their_boundaries_after_the_release(owner, tmp_path, monkeypatch, subagents):
+    reach, calls = subagents
+    _reserve_profile(tmp_path)
+    row, _live, agent = _claimed_turn(owner, "chat")
+    agent._executing_tools = False
+    from gateway.run_shutdown import GatewayShutdownMixin
+    handed = []
+
+    async def hand_off(_runner):
+        handed.append(time.monotonic())
+    monkeypatch.setattr(GatewayShutdownMixin, "_stop_hand_off_processes", staticmethod(hand_off))
+    runner = _old_runner(owner, restart_turn_carry_ceiling_seconds=1080.0)
+    carry = asyncio.ensure_future(turn_carry.carry_restart(runner))
+    await _until(turn_carry.released)  # the subagent's model call does not hold the release
+    assert len(calls) == 1 and calls[0]["boundary_seconds"] == pytest.approx(1080.0 - turn_carry.SUBAGENT_STOP_RESERVE_S)
+    from hermes_state_runtime import settle_session_input
+    settle_session_input(owner.db, epoch=owner.epoch, admission_id=row["admission_id"],
+                         generation=row["generation"], outcome="completed")
+    await asyncio.sleep(0.4)
+    # The turn ended, but the subagent still runs here: the carrier stays, keeps its processes and does not tell
+    # the next gateway to adopt the subagent yet.
+    assert not carry.done() and handed == []
+    assert all(f["type"] != turn_carry.PROCESSES_HANDED for f in _frames(tmp_path, owner.epoch))
+    reach.set()
+    await asyncio.wait_for(carry, 5.0)
+    assert len(handed) == 1
+    assert [f["type"] for f in _frames(tmp_path, owner.epoch)].count(turn_carry.PROCESSES_HANDED) == 1
+    os.close(runner._turn_carry.lock_fd)
+
+
