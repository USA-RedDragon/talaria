+def judge_source(text: str) -> tuple[str, str] | None:
+    """``(identity, display)`` of a source the review model named (``github.com/owner/repo``, a clone URL,
+    ``git@github.com:owner/repo.git``, ``pypi.org/<project>``), or ``None`` when it is not exactly one valid
+    source: the host must be a known forge or package host (no look-alike, no port, no user part), the path
+    must name an owner and a repo (a project on a package host), and nothing may be a wildcard, a variable or
+    a list. The same naming as every other grant source (``url_source``), so the grant covers what a clone of
+    or a download from that repo names."""
+    if not isinstance(text, str):
+        return None
+    ref = text.strip()
+    if not ref or len(ref) > 200 or _JUDGE_BAD.search(ref.rstrip(".")):
+        return None
+    if "://" not in ref and not re.match(r"[\w.-]+@", ref) and not _NPM_SHORTHAND.fullmatch(ref):
+        ref = "https://" + ref
+    ident = url_source(ref, clone=True)
+    shown = url_source(ref, clone=True, display=True)
+    if not ident or not shown:
+        return None
+    parts = ident.split("/")
+    if parts[0] not in _JUDGE_HOSTS or len(parts) < 2 or (parts[0] in _GITHUB_HOSTS | _FORGE_HOSTS and len(parts) < 3):
+        return None
+    return ident, shown
+
