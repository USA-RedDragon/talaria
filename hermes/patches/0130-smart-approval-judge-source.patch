-def _granted_sources(tool_name: str, args: dict, data: ReviewInput, grants: dict) -> str:
+# --- sources named by a script the command runs ------------------------------------------------------------
+# A command that sources a script of the project or of a clone and calls a function of it (``. lib.sh; fetch_tool``)
+# shows no URL, while the function downloads and builds a repo. The URLs of the called functions are read from the
+# script on the machine the command runs on, never from the command's own text: a script the same command writes
+# or edits, or a function it redefines, is not read.
+
+_SCRIPT_MAX_BYTES = 200_000
+_SHELLS = frozenset({"bash", "sh", "zsh", "dash", "ksh"})
+_READERS = frozenset({".", "source", "bash", "sh", "zsh", "dash", "ksh", "cat", "ls", "head", "tail", "less", "grep",
+                      "wc", "test", "[", "stat", "file", "diff", "cd", "echo", "printf", "true"})
+_FUNC_DEF = re.compile(r"^[ \t]*(?:function[ \t]+)?([A-Za-z_][\w.-]*)[ \t]*(?:\([ \t]*\))?[ \t]*\{", re.M)
+
+
+def _shell_tokens(command: str) -> list[str]:
+    """Words and operator tokens (``;``, ``&&``, ``|``, parentheses) of a shell command; quotes respected, an
+    unquoted newline is ``;``. Empty when the command cannot be parsed."""
+    out, quote, esc = [], "", False
+    for ch in command:
+        if esc:
+            esc = False
+        elif ch == "\\" and quote != "'":
+            esc = True
+        elif quote:
+            quote = "" if ch == quote else quote
+        elif ch in "'\"":
+            quote = ch
+        elif ch == "\n":
+            ch = " ; "
+        out.append(ch)
+    try:
+        lex = shlex.shlex("".join(out), posix=True, punctuation_chars=";&|()")
+        lex.whitespace, lex.whitespace_split, lex.commenters = " \t\r", True, "#"
+        return list(lex)
+    except ValueError:
+        return []
+
+
+def _shell_units(command: str, depth: int = 0):
+    """``(words, cwd-change list)`` per simple command, descending into ``bash -c '...'`` strings; yields
+    ``(prog, args, text)`` where ``text`` is the unit's own source text."""
+    tokens = _shell_tokens(command)
+    words: list[str] = []
+    for tok in tokens + [";"]:
+        if tok and set(tok) <= set(";&|()"):
+            if words:
+                while words and re.match(r"^[A-Za-z_][A-Za-z0-9_]*=", words[0]):
+                    words = words[1:]
+                if words:
+                    yield words
+                    prog = os.path.basename(words[0])
+                    if prog in _SHELLS and "-c" in words and depth < 3:
+                        i = words.index("-c")
+                        if i + 1 < len(words):
+                            yield from _shell_units(words[i + 1], depth + 1)
+            words = []
+        else:
+            words.append(tok)
+
+
+def _device_path(path: str, cwd: str | None) -> str | None:
+    """``path`` made absolute against ``cwd`` as text, a leading ``~`` kept for the machine the command runs on
+    (this process may be on another one). ``None`` for a path built from a variable or a substitution."""
+    if not path or any(c in path for c in "$`*?[{"):
+        return None
+    if not path.startswith(("/", "~")):
+        if not cwd:
+            return None
+        path = posixpath.join(cwd, path)
+    return posixpath.normpath(path)
+
+
+def _script_files(command: str, base: str | None) -> list[tuple[str, bool]]:
+    """``(path, sourced)`` of each script file the command sources (``. f``, ``source f``) or runs (``bash f``)
+    whose path is a plain word, relative paths against the ``cd`` of the command or ``base``."""
+    cwd, files = base, []
+    for words in _shell_units(command):
+        prog = os.path.basename(words[0])
+        if prog == "cd" and len(words) > 1:
+            cwd = _device_path(words[1], cwd)
+            continue
+        target, sourced = None, False
+        if prog in (".", "source") and len(words) > 1:
+            target, sourced = words[1], True
+        elif prog in _SHELLS and "-c" not in words:
+            rest = [w for w in words[1:] if not w.startswith("-")]
+            target = rest[0] if rest else None
+        path = _device_path(target, cwd) if target else None
+        if path and (path, sourced) not in files:
+            files.append((path, sourced))
+    return files
+
+
+def _touched_elsewhere(command: str, path: str) -> bool:
+    """Whether the command touches the script file with anything but a reader (``sed -i``, ``tee``, ``mv``,
+    ``cp``, a redirect, an interpreter), so the file the review reads is not what will run."""
+    name = os.path.basename(path)
+    for words in _shell_units(command):
+        prog = os.path.basename(words[0])
+        if prog in _READERS and prog not in ("echo", "printf"):
+            continue
+        if any(name in w for w in words):
+            return True
+    return bool(re.search(r">[ \t]*\S*" + re.escape(name), command))
+
+
+def _function_body(text: str, start: int) -> str | None:
+    """The text between the ``{`` at ``start`` and its matching ``}`` (quotes ignored: an unbalanced one gives
+    ``None``)."""
+    depth = 0
+    for i in range(start, len(text)):
+        if text[i] == "{":
+            depth += 1
+        elif text[i] == "}":
+            depth -= 1
+            if depth == 0:
+                return text[start + 1:i]
+    return None
+
+
+def _uncommented(text: str) -> str:
+    return "\n".join(line for line in text.split("\n") if not line.lstrip().startswith("#"))
+
+
+def _without_comments(command: str) -> str:
+    """``command`` without its shell comments (a ``#`` that starts a word, outside quotes): a comment never runs,
+    so a URL in one is the agent's own words and names no source."""
+    out, quote, esc, prev = [], "", False, " "
+    lines = []
+    for ch in command:
+        if esc:
+            esc = False
+        elif ch == "\\" and quote != "'":
+            esc = True
+        elif quote:
+            quote = "" if ch == quote else quote
+        elif ch in "'\"":
+            quote = ch
+        elif ch == "#" and prev in " \t\n;&|(":
+            quote = "#"  # until the end of the line
+        elif ch == "\n":
+            pass
+        if quote == "#" and ch == "\n":
+            quote = ""
+        if quote != "#":
+            out.append(ch)
+        prev = ch
+    return "".join(out)
+
+
+def _called_script_text(script: str, command: str, sourced: bool) -> str | None:
+    """The part of a script that runs for the command: the whole file when it is run, and when it is sourced its
+    top level and the functions the command calls (and they call), up to three levels. ``None`` when a function
+    is redefined by the command or the script's braces do not balance."""
+    script = _uncommented(script)
+    if not sourced:
+        return script
+    spans: dict[str, tuple[int, int, str]] = {}
+    top, last = [], 0
+    for m in _FUNC_DEF.finditer(script):
+        if m.start() < last:
+            continue  # inside the previous function
+        body = _function_body(script, m.end() - 1)
+        if body is None:
+            return None
+        end = m.end() - 1 + len(body) + 2
+        spans[m.group(1)] = (m.start(), end, body)
+        top.append(script[last:m.start()])
+        last = end
+    top.append(script[last:])
+    calls = {w for w in re.findall(r"[A-Za-z_][\w.-]*", command)}
+    for name in spans:  # the command defines the same name itself: the script's version is not what runs
+        if re.search(r"(?:^|[;&|\n({])[ \t]*(?:function[ \t]+)?" + re.escape(name) + r"[ \t]*(?:\(\)[ \t]*)?\{",
+                     command) or re.search(r"\bfunction[ \t]+" + re.escape(name) + r"\b", command):
+            return None
+    chosen, todo = [], [n for n in spans if n in calls]
+    for _ in range(3):
+        nxt = []
+        for name in todo:
+            if name in chosen:
+                continue
+            chosen.append(name)
+            nxt.extend(n for n in spans if n not in chosen and re.search(r"\b" + re.escape(n) + r"\b", spans[name][2]))
+        todo = nxt
+    return "\n".join(top + [spans[n][2] for n in chosen])
+
+
+def _read_script(path: str, task_key: str | None = None) -> str | None:
+    """The text of ``path`` on the machine the commands run on, when it is a regular file of at most
+    ``_SCRIPT_MAX_BYTES`` inside a git work tree (the project or a clone); else ``None``."""
+    q = '"$HOME"' + shlex.quote(path[1:]) if path.startswith("~/") else shlex.quote(path)
+    probe = (f'p={q}; [ -f "$p" ] || exit 3; [ "$(wc -c < "$p")" -le {_SCRIPT_MAX_BYTES} ] || exit 4; '
+             'd=$(dirname "$p"); while [ "$d" != / ] && [ ! -e "$d/.git" ]; do d=$(dirname "$d"); done; '
+             '[ -e "$d/.git" ] || exit 5; cat "$p"')
+    try:
+        from tools.file_tools import _get_file_ops
+        res = _get_file_ops(task_key or "default")._exec(probe, timeout=15)
+        if getattr(res, "exit_code", 1) != 0:
+            return None
+        text = getattr(res, "stdout", None)
+        return text if isinstance(text, str) and text.strip() else None
+    except Exception as exc:
+        logger.info("Smart approval (provenance): could not read %s (%s: %s)", path, type(exc).__name__, exc)
+        return None
+
+
+def script_sources(command: str, base: str | None, task_key: str | None = None) -> list[tuple[str, str | None]]:
+    """``(URL, identity)`` of each remote source named in the scripts a terminal command sources or runs, as
+    ``command_sources`` gives them for a command's own text; the identity is ``None`` for a URL that names no
+    source. Only the code that runs counts (see ``_called_script_text``); a script the same command touches, a
+    file outside a git work tree, an unreadable or oversized file and a path built from a variable give
+    nothing. Nothing is taken from the command's own words or comments."""
+    from tools.approval_chat_grants import command_sources
+    out: list[tuple[str, str | None]] = []
+    try:
+        files = _script_files(command, base)
+    except Exception:
+        return []
+    for path, sourced in files[:4]:
+        if _touched_elsewhere(command, path):
+            logger.info("Smart approval (provenance): %s is also changed by the command; not read", path)
+            continue
+        text = _read_script(path, task_key)
+        part = _called_script_text(text, command, sourced) if text else None
+        if not part:
+            continue
+        for ref, ident in command_sources(part):
+            if (ref, ident) not in out:
+                out.append((ref, ident))
+    return out[:12]
+
