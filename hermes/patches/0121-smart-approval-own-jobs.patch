--- /dev/null
+++ b/tests/tools/test_delegation_keep_wait_loops.py
@@ -0,0 +1,107 @@
+"""delegation.keep_child_processes keeps real work, not wait loops.
+
+A finished subagent's background process that only waited on the subagent's own work (``while pgrep -f ...; do
+sleep N; done``, which matches its own command line and never ends) stops with the subagent and is reported as
+stopped; builds, runs and servers move to the parent with a note that says what each one is. A process the child
+handed off itself (process_manage handoff) is the parent's already and is left alone.
+"""
+
+from __future__ import annotations
+
+import time
+import types
+
+import pytest
+
+import tools.delegate_tool_config as delegate_config
+from tools.delegate_tool_child_run import _ChildRun
+from tools.process_kinds import describe_process, is_wait_loop
+from tools.process_registry import process_registry
+
+
+@pytest.fixture(autouse=True)
+def _plain_spawn(monkeypatch):
+    import tools.process_registry as _pr
+    monkeypatch.setattr(_pr, "_SYSTEMD_SCOPE_AVAILABLE", False)
+    monkeypatch.setattr(delegate_config, "_get_keep_child_processes", lambda: True)
+
+
+def _run(sid):
+    parent = types.SimpleNamespace(session_id="sess-wait", _current_task_id="parent-turn-w")
+    child = types.SimpleNamespace(_process_owner_task_ids={sid}, _delegate_restart_handoff=False,
+                                  _handed_off_processes=[])
+    run = types.SimpleNamespace(child=child, parent_agent=parent, child_task_id=sid, subagent_id=sid)
+    run.keep_background_processes = lambda: _ChildRun.keep_background_processes(run)
+    return run
+
+
+@pytest.mark.parametrize("command,wait", [
+    ('while pgrep -f "corpus_run --all" >/dev/null; do sleep 30; done', True),
+    ("until ! pgrep -f ninja; do sleep 5; done; echo finished", True),
+    ("while true; do sleep 60; done", True),
+    ("bash -c 'while kill -0 4123 2>/dev/null; do sleep 10; done'", True),
+    ("while [ -e build/.lock ]; do sleep 2; done", True),
+    ("sleep 300", False),
+    ("ninja -C build", False),
+    ("while pgrep -f x; do sleep 5; rsync -a out/ host:out/; done", False),
+    ("while pgrep -f $(cat pidfile); do sleep 1; done", False),
+    ("while pgrep x; do sleep 1; done && make install", False),
+    ("while read l; do echo $l; done < list", False),
+])
+def test_is_wait_loop(command, wait):
+    assert is_wait_loop(command) is wait
+
+
+@pytest.mark.parametrize("command,what", [
+    ("cd ~/src && ninja -C build -j8", "a build"), ("ctest --test-dir build", "a test run"),
+    ("python -m http.server 8000", "a server"), ("rsync -a a/ b/", "a download or sync"),
+    ("./corpus_run --all", "a run of corpus_run"),
+])
+def test_describe_process(command, what):
+    assert describe_process(command) == what
+
+
+def _wait_exit(proc):
+    deadline = time.time() + 10
+    while not proc.exited and time.time() < deadline:
+        time.sleep(0.05)
+    return proc.exited
+
+
+def test_wait_loop_stops_with_the_child_real_work_is_kept_and_named():
+    sid = "sa-0-wait01"
+    work = process_registry.spawn_local("sleep 30", task_id=sid, owner_task_id=sid)
+    loop = process_registry.spawn_local("while pgrep -f 'sleep 30' >/dev/null; do sleep 1; done", task_id=sid,
+                                        owner_task_id=sid)
+    run = _run(sid)
+    try:
+        entry: dict = {}
+        _ChildRun.account_background_processes(run, entry)
+        assert [k["session_id"] for k in entry["handed_off_processes"]] == [work.id]
+        kept = entry["handed_off_processes"][0]
+        assert kept["what"] == "a run of sleep" and "it is a run of sleep" in kept["note"]
+        assert work.owner_task_id == "parent-turn-w" and work.kept_from_child
+        assert [w["session_id"] for w in entry["stopped_wait_loops"]] == [loop.id]
+        assert "orphaned_processes" not in entry
+        assert loop.owner_task_id == sid  # child teardown kills it
+        process_registry.kill_all(sid, source="agent_close")
+        assert _wait_exit(loop)
+        assert process_registry.poll(work.id)["status"] == "running"
+    finally:
+        for p in (work, loop):
+            process_registry.kill_process(p.id, source="test")
+
+
+def test_wait_loop_the_child_handed_off_stays_with_the_parent():
+    sid = "sa-0-wait02"
+    loop = process_registry.spawn_local("while true; do sleep 1; done", task_id=sid, owner_task_id=sid)
+    try:
+        assert process_registry.transfer_ownership(loop.id, from_owner=sid, to_owner="parent-turn-w",
+                                                   to_task_id="parent-turn-w", to_session_key="sess-wait", note="mine")
+        entry: dict = {}
+        _ChildRun.account_background_processes(_run(sid), entry)
+        assert "stopped_wait_loops" not in entry and loop.owner_task_id == "parent-turn-w"
+        process_registry.kill_all(sid, source="agent_close")
+        assert process_registry.poll(loop.id)["status"] == "running"
+    finally:
+        process_registry.kill_process(loop.id, source="test")
diff --git a/tests/tools/test_smart_approval_own_jobs.py b/tests/tools/test_smart_approval_own_jobs.py
new file mode 100644
index 00000000..825d1210
--- /dev/null
+++ b/tests/tools/test_smart_approval_own_jobs.py
@@ -0,0 +1,223 @@
+"""Smart approval provenance review of the agent's own jobs.
+
+Invariants:
+  1. The review and the card see every argument of the call, ids included (``session_id``, ``task_id``,
+     ``subagent_id``, ``tab_id``).
+  2. A kill, stop, steer or stdin write of a background process or subagent this agent or one of its own subagents
+     started this session runs without a review or card: by ``session_id`` (full or prefix), by the PID Hermes
+     recorded (``terminal`` ``kill <pid>``), including processes a subagent handed off or left to this agent.
+  3. A call that names no target, another session's process or subagent, or a PID the session tree never started
+     is reviewed, and the review is told the target is not one of the agent's jobs.
+"""
+
+from __future__ import annotations
+
+import json
+import time
+import types
+import weakref
+
+import pytest
+
+from tools import approval as approval_module
+from tools import approval_automode as A
+from tools import approval_context
+from tools import approval_own_jobs as J
+from tools.process_registry import process_registry
+
+
+@pytest.fixture(autouse=True)
+def _plain_spawn(monkeypatch):
+    import tools.process_registry as _pr
+    monkeypatch.setattr(_pr, "_SYSTEMD_SCOPE_AVAILABLE", False)
+
+
+@pytest.fixture()
+def judge(monkeypatch):
+    """A judge that blocks everything at both stages; records its prompts."""
+    calls = []
+
+    def complete(stage, system, user, max_tokens):
+        calls.append({"stage": stage, "user": user})
+        return "<block>yes</block>" if stage == 1 else \
+            "<block>yes</block><category>Irreversible Local Destruction</category><reason>not its process</reason>"
+
+    A.set_complete_override(complete)
+    yield calls
+    A.set_complete_override(None)
+
+
+def _cfg(monkeypatch):
+    cfg = {"mode": "smart", "smart_provenance": True}
+    monkeypatch.setattr(approval_context, "_get_approval_config", lambda: cfg)
+    monkeypatch.setattr(approval_context, "_get_approval_mode", lambda: "smart")
+    monkeypatch.setattr(approval_module, "_YOLO_MODE_FROZEN", False)
+
+
+def _call(cid, name, args):
+    return {"role": "assistant", "content": "", "tool_calls": [
+        {"id": cid, "type": "function", "function": {"name": name, "arguments": json.dumps(args)}}]}
+
+
+def _result(cid, content):
+    return {"role": "tool", "tool_call_id": cid, "content": json.dumps(content)}
+
+
+P1, P2, OTHER = "proc_5f81c8aa80e6", "proc_974538f09cc5", "proc_0badc0ffee11"
+
+
+def _chat():
+    return [
+        {"role": "user", "content": "Build relift in the background and run a docs lane."},
+        _call("call_1", "terminal", {"command": "ninja -C build", "background": True}),
+        _result("call_1", {"output": "Background process started", "session_id": P1, "pid": 41231}),
+        _call("call_2", "terminal", {"command": "ctest --test-dir build", "background": True}),
+        _result("call_2", {"output": "Background process started", "session_id": P2, "pid": 41377}),
+        _call("call_3", "delegate_task", {"tasks": [{"goal": "Proofread the docs."}]}),
+        _result("call_3", {"status": "dispatched", "subagents": [{"subagent_id": "sa-3f2a91c0"}],
+                           "results": [{"handed_off_processes": [{"session_id": "proc_b10d0dc9cd3c",
+                                                                  "command": "make corpus"}]}]}),
+        # output that only mentions another process is not the harness's record
+        _call("call_4", "terminal", {"command": "ps aux"}),
+        _result("call_4", {"output": f"{OTHER} pid 999", "session_id": OTHER, "pid": 999}),
+        {"role": "user", "content": "Stop the builds you started; the PC load is too high."},
+    ]
+
+
+def _agent(messages=None, task="turn-1", sid="sess-root"):
+    return types.SimpleNamespace(session_id=sid, _current_task_id=task, _process_owner_task_ids={task},
+                                 _approval_review_messages=messages if messages is not None else [], _session_db=None)
+
+
+@pytest.mark.parametrize("tool,args,key", [
+    ("process_manage", {"action": "kill", "session_id": P1}, P1),
+    ("kanban_complete", {"task_id": "t_42"}, "t_42"),
+    ("delegate_task", {"action": "stop", "subagent_id": "sa-1"}, "sa-1"),
+    ("browser_tabs", {"action": "close", "tab_id": 12}, "12"),
+])
+def test_review_and_card_see_every_argument(monkeypatch, tool, args, key):
+    assert key in json.dumps(A.classifier_input(tool, args, 300))
+    _cfg(monkeypatch)
+    seen = {}
+    monkeypatch.setattr(approval_module, "_presence", lambda *a: (None, False, True, False))
+
+    def decide(spec, tool_name, a, *, command, **_k):
+        seen["command"] = command
+        return {"approved": False, "message": "BLOCKED"}
+
+    monkeypatch.setattr(approval_module, "_provenance_decision", decide)
+    approval_module.check_tool_provenance(tool, args)
+    assert key in seen["command"]
+
+
+@pytest.mark.parametrize("tool,args", [
+    ("process_manage", {"action": "kill", "session_id": P1}),
+    ("process_manage", {"action": "kill", "session_id": "5f81"}),
+    ("process_manage", {"action": "submit", "session_id": P2, "data": "q"}),
+    ("process_manage", {"action": "kill", "session_id": "proc_b10d0dc9cd3c"}),
+    ("delegate_task", {"action": "stop", "subagent_id": "sa-3f2a91c0"}),
+    ("delegate_task", {"action": "steer", "subagent_id": "sa-3f2a91c0", "message": "wrap up"}),
+    ("terminal", {"command": "kill 41231"}),
+    ("terminal", {"command": "kill -9 41231 41377 2>/dev/null; sleep 1; ps -p 41231"}),
+])
+def test_own_job_runs_without_review(judge, tool, args):
+    v = A.review(tool, args, agent=_agent(_chat()), cwd=None)
+    assert v.decision == "allow" and v.stage == 0 and v.detail["own_jobs"]
+    assert judge == []
+
+
+@pytest.mark.parametrize("tool,args,fact", [
+    ("process_manage", {"action": "kill"}, "names no process"),
+    ("process_manage", {"action": "kill", "session_id": OTHER}, f"{OTHER} is not a process"),
+    ("process_manage", {"action": "kill", "session_id": "proc_31337deadbee"}, "is not a process"),
+    ("delegate_task", {"action": "stop", "subagent_id": "sa-77e1d4b2"}, "is not a subagent"),
+    ("terminal", {"command": "kill 999"}, "PID 999 is not"),
+    ("terminal", {"command": "kill 41231 2532335"}, "PID 2532335 is not"),
+])
+def test_other_targets_are_reviewed_with_the_fact(judge, tool, args, fact):
+    v = A.review(tool, args, agent=_agent(_chat()), cwd=None)
+    assert v.decision == "block" and judge
+    assert fact in judge[0]["user"]
+
+
+@pytest.mark.parametrize("command", ["kill $(pgrep ninja)", "pkill -f ninja", "sudo kill 41231", "kill -9 -1",
+                                     "kill 41231 | sh", "kill 41231 && rm -rf build"])
+def test_kill_shapes_the_harness_cannot_tie_are_reviewed(judge, command):
+    v = A.review("terminal", {"command": command}, agent=_agent(_chat()), cwd=None)
+    assert v.decision == "block" and judge
+
+
+def _spawn(owner):
+    return process_registry.spawn_local("sleep 30", task_id=owner, owner_task_id=owner)
+
+
+def test_registry_process_by_id_and_pid(judge):
+    proc = _spawn("turn-reg")
+    try:
+        agent = _agent(task="turn-reg")  # no transcript: compaction folded the start away
+        assert A.review("process_manage", {"action": "kill", "session_id": proc.id[5:11]}, agent=agent).decision == "allow"
+        assert A.review("terminal", {"command": f"kill {proc.pid}"}, agent=agent).decision == "allow"
+        assert judge == []
+        other = _agent(task="turn-someone-else", sid="sess-other")
+        assert A.review("terminal", {"command": f"kill {proc.pid}"}, agent=other).decision == "block"
+        assert A.review("process_manage", {"action": "kill", "session_id": proc.id}, agent=other).decision == "block"
+    finally:
+        process_registry.kill_process(proc.id, source="test")
+
+
+def test_kept_and_handed_off_processes_are_the_parents(judge):
+    kept, handed = _spawn("sa-0-kept01"), _spawn("sa-0-hand01")
+    try:
+        assert process_registry.keep_for_parent(kept.id, from_owner="sa-0-kept01", to_owner="turn-par",
+                                                to_task_id="turn-par", to_session_key="sess-par", note="kept")
+        assert process_registry.transfer_ownership(handed.id, from_owner="sa-0-hand01", to_owner="turn-par",
+                                                   to_task_id="turn-par", to_session_key="sess-par")
+        parent = _agent(task="turn-par", sid="sess-par")
+        for p in (kept, handed):
+            assert A.review("process_manage", {"action": "kill", "session_id": p.id}, agent=parent).decision == "allow"
+        assert judge == []
+    finally:
+        for p in (kept, handed):
+            process_registry.kill_process(p.id, source="test")
+
+
+def test_live_subagents_processes_count_for_the_parent_not_a_sibling(judge, monkeypatch):
+    from tools import delegate_tool_registry as R
+    root = _agent(task="turn-root", sid="sess-root")
+    child = _agent(task="sa-0-child1", sid="sess-child")
+    child._delegate_parent_ref = weakref.ref(root) if hasattr(root, "__weakref__") else (lambda: root)
+    sibling = _agent(task="sa-0-sib1", sid="sess-sib")
+    sibling._delegate_parent_ref = lambda: root
+    monkeypatch.setitem(R._active_subagents, "sa-0-child1", {"subagent_id": "sa-0-child1", "agent": child,
+                                                             "owner_agent_session_id": "sess-root"})
+    proc = _spawn("sa-0-child1")
+    try:
+        assert A.review("terminal", {"command": f"kill {proc.pid}"}, agent=root).decision == "allow"
+        assert A.review("delegate_task", {"action": "stop", "subagent_id": "sa-0-child1"}, agent=root).decision == "allow"
+        assert judge == []
+        assert A.review("terminal", {"command": f"kill {proc.pid}"}, agent=sibling).decision == "block"
+    finally:
+        process_registry.kill_process(proc.id, source="test")
+
+
+def test_subagent_kills_its_own_not_its_parents(judge):
+    child_msgs = [{"role": "user", "content": "relift build lane"},
+                  _call("c1", "terminal", {"command": "corpus_run --all", "background": True}),
+                  _result("c1", {"output": "Background process started", "session_id": "proc_7637b7f0c28c",
+                                 "pid": 366478})]
+    child = _agent(child_msgs, task="sa-0-lane", sid="sess-lane")
+    assert A.review("terminal", {"command": "kill 366478"}, agent=child, messages=child_msgs).decision == "allow"
+    assert A.review("process_manage", {"action": "kill", "session_id": "proc_7637b7f0c28c"}, agent=child,
+                    messages=child_msgs).decision == "allow"
+    assert judge == []
+    assert A.review("process_manage", {"action": "kill", "session_id": P2}, agent=child,
+                    messages=child_msgs).decision == "block"
+
+
+@pytest.mark.parametrize("command,pids", [
+    ("kill 366478", [366478]), ("kill -9 366478 2532335", [366478, 2532335]), ("kill -TERM -- -366478", [366478]),
+    ("kill -s KILL 12 && sleep 1 && kill -9 12", [12, 12]), ("kill $(pgrep x)", None), ("kill -1", None),
+    ("kill 0", None), ("kill -l", None), ("pkill x", None), ("kill 12 | sh", None), ("kill 12 & ", None),
+])
+def test_kill_pids(command, pids):
+    assert J.kill_pids(command) == pids
