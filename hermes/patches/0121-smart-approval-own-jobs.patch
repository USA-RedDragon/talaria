index 00000000..4c26f81b
--- /dev/null
+++ b/tools/process_kinds.py
@@ -0,0 +1,105 @@
+"""What a background process is, from its command: a pure wait loop, or the kind of work it does.
+
+Used when a finished subagent's processes move to its parent (``delegation.keep_child_processes``): a loop that
+only waits (``while pgrep -f ...; do sleep N; done``) watched the subagent's own work, and since ``pgrep -f``
+matches the loop's own command line it often never ends, so it stops with the subagent. Anything else is real work
+and is kept, named by what it is.
+"""
+
+from __future__ import annotations
+
+import os
+import re
+import shlex
+
+# Programs a wait loop may test in its condition: they look at processes or files and change nothing.
+_WAIT_TESTS = frozenset({"pgrep", "pidof", "ps", "test", "[", "[[", "true", ":", "false", "ls", "stat", "grep",
+                         "systemctl", "kill"})
+_IDLE = frozenset({"sleep", ":", "true"})
+_TAIL = frozenset({"echo", "printf", "true", ":", "date"})
+_LOOP = re.compile(r"(?s)(?:while|until)\s+(?P<cond>.+?)\s*;?\s*do\s+(?P<body>.+?)\s*;?\s*done(?P<tail>.*)")
+_REDIRECT = re.compile(r"(?:\d*>&\d|(?:\d+|&)?>>?\s*/dev/null(?![\w/.-]))")
+_SPLIT = re.compile(r"\s*(?:&&|\|\||;|\||\n)\s*")
+
+
+def _unwrap(command: str) -> str:
+    """``bash -c '...'`` and ``sh -lc '...'`` hold the real command."""
+    text = (command or "").strip()
+    try:
+        words = shlex.split(text)
+    except ValueError:
+        return text
+    if len(words) == 3 and os.path.basename(words[0]) in ("bash", "sh", "zsh", "dash") \
+            and re.fullmatch(r"-[a-z]*c[a-z]*", words[1]):
+        return words[2].strip()
+    return text
+
+
+def _parts(text: str) -> list[list[str]] | None:
+    out = []
+    for part in _SPLIT.split(_REDIRECT.sub(" ", text).strip()):
+        if not part:
+            continue
+        try:
+            words = shlex.split(part)
+        except ValueError:
+            return None
+        while words and words[0] == "!":
+            words = words[1:]
+        if words:
+            out.append(words)
+    return out
+
+
+def is_wait_loop(command: str) -> bool:
+    """A ``while``/``until`` loop whose condition only looks at processes or files and whose body only sleeps,
+    optionally followed by an ``echo``. Command or process substitution makes it more than a wait."""
+    text = _unwrap(command)
+    if not text or "$(" in text or "`" in text:
+        return False
+    m = _LOOP.fullmatch(text)
+    if not m:
+        return False
+    cond, body = _parts(m.group("cond")), _parts(m.group("body"))
+    tail = m.group("tail").strip()
+    if tail and not re.match(r"^(?:;|&&|\|\|)", tail):
+        return False
+    tail_parts = _parts(re.sub(r"^(?:;|&&|\|\|)\s*", "", tail)) if tail else []
+    if not cond or not body or tail_parts is None:
+        return False
+    for words in cond:
+        prog = os.path.basename(words[0])
+        if prog not in _WAIT_TESTS or (prog == "kill" and "-0" not in words[1:2]) \
+                or (prog == "systemctl" and "is-active" not in words):
+            return False
+    if any(os.path.basename(w[0]) not in _IDLE for w in body):
+        return False
+    return all(os.path.basename(w[0]) in _TAIL for w in tail_parts)
+
+
+_KINDS = (
+    ("a build", re.compile(r"\b(?:make|ninja|cmake\s+--build|cargo\s+build|go\s+build|meson\s+compile|gradle|mvn|"
+                          r"docker\s+(?:buildx\s+)?build|npm\s+run\s+build|pnpm\s+(?:run\s+)?build|yarn\s+build|"
+                          r"bazel\s+build|msbuild|xcodebuild)\b")),
+    ("a test run", re.compile(r"\b(?:pytest|ctest|cargo\s+test|go\s+test|npm\s+(?:run\s+)?test|tox|nox|jest|"
+                             r"vitest|playwright\s+test|make\s+(?:check|test))\b")),
+    ("a server", re.compile(r"\b(?:serve|server|uvicorn|gunicorn|flask\s+run|vite|next\s+dev|npm\s+run\s+(?:dev|start)|"
+                           r"http\.server|nginx|caddy|redis-server|postgres|--listen|nc\s+-l)\b")),
+    ("a download or sync", re.compile(r"\b(?:curl|wget|rsync|rclone|git\s+(?:clone|fetch|pull)|scp|aria2c)\b")),
+)
+
+
+def describe_process(command: str) -> str:
+    """Plain words for what a kept process does: a build, a test run, a server, a download or sync, or the
+    program it runs."""
+    text = _unwrap(command)
+    if text.startswith(("while ", "until ")) or text.startswith("for "):
+        return "a loop: " + text[:80]
+    for kind, rx in _KINDS:
+        if rx.search(text):
+            return kind
+    parts = _parts(text) or []
+    prog = os.path.basename(parts[0][0]) if parts and parts[0] else "a command"
+    if prog in ("cd", "env", "nice", "ionice", "timeout", "nohup", "setsid") and len(parts) > 1:
+        prog = os.path.basename(parts[1][0])
+    return f"a run of {prog}"
