diff --git a/tools/approval_own_jobs.py b/tools/approval_own_jobs.py
new file mode 100644
index 00000000..65a46251
--- /dev/null
+++ b/tools/approval_own_jobs.py
@@ -0,0 +1,313 @@
+"""The agent's own jobs, for the provenance review (smart approval).
+
+A kill, stop, steer or stdin write that targets a background process or a subagent this agent, or one of its own
+subagents, started in this session is the agent managing its own work. The harness checks that itself: from the
+process registry (the owner of each process, including processes a subagent handed off or left to this agent) and
+from its own records in the agent's transcript (the ``session_id`` and ``pid`` a ``terminal(background=true)``
+call returned, the subagent ids and handed-off processes a ``delegate_task`` call returned). Such a call runs
+without a card. Anything the harness cannot tie to the session tree is reviewed as before, and the review is told
+that the target is not one of the agent's jobs.
+"""
+
+from __future__ import annotations
+
+import json
+import logging
+import os
+import re
+import shlex
+from dataclasses import dataclass, field
+from typing import Any
+
+logger = logging.getLogger("tools.approval")
+
+PROCESS_ACTIONS = frozenset({"kill", "write", "submit", "close", "handoff"})
+SUBAGENT_ACTIONS = frozenset({"stop", "steer"})
+_MIN_PREFIX = 4
+_KILL_SIGNAL = re.compile(r"^-(?:\d+|[A-Z][A-Z0-9+-]*|SIG[A-Z0-9+-]+)$", re.IGNORECASE)
+_SHELL_META = re.compile(r"[<>`]|\$\(|\$\{|&\s*$|\|&|<<")
+_HARMLESS_REDIRECT = re.compile(r"(?:\d*>&\d|(?:\d+|&)?>>?\s*/dev/null(?![\w/.-]))")
+
+
+@dataclass
+class JobTable:
+    """What the session tree started: process ids with their PIDs and commands, and subagent ids."""
+    processes: dict = field(default_factory=dict)   # proc id -> {"pid": int | None, "command": str}
+    subagents: set = field(default_factory=set)
+
+    def pids(self) -> dict:
+        """PID -> process id, for the processes whose PID the harness recorded."""
+        return {p["pid"]: proc for proc, p in self.processes.items() if isinstance(p.get("pid"), int) and p["pid"] > 1}
+
+
+def owner_ids(agent) -> set[str]:
+    """The process owner ids of this agent: its task ids (every turn's) and its session id."""
+    ids = {str(x) for x in (getattr(agent, "_process_owner_task_ids", None) or ()) if x}
+    for attr in ("_current_task_id", "session_id", "_subagent_id"):
+        value = getattr(agent, attr, None)
+        if isinstance(value, str) and value:
+            ids.add(value)
+    return ids
+
+
+def _descendant_owners(agent) -> tuple[set[str], set[str]]:
+    """Owner ids and subagent ids of the live subagents below ``agent`` in the spawn tree."""
+    owners: set[str] = set()
+    subagents: set[str] = set()
+    try:
+        from tools.delegate_tool_registry import _active_subagents, _active_subagents_lock, _owns_subagent_record
+        with _active_subagents_lock:
+            records = list(_active_subagents.values())
+        for record in records:
+            if not _owns_subagent_record(record, agent):
+                continue
+            sid = record.get("subagent_id")
+            if sid:
+                subagents.add(str(sid))
+                owners.add(str(sid))
+            child = record.get("agent")
+            if child is not None:
+                owners |= owner_ids(child)
+    except Exception as exc:
+        logger.debug("own jobs: subagent registry unreadable: %s", exc)
+    return owners, subagents
+
+
+def _registry_processes(owners: set[str]) -> dict:
+    out: dict = {}
+    if not owners:
+        return out
+    try:
+        from tools.process_registry import process_registry as reg
+        with reg._lock:
+            sessions = list(reg._running.values()) + list(reg._finished.values())
+        for s in sessions:
+            if str(getattr(s, "owner_task_id", "") or "") in owners:
+                out[s.id] = {"pid": getattr(s, "pid", None), "command": str(getattr(s, "command", "") or "")}
+    except Exception as exc:
+        logger.debug("own jobs: process registry unreadable: %s", exc)
+    return out
+
+
+def _json(content: Any):
+    if isinstance(content, (dict, list)):
+        return content
+    if not isinstance(content, str):
+        return None
+    try:
+        return json.loads(content)
+    except Exception:
+        return None
+
+
+def _collect_key(value: Any, key: str, out: list, depth: int = 0) -> None:
+    if depth > 6:
+        return
+    if isinstance(value, dict):
+        for k, v in value.items():
+            if k == key and isinstance(v, str) and v:
+                out.append(v)
+            else:
+                _collect_key(v, key, out, depth + 1)
+    elif isinstance(value, list):
+        for v in value[:200]:
+            _collect_key(v, key, out, depth + 1)
+
+
+def _lists_under(value: Any, key: str, depth: int = 0) -> list:
+    """The items of every list stored under ``key`` in a parsed result (each child's entry has its own)."""
+    out: list = []
+    if depth > 6:
+        return out
+    if isinstance(value, dict):
+        for k, v in value.items():
+            if k == key and isinstance(v, list):
+                out.extend(v[:50])
+            else:
+                out.extend(_lists_under(v, key, depth + 1))
+    elif isinstance(value, list):
+        for v in value[:200]:
+            out.extend(_lists_under(v, key, depth + 1))
+    return out
+
+
+def _transcript_jobs(messages: list | None, table: JobTable) -> None:
+    """The harness's own records in the transcript: what a background ``terminal`` call and a ``delegate_task``
+    call returned. Only top-level result fields count, never command output."""
+    from tools.approval_automode import _call_parts, _parse_args
+    msgs = [m for m in (messages or []) if isinstance(m, dict)]
+    results = {m.get("tool_call_id"): m.get("content") for m in msgs if m.get("role") == "tool"}
+    for message in msgs:
+        if message.get("role") != "assistant":
+            continue
+        for call in message.get("tool_calls") or []:
+            cid, name, raw = _call_parts(call)
+            if cid not in results:
+                continue
+            args = _parse_args(raw)
+            value = _json(results[cid])
+            if not isinstance(value, dict):
+                continue
+            if name == "terminal" and args.get("background"):
+                sid = value.get("session_id")
+                if isinstance(sid, str) and sid.startswith("proc_"):
+                    pid = value.get("pid")
+                    table.processes.setdefault(sid, {"pid": pid if isinstance(pid, int) else None,
+                                                     "command": str(args.get("command") or "")})
+            elif name == "delegate_task":
+                ids: list = []
+                _collect_key(value, "subagent_id", ids)
+                table.subagents.update(ids)
+                for handed in _lists_under(value, "handed_off_processes"):
+                    if isinstance(handed, dict) and isinstance(handed.get("session_id"), str):
+                        table.processes.setdefault(handed["session_id"], {"pid": None,
+                                                                          "command": str(handed.get("command") or "")})
+
+
+def job_table(agent, messages: list | None) -> JobTable:
+    """The session tree's process table: this agent's processes and its live subagents' (registry), plus the
+    harness records in its own transcript."""
+    table = JobTable()
+    if agent is not None:
+        owners = owner_ids(agent)
+        child_owners, child_ids = _descendant_owners(agent)
+        table.processes.update(_registry_processes(owners | child_owners))
+        table.subagents |= child_ids
+    _transcript_jobs(messages, table)
+    return table
+
+
+def _resolve_process(ref: str, table: JobTable) -> str | None:
+    """The table's process id that ``ref`` (full id or unique prefix, with or without ``proc_``) names. When the
+    registry resolves ``ref`` it decides, so a prefix that the tool would resolve to another process never counts."""
+    ref = ref.strip()
+    if not ref:
+        return None
+    try:
+        from tools.process_registry import process_registry as reg
+        session = reg.get(ref)
+        if session is not None:
+            return session.id if session.id in table.processes else None
+    except Exception:
+        pass
+    full = ref if ref.startswith("proc_") else f"proc_{ref}"
+    if full in table.processes:
+        return full
+    if len(full) - len("proc_") < _MIN_PREFIX:
+        return None
+    hits = [p for p in table.processes if p.startswith(full)]
+    return hits[0] if len(hits) == 1 else None
+
+
+def _kill_args(words: list[str]) -> list[int] | None:
+    """The PIDs one ``kill`` names (signal options first), or None for a list call, a name or PID 0, 1, -1."""
+    pids: list[int] = []
+    ended, i = False, 0
+    while i < len(words):
+        w = words[i]
+        if not ended:
+            if w == "--":
+                ended, i = True, i + 1
+                continue
+            if w in ("-s", "-n", "--signal"):
+                i += 2
+                continue
+            if w.startswith("--") or w in ("-l", "-L"):
+                return None
+            if not pids and _KILL_SIGNAL.match(w):
+                i += 1
+                continue
+        if not re.fullmatch(r"-?\d+", w) or abs(int(w)) <= 1:
+            return None
+        pids.append(abs(int(w)))
+        i += 1
+    return pids or None
+
+
+def kill_pids(command: str) -> list[int] | None:
+    """The PIDs of a command made only of ``kill`` calls with numeric PIDs (plus harmless read-only steps and a
+    short ``sleep``), or None. ``kill -- -PGID`` names a process group by its leader."""
+    from tools.approval_automode import is_read_only_command
+    if not isinstance(command, str) or not command.strip() or "\n" in command.strip():
+        return None
+    text = _HARMLESS_REDIRECT.sub(" ", command)
+    if _SHELL_META.search(text):
+        return None
+    try:
+        lexer = shlex.shlex(text, posix=True, punctuation_chars="|&;")
+        lexer.whitespace_split = True
+        tokens = list(lexer)
+    except ValueError:
+        return None
+    segments: list[list[str]] = []
+    seg: list[str] = []
+    for tok in tokens + [";"]:
+        if tok and set(tok) <= set("|&;"):
+            if tok not in (";", "&&", "||"):
+                return None
+            if seg:
+                segments.append(seg)
+            seg = []
+        else:
+            seg.append(tok)
+    pids: list[int] = []
+    for seg in segments:
+        prog = os.path.basename(seg[0])
+        if prog == "kill":
+            found = _kill_args(seg[1:])
+            if not found:
+                return None
+            pids.extend(found)
+        elif prog == "sleep" and len(seg) == 2 and re.fullmatch(r"\d+(?:\.\d+)?", seg[1]) and float(seg[1]) <= 10:
+            continue
+        elif prog in ("true", ":"):
+            continue
+        elif is_read_only_command(shlex.join(seg)):
+            continue
+        else:
+            return None
+    return pids or None
+
+
+@dataclass
+class JobCheck:
+    own: bool                      # every target is one of the session tree's jobs
+    targets: list = field(default_factory=list)   # [{"id"|"pid": ..., "command": ...}]
+    fact: str = ""                 # for the review when not own
+
+
+def check(tool_name: str, args: dict, agent=None, messages: list | None = None) -> JobCheck | None:
+    """None when the call is not a job control call. Otherwise whether every target is the agent's own job."""
+    args = args if isinstance(args, dict) else {}
+    action = str(args.get("action") or "").strip().lower()
+    if tool_name in ("process_manage", "process") and action in PROCESS_ACTIONS:
+        ref = args.get("session_id")
+        if not isinstance(ref, str) or not ref.strip():
+            return JobCheck(False, fact="the call names no process")
+        table = job_table(agent, messages)
+        pid = _resolve_process(ref, table)
+        if pid:
+            return JobCheck(True, [{"id": pid, "command": table.processes[pid].get("command", "")[:200]}])
+        return JobCheck(False, fact=f"{ref.strip()} is not a process this agent or its subagents started in this session")
+    if tool_name == "delegate_task" and action in SUBAGENT_ACTIONS:
+        ref = args.get("subagent_id")
+        if not isinstance(ref, str) or not ref.strip():
+            return JobCheck(False, fact="the call names no subagent")
+        table = job_table(agent, messages)
+        if ref.strip() in table.subagents:
+            return JobCheck(True, [{"id": ref.strip()}])
+        return JobCheck(False, fact=f"{ref.strip()} is not a subagent this agent started in this session")
+    if tool_name == "terminal" and not args.get("background"):
+        pids = kill_pids(str(args.get("command") or ""))
+        if pids is None:
+            return None
+        table = job_table(agent, messages)
+        by_pid = table.pids()
+        missing = [p for p in pids if p not in by_pid]
+        if not missing:
+            return JobCheck(True, [{"pid": p, "id": by_pid[p], "command": table.processes[by_pid[p]].get("command", "")[:200]}
+                                   for p in pids])
+        return JobCheck(False, fact="PID " + ", ".join(str(p) for p in missing)
+                        + (" is" if len(missing) == 1 else " are")
+                        + " not a process this agent or its subagents started in this session")
+    return None
