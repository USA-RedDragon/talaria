@@ -0,0 +1,82 @@
+"""gateway.restart_turn_handoff_per_turn: a background subagent waiting (resume_on_exit) on a process that a busy carrier
+held back.
+
+Live, the carrier kept the process until its last carried tool call ended; the process ended on the carrier first, so
+it was never handed over, the next gateway had no record of it and the woken subagent ran its command again. Now the
+carrier relays the process to the next gateway at once: the adopted subagent waits on it there and is woken with its
+real exit and output, and the command runs once.
+"""
+
+import fcntl
+import os
+
+from tests.tools.test_delegate_child_wait import _waiting_child
+from tests.tools.test_delegate_resume_action import (  # fixtures too
+    _Parent, _call, _clean_state, _completions, _db, _fake_child, _finished_child, seams,
+)
+from tests.waiting import wait_until
+from tools import async_delegation as ad
+from tools import delegate_tool_handoff as handoff
+import tools.process_registry as pr
+import tools.process_registry_handoff as prh
+from tools.delegate_tool_registry import _active_subagents, _active_subagents_lock
+from tools.process_registry import ProcessRegistry
+
+
+def _delegation_events(registry, delegation_id) -> list:
+    events = []
+    while not registry.completion_queue.empty():
+        event = registry.completion_queue.get_nowait()
+        if isinstance(event, dict) and event.get("type") == "async_delegation" and event.get(
+                "delegation_id") == delegation_id:
+            events.append(event)
+    return events
+
+
+def test_a_subagent_waiting_on_a_held_process_is_woken_with_its_real_output_on_the_next_gateway(
+        seams, monkeypatch, tmp_path):
+    monkeypatch.setattr(pr, "CHECKPOINT_PATH", tmp_path / "processes.json")
+    monkeypatch.setattr(prh, "configured_handoff_backends", lambda: ["device"])
+    db = _db()
+    _finished_child(db)
+    child = _waiting_child(f"for i in 1 2 3 4; do echo tick$i >> {tmp_path}/runs; echo tick$i; sleep 0.5; done; "
+                           "echo zd-sub-done")
+    seams(child)
+    run_id = _call(_Parent(db), subagent_id="sa-0-abcd", message="run it and wait")["run_id"]
+    wait_until(lambda: any(r.get("status") == "waiting" for r in _active_subagents.values()), what="waiting")
+    session = child.seen["session"]
+    session.backend = "device"  # a device command, as live
+
+    # The restart hands the waiting subagent over (0016); the busy carrier relays its process (this patch).
+    assert ad.hand_off_for_restart(2.0, 8.0) == 1
+    carrier = pr.process_registry
+    lock = tmp_path / ".turn-carry.lock"
+    fd = os.open(lock, os.O_RDWR | os.O_CREAT, 0o600)
+    fcntl.flock(fd, fcntl.LOCK_EX)
+    try:
+        assert carrier.relay_to_successor(tmp_path / "relay", lock, ["device"]) == [session.id]
+
+        # The next gateway: its own process registry reattaches the relayed process, then adopts the subagent.
+        nxt = ProcessRegistry()
+        monkeypatch.setattr(pr, "process_registry", nxt)
+        assert nxt.recover_from_checkpoint() == 1
+        ad._reset_for_tests()
+        with _active_subagents_lock:
+            _active_subagents.clear()
