diff --git a/tools/process_registry_relay.py b/tools/process_registry_relay.py
new file mode 100644
index 00000000..a4d79641
--- /dev/null
+++ b/tools/process_registry_relay.py
@@ -0,0 +1,326 @@
+"""Move background processes to the next gateway while the old one still holds their backend's connection.
+
+``gateway.restart_turn_handoff_per_turn``: the old gateway (the carrier) carries its running turns on after the next
+gateway took the profile over. The real process handoff (``ProcessHandoffMixin.hand_off_for_restart``) closes the
+device connections, so the carrier makes it only once no carried turn runs a tool call there. Until then each
+background process belongs to the next gateway already and the carrier only relays it:
+
+* the carrier (:meth:`ProcessRelayMixin.relay_to_successor`) keeps reading the process as before, but writes every
+  chunk of its output to ``<dir>/<id>.out`` and its exit to ``<id>.exit``, never reports it itself (no completion,
+  watch match or heartbeat) and kills it when the next gateway asks (``<id>.kill``); the process goes into the
+  checkpoint with the reattach kind ``carry``;
+* the next gateway reattaches it from the checkpoint (:meth:`ProcessRelayMixin._reattach_relay_session`), shows its
+  output to its viewers and reports its exit to its owner (a waiting subagent's wake included);
+* when the carrier makes the real handoff it writes the process's handoff state to ``<id>.switch`` once the output
+  before it is in ``<id>.out``, and the next gateway goes on reading the process from there itself;
+* a carrier that exits without either file left the process unreported: it is reported lost once.
+"""
+
+import codecs
+import json
+import logging
+import os
+import threading
+import time
+from contextlib import suppress
+from pathlib import Path
+from typing import Iterable, Optional
+
+logger = logging.getLogger("tools.process_registry")
+
+RELAY_KIND = "carry"
+RELAY_POLL_SECONDS = 0.1
+# How long a kill on the next gateway waits for the carrier to report the relayed process ended.
+RELAY_KILL_WAIT_SECONDS = 15.0
+_TAIL_CHARS = 20_000
+
+
+def _paths(directory, session_id) -> dict:
+    base = Path(directory)
+    return {ext: base / f"{session_id}.{ext}" for ext in ("out", "exit", "switch", "kill")}
+
+
+def _write_json(path: Path, value: dict) -> None:
+    tmp = path.with_name(path.name + ".tmp")
+    with open(tmp, "w", encoding="utf-8") as fh:
+        json.dump(value, fh)
+        fh.flush()
+        os.fsync(fh.fileno())
+    os.replace(tmp, path)
+
+
+def _read_json(path: Path) -> Optional[dict]:
+    try:
+        value = json.loads(path.read_text(encoding="utf-8"))
+    except (OSError, ValueError):
+        return None
+    return value if isinstance(value, dict) else None
+
+
+def _holder_alive(lock) -> bool:
+    """Whether the carrier still holds its lock file (a flock ends with its process)."""
+    if not lock:
+        return False
+    import fcntl
+    try:
+        fd = os.open(lock, os.O_RDONLY)
+    except FileNotFoundError:
+        return False
+    except OSError:
+        return True
+    try:
+        try:
+            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
+        except OSError:
+            return True
+        fcntl.flock(fd, fcntl.LOCK_UN)
+        return False
+    finally:
+        os.close(fd)
+
+
+def stale_relay(entry: dict) -> bool:
+    """A checkpoint entry of a relay whose files are gone: the next gateway settled it already."""
+    state = entry.get("reattach") or {}
+    if not isinstance(state, dict) or state.get("kind") != RELAY_KIND:
+        return False
+    return not _paths(state.get("dir") or ".", entry.get("session_id") or "")["out"].exists()
+
+
+class ProcessRelayMixin:
+    """Mixed into ``ProcessRegistry``; the registry supplies ``_running``, ``_finished``, ``_lock``,
+    ``_track_started``, ``_ingest_output``, ``_finish_exited``, ``_write_checkpoint`` and ``kill_process``."""
+
+    # ── the carrier ──────────────────────────────────────────────────────────────────────────────────────
+
+    def _relay_init(self) -> None:
+        if getattr(self, "_relaying", None) is None:
+            self._relaying: dict = {}
+            self._relay_thread: Optional[threading.Thread] = None
+            self._sync_waits: dict = {}
+            # Orders the writes of one relay: output, then the exit or the switch after it.
+            self._relay_io = threading.RLock()
+
+    def note_sync_wait(self, session_id: str, delta: int) -> None:
+        """``wait()`` blocks a tool call on *session_id*: the process stays here until that call returns."""
+        self._relay_init()
+        with self._lock:
+            count = self._sync_waits.get(session_id, 0) + delta
+            if count > 0:
+                self._sync_waits[session_id] = count
+            else:
+                self._sync_waits.pop(session_id, None)
+
+    def relay_to_successor(self, directory, lock, backends: Iterable[str]) -> list[str]:
+        """Relay every running process of *backends* to the next gateway, except one a tool call waits on here;
+        returns the ids relayed now. *lock* is the file the carrier holds for the rest of its life."""
+        self._relay_init()
+        backends = {name for name in backends if name}
+        if not backends:
+            return []
+        with self._lock:
+            candidates = [s for s in self._running.values()
+                          if not s.exited and not s.handed_off and not s._carry_relay and s.backend in backends
+                          and s.id not in self._sync_waits]
+        if not candidates:
+            return []
+        Path(directory).mkdir(mode=0o700, parents=True, exist_ok=True)
+        relayed = []
+        for session in candidates:
+            paths = _paths(directory, session.id)
+            with session._lock:
+                if session.exited or session.handed_off:
+                    continue
+                paths["out"].touch(mode=0o600)
+                session.reattach = {"kind": RELAY_KIND, "dir": str(directory), "lock": str(lock),
+                                    "output_tail": session.output_buffer[-_TAIL_CHARS:],
+                                    "total_output_chars": session.total_output_chars}
+                session._carry_relay = str(directory)
+                self._relaying[session.id] = [session, session.total_output_chars]
+            relayed.append(session.id)
+        if relayed:
+            self._write_checkpoint()
+            self._ensure_relay_thread()
+            logger.info("Relaying %d background process(es) to the next gateway: %s", len(relayed), ", ".join(relayed))
+        return relayed
+
+    def _ensure_relay_thread(self) -> None:
+        with self._lock:
+            if self._relay_thread is not None and self._relay_thread.is_alive():
+                return
+            self._relay_thread = threading.Thread(target=self._relay_writer_loop, name="process-relay", daemon=True)
+            self._relay_thread.start()
+
+    def _relay_writer_loop(self) -> None:
+        while True:
+            with self._lock:
+                items = list(self._relaying.items())
+                if not items:
+                    self._relay_thread = None
+                    return
+            for session_id, (session, _written) in items:
+                try:
+                    self._relay_step(session)
+                except Exception:
+                    logger.warning("Relay of process %s failed", session_id, exc_info=True)
+            time.sleep(RELAY_POLL_SECONDS)
+
+    def _relay_flush(self, session) -> None:
+        """Append the output read since the last flush to ``<id>.out``. Caller holds no session lock."""
+        with self._relay_io:
+            self._relay_flush_locked(session)
+
+    def _relay_flush_locked(self, session) -> None:
+        with self._lock:
+            item = self._relaying.get(session.id)
+        if item is None:
+            return
+        with session._lock:
+            delta = session.total_output_chars - item[1]
+            text = session.output_buffer[-delta:] if delta > 0 else ""
+            lost = max(0, delta - len(session.output_buffer))
+            item[1] = session.total_output_chars
+        if lost:
+            text = f"\n[{lost} characters of output were not relayed]\n" + text
+        if text:
+            with open(_paths(session._carry_relay, session.id)["out"], "a", encoding="utf-8") as fh:
+                fh.write(text)
+
+    def _relay_step(self, session) -> None:
+        paths = _paths(session._carry_relay, session.id)
+        if paths["kill"].exists() and not session.exited:
+            with suppress(OSError):
+                paths["kill"].unlink()
+            logger.info("Next gateway asked to stop relayed process %s", session.id)
+            self.kill_process(session.id, source="process.kill", consume_output=False)
+        exited = session.exited and session._completion_event.is_set()
+        with self._relay_io:
+            with self._lock:
+                if session.id not in self._relaying:
+                    return  # switched meanwhile
+            self._relay_flush_locked(session)
+            if not exited:
+                return
+            _write_json(paths["exit"], {"exit_code": session.exit_code, "completion_reason": session.completion_reason,
+                                        "termination_source": session.termination_source,
+                                        "exited_at": session.exited_at,
+                                        "consumed": session.id in self._completion_consumed})
+            with self._lock:
+                self._relaying.pop(session.id, None)
+
+    def _relay_switch(self, session, state: dict) -> None:
+        """The real handoff took *session* (``hand_off_for_restart``): the next gateway reads it itself from here."""
+        self._relay_init()
+        if not session._carry_relay:
+            return
+        with self._relay_io:
+            with self._lock:
+                if session.id not in self._relaying:
+                    return  # its exit was relayed already
+            self._relay_flush_locked(session)
+            with self._lock:
+                self._relaying.pop(session.id, None)
+            clean = {k: v for k, v in state.items() if k not in ("output_tail", "total_output_chars")}
+            _write_json(_paths(session._carry_relay, session.id)["switch"], clean)
+
+    def relaying(self) -> int:
+        self._relay_init()
+        with self._lock:
+            return len(self._relaying)
+
+    # ── the next gateway ─────────────────────────────────────────────────────────────────────────────────
+
+    def _reattach_relay_session(self, session, state: dict) -> bool:
+        directory = state.get("dir") or ""
+        if not directory or not _paths(directory, session.id)["out"].exists():
+            return False
+        session._relay_in = directory
+        session._relay_lock = str(state.get("lock") or "")
+        session.backend = session.backend or ""
+        self._track_started(session, self._relay_reader_loop, f"proc-relay-{session.id}")
+        return True
+
+    def _relay_reader_loop(self, session) -> None:
+        """Read a relayed process: its output as the carrier writes it, then its exit or its handoff state."""
+        paths = _paths(session._relay_in, session.id)
+        decoder = codecs.getincrementaldecoder("utf-8")(errors="replace")
+        offset = 0
+        last_check = 0.0
+        holder_gone = False
+
+        def read_out() -> None:
+            nonlocal offset
+            try:
+                with open(paths["out"], "rb") as fh:
+                    fh.seek(offset)
+                    chunk = fh.read()
+            except OSError:
+                return
+            offset += len(chunk)
+            if text := decoder.decode(chunk):
+                self._ingest_output(session, text, unless_exited=True)
+
+        while not session.exited:
+            # Decided before the read: the carrier writes these only after the output before them.
+            ended = paths["exit"].exists() or paths["switch"].exists() or holder_gone
+            read_out()
+            if ended:
+                break
+            now = time.monotonic()
+            if now - last_check >= 1.0:
+                last_check = now
+                holder_gone = not _holder_alive(session._relay_lock)
+                if holder_gone:
+                    continue  # one more read of what it wrote before it exited
+            time.sleep(RELAY_POLL_SECONDS)
+        if tail := decoder.decode(b"", final=True):
+            self._ingest_output(session, tail, unless_exited=True)
+        if session.exited:  # a kill here settled it
+            self._relay_cleanup(paths)
+            return
+        exit_info = _read_json(paths["exit"])
+        switch = _read_json(paths["switch"])
+        self._relay_cleanup(paths)
+        if exit_info is not None:
+            if exit_info.get("consumed"):  # a carried tool call already read its result there
+                self._completion_consumed.add(session.id)
+            code = exit_info.get("exit_code")
+            self._finish_exited(session, -1 if code is None else code,
+                                reason=str(exit_info.get("completion_reason") or "exited"),
+                                source=str(exit_info.get("termination_source") or ""))
+            return
+        if switch is not None:
+            session._relay_in = ""
+            if self._continue_relayed(session, switch):
+                return
+        logger.info("Relayed process %s was neither ended nor handed over by the carrier; reported lost", session.id)
+        self._finish_exited(session, -1, reason="lost", source="handoff_lost")
+
+    def _continue_relayed(self, session, state: dict) -> bool:
+        """Read the process from its backend as the real handoff left it."""
+        from tools.process_registry_handoff import ENV_KIND
+        kind = state.get("kind")
+        try:
+            if kind == ENV_KIND:
+                return bool(self._reattach_env_session(session, state))
+            return bool(self._reattach_provider_session(session, kind, state))
+        except Exception:
+            logger.warning("Could not take over relayed process %s (%s)", session.id, kind, exc_info=True)
+            return False
+
+    @staticmethod
+    def _relay_cleanup(paths) -> None:
+        for path in paths.values():
+            with suppress(OSError):
+                path.unlink()
+
+    def _relay_kill(self, session) -> Optional[dict]:
+        """A kill here of a process the carrier still runs: the carrier kills it and relays the exit. None once it
+        ended (the caller answers as for an exited process), else an error result."""
+        paths = _paths(session._relay_in, session.id)
+        with suppress(OSError):
+            paths["kill"].touch(mode=0o600)
+        if session._completion_event.wait(RELAY_KILL_WAIT_SECONDS):
+            return None
+        return {"status": "error", "session_id": session.id, "process_running": True,
+                "error": "The old gateway still runs this process and did not stop it in time; try again."}
