+# How often a busy carrier looks for background processes to relay (new ones, or one a tool call stopped waiting on).
+RELAY_CHECK_S = 0.5
+
+
+def relay_dir(home, epoch) -> Path:
+    return Path(home) / RELAY_DIR / f"{int(epoch)}.proc"
+
+
+async def _relay_processes(carry) -> None:
+    """While the real handoff waits: every background process no tool call here waits on becomes the next gateway's
+    at once, and this gateway only relays its output, exit and kill (``ProcessRelayMixin``)."""
+    if time.monotonic() - carry.relay_checked < RELAY_CHECK_S:
+        return
+    carry.relay_checked = time.monotonic()
+    from tools.process_registry_handoff import configured_handoff_backends
+    try:
+        from tools.process_registry import process_registry
+        backends = configured_handoff_backends()
+        relayed = await asyncio.to_thread(process_registry.relay_to_successor, relay_dir(carry.home, carry.epoch),
+                                          str(lock_path(carry.home)), backends) if backends else []
+    except Exception:
+        logger.warning("Relay of the background processes to the next gateway failed", exc_info=True)
+        return
+    if relayed:
+        carry.relayed.update(relayed)
+        carry.relay_announced = False
+    _announce_relay(carry)
+
+
+def _announce_relay(carry) -> None:
+    if carry.relayed and not carry.relay_announced and carry.events is not None:
+        carry.relay_announced = True
+        # The next gateway reattaches them (the relay kind) and adopts the subagents that wait on them.
+        _write_frame(carry, {"type": PROCESSES_HANDED, "session_id": ""})
+
+
