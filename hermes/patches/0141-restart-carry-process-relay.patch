@@ -0,0 +1,242 @@
+"""gateway.restart_turn_handoff_per_turn and the background processes of a busy carrier.
+
+The real process handoff closes the device connections, so the carrier makes it only once no carried turn runs a
+tool call. On a busy instance (a carried turn always in a tool round) that moment came only at the end of the
+carry: a process held back until then kept running and reporting on the old gateway alone, its output reached no
+viewer, and one that ended meanwhile was never handed over, so the next gateway had no record of it and the
+subagent waiting on it ran its command again. Now:
+
+- every background process goes to the next gateway at once and the carrier relays its output, exit and kill;
+- a process a carried tool call waits on stays until that call returns, then goes;
+- the real handoff at the end of the carry continues a relayed process on the next gateway from its state.
+"""
+import asyncio
+import json
+import os
+import threading
+import time
+from pathlib import Path
+
+import pytest
+
+import tools.process_registry as pr
+import tools.process_registry_handoff as handoff
+from gateway import turn_boundary, turn_carry, turn_handoff
+from tools.process_registry import ProcessRegistry
+
+from tests.gateway.test_restart_turn_carry import _NextAuthority, _claimed_turn, _old_runner, _reserve_profile, _until
+from tests.tools.test_process_handoff import ShellEnv, _completions
+
+
+@pytest.fixture(autouse=True)
+def _clean(monkeypatch, tmp_path):
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+    monkeypatch.setattr(turn_handoff, "_handing_off", False)
+    monkeypatch.setattr(turn_boundary, "_resuming", set())
+    monkeypatch.setattr(turn_boundary, "_handed_off", set())
+    monkeypatch.setattr(turn_carry, "_released", False)
+    monkeypatch.setattr(turn_carry, "_api_target", None)
+    monkeypatch.setattr(turn_carry, "_carrying", False)
+
+    async def noop(*_a, **_k):
+        return None
+    for name in ("_stop_cron", "_hand_off_background", "_disconnect_messaging"):
+        monkeypatch.setattr(turn_carry, name, noop)
+
+
+@pytest.fixture
+def gateways(tmp_path, monkeypatch):
+    """The carrier's process registry (the process-global one) and the next gateway's, on one device env."""
+    monkeypatch.setattr(pr, "CHECKPOINT_PATH", tmp_path / "processes.json")
+    monkeypatch.setattr(pr, "ENV_POLL_INTERVAL_SECONDS", 0.05)
+    monkeypatch.setattr(handoff, "configured_handoff_backends", lambda: ["device"])
+    (tmp_path / "device").mkdir()
+    env = ShellEnv(tmp_path / "device")
+    monkeypatch.setattr(handoff, "_environment_for", lambda backend, s: env)
+    carrier, nxt = ProcessRegistry(), ProcessRegistry()
+    monkeypatch.setattr(pr, "process_registry", carrier)
+    shown = []
+    nxt.on_output = lambda session, chunk: shown.append((time.monotonic(), session.id, chunk))
+    nxt.shown = shown
+    return carrier, nxt, env
+
+
+def _spawn(registry, env, command):
+    session = registry.spawn_via_env(env, command, task_id="t1", session_key="agent:main:webapp:dm:1",
+                                     backend="device")
+    session.notify_on_complete = True
+    session.parent_session_id = "sess-1"
+    registry._write_checkpoint()
+    return session
+
+
+def _watch(monkeypatch, owner, tmp_path, nxt):
+    """The next gateway's watch of the carrier; its process reattach reads the checkpoint into *nxt*."""
+    from hermes_state_runtime import turn_carry_record
+    reattached = []
+
+    async def reattach(_runner):
+        reattached.append(await asyncio.to_thread(nxt.recover_from_checkpoint))
+    monkeypatch.setattr(turn_carry, "_reattach_processes", reattach)
+    import tools.delegate_tool_handoff as dth
+    monkeypatch.setattr(dth, "resume_handed_off_delegations", lambda: 0)
+    authority = _NextAuthority(owner.db)
+    remote = turn_carry._Remote(owner.runner, authority, turn_carry_record(owner.db), tmp_path)
+    authority._turn_carrier = remote
+    return reattached, asyncio.ensure_future(turn_carry._watch(remote))
+
+
+async def _busy_carry(owner, tmp_path):
+    """A carry whose only turn is in a tool round for good."""
+    _reserve_profile(tmp_path)
+    row, _live, agent = _claimed_turn(owner, "busy")
+    agent._executing_tools = True
+    runner = _old_runner(owner)
+    carry = asyncio.ensure_future(turn_carry.carry_restart(runner))
+    await _until(turn_carry.released)
+    return row, agent, runner, carry
+
+
+async def _end_carry(owner, row, runner, carry, watch):
+    from hermes_state_runtime import settle_session_input
+    settle_session_input(owner.db, epoch=owner.epoch, admission_id=row["admission_id"],
+                         generation=row["generation"], outcome="completed")
+    await asyncio.wait_for(carry, 10.0)
+    os.close(runner._turn_carry.lock_fd)  # the carrier exits
+    await asyncio.wait_for(watch, 10.0)
+
+
+@pytest.mark.platforms("linux")
+@pytest.mark.asyncio
+async def test_a_busy_carrier_hands_a_process_over_at_once_and_its_output_and_exit_reach_the_next_gateway(
+        owner, tmp_path, monkeypatch, gateways):
+    carrier, nxt, env = gateways
+    session = _spawn(carrier, env, "for i in 1 2 3 4 5 6; do echo tick$i; sleep 0.4; done; echo zd-sub-done")
+    row, agent, runner, carry = await _busy_carry(owner, tmp_path)
+    started = time.monotonic()
+    _reattached, watch = _watch(monkeypatch, owner, tmp_path, nxt)
+    await _until(lambda: nxt.get(session.id) is not None, timeout=3.0)
+    assert agent._executing_tools and not session.exited  # handed over while the carried turn is still busy
+    took = time.monotonic() - started
+    assert took < 3.0
+    # Its output reaches the next gateway's viewers while it runs, from what it printed before the handoff on.
+    await _until(lambda: any("tick3" in chunk for _t, _sid, chunk in nxt.shown), timeout=5.0)
+    assert not nxt.get(session.id).exited
+    resumed = nxt.get(session.id)
+    assert await asyncio.to_thread(resumed._completion_event.wait, 10)
+    assert resumed.exit_code == 0 and resumed.completion_reason == "exited"
+    for i in range(1, 7):
+        assert resumed.output_buffer.count(f"tick{i}\n") == 1
+    assert "zd-sub-done" in resumed.output_buffer
+    (event,) = _completions(nxt)  # the next gateway reports it, once
+    assert event["session_id"] == session.id and event["exit_code"] == 0 and "zd-sub-done" in event["output"]
+    assert _completions(carrier) == []  # the carrier read it to its end but reports nothing
+    assert session.exited  # ended on the carrier while it was still busy
+    await _end_carry(owner, row, runner, carry, watch)
+    assert nxt.get(session.id).exit_code == 0
+    assert _completions(nxt) == []
+
+
+@pytest.mark.platforms("linux")
+@pytest.mark.asyncio
+async def test_a_relayed_process_still_running_at_the_end_of_the_carry_goes_on_from_the_real_handoff(
+        owner, tmp_path, monkeypatch, gateways):
+    carrier, nxt, env = gateways
+    session = _spawn(carrier, env, "echo first; sleep 2; echo second; exit 4")
+    row, _agent, runner, carry = await _busy_carry(owner, tmp_path)
+    _reattached, watch = _watch(monkeypatch, owner, tmp_path, nxt)
+    await _until(lambda: nxt.get(session.id) is not None and "first" in nxt.get(session.id).output_buffer,
+                 timeout=3.0)
+    # The carried turn ends while the process still runs: the carry ends with the real handoff.
+    await _end_carry(owner, row, runner, carry, watch)
+    assert session.handed_off and not session.exited
+    resumed = nxt.get(session.id)
+    assert await asyncio.to_thread(resumed._completion_event.wait, 10)
+    assert resumed.exit_code == 4
+    assert resumed.output_buffer.count("first") == 1 and resumed.output_buffer.count("second") == 1
+    (event,) = _completions(nxt)
+    assert event["exit_code"] == 4
+    assert _completions(carrier) == []
+    assert not list(turn_carry.relay_dir(tmp_path, owner.epoch).glob("*"))  # the relay files are gone
+
+
+@pytest.mark.platforms("linux")
+@pytest.mark.asyncio
+async def test_a_process_a_carried_tool_call_waits_on_goes_over_once_the_wait_returns(
+        owner, tmp_path, monkeypatch, gateways):
+    carrier, nxt, env = gateways
+    waited = _spawn(carrier, env, "sleep 4; echo waited")
+    other = _spawn(carrier, env, "sleep 4; echo other")
+    result = {}
+    in_wait = threading.Event()
+
+    def carried_wait():  # a carried turn's process_manage wait, in its tool round
+        in_wait.set()
+        result.update(carrier.wait(waited.id, timeout=2))
+    thread = threading.Thread(target=carried_wait, daemon=True)
+    thread.start()
+    in_wait.wait(5)
+    await asyncio.sleep(0.1)
+    row, _agent, runner, carry = await _busy_carry(owner, tmp_path)
+    _reattached, watch = _watch(monkeypatch, owner, tmp_path, nxt)
+    # The long tool round of the carried turn does not keep the other process back.
+    await _until(lambda: nxt.get(other.id) is not None, timeout=3.0)
+    assert nxt.get(waited.id) is None and thread.is_alive()
+    await asyncio.to_thread(thread.join, 10)
+    assert result["status"] == "timeout"
+    await _until(lambda: nxt.get(waited.id) is not None, timeout=3.0)
+    for session in (waited, other):
+        resumed = nxt.get(session.id)
+        assert await asyncio.to_thread(resumed._completion_event.wait, 10)
+        assert resumed.exit_code == 0
+    assert "waited" in nxt.get(waited.id).output_buffer and "other" in nxt.get(other.id).output_buffer
+    await _end_carry(owner, row, runner, carry, watch)
+
+
+@pytest.mark.platforms("linux")
+@pytest.mark.asyncio
+async def test_a_kill_on_the_next_gateway_stops_a_process_the_carrier_relays(owner, tmp_path, monkeypatch, gateways):
+    carrier, nxt, env = gateways
+    session = _spawn(carrier, env, "echo up; sleep 30")
+    row, _agent, runner, carry = await _busy_carry(owner, tmp_path)
+    _reattached, watch = _watch(monkeypatch, owner, tmp_path, nxt)
+    await _until(lambda: nxt.get(session.id) is not None and "up" in nxt.get(session.id).output_buffer, timeout=3.0)
+    host_pid = int(Path(session.env_files[1]).read_text())
+    result = await asyncio.to_thread(nxt.kill_process, session.id)
+    assert result["status"] == "killed" and "up" in result["output"]
+    assert nxt.get(session.id).exited and session.exited
+    deadline = time.monotonic() + 5
+    while time.monotonic() < deadline:
+        try:
+            os.kill(host_pid, 0)
+        except OSError:
+            break
+        await asyncio.sleep(0.05)
+    else:
+        pytest.fail("the relayed process still runs")
+    assert _completions(carrier) == []
+    await _end_carry(owner, row, runner, carry, watch)
+
+
+@pytest.mark.platforms("linux")
+def test_a_carrier_that_exits_without_relaying_the_end_leaves_the_process_reported_lost_once(tmp_path, gateways):
+    import fcntl
+    carrier, nxt, env = gateways
+    session = _spawn(carrier, env, "echo up; sleep 30")
+    lock = tmp_path / ".turn-carry.lock"
+    fd = os.open(lock, os.O_RDWR | os.O_CREAT, 0o600)
+    fcntl.flock(fd, fcntl.LOCK_EX)
+    assert carrier.relay_to_successor(tmp_path / "relay", lock, ["device"]) == [session.id]
+    assert nxt.recover_from_checkpoint() == 1
+    carrier._relaying.clear()  # the carrier dies without writing the exit or the handoff state
+    os.close(fd)
+    resumed = nxt.get(session.id)
+    assert resumed._completion_event.wait(10)
+    assert resumed.completion_reason == "lost" and resumed.termination_source == "handoff_lost"
+    assert len(_completions(nxt)) == 1
+    # Its checkpoint entry is settled: a later gateway does not report it again.
+    later = ProcessRegistry()
+    assert later.recover_from_checkpoint() == 0 and later.get(session.id) is None
+    assert session.id not in [e["session_id"] for e in json.loads((tmp_path / "processes.json").read_text())]
+    carrier._relay_init()
+    carrier.kill_process(session.id)  # this test's own leftover
