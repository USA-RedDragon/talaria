@@ -0,0 +1,160 @@
+"""Which Claude account the smart approval judge runs on.
+
+The judge is configured on the account pool (``approvals.smart_model`` and ``smart_fast_model`` name
+``claude-pool``). The account the user picked for the chat decides who pays for the review of its calls:
+
+* A chat on an Anthropic API-key provider (``claude-api-<account>``, the rule subagents follow in
+  ``delegate_tool_claude``) has both judge stages run on that provider, with the configured judge model. The pool
+  is not used, so a pool at its limit does not stop the review.
+* A chat on the pool keeps the pool. Only when every pool account is at its limit or on hold (``PoolExhausted``)
+  do both stages move, for the rest of that review, to the API-key provider with the most API credit left
+  (``claude_api_credit_choice``). With no API account that has credit, or no readable estimate, nothing moves and
+  the user is asked, as before.
+* Any other chat, and a judge route that does not name the pool, are left as configured.
+
+``claude_api_credit_choice`` is the one seam to change when the fallback policy changes.
+
+The state of one review lives in a context variable that ``approval_automode.review`` sets, so the judge calls
+(and the card text) know the chat without the call chain carrying it.
+"""
+
+from __future__ import annotations
+
+import contextvars
+import logging
+import sys
+from contextlib import contextmanager
+from dataclasses import dataclass, field
+from typing import Any, Iterator, Optional
+
+from tools.delegate_tool_claude import CLAUDE_POOL, _name, parent_claude_account
+
+logger = logging.getLogger(__name__)
+
+API_PREFIX = "claude-api-"
+# The module the claude-accounts plugin loads its shared state as (talaria-claude-pool core.py).
+ACCOUNTS_CORE = "hermes_claude_accounts_core"
+_DROP = ("base_url", "api_key", "api_mode")
+
+
+@dataclass
+class ReviewChat:
+    """The chat whose call is being reviewed, as far as the judge route cares."""
+
+    account: Optional[str] = None  # the chat's Anthropic API-key provider, or None
+    on_pool: bool = False  # the chat runs on the account pool
+    fallback: Optional[str] = None  # the API-key provider the judge moved to after the pool ran out
+    used: list[str] = field(default_factory=list)  # providers a judge call was answered on
+
+    @property
+    def provider(self) -> Optional[str]:
+        """The API-key provider the judge runs on in place of the pool, if any."""
+        return self.account or self.fallback
+
+
+_current: contextvars.ContextVar[Optional[ReviewChat]] = contextvars.ContextVar("approval_judge_chat", default=None)
+
+
+def is_pool(provider: Any) -> bool:
+    return _name(provider).lower() == CLAUDE_POOL
+
+
+def chat_of(agent: Any, root: Any = None) -> ReviewChat:
+    """The ReviewChat of a reviewed agent: its root chat for a subagent, the agent itself otherwise."""
+    chat = root if root is not None else agent
+    if chat is None:
+        return ReviewChat()
+    account = parent_claude_account(chat)
+    on_pool = account is None and any(is_pool(getattr(chat, key, None)) for key in ("requested_provider", "provider"))
+    return ReviewChat(account=account, on_pool=on_pool)
+
+
+@contextmanager
+def review_chat(chat: ReviewChat) -> Iterator[ReviewChat]:
+    token = _current.set(chat)
+    try:
+        yield chat
+    finally:
+        _current.reset(token)
+
+
+def current() -> Optional[ReviewChat]:
+    return _current.get()
+
+
+def route_for(route: dict) -> dict:
+    """``route`` (one stage's configured judge route) on the chat's API-key provider when it names the pool and the
+    review has one; the pool's own address and key never carry over. Any other route is returned as it is."""
+    chat = _current.get()
+    provider = chat.provider if chat is not None else None
+    if not provider or not is_pool(route.get("provider")):
+        return route
+    return {**{k: v for k, v in route.items() if k not in _DROP}, "provider": provider}
+
+
+def note_used(route: dict) -> None:
+    """Record the provider a judge call was answered on."""
+    chat = _current.get()
+    provider = _name(route.get("provider"))
+    if chat is not None and provider and provider not in chat.used:
+        chat.used.append(provider)
+
+
+def claude_api_credit_choice() -> Optional[tuple[str, float]]:
+    """``(provider, USD left)`` of the Anthropic API-key account with the most credit left, or None.
+
+    Reads the estimate the hub shows per account (the plan's monthly credit less what Hermes spent through the
+    key since the cycle started), from the claude-accounts plugin loaded in this process. An account without a
+    key, without a readable estimate, or with no credit left is not a choice; the first account in the plugin's
+    order wins a tie. None when the plugin is not loaded or no account qualifies, so the user is asked."""
+    core = sys.modules.get(ACCOUNTS_CORE)
+    if core is None:
+        logger.info("Smart approval (provenance): the claude-accounts plugin is not loaded; no API credit estimate")
+        return None
+    best: Optional[tuple[str, float]] = None
+    try:
+        accounts = list(core.accounts())
+    except Exception as exc:
+        logger.warning("Smart approval (provenance): API accounts unreadable (%s)", type(exc).__name__)
+        return None
+    for acct in accounts:
+        try:
+            plan = (core.status(acct) or {}).get("subscription_type")
+            credits = core.api_credits(acct, plan)
+        except Exception as exc:  # one account's estimate failing must not hide the others
+            logger.warning("Smart approval (provenance): API credit estimate of %s failed (%s)", acct.id,
+                           type(exc).__name__)
+            continue
+        left = credits.get("left_usd") if isinstance(credits, dict) else None
+        provider = _name(credits.get("provider")) if isinstance(credits, dict) else ""
+        if not provider.startswith(API_PREFIX) or isinstance(left, bool) or not isinstance(left, (int, float)):
+            continue
+        if left > 0 and (best is None or left > best[1]):
+            best = (provider, float(left))
+    return best
+
+
+def fall_back_from_pool() -> Optional[str]:
+    """After the pool ran out: move the rest of this review to the API account with the most credit. Returns the
+    provider, or None when the chat is not on the pool, the review already moved, or no account has credit."""
+    chat = _current.get()
+    if chat is None or not chat.on_pool or chat.provider:
+        return None
+    choice = claude_api_credit_choice()
+    if choice is None:
+        return None
+    chat.fallback = choice[0]
+    logger.info("Smart approval (provenance): every pool account is at its limit; the review moves to %s "
+                "(about $%.2f of credit left)", choice[0], choice[1])
+    return choice[0]
+
+
+def account_label(provider: str) -> str:
+    """\"API account caam\" for ``claude-api-caam``, as the hub names it."""
+    return "API account " + (provider[len(API_PREFIX):] if provider.startswith(API_PREFIX) else provider)
+
+
+def used_api_account() -> Optional[str]:
+    """The API-key provider a judge call of this review was answered on, or None."""
+    chat = _current.get()
+    return next((p for p in (chat.used if chat else []) if p.startswith(API_PREFIX)), None)
