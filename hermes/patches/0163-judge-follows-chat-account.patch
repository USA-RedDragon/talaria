@@ -0,0 +1,278 @@
+"""Smart approval's judge runs on the account the reviewed chat runs on.
+
+A judge configured on the account pool (``claude-pool``) runs, for a chat on an Anthropic API-key provider
+(``claude-api-<account>``), on that provider with the configured judge model; the pool is not touched. A chat on
+the pool keeps the pool, and only when every pool account is at its limit or on hold do both stages move, for that
+review, to the API account with the most credit left (the estimate the hub shows). With no account that has credit,
+or no readable estimate, the user is asked as before. A subagent follows its chat; a judge route that does not name
+the pool is left alone. The card names the API account that did the review. Real routing and card text; the model
+call (``call_llm``) and the claude-accounts plugin's credit estimate are faked.
+"""
+
+from __future__ import annotations
+
+import sys
+from types import SimpleNamespace
+
+import pytest
+
+from tools import approval_automode as A
+from tools import approval_judge_route as R
+
+API = "https://api.anthropic.com"
+BLOCK = "<block>yes</block><category>Git Destructive</category><reason>[Git Destructive] it rewrites main</reason>"
+POOL_CFG = {"smart_fast_model": {"provider": "claude-pool", "model": "claude-sonnet-5-5"},
+            "smart_model": {"provider": "claude-pool", "model": "claude-sonnet-5-5"}}
+
+
+class PoolExhausted(RuntimeError):
+    """Same class name as the claude-accounts pool's."""
+
+
+def _chat(provider, api_mode="anthropic_messages", base_url=API, **extra):
+    return SimpleNamespace(provider=provider, requested_provider=provider, api_mode=api_mode, base_url=base_url,
+                           session_id="s1", **extra)
+
+
+POOL_CHAT = _chat("claude-pool", base_url="process://claude-pool")
+CAAM_CHAT = _chat("claude-api-caam")
+
+
+class _Models:
+    """call_llm's stand-in: records every call; a provider in ``down`` raises what that provider would."""
+
+    def __init__(self):
+        self.calls: list[dict] = []
+        self.down: dict[str, BaseException] = {}
+
+    def __call__(self, **kw):
+        stage2 = kw["messages"][0]["content"].endswith(A.STAGE2_SUFFIX)
+        self.calls.append({"provider": kw.get("provider"), "model": kw.get("model"), "stage": 2 if stage2 else 1,
+                           "base_url": kw.get("base_url"), "api_key": kw.get("api_key")})
+        if kw.get("provider") in self.down:
+            raise self.down[kw["provider"]]
+        text = BLOCK if stage2 else "<block>yes</block>"
+        return SimpleNamespace(choices=[SimpleNamespace(message=SimpleNamespace(content=text))], usage=None)
+
+    def providers(self):
+        return [(c["stage"], c["provider"]) for c in self.calls]
+
+
+class _Core:
+    """The claude-accounts plugin's shared module, as far as the judge reads it."""
+
+    def __init__(self, credits):
+        self.rows = credits  # {account id: api_credits dict, None, or an exception}
+        self.read: list[str] = []
+
+    def accounts(self):
+        return [SimpleNamespace(id=i) for i in self.rows]
+
+    def status(self, acct):
+        return {"subscription_type": "max"}
+
+    def api_credits(self, acct, plan):
+        self.read.append(acct.id)
+        row = self.rows[acct.id]
+        if isinstance(row, BaseException):
+            raise row
+        return row
+
+
+def _credit(account, left):
+    return {"provider": f"claude-api-{account}", "monthly_usd": 100.0, "spent_usd": 100.0 - (left or 0), "left_usd": left}
+
+
+@pytest.fixture()
+def models(monkeypatch):
+    fake = _Models()
+    monkeypatch.setattr(A, "_config", lambda: POOL_CFG)
+    monkeypatch.setattr(A, "_served_window", lambda route: None)
+    monkeypatch.setattr("agent.auxiliary_client.call_llm", fake)
+    monkeypatch.setattr("agent.auxiliary_client._get_task_timeout", lambda task: 30)
+    monkeypatch.delitem(sys.modules, R.ACCOUNTS_CORE, raising=False)
+    A.set_complete_override(None)
+    yield fake
+    sys.modules.pop(R.ACCOUNTS_CORE, None)
+
+
+def _credits(**by_account):
+    core = _Core(by_account)
+    sys.modules[R.ACCOUNTS_CORE] = core
+    return core
+
+
+def _review(agent, root=None):
+    chat = R.chat_of(agent, root)
+    with R.review_chat(chat):
+        verdict = A.review_input(A.ReviewInput(lines=["User: push my branch"], action="{}"))
+        account = R.used_api_account()
+    if account:
+        verdict.detail["judge_account"] = account
+    return verdict
+
+
+def test_chat_on_an_api_account_runs_both_judge_stages_on_it(models):
+    v = _review(CAAM_CHAT)
+    assert models.providers() == [(1, "claude-api-caam"), (2, "claude-api-caam")]
+    assert {c["model"] for c in models.calls} == {"claude-sonnet-5-5"}
+    assert v.decision == "block" and v.rule == "Git Destructive"
+    assert v.detail["judge_account"] == "claude-api-caam"
+    assert v.card_text.endswith("Reviewed on API account caam.")
+    assert v.card_parts["reason"].endswith("Reviewed on API account caam.")
+
+
+def test_the_pool_address_and_key_do_not_follow_the_route_to_the_api_account(models, monkeypatch):
+    cfg = {"smart_model": {"provider": "claude-pool", "model": "claude-sonnet-5-5", "base_url": "process://claude-pool",
+                           "api_key": "pool-key"}}
+    monkeypatch.setattr(A, "_config", lambda: {**POOL_CFG, **cfg})
+    _review(CAAM_CHAT)
+    stage2 = next(c for c in models.calls if c["stage"] == 2)
+    assert stage2["provider"] == "claude-api-caam" and not stage2["base_url"] and not stage2["api_key"]
+
+
+def test_pool_exhausted_and_chat_on_an_api_account_still_reviews(models):
+    models.down["claude-pool"] = PoolExhausted("All Claude accounts are at their limit.")
+    v = _review(CAAM_CHAT)
+    assert v.decision == "block" and "claude-pool" not in {p for _s, p in models.providers()}
+
+
+def test_chat_on_the_pool_keeps_the_pool_and_reads_no_credit(models):
+    core = _credits(caam=_credit("caam", 50.0))
+    v = _review(POOL_CHAT)
+    assert models.providers() == [(1, "claude-pool"), (2, "claude-pool")]
+    assert core.read == [] and "judge_account" not in v.detail
+    assert "Reviewed on" not in v.card_text
+
+
+def test_pool_exhausted_moves_both_stages_to_the_account_with_the_most_credit(models):
+    models.down["claude-pool"] = PoolExhausted("All Claude accounts are at their limit. The first frees up at 10:09 PM.")
+    _credits(jaam=_credit("jaam", 12.5), caam=_credit("caam", 71.25), maam=_credit("maam", 40.0))
+    v = _review(POOL_CHAT)
+    # Stage 1 tries the pool once, then both stages run on caam; the pool is not asked again.
+    assert models.providers() == [(1, "claude-pool"), (1, "claude-api-caam"), (2, "claude-api-caam")]
+    assert v.decision == "block" and v.detail["judge_account"] == "claude-api-caam"
+    assert v.card_text.endswith("Reviewed on API account caam.")
+
+
+def test_a_tie_goes_to_the_first_account(models):
+    models.down["claude-pool"] = PoolExhausted("All Claude accounts are at their limit.")
+    _credits(jaam=_credit("jaam", 30.0), caam=_credit("caam", 30.0))
+    v = _review(POOL_CHAT)
+    assert v.detail["judge_account"] == "claude-api-jaam"
+
+
+def test_an_account_with_no_credit_left_is_not_chosen(models):
+    models.down["claude-pool"] = PoolExhausted("All Claude accounts are at their limit.")
+    _credits(jaam=_credit("jaam", 0.0), caam=_credit("caam", 0.01))
+    assert _review(POOL_CHAT).detail["judge_account"] == "claude-api-caam"
+
+
+def test_no_account_with_credit_asks_the_user_with_the_pool_words(models):
+    models.down["claude-pool"] = PoolExhausted("All Claude accounts are at their limit. The first frees up at 10:09 PM.")
+    _credits(jaam=_credit("jaam", 0.0), caam=_credit("caam", 0.0))
+    v = _review(POOL_CHAT)
+    assert {p for _s, p in models.providers()} == {"claude-pool"}
+    assert v.decision == "unsure" and v.detail["unavailable"] == "pool"
+    assert v.card_text.startswith("Smart approval could not review this: the review model was unavailable (all Claude "
+                                  "accounts are at their limit; the first frees up at 10:09 PM)")
+    assert "API account" not in v.card_text
+
+
+@pytest.mark.parametrize("rows", [
+    {"jaam": _credit("jaam", None), "caam": _credit("caam", None)},  # the plan's credit is unknown
+    {"jaam": None},  # no key for the account
+    {"jaam": RuntimeError("state.db is locked"), "caam": {"provider": "claude-api-caam", "left_usd": "n/a"}},
+    {},
+])
+def test_an_unreadable_estimate_keeps_todays_ask(models, rows):
+    models.down["claude-pool"] = PoolExhausted("All Claude accounts are at their limit.")
+    _credits(**rows)
+    v = _review(POOL_CHAT)
+    assert {p for _s, p in models.providers()} == {"claude-pool"}
+    assert v.decision == "unsure" and v.detail["unavailable"] == "pool"
+
+
+def test_the_plugin_not_loaded_keeps_todays_ask(models):
+    models.down["claude-pool"] = PoolExhausted("All Claude accounts are at their limit.")
+    v = _review(POOL_CHAT)
+    assert v.decision == "unsure" and "claude-api" not in " ".join(p for _s, p in models.providers())
+
+
+def test_a_good_account_is_chosen_past_one_whose_estimate_fails(models):
+    models.down["claude-pool"] = PoolExhausted("All Claude accounts are at their limit.")
+    _credits(jaam=RuntimeError("boom"), caam=_credit("caam", 5.0))
+    assert _review(POOL_CHAT).detail["judge_account"] == "claude-api-caam"
+
+
+def test_the_chosen_account_failing_is_named_on_the_card(models):
+    models.down["claude-pool"] = PoolExhausted("All Claude accounts are at their limit.")
+    models.down["claude-api-caam"] = RuntimeError("API Error: 429 rate limit")
+    _credits(caam=_credit("caam", 5.0))
+    v = _review(POOL_CHAT)
+    assert v.decision == "unsure"
+    assert "all Claude accounts are at their limit; API account caam: it is at its usage limit" in v.card_text
+    assert "429" not in v.card_text
+
+
+def test_a_chat_on_an_api_account_failing_is_named_on_the_card(models):
+    models.down["claude-api-caam"] = RuntimeError("API Error: 429 rate limit")
+    v = _review(CAAM_CHAT)
+    assert v.decision == "unsure"
+    assert "(API account caam: it is at its usage limit)" in v.card_text
+
+
+def test_no_fallback_for_a_chat_on_another_provider(models):
+    models.down["claude-pool"] = PoolExhausted("All Claude accounts are at their limit.")
+    core = _credits(caam=_credit("caam", 50.0))
+    v = _review(_chat("deepinfra", api_mode="chat_completions", base_url="https://api.deepinfra.com/v1"))
+    assert v.decision == "unsure" and core.read == []
+
+
+def test_a_judge_route_that_does_not_name_the_pool_is_left_alone(models, monkeypatch):
+    cfg = {"smart_fast_model": {"provider": "deepinfra", "model": "m"}, "smart_model": "claude-sonnet-5-5"}
+    monkeypatch.setattr(A, "_config", lambda: cfg)
+    _review(CAAM_CHAT)
+    assert models.providers() == [(1, "deepinfra"), (2, None)]
+
+
+def test_a_subagent_follows_its_chats_account(models):
+    # The subagent runs on another route; its root chat is on caam.
+    sub = _chat("deepinfra", api_mode="chat_completions", base_url="https://api.deepinfra.com/v1",
+                _delegate_claude_account="claude-api-caam", _delegate_depth=1)
+    assert _review(sub, root=CAAM_CHAT).detail["judge_account"] == "claude-api-caam"
+    assert {p for _s, p in models.providers()} == {"claude-api-caam"}
+
+
+def test_a_subagent_that_carries_the_chats_answer_follows_it_without_a_root(models):
+    sub = _chat("claude-pool", base_url="process://claude-pool", _delegate_claude_account="claude-api-jaam")
+    assert _review(sub).detail["judge_account"] == "claude-api-jaam"
+
+
+def test_a_subagent_of_a_pool_chat_falls_back_through_its_root(models):
+    models.down["claude-pool"] = PoolExhausted("All Claude accounts are at their limit.")
+    _credits(caam=_credit("caam", 9.0))
+    sub = _chat("deepinfra", api_mode="chat_completions", base_url="https://api.deepinfra.com/v1",
+                _delegate_claude_account="", _delegate_depth=1)
+    assert _review(sub, root=POOL_CHAT).detail["judge_account"] == "claude-api-caam"
+
+
+def test_the_chat_account_comes_from_the_chats_provider_not_the_base_url(models):
+    odd = _chat("claude-api-caam", base_url="http://localhost:1234")  # not api.anthropic.com
+    assert R.chat_of(odd).account is None
+
+
+def test_review_names_the_account_on_the_whole_path(models, monkeypatch):
+    """``review`` itself: the agent's chat decides the route, and the verdict's card names the account."""
+    models.down["claude-pool"] = PoolExhausted("All Claude accounts are at their limit.")
+    v = A.review("terminal", {"command": "git push --force origin main"}, agent=CAAM_CHAT,
+                 messages=[{"role": "user", "content": "push my branch"}])
+    assert v.detail.get("judge_account") == "claude-api-caam"
+    assert "claude-pool" not in {p for _s, p in models.providers()}
+    assert v.card_text.endswith("Reviewed on API account caam.")
+
+
+def test_the_review_state_does_not_leak_between_reviews(models):
+    _review(CAAM_CHAT)
+    assert R.current() is None
+    assert _review(POOL_CHAT).detail.get("judge_account") is None
