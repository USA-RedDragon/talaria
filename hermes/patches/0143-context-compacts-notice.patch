diff --git a/tests/agent/test_context_notice.py b/tests/agent/test_context_notice.py
new file mode 100644
index 00000000..af6335f1
--- /dev/null
+++ b/tests/agent/test_context_notice.py
@@ -0,0 +1,66 @@
+"""A subagent is told its context compacts on its own, and every agent sees how full it is."""
+from types import SimpleNamespace
+
+from agent.turn_iteration_prep import _maybe_inject_context_notice
+from tools.delegate_tool_progress import _build_child_system_prompt
+
+
+def _agent(used, window=1000, threshold=800):
+    comp = SimpleNamespace(last_prompt_tokens=used, context_length=window, threshold_tokens=threshold)
+    return SimpleNamespace(context_compressor=comp, _interrupt_requested=False)
+
+
+def _msgs():
+    return [{"role": "user", "content": "go"}, {"role": "tool", "tool_call_id": "t", "content": "result"}]
+
+
+def test_child_prompt_says_compaction_is_automatic():
+    prompt = _build_child_system_prompt("g")
+    assert "compacts on its own" in prompt
+    assert "never stop or hand off because the context seems long" in prompt
+
+
+def test_no_notice_under_half():
+    agent, msgs = _agent(490), _msgs()
+    assert not _maybe_inject_context_notice(agent, msgs)
+    assert msgs[-1]["content"] == "result"
+
+
+def test_notice_once_per_ten_percent_step():
+    agent, msgs = _agent(620), _msgs()
+    assert _maybe_inject_context_notice(agent, msgs)
+    assert "Context: 62% used" in msgs[-1]["content"]
+    assert "compacts on its own at 80%" in msgs[-1]["content"]
+    assert not _maybe_inject_context_notice(agent, _msgs())  # same step
+    agent.context_compressor.last_prompt_tokens = 671
+    assert not _maybe_inject_context_notice(agent, _msgs())  # still the 60s
+    agent.context_compressor.last_prompt_tokens = 705
+    assert _maybe_inject_context_notice(agent, _msgs())
+
+
+def test_notice_rearms_after_compaction():
+    agent = _agent(900)
+    assert _maybe_inject_context_notice(agent, _msgs())
+    agent.context_compressor.last_prompt_tokens = 200
+    assert not _maybe_inject_context_notice(agent, _msgs())
+    agent.context_compressor.last_prompt_tokens = 550
+    assert _maybe_inject_context_notice(agent, _msgs())
+
+
+def test_notice_never_rewrites_a_durable_result_or_list_content():
+    from agent.context_compressor import _DB_PERSISTED_MARKER
+    agent, msgs = _agent(700), _msgs()
+    msgs[-1][_DB_PERSISTED_MARKER] = True
+    assert not _maybe_inject_context_notice(agent, msgs)
+    assert msgs[-1]["content"] == "result"
+    msgs = _msgs()
+    msgs[-1]["content"] = [{"type": "text", "text": "result"}]
+    assert _maybe_inject_context_notice(agent, msgs)
+    assert msgs[-1]["content"][-1]["text"].startswith("[SYSTEM NOTICE")
+
+
+def test_no_notice_without_a_reading_or_when_interrupted():
+    assert not _maybe_inject_context_notice(_agent(0), _msgs())
+    agent = _agent(900)
+    agent._interrupt_requested = True
+    assert not _maybe_inject_context_notice(agent, _msgs())
