+def _append_to_tail_tool_result(messages: Any, notice: str) -> bool:
+    """Append ``notice`` to the newest tool result when it is not yet durable.
+
+    Only the current tool-result tail is mutable; an older turn may already be cached.
+    """
+    from agent.context_compressor import _DB_PERSISTED_MARKER
+    if (not messages or messages[-1].get("role") != "tool"
+            or messages[-1].get(_DB_PERSISTED_MARKER)):
+        return False
+    message = messages[-1]
+    content = message.get("content", "")
+    if isinstance(content, str):
+        message["content"] = content + f"\n\n{notice}"
+    elif isinstance(content, list) or content is None:
+        message["content"] = [*(content or []), {"type": "text", "text": notice}]
+    else:
+        return False
+    return True
+
+
+CONTEXT_NOTICE_FROM_PERCENT = 50
+CONTEXT_NOTICE_TEMPLATE = (
+    "[SYSTEM NOTICE — context] Context: {percent}% used. The conversation compacts on its own at "
+    "{threshold}%; never stop or hand off because the context seems long."
+)
+
+
+def _maybe_inject_context_notice(agent: Any, messages: Any) -> bool:
+    """Tell the agent how full its context is, once per 10% step from 50% up.
+
+    The figure is the last real prompt size over the window. The line goes on the newest tool
+    result (append-only, so the prompt cache holds), at most five times between compactions, and
+    never into the system prompt. The step latch clears once compaction brings use under 50%.
+    """
+    if getattr(agent, "_interrupt_requested", False):
+        return False
+    comp = getattr(agent, "context_compressor", None)
+    try:
+        used = int(getattr(comp, "last_prompt_tokens", 0) or 0)
+        window = int(getattr(comp, "context_length", 0) or 0)
+        trigger = int(getattr(comp, "threshold_tokens", 0) or 0)
+    except (TypeError, ValueError):
+        return False
+    if used <= 0 or window <= 0:
+        return False
+    percent = used * 100 // window
+    if percent < CONTEXT_NOTICE_FROM_PERCENT:
+        agent._context_notice_step = 0
+        return False
+    step = percent // 10 * 10
+    if step <= getattr(agent, "_context_notice_step", 0):
+        return False
+    notice = CONTEXT_NOTICE_TEMPLATE.format(percent=percent, threshold=min(100, trigger * 100 // window))
+    if not _append_to_tail_tool_result(messages, notice):
+        return False
+    agent._context_notice_step = step
+    return True
+
+
