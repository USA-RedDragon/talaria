-def test_unfinished_child_without_an_end_record_cannot_be_resumed(seams):
+def _stored_only_child(db, sid=SID, session=CHILD, parent=PARENT, *, goal="fix the parser", context="repo at ~/src",
+                       ended=True, messages=True, model="qwen"):
+    """A child as it sits in state.db with no resume record at all (spawned before records, or one never written)."""
+    if db.get_session(parent) is None:
+        db.create_session(session_id=parent, source="telegram")
+    config = {"_delegate_from": parent, "_subagent_id": sid, "max_iterations": 40}
+    if goal:
+        config["_delegate_goal"] = goal
+    if context:
+        config["_delegate_context"] = context
+    db.create_session(session_id=session, source="subagent", parent_session_id=parent, model=model, model_config=config)
+    if messages:
+        db.append_message(session, "user", content=goal or "fix the parser")
+        db.append_message(session, "assistant", content="Fixed the parser; tests pass.")
+    if ended:
+        db.end_session(session, "agent_close")
+
+
+class _LiveParent(_Parent):
+    """A parent as the live gateway agent: its route is what a child that named none inherits."""
+    model, provider, requested_provider, base_url = "main", "custom", "custom", BASE_URL
+
+    def __init__(self, db, session_id=PARENT, task_id=None):
+        super().__init__(db, session_id)
+        self._current_task_id = task_id
+
+
+def _resume_and_wait(parent, seams, child, **kw):
+    seams(child)
+    handle = _call(parent, message="Round two.", **kw)
+    assert handle["status"] == "dispatched", handle
+    return handle, wait_until(lambda: _completions(handle["run_id"]), what="the resumed child's completion")[0]
+
+
+def test_child_with_no_record_is_rebuilt_from_its_stored_session(seams):
+    db = _db()
+    _stored_only_child(db)
+    child = _fake_child()
+    handle, event = _resume_and_wait(_LiveParent(db), seams, child, subagent_id=SID)
+    built = seams.built[0]
+    assert built["resume_session_id"] == CHILD and built["subagent_id"] == SID
+    assert built["goal"] == "fix the parser" and built["context"] == "repo at ~/src" and built["max_iterations"] == 40
+    assert built["model"] == "qwen"
+    kwargs = child.conversations[0]
+    assert kwargs["user_message"] == "Round two."
+    assert [m["role"] for m in kwargs["conversation_history"]] == ["user", "assistant"]
+    assert event["status"] == "completed" and event["resumed"]["subagent_ids"] == [SID]
+    assert db.get_session(CHILD)["ended_at"] is None
+
+
+def test_child_without_a_stamped_brief_takes_its_first_message_as_the_goal(seams):
+    db = _db()
+    _stored_only_child(db, goal=None, context=None)
+    _resume_and_wait(_LiveParent(db), seams, _fake_child(), subagent_id=SID)
+    assert seams.built[0]["goal"] == "fix the parser"
+
+
+def test_child_cut_off_before_its_end_state_was_written_is_resumed(seams):
     db = _db()
     record = _record()
     del record[handoff.RESUME_STATE_KEY]
     _finished_child(db, record=record, ended=False)
+    child = _fake_child()
+    _resume_and_wait(_LiveParent(db), seams, child, subagent_id=SID)
+    built = seams.built[0]
+    assert built["goal"] == "fix the parser" and built["override_base_url"] == BASE_URL  # the record's route stands
+    assert child.conversations[0]["user_message"] == "Round two."
+
+
+def test_grandchild_is_resumed_under_the_child_that_spawned_it(seams):
+    db = _db()
+    _stored_only_child(db)
+    _stored_only_child(db, sid="sa-1-beef", session="grandchild-0", parent=CHILD, goal="lex the input")
+    child = _fake_child()
+    child._subagent_id, child.session_id = "sa-1-beef", "grandchild-0"
+    _resume_and_wait(_LiveParent(db), seams, child, subagent_id="sa-1-beef")
+    built = seams.built[0]
+    assert built["resume_session_id"] == "grandchild-0" and built["goal"] == "lex the input"
+    assert built["parent_agent"].session_id == CHILD and built["parent_agent"]._delegate_depth == 1
+    assert built["parent_agent"]._subagent_id == SID
+
+
+def _git_repo(path):
+    import subprocess
+    run = lambda *a: subprocess.run(["git", "-c", "user.name=t", "-c", "user.email=t@example.com", *a], cwd=path,
+                                    check=True, capture_output=True)
+    path.mkdir()
+    run("init", "-q", "-b", "main")
+    (path / "f").write_text("x")
+    run("add", "f")
+    run("commit", "-q", "-m", "one")
+    return run
+
+
+def test_worktree_child_resumes_in_its_worktree_even_after_it_was_removed(seams, tmp_path):
+    from tools.terminal_tool import record_session_cwd
+    repo = tmp_path / "repo"
+    git = _git_repo(repo)
+    wt = repo / ".worktrees" / f"subagent-{SID}"
+    git("worktree", "add", str(wt), "-b", f"hermes-subagent/subagent-{SID}", "HEAD")
+    record_session_cwd("task-p", str(repo))
+    db = _db()
+    _stored_only_child(db)
+    child = _fake_child()
+    _resume_and_wait(_LiveParent(db, task_id="task-p"), seams, child, subagent_id=SID)
+    assert child._delegate_resume["cwd"] == str(wt)
+
+    # The child's end removed the tree and kept its branch: resume checks the branch out again.
+    git("worktree", "remove", "--force", str(wt))
+    assert not wt.exists()
+    again = _fake_child()
+    _resume_and_wait(_LiveParent(db, task_id="task-p"), seams, again, subagent_id=SID)
+    assert again._delegate_resume["cwd"] == str(wt) and wt.is_dir()
+
+
+def test_child_without_a_worktree_continues_in_the_parents_directory(seams, tmp_path):
+    from tools.terminal_tool import record_session_cwd
+    repo = tmp_path / "repo"
+    _git_repo(repo)
+    record_session_cwd("task-p", str(repo))
+    db = _db()
+    _stored_only_child(db)
+    child = _fake_child()
+    _resume_and_wait(_LiveParent(db, task_id="task-p"), seams, child, subagent_id=SID)
+    assert child._delegate_resume["cwd"] == str(repo)
+
+
+def test_running_child_with_no_record_is_steered_not_resumed(seams):
+    db = _db()
+    _stored_only_child(db, ended=False)
+    with _active_subagents_lock:
+        _active_subagents[SID] = {"subagent_id": SID, "status": "running", "agent": _fake_child()}
+    seams()
+    result = _call(_LiveParent(db), subagent_id=SID, message="more")
+    assert "still running" in result["error"] and "steer" in result["error"]
+    assert _completions() == []
+
+
+def test_session_that_is_gone_or_empty_is_reported(seams):
+    db = _db()
     seams()
-    assert "no finished-run record" in _call(_Parent(db), subagent_id=SID, message="more")["error"]
+    gone = _call(_LiveParent(db), subagent_id="sa-0-0000", message="more")
+    assert "stored session is gone" in gone["error"] and "cannot be resumed" in gone["error"]
+    _stored_only_child(db, messages=False)
+    empty = _call(_LiveParent(db), subagent_id=SID, message="more")
+    assert "holds no conversation" in empty["error"]
+    assert _completions() == []
 
 
 def test_child_of_another_chat_cannot_be_resumed(seams):
