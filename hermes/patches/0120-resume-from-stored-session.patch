 from __future__ import annotations
@@ -17,6 +20,9 @@ from __future__ import annotations
 import json
 import threading
 import time
+import os
+import re
+import subprocess
 from typing import Any, Optional
 
 _resuming: set[str] = set()
@@ -33,6 +39,111 @@ def _model_config(row: dict[str, Any]) -> dict[str, Any]:
     return raw if isinstance(raw, dict) else {}
 
 
+class _NotRebuildable(Exception):
+    """Why a stored session cannot stand in for a missing record."""
+
+
+def _row_config(row: Optional[dict[str, Any]]) -> dict[str, Any]:
+    return _model_config(row or {})
+
+
+def _spawn_depth(db: Any, session_id: str) -> int:
+    """Delegation hops above *session_id*: 0 for a conversation, 1 for its child, 2 for a grandchild."""
+    depth, seen, current = 0, set(), session_id
+    while current and current not in seen and len(seen) < 50:
+        seen.add(current)
+        parent = _row_config(db.get_session(current)).get("_delegate_from")
+        if not isinstance(parent, str) or not parent:
+            break
+        depth, current = depth + 1, parent
+    return depth
+
+
+def _stored_route(row: dict[str, Any], parent_agent: Any) -> dict[str, Any]:
+    """The route the child ran on, from its session row: its model, and its provider and endpoint when they differ
+    from the parent's now (the child then resolves them again, as a route the caller named does)."""
+    model = str(row.get("model") or "").strip()
+    provider = str(row.get("billing_provider") or "").strip()
+    base_url = str(row.get("billing_base_url") or "").strip()
+    route: dict[str, Any] = {}
+    if model:
+        route["model"] = model
+    same_endpoint = (not base_url or base_url.rstrip("/") == str(getattr(parent_agent, "base_url", "") or "").rstrip("/"))
+    same_provider = (not provider or provider == str(getattr(parent_agent, "provider", "") or ""))
+    if not (same_endpoint and same_provider):
+        if provider:
+            route["provider"] = provider
+        if base_url:
+            route["base_url"] = base_url
+    return {"backend": "default", "route": route}
+
+
+def _worktree_cwd(sid: str, base_cwd: Optional[str]) -> Optional[str]:
+    """The worktree a child ran in under ``delegation.worktree_isolation``, brought back when it was removed at the
+    child's end but its branch was kept; None for a child that never had one."""
+    from tools import subagent_worktree
+    if not base_cwd or not subagent_worktree.local_backend_active():
+        return None
+    try:
+        root = subagent_worktree.resolve_repo_root(base_cwd)
+        if not root:
+            return None
+        name = f"subagent-{sid.replace('/', '-')}"
+        path = os.path.join(root, ".worktrees", name)
+        if os.path.isdir(path):
+            return path
+        branch = f"hermes-subagent/{name}"
+        if subagent_worktree._run_git(["rev-parse", "--verify", "--quiet", f"refs/heads/{branch}"], cwd=root).returncode:
+            return None
+        if subagent_worktree._run_git(["worktree", "add", path, branch], cwd=root).returncode:
+            return None
+        return path
+    except (OSError, subprocess.SubprocessError):
+        return None
+
+
+def stored_record(db: Any, parent_agent: Any, sid: str, session_id: str, row: dict[str, Any],
+                  spec: Optional[dict[str, Any]], state: Optional[dict[str, Any]]) -> tuple[dict[str, Any], dict[str, Any]]:
+    """``(spec, state)`` rebuilt from the child's stored session for whichever of the two the session lacks. Raises
+    ``_NotRebuildable`` when the session holds no conversation to continue."""
+    from tools.delegate_tool_handoff import _SPEC_VERSION, _parent_snapshot, _session_snapshot
+    from tools.delegate_tool_sessions import stored_child_brief
+    history = db.get_messages_as_conversation(session_id, repair_alternation=True)
+    if not history:
+        raise _NotRebuildable("its stored session holds no conversation")
+    config = _row_config(row)
+    goal, context = stored_child_brief(db, session_id)
+    if not goal:  # spawned before the brief was stamped: the first thing it was asked
+        first = next((m.get("content") for m in history if m.get("role") == "user"), None)
+        goal = first if isinstance(first, str) and first.strip() else "(goal not recorded)"
+    found = re.match(r"sa-(\d+)-", sid)
+    index = int(found.group(1)) if found else 0
+    depth = _spawn_depth(db, session_id)
+    owner = config.get("_delegate_from") if isinstance(config.get("_delegate_from"), str) else None
+    parent = _parent_snapshot(parent_agent)
+    if depth > 1 and owner:  # a grandchild: its parent is the child that spawned it, not this conversation
+        parent = {**parent, "session_id": owner, "delegate_depth": depth - 1,
+                  "subagent_id": _row_config(db.get_session(owner)).get("_subagent_id")}
+    orchestrator = any((c.get("function") or {}).get("name") == "delegate_task"
+                       for m in history if m.get("role") == "assistant"
+                       for c in (m.get("tool_calls") or []) if isinstance(c, dict))
+    base_cwd = parent.get("cwd") or parent.get("workspace")
+    cwd = _worktree_cwd(sid, base_cwd) or base_cwd
+    if spec is None:
+        child = {"goal": goal, "context": context, "role": "orchestrator" if orchestrator else "leaf",
+                 "subagent_id": sid, "session_id": session_id, "route": _stored_route(row, parent_agent),
+                 "task": {"goal": goal}, "output_schema": None, "images": None, "transcript": None,
+                 "max_iterations": config.get("max_iterations")}
+        spec = {"version": _SPEC_VERSION, "parent": parent, "session": _session_snapshot(parent_agent),
+                "children": {str(index): child}, "top_role": "leaf", "max_children": 3, "task_count": index + 1,
+                "live_deleg_id": None, "group": None, "slot_key": None}
+    if state is None:
+        started = row.get("started_at")
+        state = {"session_id": session_id, "cwd": cwd,
+                 "started_at": float(started) if isinstance(started, (int, float)) else None}
+    return spec, state
+
+
 def _find_subagent(parent_agent: Any, subagent_id: Optional[str], delegation_id: Optional[str],
                    task_index: Any) -> tuple[str, Optional[str]]:
     """``(subagent_id, error)``: the id as given, or the one the delegation's task ran as."""
@@ -92,12 +203,16 @@ def resume_subagent(parent_agent: Any, *, subagent_id: Optional[str], delegation
     if _is_live(sid):
         return {"error": f"Subagent '{sid}' is still running (or queued). Use action='steer' to redirect it; "
                          "its result arrives as a normal completion message. Only a finished subagent can be resumed."}
-    config = _model_config(db.get_session(session_id) or {})
+    row = db.get_session(session_id) or {}
+    config = _model_config(row)
     spec, state = config.get(RESUME_KEY), config.get(RESUME_STATE_KEY)
     if not isinstance(spec, dict) or not isinstance(state, dict):
-        return {"error": f"Subagent '{sid}' has no finished-run record to resume from (it was spawned before resume "
-                         "existed, ran under worktree isolation, or has not finished). Spawn a new subagent and brief "
-                         "it from its branch and notes."}
+        try:
+            spec, state = stored_record(db, parent_agent, sid, session_id, row, spec if isinstance(spec, dict) else None,
+                                        state if isinstance(state, dict) else None)
+        except _NotRebuildable as exc:
+            return {"error": f"Subagent '{sid}' cannot be resumed: {exc}. Spawn a new subagent and brief it from its "
+                             "branch and notes."}
     with _resuming_lock:
         if sid in _resuming:
             return {"error": f"Subagent '{sid}' is already being resumed."}
