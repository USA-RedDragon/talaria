diff --git a/tests/agent/test_pinned_rules.py b/tests/agent/test_pinned_rules.py
new file mode 100644
index 00000000..1875f760
--- /dev/null
+++ b/tests/agent/test_pinned_rules.py
@@ -0,0 +1,181 @@
+"""``compression.pin_user_rules_chars``: the user's standing rules ride the system prompt across compactions.
+
+The fixtures are sanitized from a real session in which each was said in prose, lost at a compaction, and
+asked again or broken; the complaint must never be stored, and a peer agent quoting the user is not the user.
+"""
+
+import json
+from types import SimpleNamespace
+from unittest.mock import MagicMock, patch
+
+from agent import conversation_compression as cc
+from agent import decision_ledger as dl
+from agent import pinned_rules as pr
+from agent.context_compressor import ContextCompressor
+from agent.system_prompt import build_system_prompt
+from tools.ledger_tool import ledger_tool
+
+RELIFT = {
+    "plus-skips-cutscene": "Hold + to skip the cutscene.",
+    "plus-correction": "I mean + IN THE NINTENDO SWITCH WAY NOT THE KEYBOARD WAY",
+    "progress-ui": "There needs to be a UI so users know what is going on. Progress bar, eta etc",
+    "progress-ui-approved": "The mockup looks good, build it.",
+    "cutscene-not-engine": "This one is def a cutscene not engine",
+    "needs-screenshots": "Strong claim based solely on an integer going up. Needs screenshots to back it up",
+    "headed": "Games run headed on the desktop so I can watch.",
+    "progress-reports": "Ask the lanes for a progress report every 15 minutes, inline, not a cron.",
+    "swkbd-landed": "The software keyboard landed yesterday.",
+}
+COMPLAINT = "you're burning so much trust by the hour"
+PEER = ("[Agent message am_0123456789abcdef from chat 'ops' (session local-1)]\n"
+        "The user said: Never push to the live cluster.")
+FILLER = ["continue", "ok", "go on with the next one", "what's the status", "run it again", "and now?"]
+
+
+def _session(n=160):
+    msgs = [{"role": "system", "content": "sys"}]
+    stated = iter(RELIFT.values())
+    for i in range(n):
+        msgs += [{"role": "user", "content": f"{FILLER[i % len(FILLER)]} ({i})", "_row_id": 1000 + 2 * i,
+                  "timestamp": 1795300000.0 + i},
+                 {"role": "assistant", "content": f"Done with step {i}."}]
+        if i % 15 == 3 and (text := next(stated, None)):
+            msgs += [{"role": "user", "content": text, "_row_id": 5000 + i, "timestamp": 1795300000.0 + i},
+                     {"role": "assistant", "content": "Noted."}]
+    msgs += [{"role": "user", "content": COMPLAINT}, {"role": "assistant", "content": "Understood."},
+             {"role": "user", "content": PEER}, {"role": "assistant", "content": "ok"}]
+    return msgs
+
+
+def _compressor():
+    with patch("agent.context_compressor.get_model_context_length", return_value=100_000):
+        c = ContextCompressor(model="test/model", quiet_mode=True, protect_first_n=1, protect_last_n=2)
+    c.decision_ledger_chars = 6000
+    c.pin_user_rules_chars = pr.MAX_CHARS
+    return c
+
+
+def _compress(msgs):
+    response = MagicMock()
+    response.choices = [MagicMock()]
+    response.choices[0].message.content = "## Goal\nWork."
+    c = _compressor()
+    with (
+        patch.object(c, "_find_tail_cut_by_tokens", return_value=len(msgs) - 2),
+        patch("agent.context_compressor.call_llm", return_value=response),
+    ):
+        return c.compress(msgs, force=True)
+
+
+def _twice(tmp_path):
+    with patch.object(dl, "archive_dir", return_value=tmp_path):
+        out = _compress(_session())
+        more = out + [{"role": "user" if i % 2 == 0 else "assistant", "content": f"next {i}"} for i in range(60)]
+        return _compress(more + [{"role": "user", "content": "go"}, {"role": "assistant", "content": "ok"}])
+
+
+def _agent(**over):
+    def _build(system_message=None):
+        return build_system_prompt(agent)
+
+    def _invalidate():
+        agent._cached_system_prompt = None
+
+    fields = dict(
+        load_soul_identity=False, skip_context_files=True, valid_tool_names=[], _task_completion_guidance=False,
+        _tool_use_enforcement=False, _environment_probe=False, _kanban_worker_guidance="", _memory_store=None,
+        _memory_manager=None, model="", provider="", platform="", pass_session_id=False, session_id="s1",
+        _emit_status=lambda *a, **k: None, _cached_system_prompt="old prompt",
+        context_compressor=SimpleNamespace(pin_user_rules_chars=pr.MAX_CHARS),
+        _build_system_prompt=_build, _invalidate_system_prompt=_invalidate, _session_db=MagicMock(),
+    )
+    fields.update(over)
+    agent = SimpleNamespace(**fields)
+    return agent
+
+
+def _rebuild(agent, compressed):
+    with patch.object(cc, "_refresh_agent_tool_definitions", return_value=False), \
+         patch("agent.system_prompt.reconstruct_static_prefix"), \
+         patch("agent.prompt_builder.build_environment_hints", return_value=""):
+        return cc._rebuild_system_prompt_at_boundary(agent, "", compressed)
+
+
+def test_every_rule_and_fact_survives_two_compactions_into_the_system_prompt(tmp_path):
+    out = _twice(tmp_path)
+    prompt = _rebuild(_agent(), out)
+    block = pr.extract(prompt)
+    assert block.startswith(pr.OPEN) and pr.HEADING in block
+    missing = [name for name, text in RELIFT.items() if json.dumps(text) not in block]
+    assert not missing
+    assert "2026-11-" in block and "message 50" in block  # the day and the message id of each
+    assert "rule," in block.split("Facts, corrections")[0]
+    assert COMPLAINT not in prompt and "Never push to the live cluster" not in prompt
+
+
+def test_the_complaint_and_a_peer_agents_quote_are_never_stored():
+    ledger = dl.current(_session())
+    texts = [e.text for e in ledger.entries]
+    assert COMPLAINT not in texts and not any("live cluster" in t for t in texts)
+
+
+def _close(entry_id, note="the user withdrew it"):
+    return [
+        {"role": "assistant", "content": "", "tool_calls": [{"id": "lc1", "type": "function", "function": {
+            "name": "ledger", "arguments": json.dumps({"action": "close", "id": entry_id, "note": note})}}]},
+        {"role": "tool", "tool_call_id": "lc1",
+         "content": json.dumps({"ok": True, "ledger": {"op": "close", "id": entry_id, "note": note}})},
+    ]
+
+
+def test_a_withdrawn_rule_leaves_the_prompt_at_once_and_stays_out(tmp_path):
+    out = _twice(tmp_path)
+    agent = _agent()
+    agent._cached_system_prompt = _rebuild(agent, out)
+    headed = next(e for e in pr.pinned_entries(dl.current(out)) if "headed" in e.text)
+    result = json.loads(ledger_tool("close", id=headed.id, note="games may run headless now", messages=out,
+                                    tool_call_id="lc1", agent=agent))
+    assert result["ok"] and "standing rules" in result["note"]
+    assert "headed" not in pr.extract(agent._cached_system_prompt)
+    assert json.dumps(RELIFT["progress-reports"]) in pr.extract(agent._cached_system_prompt)
+    agent._session_db.update_system_prompt.assert_called_once_with("s1", agent._cached_system_prompt)
+    with patch.object(dl, "archive_dir", return_value=tmp_path):
+        later = _compress(out + _close(headed.id) + [{"role": "user", "content": f"more {i}"} for i in range(4)]
+                          + [{"role": "assistant", "content": "ok"}])
+    assert "headed" not in pr.extract(_rebuild(_agent(), later))
+
+
+def test_the_block_is_capped_dropping_facts_before_rules():
+    ledger = dl.Ledger()
+    ledger.add(dl.Entry("L0000r1", "USER", "Games run headed.", "", {"keep": "rule", "at": "2026-11-20"}))
+    for i in range(40):
+        ledger.add(dl.Entry(f"L1000{i:02d}", "USER", f"fact {i} " + "x" * 60, "", {"keep": "fact"}))
+    block = pr.render(ledger, 1200)
+    assert len(block) <= 1200 and "Games run headed." in block and "fact 39" in block and "fact 0 " not in block
+    assert pr.render(ledger, 0) == "" and pr.render(dl.Ledger()) == ""
+
+
+def test_apply_keeps_the_runtime_environment_last():
+    prompt = "You are Hermes.\n\nmemory\n\n# Runtime environment\n\nOS: Linux"
+    block = pr.OPEN + "\nrules\n" + pr.CLOSE
+    once = pr.apply(prompt, block)
+    assert once == "You are Hermes.\n\nmemory\n\n" + block + "\n\n# Runtime environment\n\nOS: Linux"
+    assert pr.apply(once, block) == once and pr.apply(once, "") == prompt and pr.extract(once) == block
+
+
+def test_a_seeded_hygiene_agent_gets_the_new_block_spliced_in(tmp_path):
+    out = _twice(tmp_path)
+    agent = _agent(_retain_seeded_system_prompt=True, _cached_system_prompt="stored prompt")
+    prompt = _rebuild(agent, out)
+    assert prompt.startswith("stored prompt\n\n" + pr.OPEN) and json.dumps(RELIFT["headed"]) in prompt
+
+
+def test_a_fresh_agent_builds_the_block_from_its_transcript(tmp_path):
+    out = _twice(tmp_path)
+    agent = _agent(_pinned_user_rules=None)
+    pr.prime(agent, out)
+    with patch("agent.prompt_builder.build_environment_hints", return_value=""):
+        assert json.dumps(RELIFT["swkbd-landed"]) in build_system_prompt(agent)
+    off = _agent(_pinned_user_rules=None, context_compressor=SimpleNamespace(pin_user_rules_chars=0))
+    pr.prime(off, out)
+    assert off._pinned_user_rules == ""
