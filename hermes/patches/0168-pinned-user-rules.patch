+def _provenance(message: dict[str, Any], raw: str) -> dict[str, str]:
+    """``at`` (the day the user wrote it) and ``msg`` (its message id) when the row carries them."""
+    import datetime as _dt
+
+    out: dict[str, str] = {}
+    when = message.get("timestamp")
+    if not isinstance(when, (int, float)):
+        try:
+            from gateway.message_timestamps import strip_leading_message_timestamps
+
+            when = strip_leading_message_timestamps(raw)[1]
+        except Exception:
+            when = None
+    if isinstance(when, (int, float)) and when > 0:
+        out["at"] = _dt.datetime.fromtimestamp(when, _dt.timezone.utc).strftime("%Y-%m-%d")
+    elif isinstance(when, str) and re.match(r"\d{4}-\d{2}-\d{2}", when):
+        out["at"] = when[:10]
+    row = message.get("_row_id") or message.get("message_id")
+    if isinstance(row, (int, str)) and str(row).strip():
+        out["msg"] = str(row).strip()
+    return out
+
