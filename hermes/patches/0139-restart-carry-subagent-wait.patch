diff --git a/tests/tools/test_restart_carry_subagent_wait.py b/tests/tools/test_restart_carry_subagent_wait.py
new file mode 100644
index 00000000..b8646a21
--- /dev/null
+++ b/tests/tools/test_restart_carry_subagent_wait.py
@@ -0,0 +1,119 @@
+"""gateway.restart_turn_handoff_per_turn and a background subagent waiting on its process (resume_on_exit).
+
+The carrier (the old gateway) goes on running while the next gateway has adopted the subagent it handed off. In the
+live rollout the two ran in different pods, so neither could see the other's pid: the carrier's orphan sweep read
+the next gateway's adopted unit as abandoned and delivered "owner exited" to the parent while the subagent still
+waited on its process. These tests make the other pod's pids invisible the same way (the liveness probe says dead):
+
+- the carrier no longer sweeps the ledger once it released the profile, so the adopted subagent goes on waiting
+  and its process's exit wakes it and it reports its real result;
+- the next gateway does not settle a unit the live carrier still owns, and does once the carrier exited.
+"""
+
+import fcntl
+import json
+import os
+import sqlite3
+import threading
+from types import SimpleNamespace
+
+from tests.tools.test_delegate_child_wait import _waiting_child
+from tests.tools.test_delegate_resume_action import (  # fixtures too
+    _Parent, _call, _clean_state, _completions, _db, _fake_child, _finished_child, seams,
+)
+from tests.waiting import wait_until
+from tools import async_delegation as ad
+from tools import delegate_tool_handoff as handoff
+from tools.delegate_tool_registry import _active_subagents, _active_subagents_lock
+
+from gateway import turn_carry
+from gateway.run_notifications import GatewayNotificationsMixin
+from hermes_constants import get_hermes_home
+
+
+def _state(delegation_id: str) -> str:
+    conn = sqlite3.connect(get_hermes_home() / "state.db")
+    try:
+        return conn.execute("SELECT state FROM async_delegations WHERE delegation_id=?", (delegation_id,)).fetchone()[0]
+    finally:
+        conn.close()
+
+
+def _carrier_sweep() -> None:
+    """The carrier's watcher tick (``_async_delegation_watcher``): its orphan sweep."""
+    runner = SimpleNamespace(_served_profile_homes=None, _each_secondary_ledger=lambda *a, **k: None)
+    GatewayNotificationsMixin._sweep_orphaned_completion_ledgers(runner)
+
+
+def test_the_carrier_leaves_the_subagent_the_next_gateway_adopted_waiting_on_its_process(seams, monkeypatch):
+    db = _db()
+    _finished_child(db)
+    child = _waiting_child("sleep 6; echo zd-sub-done")
+    seams(child)
+    run_id = _call(_Parent(db), subagent_id="sa-0-abcd", message="run it and wait")["run_id"]
+    wait_until(lambda: any(r.get("status") == "waiting" for r in _active_subagents.values()), what="waiting")
+
+    # The restart hands the waiting subagent over; its process keeps running (0012 hands it to the next gateway).
+    assert ad.hand_off_for_restart(2.0, 8.0) == 1
+    assert not child.seen["session"].exited
+
+    # The next gateway adopts it after the carrier's process handoff (0138); it waits on the process again.
+    ad._reset_for_tests()
+    with _active_subagents_lock:
+        _active_subagents.clear()
+    second = _fake_child()
+    seams(second)
+    assert ad.adopt_handed_off_delegations(handoff._resume_unit) == 1
+    assert _state(run_id) == "running"
+
+    # The carrier released the profile and carries its turns on; from its pod the next gateway's pid reads as dead.
+    monkeypatch.setattr(turn_carry, "_released", True)
+    monkeypatch.setattr(ad, "_owner_liveness", lambda: (lambda pid, started: False))
+    _carrier_sweep()
+    assert _state(run_id) == "running"
+    assert _completions(run_id) == []  # no "owner exited" result for the parent
+
+    event = wait_until(lambda: _completions(run_id), timeout=30, what="the woken subagent's result")[0]
+    assert event["status"] == "completed" and not event.get("last_known_status")
+    assert len(second.conversations) == 1 and "zd-sub-done" in second.conversations[0]["user_message"]
+    assert "exited with code 0" in second.conversations[0]["user_message"]
+
+
+def _carrier_record(pid: int) -> int:
+    """A live carrier in another pod: its record in state.db and its held ``.turn-carry.lock``. Returns the lock fd."""
+    from hermes_state_runtime import CARRY_KEY
+    home = get_hermes_home()
+    conn = sqlite3.connect(home / "state.db")
+    try:
+        conn.execute("CREATE TABLE IF NOT EXISTS state_meta (key TEXT PRIMARY KEY, value TEXT)")
+        conn.execute("INSERT OR REPLACE INTO state_meta(key, value) VALUES(?, ?)",
+                     (CARRY_KEY, json.dumps({"pid": pid, "epoch": 7, "turns": {}})))
+        conn.commit()
+    finally:
+        conn.close()
+    fd = os.open(turn_carry.lock_path(home), os.O_RDWR | os.O_CREAT, 0o600)
+    fcntl.flock(fd, fcntl.LOCK_EX)
+    return fd
+
+
+def test_the_next_gateway_leaves_a_unit_the_live_carrier_owns_until_the_carrier_exits(monkeypatch):
+    release = threading.Event()
+    handle = ad.dispatch_async_delegation(
+        goal="carried work", context=None, toolsets=None, role="leaf", model="m", session_key="chat",
+        parent_session_id="parent", runner=lambda: (release.wait(30), {"status": "completed", "summary": "x"})[1])
+    delegation_id = handle["delegation_id"]
+    carrier_pid = 4_000_000  # the carrier's pid in its own pod; no such process here
+    conn = sqlite3.connect(get_hermes_home() / "state.db")
+    conn.execute("UPDATE async_delegations SET owner_pid=?, owner_started_at=NULL WHERE delegation_id=?",
+                 (carrier_pid, delegation_id))
+    conn.commit()
+    conn.close()
+    fd = _carrier_record(carrier_pid)
+    try:
+        assert ad.recover_abandoned_delegations() == 0
+        assert _state(delegation_id) == "running"
+    finally:
+        os.close(fd)  # the carrier exits
+    assert ad.recover_abandoned_delegations() == 1
+    assert _state(delegation_id) == "unknown"
+    release.set()
