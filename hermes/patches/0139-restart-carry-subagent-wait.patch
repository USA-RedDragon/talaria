+def _live_carrier_pid() -> Optional[int]:
+    """``gateway.restart_turn_handoff_per_turn``: the pid of the previous gateway while it still carries its turns.
+    It may run in another pod whose pids this process cannot see, so its units are not read as abandoned."""
+    try:
+        from gateway.turn_carry import live_carrier_pid
+        return live_carrier_pid(get_hermes_home())
+    except Exception:
+        return None
+
+
