         os.close(fd)
 
 
+def live_carrier_pid(home) -> int | None:
+    """The pid a live carrier recorded in *home*'s state.db, or None (no carrier, or it exited). The pid is the one
+    its own process sees, as on the rows it owns, even when it runs in another pod."""
+    if not carrier_alive(home):
+        return None
+    import sqlite3
+    path = Path(home) / "state.db"
+    if not path.exists():
+        return None
+    from hermes_state_runtime import CARRY_KEY
+    try:
+        conn = sqlite3.connect(f"file:{path}?mode=ro", uri=True, timeout=2.0)
+        try:
+            row = conn.execute("SELECT value FROM state_meta WHERE key=?", (CARRY_KEY,)).fetchone()
+        finally:
+            conn.close()
+        record = json.loads(row[0]) if row is not None else None
+    except (sqlite3.Error, TypeError, ValueError):
+        return None
+    pid = record.get("pid") if isinstance(record, dict) else None
+    return pid if type(pid) is int else None
+
