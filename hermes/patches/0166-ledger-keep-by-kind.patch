@@ -0,0 +1,271 @@
+"""Facts, rules, corrections and approvals the user states in prose ride the decision ledger, and clarify
+checks the ledger before asking again."""
+
+import json
+from unittest.mock import MagicMock, patch
+
+import pytest
+
+from agent import decision_ledger as dl
+from agent.context_compressor import ContextCompressor
+from tools.clarify_tool import PRECHECK_OUTCOME, clarify_tool
+
+# Sanitized from a real session where each was said in prose, lost at a compaction, and asked or broken again.
+STATEMENTS = [
+    ("cutscene-skip", "Hold + to skip the cutscene."),
+    ("cutscene-skip-correction", "hold +, and no. and this is already something you knew"),
+    ("cutscene-skip-button", "I mean + IN THE NINTENDO SWITCH WAY NOT THE KEYBOARD WAY"),
+    ("told-many-times", "I've told you SO many times"),
+    ("progress-ui", "But regardless, if it's 10 seconds or 1 hour, there needs to be a UI so users know what is "
+                    "going on. Progress bar, eta etc"),
+    ("progress-ui-approval", "The mockup looks good, build it."),
+    ("mockup-correction", "WE ALREADY MOCKED IT UP AND I APPROVED IT"),
+    ("cutscene-not-engine", "This one is def a cutscene not engine"),
+    ("needs-screenshots", "Strong claim based solely on an integer going up. Needs screenshots to back it up"),
+    ("fifth-time", "5th time you've made that mistake"),
+    ("headed", "Runs are headed: the game window goes on the desktop so I can watch."),
+    ("progress-reports", "Ask the lanes for a progress report every 15 minutes, inline, not a cron."),
+    ("swkbd-landed", "The software keyboard landed yesterday."),
+]
+COMPLAINTS = [
+    "You've had so many hundreds of tests fail because of stuff like this",
+    "you're burning so much trust by the hour",
+]
+FILLER = ["continue", "ok", "go on with the next one", "what's the status", "run it again", "thanks", "and now?"]
+
+
+def _session(fillers=300):
+    msgs = [{"role": "system", "content": "sys"}]
+    stated = iter(STATEMENTS)
+    for i in range(fillers):
+        msgs.append({"role": "user", "content": FILLER[i % len(FILLER)] + f" ({i})"})
+        msgs.append({"role": "assistant", "content": f"Done with step {i}."})
+        if i % 20 == 5:
+            item = next(stated, None)
+            if item:
+                msgs.append({"role": "user", "content": item[1]})
+                msgs.append({"role": "assistant", "content": "Noted."})
+    for c in COMPLAINTS:
+        msgs += [{"role": "user", "content": c}, {"role": "assistant", "content": "Understood."}]
+    return msgs
+
+
+def _ledger(msgs):
+    return dl.capture(dl.Ledger(), msgs, 1, len(msgs))
+
+
+@pytest.mark.parametrize("name,text", STATEMENTS, ids=[n for n, _ in STATEMENTS])
+def test_each_statement_is_kept_as_the_users_words(name, text):
+    msgs = [{"role": "system", "content": "sys"}, {"role": "user", "content": text}]
+    entries = [e for e in _ledger(msgs).entries if e.kind == "USER"]
+    assert [e.text for e in entries] == [text] and entries[0].fields["keep"]
+
+
+def test_plain_requests_and_complaints_do_not_flood_the_ledger():
+    users = [e for e in _ledger(_session()).entries if e.kind == "USER"]
+    assert sorted(e.text for e in users) == sorted(t for _, t in STATEMENTS)
+    for text in COMPLAINTS + ["Why isn't it headed?"]:
+        assert not dl.keep_reason(text)
+
+
+def test_a_restated_rule_is_kept_once():
+    msgs = [{"role": "system", "content": "sys"}, {"role": "user", "content": "Runs are headed."},
+            {"role": "assistant", "content": "ok"}, {"role": "user", "content": "runs are HEADED!"}]
+    assert len([e for e in _ledger(msgs).entries if e.kind == "USER"]) == 1
+
+
+def test_a_long_message_keeps_only_its_rule_sentences():
+    filler = "Here is a lot of context about the build. " * 30
+    msgs = [{"role": "system", "content": "sys"}, {"role": "user", "content": filler + "Never run tests headless."}]
+    entry = next(e for e in _ledger(msgs).entries)
+    assert entry.text == "Never run tests headless." and entry.fields["keep"] == "rule"
+
+
+def test_bound_keeps_stated_rules_past_plain_answers(tmp_path):
+    msgs = [{"role": "system", "content": "sys"}, {"role": "user", "content": "Runs are headed."}]
+    for i in range(40):
+        msgs += [{"role": "assistant", "content": f"Option {i}: A or B?"}, {"role": "user", "content": f"A {i}"}]
+    ledger = _ledger(msgs)
+    with patch.object(dl, "archive_dir", return_value=tmp_path):
+        dl.bound(ledger, 1200, "s1")
+    assert any(e.text == "Runs are headed." for e in ledger.entries)
+    assert '"A 0"' in (tmp_path / "s1.md").read_text()
+
+
+def _compress(c, msgs):
+    response = MagicMock()
+    response.choices = [MagicMock()]
+    response.choices[0].message.content = "## Goal\nWork."
+    with (
+        patch.object(c, "_find_tail_cut_by_tokens", return_value=len(msgs) - 2),
+        patch("agent.context_compressor.call_llm", return_value=response),
+    ):
+        return c.compress(msgs, force=True)
+
+
+def _compressor():
+    with patch("agent.context_compressor.get_model_context_length", return_value=100_000):
+        c = ContextCompressor(model="test/model", quiet_mode=True, protect_first_n=1, protect_last_n=2)
+    c.decision_ledger_chars = 6000
+    return c
+
+
+def _handoff(result):
+    return next(m["content"] for m in result if ContextCompressor.classify_summary_content(m.get("content")))
+
+
+def test_every_statement_survives_two_compactions(tmp_path):
+    with patch.object(dl, "archive_dir", return_value=tmp_path):
+        out = _compress(_compressor(), _session())
+        more = out + [{"role": "user", "content": f"next {i}"} for i in range(50)]
+        more += [{"role": "assistant", "content": "ok"}, {"role": "user", "content": "go"},
+                 {"role": "assistant", "content": "ok"}]
+        handoff = _handoff(_compress(_compressor(), more))
+    ledger = dl.parse(handoff)
+    kept = {e.text for e in ledger.entries if e.kind == "USER"}
+    missing = [name for name, text in STATEMENTS if text not in kept]
+    assert not missing
+    assert f'] USER: {json.dumps("Runs are headed: the game window goes on the desktop so I can watch.")}' in handoff
+
+
+def _with_ledger(text):
+    first = dl.attach(ContextCompressor._with_summary_prefix("s"),
+                      [{"role": "system", "content": "sys"}, {"role": "user", "content": text}], 1, 2, 6000)
+    return [{"role": "system", "content": "sys"}, {"role": "user", "content": first},
+            {"role": "user", "content": "work on the intro"}]
+
+
+def _ask(questions, msgs, answer="later"):
+    callback = MagicMock(return_value={"answers": {"q1": answer}, "outcome": "submitted"})
+    with patch("tools.clarify_tool._precheck_enabled", return_value=True):
+        return json.loads(clarify_tool(questions, callback=callback, messages=msgs)), callback
+
+
+def test_clarify_returns_the_users_earlier_words_instead_of_asking():
+    msgs = _with_ledger("Hold + to skip the cutscene.")
+    questions = [{"question": "How do you skip the intro cutscene?"}]
+    first, callback = _ask(questions, msgs)
+    assert first["outcome"] == PRECHECK_OUTCOME and not callback.called
+    assert any("Hold + to skip the cutscene." in line for line in first["prior_user_words"])
+    msgs += [{"role": "assistant", "content": "", "tool_calls": [
+        {"id": "c1", "type": "function", "function": {"name": "clarify", "arguments": json.dumps({"questions": questions})}}]},
+        {"role": "tool", "tool_call_id": "c1", "content": json.dumps(first)}]
+    second, callback = _ask(questions, msgs)
+    assert callback.called and second["outcome"] == "submitted"
+    assert second["prior_user_words"] == first["prior_user_words"]
+    assert not [e for e in dl.current(msgs).entries if e.kind == "CLARIFY"]
+
+
+def test_clarify_asks_when_nothing_matches_or_precheck_is_off():
+    msgs = _with_ledger("Hold + to skip the cutscene.")
+    result, callback = _ask([{"question": "Which port should the dashboard use?"}], msgs)
+    assert callback.called and "prior_user_words" not in result
+    callback = MagicMock(return_value={"answers": {"q1": "x"}, "outcome": "submitted"})
+    with patch("tools.clarify_tool._precheck_enabled", return_value=False):
+        assert json.loads(clarify_tool([{"question": "How do you skip the cutscene?"}], callback=callback,
+                                       messages=msgs))["outcome"] == "submitted"
+
+
+def test_clarify_precheck_searches_the_archive(tmp_path):
+    ledger = dl.Ledger()
+    ledger.add(dl.Entry("L000001", "USER", "Hold + to skip the cutscene.", "", {"keep": "fact"}))
+    for i in range(30):
+        ledger.add(dl.Entry(f"L1000{i:02d}", "DISPATCH", f"task {i} " + "x" * 80, "open"))
+    with patch.object(dl, "archive_dir", return_value=tmp_path):
+        dl.bound(ledger, 600, "s2")
+    assert all(e.kind != "USER" for e in ledger.entries)
+    msgs = [{"role": "system", "content": "sys"},
+            {"role": "user", "content": ContextCompressor._with_summary_prefix("s") + "\n\n" + dl.render(ledger)}]
+    found = dl.prior_user_words(msgs, ["How do I skip a cutscene?"])
+    assert found and "Hold + to skip the cutscene." in found[0]
+
+
+def test_user_section_cap_scales_with_the_window():
+    from agent import compaction_structured as cs
+
+    assert cs.user_section_cap(0) == cs.USER_SECTION_MAX_CHARS
+    assert cs.USER_SECTION_MAX_CHARS < cs.user_section_cap(64_000) < cs.user_section_cap(200_000)
+    assert cs.user_section_cap(2_000_000) == cs.USER_SECTION_CEILING
+
+
+def test_user_section_squeezes_old_messages_instead_of_dropping_them():
+    from agent import compaction_structured as cs
+
+    turns = [{"role": "user", "content": f"message {i} " + "y" * 400} for i in range(300)]
+    section = cs.user_messages_section("", turns, max_chars=cs.user_section_cap(200_000))
+    assert "left out" not in section
+    assert all(f'"message {i} ' in section for i in range(300))
+    oldest, newest = (section.split(f'"message {i} ')[1].split("\n")[0] for i in (0, 299))
+    assert oldest.endswith(cs.SQUEEZE_MARK + '"') and len(oldest) < 100 < len(newest)
+
+
+def test_stated_facts_and_rules_outlast_open_dispatches(tmp_path):
+    ledger = dl.Ledger()
+    ledger.add(dl.Entry("L0000a1", "USER", "Runs are headed.", "", {"keep": "rule"}))
+    ledger.add(dl.Entry("L0000a2", "USER", "The software keyboard landed yesterday.", "", {"keep": "fact"}))
+    for i in range(30):
+        ledger.add(dl.Entry(f"L1000{i:02d}", "DISPATCH", f"task {i} " + "x" * 80, "open"))
+    users = dl.Ledger(ledger.entries[:2], archived=30, archive_path=str(tmp_path / "s3.md"))
+    with patch.object(dl, "archive_dir", return_value=tmp_path):
+        dl.bound(ledger, len(dl.render(users)), "s3")
+    assert [e.id for e in ledger.entries] == ["L0000a1", "L0000a2"]
+    with patch.object(dl, "archive_dir", return_value=tmp_path):
+        dl.bound(ledger, len(dl.render(users)) - 20, "s3")
+    assert [e.id for e in ledger.entries] == ["L0000a1"]
+
+
+def _dispatch(cid, content, args=None):
+    args = args or {"goal": "build the software keyboard"}
+    return [
+        {"role": "assistant", "content": "", "tool_calls": [{"id": cid, "type": "function", "function": {
+            "name": "delegate_task", "arguments": json.dumps(args)}}]},
+        {"role": "tool", "tool_call_id": cid, "content": json.dumps(content)},
+    ]
+
+
+def _dispatches(msgs):
+    return [e for e in dl.capture(dl.Ledger(), msgs, 0, len(msgs)).entries if e.kind == "DISPATCH"]
+
+
+def test_a_completed_lane_is_not_left_open_behind_a_timestamp():
+    msgs = _dispatch("c1", {"status": "dispatched", "mode": "background", "delegation_id": "deleg_ab12"})
+    msgs.append({"role": "user", "content": "[Sun 2026-11-22 09:14:05 CST] [ASYNC DELEGATION COMPLETE — deleg_ab12]\n"
+                                            "A background subagent you dispatched earlier has finished.\n"
+                                            "--- RESULT ---\nThe software keyboard landed."})
+    (entry,) = _dispatches(msgs)
+    assert entry.status == "done" and "software keyboard landed" in entry.fields["result"]
+
+
+def test_a_foreground_delegation_is_done_when_its_result_is_in():
+    (entry,) = _dispatches(_dispatch("c2", {"results": [{"status": "completed", "summary": "ok"}]}))
+    assert entry.status == "done" and entry.fields["result"] == "1 completed"
+
+
+def test_a_fan_out_is_done_only_when_every_unit_reported():
+    msgs = _dispatch("c3", {"status": "dispatched", "delegation_id": "deleg_u1", "units": [
+        {"delegation_id": "deleg_u1"}, {"delegation_id": "deleg_u2"}]})
+    msgs.append({"role": "user", "content": "[ASYNC DELEGATION TASK FAILED — deleg_u1, task 1/3]\nOne subagent ..."})
+    assert _dispatches(msgs)[0].status == "open"
+    msgs.append({"role": "user", "content": "[ASYNC DELEGATION BATCH COMPLETE — deleg_u1]\nunit one done"})
+    (entry,) = _dispatches(msgs)
+    assert entry.status == "open" and entry.fields["pending"] == "deleg_u2"
+    msgs.append({"role": "user", "content": "[ASYNC DELEGATION BATCH COMPLETE — deleg_u2]\nunit two done"})
+    (entry,) = _dispatches(msgs)
+    assert entry.status == "done" and "pending" not in entry.fields
+    assert dl.parse(dl.render(dl.Ledger([entry]))).entries[0].status == "done"
+
+
+def test_a_delegate_control_call_is_not_a_dispatch():
+    assert not _dispatches(_dispatch("c4", {"status": "ok"}, {"action": "list"}))
+
+
+def test_a_peer_agent_quoting_the_user_is_not_the_users_words():
+    peer = ("[Agent message am_0123456789abcdef from chat 'ops' (session local-1)]\n"
+            "The user said: Runs are headed: the game window goes on the desktop so I can watch.")
+    msgs = [{"role": "system", "content": "sys"}, {"role": "user", "content": peer}]
+    assert not [e for e in _ledger(msgs).entries if e.section == "user"]
+
+
+def test_the_complaint_is_never_stored():
+    msgs = [{"role": "system", "content": "sys"}, {"role": "user", "content": "you're burning so much trust by the hour"}]
+    assert not _ledger(msgs).entries
