+        r"|(?:hold|press|tap|click|use|run|hit|type) [^.!?\n]{1,40}\bto (?:skip|open|close|exit|quit|start|stop|get|"
+        r"go|reach|enable|disable|switch|toggle|save|load|reset|jump|pause|continue|advance)\b"
+        r"|(?:lives|is located|is stored|is kept|is installed|runs) (?:in|at|on|under) \S"
+        r"|it'?s called|is called|we use|i use|i prefer|i'?d rather|i want (?:it|them|you|the|all|every)"
+        r"|is on port|my (?:\w+ ){0,2}(?:is|are)\b|the (?:password|path|port|url|host|repo|branch|account|key) (?:is|for)"
+        r"|(?:landed|merged|shipped) (?:yesterday|today|already|last \w+|on \w+)|(?:is|was) (?:already )?(?:done|merged|landed|fixed)\b"
+        r"|(?:is|are) (?:def|definitely|actually|really|clearly) (?:a|an|the|not)\b)",
+        re.IGNORECASE)),
+    ("approval", re.compile(
+        r"(?:^|\b)(?:looks (?:good|great|perfect|right)|(?:mock(?:up)?|design|layout) (?:is|looks) (?:good|great|fine|perfect|right)|build it|lgtm|approved?|ship it|go with|let'?s (?:go with|do|use)"
+        r"|i (?:like|love) (?:the|this|that|it)|that'?s (?:it|perfect|right|the one)|use (?:that|this|the) "
+        r"(?:one|design|layout|version|mock(?:up)?)|keep (?:that|this|it) (?:design|layout|look|way))\b", re.IGNORECASE)),
+)
+_SENTENCE_RE = re.compile(r"[^.!?\n]+[.!?]*")
+
