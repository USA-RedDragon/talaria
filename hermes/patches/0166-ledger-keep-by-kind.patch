+_STOP = frozenset(
+    "a an and are as at be but by can could did do does for from had has have how i if in into is it its me my "
+    "no not of on or our shall should so than that the their them then there these they this to was we were "
+    "what when where which who whom why will with would you your yours want like use used using one which "
+    "now next also just ok okay please here".split()
+)
+
+
+def _terms(text: str) -> set[str]:
+    out = set()
+    for w in re.findall(r"[\w+#-]+", (text or "").casefold()):
+        if len(w) < 3 and not re.search(r"[+#]", w) or w in _STOP:
+            continue
+        for suffix in ("ing", "ed", "es", "s"):
+            if len(w) > len(suffix) + 3 and w.endswith(suffix):
+                w = w[: -len(suffix)]
+                break
+        out.add(w)
+    return out
+
+
+def prior_user_words(messages: list[dict[str, Any]], texts: Iterable[str], limit: int = 5) -> list[str]:
+    """Ledger lines (the live ledger and its archive file) holding the user's own words that share enough
+    terms with *texts* (a clarify question and its choices) to likely answer it already, best first."""
+    query = set().union(*(_terms(t) for t in texts)) if texts else set()
+    if not query:
+        return []
+    ledger = current(list(messages or []))
+    lines = [e.render() for e in ledger.entries if e.section == "user"]
+    if ledger.archive_path:
+        try:
+            lines += [ln for ln in Path(ledger.archive_path).read_text(encoding="utf-8").splitlines()
+                      if (m := _LINE_RE.match(ln)) is not None and m.group("kind") in USER_KINDS]
+        except OSError:
+            pass
+    scored = []
+    for n, line in enumerate(dict.fromkeys(lines)):
+        shared = len(query & _terms(line.split(": ", 1)[-1]))
+        if shared >= 2 or (shared == 1 and len(query) <= 2):
+            scored.append((-shared, n, line))
+    return [line for _, _, line in sorted(scored)[:limit]]
+
+
