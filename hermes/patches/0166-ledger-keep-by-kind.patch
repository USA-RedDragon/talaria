+def keep_reason(text: str) -> str:
+    """Why a user message is kept as a fact or rule: ``correction``, ``rule``, ``fact``, ``approval`` or ``""``."""
+    body = (text or "").strip()
+    if not body or body.endswith("?") and len(body) < 120:
+        return ""
+    for label, rx in _KEEP_RES:
+        if rx.search(body):
+            return label
+    return ""
+
+
+def _keep_text(words: str) -> str:
+    """The user's words for a kept entry: the whole message when it fits, else its matching sentences verbatim."""
+    if len(words.strip()) <= USER_TEXT_MAX:
+        return words.strip()
+    hits = [s.strip() for s in _SENTENCE_RE.findall(words) if any(rx.search(s) for _, rx in _KEEP_RES)]
+    return _clip(" … ".join(hits) if hits else words, USER_TEXT_MAX)
+
+
+def _norm(text: str) -> str:
+    return " ".join(re.findall(r"[\w+#-]+", (text or "").casefold()))
+
+
+def _same_words(ledger: Ledger, text: str) -> bool:
+    key = _norm(text)
+    return bool(key) and any(e.section == "user" and _norm(e.text) == key for e in ledger.entries)
 
 
