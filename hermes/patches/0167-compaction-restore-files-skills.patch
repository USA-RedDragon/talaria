+                strip_block(strip_restored(active_skills_as_markers(body))) for _, body in summary_hits if body
             ) or self._previous_summary
         # Zero-user provenance (#64650) rides on the newest handoff hit.
         provenance = messages[summary_idx].get(COMPRESSED_SUMMARY_HAS_USER_TURN_KEY)
@@ -5651,6 +5656,7 @@ Write only the summary body. Do not include any preamble or prefix."""
         summary, messages = self._keep_last_skill(
             summary, canonical_messages, messages, compress_start, max(compress_end, scan.tail_start),
         )
+        summary = self._restore_files(summary, canonical_messages, compress_start, max(compress_end, scan.tail_start))
         summary = self._attach_decision_ledger(
             summary, canonical_messages, compress_start, max(compress_end, scan.tail_start),
         )
@@ -5666,12 +5672,30 @@ Write only the summary body. Do not include any preamble or prefix."""
         from agent.compaction_skill_pin import keep_last_skill
 
         summary, messages, pinned = keep_last_skill(
-            summary, canonical, messages, head_end, tail_start, self.keep_last_skill_chars,
+            summary, canonical, messages, head_end, tail_start, self.keep_last_skill_chars, self._restore_budget(),
         )
         if pinned and not self.quiet_mode:
             logger.info("Compaction kept the body of skill %r on the handoff", pinned)
         return summary, messages
 
+    def _restore_budget(self) -> int:
+        """``compression.restore_budget_chars`` scaled to this model's window (0 = off)."""
+        from agent.compaction_restore import budget
