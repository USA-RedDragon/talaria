+def _skill_loads(message: dict[str, Any], calls: dict[str, tuple]) -> list[tuple[str, Optional[str]]]:
+    """Every skill load in *message*, oldest first: a handoff can carry several active skills."""
+    from agent.context_compressor import _content_text_for_contains, is_compaction_summary_message
+
+    if is_compaction_summary_message(message):
+        return active_skills(_content_text_for_contains(message.get("content")))
+    load = _skill_load(message, calls)
+    return [load] if load else []
+
+
+def _newest_loads(messages: list[dict[str, Any]], calls: dict[str, tuple], every: bool) -> list[tuple[str, Optional[str]]]:
+    """``(name, body)`` of the newest load of each skill, newest first; only the newest one unless *every*."""
+    found: dict[str, Optional[str]] = {}
+    for m in reversed(messages):
+        for name, body in reversed(_skill_loads(m, calls)):
+            found.setdefault(name, body)
+            if not every:
+                return list(found.items())
+    return list(found.items())
+
+
 def keep_last_skill(
     summary: str, messages: list[dict[str, Any]], working: list[dict[str, Any]], head_end: int, tail_start: int,
-    max_chars: int,
+    max_chars: int, total_chars: int = 0,
 ) -> tuple[str, list[dict[str, Any]], Optional[str]]:
     """``(summary, working, pinned_name)`` for one compaction. *messages* is the unpruned transcript, *working*
     its pruned copy whose rows before *head_end* and from *tail_start* stay around the handoff.
 
     The newest skill load in *messages* is kept when a kept row still holds its body, or else when its body is
-    at most *max_chars*: then it rides *summary* as an active-skill section (``pinned_name``). A kept skill's
-    reload markers leave the summary and the kept rows. A skill an earlier compaction kept that is not kept
-    now gets its markers back, also with ``max_chars <= 0`` (the key turned off); with nothing kept earlier
-    that returns the input unchanged."""
+    at most *max_chars*: then it rides *summary* as an active-skill section (``pinned_name``, the newest one
+    pinned). With *total_chars* above *max_chars*, every skill loaded in the session is kept the same way,
+    newest first, while the pinned bodies fit *total_chars*. A kept skill's reload markers leave the summary
+    and the kept rows. A skill an earlier compaction kept that is not kept now gets its markers back, also
+    with ``max_chars <= 0`` (the key turned off); with nothing kept earlier that returns the input unchanged."""
     from agent.context_compressor import (
         _PRUNED_SKILLS_SECTION_HEADING, _content_text_for_contains, _redact_compaction_text,
         _reinject_pruned_skill_markers, _skill_pruned_marker, _tool_calls_by_id, is_compaction_summary_message,
@@ -130,42 +154,54 @@ def keep_last_skill(
     for m in messages:
         text = _content_text_for_contains(m.get("content"))
         carried += _KEPT_NOTE_RE.findall(text)
-        if is_compaction_summary_message(m) and (found := active_skills(text)):
-            carried.append(found[-1][0])
+        if is_compaction_summary_message(m):
+            carried += [name for name, _ in active_skills(text)]
     kept_rows = [*range(min(head_end, len(working))), *range(tail_start, len(working))]
-    name = body = None
-    held = False
+    held: set[str] = set()
+    pinned: list[tuple[str, str]] = []
     if max_chars > 0:
         calls = _tool_calls_by_id(messages)
-        name, body = next(filter(None, (_skill_load(m, calls) for m in reversed(messages))), (None, None))
-        held = name is not None and any(
-            not is_compaction_summary_message(working[i]) and (load := _skill_load(working[i], calls))
-            and load[0] == name and load[1] for i in kept_rows
-        )
-        if not (held or (body is not None and len(body) <= max_chars)):
-            name = None
-    working = _retag_kept_rows(working, kept_rows, name)
-    carried = list(dict.fromkeys(n for n in carried if n != name))
-    if name is None:
+        room = max(total_chars, max_chars)
+        for name, body in _newest_loads(messages, calls, every=total_chars > max_chars):
+            if any(
+                not is_compaction_summary_message(working[i]) and (load := _skill_load(working[i], calls))
+                and load[0] == name and load[1] for i in kept_rows
+            ):
+                held.add(name)
+            elif body is not None and len(body) <= min(max_chars, room):
+                pinned.append((name, body))
+                room -= len(body)
+    kept = held | {name for name, _ in pinned}
+    working = _retag_kept_rows(working, kept_rows, kept)
+    carried = list(dict.fromkeys(n for n in carried if n not in kept))
+    if not kept:
         return _reinject_pruned_skill_markers(summary, carried), working, None
-    marker = _skill_pruned_marker(name)
-    summary = summary.replace(marker + "\n", "").replace(marker, "")
+    for name in kept:
+        marker = _skill_pruned_marker(name)
+        summary = summary.replace(marker + "\n", "").replace(marker, "")
     summary = re.sub(r"\n*" + re.escape(_PRUNED_SKILLS_SECTION_HEADING) + r"\s*(?=\n\n## |\Z)", "", summary)
     summary = _reinject_pruned_skill_markers(summary, carried)
-    if held:
-        return summary, working, None
-    return summary + _redact_compaction_text(active_skill_block(name, body)), working, name
+    for name, body in reversed(pinned):
+        summary += _redact_compaction_text(active_skill_block(name, body))
+    return summary, working, pinned[0][0] if pinned else None
 
 
 def keepable_newest_skill(messages: list[dict[str, Any]], max_chars: int) -> Optional[str]:
     """Name of the newest skill load in *messages* when its body is whole and at most *max_chars* (the skill
     ``keep_last_skill`` would carry), else ``None``; always ``None`` with ``max_chars <= 0``."""
+    found = keepable_skills(messages, max_chars)
+    return next(iter(found)) if found else None
+
+
+def keepable_skills(messages: list[dict[str, Any]], max_chars: int, total_chars: int = 0) -> list[str]:
+    """Names of the skills ``keep_last_skill`` would carry from *messages* with these caps, newest first."""
     if max_chars <= 0:
-        return None
+        return []
     from agent.context_compressor import _tool_calls_by_id
 
-    calls = _tool_calls_by_id(messages)
-    load = next(filter(None, (_skill_load(m, calls) for m in reversed(messages))), None)
-    if load is None or load[1] is None or len(load[1]) > max_chars:
-        return None
-    return load[0]
+    room, out = max(total_chars, max_chars), []
+    for name, body in _newest_loads(messages, _tool_calls_by_id(messages), every=total_chars > max_chars):
+        if body is not None and len(body) <= min(max_chars, room):
+            out.append(name)
+            room -= len(body)
+    return out
