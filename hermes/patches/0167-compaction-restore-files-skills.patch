--- /dev/null
+++ b/tests/agent/test_compaction_restore.py
@@ -0,0 +1,128 @@
+"""``compression.restore_budget_chars``: recent files and every loaded skill ride the handoff."""
+
+import json
+from unittest.mock import MagicMock, patch
+
+from agent import compaction_restore as cr
+from agent.compaction_skill_pin import active_skills, keepable_skills
+from agent.context_compressor import ContextCompressor, _skill_pruned_marker
+
+
+def _call(cid, name, args, result):
+    return [
+        {"role": "assistant", "content": "", "tool_calls": [
+            {"id": cid, "type": "function", "function": {"name": name, "arguments": json.dumps(args)}}]},
+        {"role": "tool", "tool_call_id": cid, "content": json.dumps(result)},
+    ]
+
+
+def _read(cid, path, body):
+    return _call(cid, "read_file", {"path": path}, {"content": body, "total_lines": body.count("\n") + 1})
+
+
+def _skill(cid, name, body):
+    return _call(cid, "skill_view", {"name": name}, {"success": True, "name": name, "content": body})
+
+
+def _session():
+    msgs = [{"role": "system", "content": "sys"}, {"role": "user", "content": "fix the intro"}]
+    msgs += _read("r1", "src/intro.py", "1|def intro():\n2|    skip()")
+    msgs += _read("r2", "src/menu.py", "1|MENU = 1")
+    msgs += _call("p1", "patch", {"path": "src/menu.py", "old_string": "1", "new_string": "2"}, {"success": True})
+    msgs += _call("w1", "write_file", {"path": "docs/progress-ui.md", "content": "# Progress UI\nbar, eta"},
+                  {"bytes_written": 22})
+    msgs += _read("r3", "huge.log", "1|" + "x" * (cr.FILE_MAX_CHARS + 10))
+    msgs += [{"role": "assistant", "content": "Done."}, {"role": "user", "content": "next"},
+             {"role": "assistant", "content": "ok"}]
+    return msgs
+
+
+def test_budget_scales_to_the_window():
+    assert cr.budget(0, 200_000) == 0
+    assert cr.budget(100_000, 1_000_000) == 100_000
+    assert cr.budget(100_000, 64_000) == 25_600
+
+
+def test_recent_files_ride_the_handoff_newest_first():
+    msgs = _session()
+    out = cr.restore_files("## 1. Primary Request and Intent\nWork.", msgs, 2, len(msgs) - 2, 100_000)
+    paths = [p for p, _, _ in cr.restored_files(out)]
+    assert paths == ["docs/progress-ui.md", "src/intro.py"]  # menu.py was patched since; the log is too big
+    assert "1|# Progress UI\n2|bar, eta" in out and "2|    skip()" in out
+    assert cr.strip_restored(out) == "## 1. Primary Request and Intent\nWork."
+    assert cr.restore_files("s", msgs, 2, len(msgs) - 2, 0) == "s"
+
+
+def test_a_file_still_in_a_kept_row_is_not_copied():
+    msgs = _session()
+    out = cr.restore_files("s", msgs, 2, 3, 100_000)
+    assert not cr.restored_files(out)
+
+
+def test_at_most_five_files():
+    msgs = [{"role": "system", "content": "sys"}]
+    for i in range(8):
+        msgs += _read(f"r{i}", f"f{i}.py", f"1|v{i}")
+    msgs += [{"role": "user", "content": "go"}, {"role": "assistant", "content": "ok"}]
+    out = cr.restore_files("s", msgs, 1, len(msgs) - 2, 100_000)
+    assert [p for p, _, _ in cr.restored_files(out)] == [f"f{i}.py" for i in (7, 6, 5, 4, 3)]
+
+
+def _compressor():
+    with patch("agent.context_compressor.get_model_context_length", return_value=200_000):
+        c = ContextCompressor(model="test/model", quiet_mode=True, protect_first_n=1, protect_last_n=2)
+    c.restore_budget_chars = 100_000
+    c.keep_last_skill_chars = 20_000
+    return c
+
+
+def _compress(c, msgs):
+    response = MagicMock()
+    response.choices = [MagicMock()]
+    response.choices[0].message.content = "## Goal\nWork."
+    with (
+        patch.object(c, "_find_tail_cut_by_tokens", return_value=len(msgs) - 2),
+        patch("agent.context_compressor.call_llm", return_value=response) as call,
+    ):
+        return c.compress(msgs, force=True), call
+
+
+def _handoff(result):
+    return next(m["content"] for m in result if ContextCompressor.classify_summary_content(m.get("content")))
+
+
+def test_files_and_skills_survive_two_compactions_and_stay_out_of_the_summarizer():
+    c = _compressor()
+    msgs = _session()
+    msgs[-3:-3] = _skill("s1", "kicad", "# kicad\nRULE: run DRC.") + _skill("s2", "jlc-order", "# jlc\nRULE: BOM first.")
+    out, _ = _compress(c, msgs)
+    first = _handoff(out)
+    assert [p for p, _, _ in cr.restored_files(first)] == ["docs/progress-ui.md", "src/intro.py"]
+    assert sorted(n for n, _ in active_skills(first)) == ["jlc-order", "kicad"]
+    more = out + [{"role": "user", "content": f"step {i}"} for i in range(3)]
+    more += [{"role": "assistant", "content": "ok"}, {"role": "user", "content": "go"}, {"role": "assistant", "content": "ok"}]
+    out2, call = _compress(c, more)
+    second = _handoff(out2)
+    assert [p for p, _, _ in cr.restored_files(second)] == ["docs/progress-ui.md", "src/intro.py"]
+    assert sorted(n for n, _ in active_skills(second)) == ["jlc-order", "kicad"]
+    assert second.count(cr.RESTORED_HEADING) == 1
+    prompt = call.call_args_list[0].kwargs["messages"][0]["content"]
+    assert "2|    skip()" not in prompt and "RULE: run DRC." not in prompt
+
+
+def test_without_the_budget_only_the_newest_skill_is_kept():
+    c = _compressor()
+    c.restore_budget_chars = 0
+    msgs = _session()
+    msgs[-3:-3] = _skill("s1", "kicad", "# kicad\nRULE: run DRC.") + _skill("s2", "jlc-order", "# jlc\nRULE: BOM first.")
+    handoff = _handoff(_compress(c, msgs)[0])
+    assert [n for n, _ in active_skills(handoff)] == ["jlc-order"]
+    assert _skill_pruned_marker("kicad") in handoff and not cr.restored_files(handoff)
+
+
+def test_keepable_skills_follow_the_same_caps():
+    msgs = _skill("s1", "a", "x" * 100) + _skill("s2", "b", "y" * 300) + _skill("s3", "c", "z" * 50)
+    assert keepable_skills(msgs, 400) == ["c"]
+    assert keepable_skills(msgs, 400, 1000) == ["c", "b", "a"]
+    assert keepable_skills(msgs, 200, 1000) == ["c", "a"]
+    assert keepable_skills(msgs, 300, 360) == ["c", "b"]
