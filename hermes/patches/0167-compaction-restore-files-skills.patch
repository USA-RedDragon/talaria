diff --git a/agent/compaction_restore.py b/agent/compaction_restore.py
new file mode 100644
index 00000000..ef157b59
--- /dev/null
+++ b/agent/compaction_restore.py
@@ -0,0 +1,112 @@
+"""Opt-in ``compression.restore_budget_chars``: the files the session read or wrote last ride the handoff.
+
+After a compaction the touched-files list names paths only, so the model reads them all again (or works from a
+summary of them). With the budget set, up to five files the compacted rows read or wrote, newest first, come
+back on the handoff as they were last seen: the newest ``read_file`` result or ``write_file`` content of each,
+at most 20,000 chars (about 5K tokens) each and the budget in total, scaled down to a tenth of a small window.
+A file patched after it was last seen is left out (its content would be stale), and so is one still in a kept
+row. A restored file is carried to the next handoff the same way until a newer read or write replaces it.
+The same budget lets every skill the session loaded ride the handoff (``compaction_skill_pin``).
+"""
+
+from __future__ import annotations
+
+import re
+from typing import Any, Optional
+
+RESTORED_HEADING = "## Restored Files"
+FILE_MAX_CHARS = 20_000
+FILES_MAX = 5
+WINDOW_SHARE = 0.4  # chars per window token: about a tenth of the window
+_NOTE = (
+    "(Copied by Hermes: the files this session read or wrote last, newest first, as they were then, so the work "
+    "can go on without reading them again. A file may have changed since; read it again before editing it.)"
+)
+_FILE_RE = re.compile(
+    r'<restored-file path="(?P<path>[^"\n]+)" seen="(?P<seen>[^"\n]*)">\n(?P<body>.*?)\n</restored-file>', re.DOTALL)
+_BLOCK_RE = re.compile(r"\n*" + re.escape(RESTORED_HEADING) + r"\n.*?(?=\n## (?!#)|\Z)", re.DOTALL)
+
+
+def budget(total_chars: int, context_length: int) -> int:
+    """*total_chars* scaled to the window: at most a tenth of it (in tokens, about 4 chars each)."""
+    if total_chars <= 0:
+        return 0
+    return min(total_chars, int(context_length * WINDOW_SHARE)) if context_length else total_chars
+
+
+def restored_files(text: str) -> list[tuple[str, str, str]]:
+    """``(path, seen, body)`` of every restored file in *text*, in order."""
+    return [(m.group("path"), m.group("seen"), m.group("body")) for m in _FILE_RE.finditer(text or "")]
+
+
+def strip_restored(text: str) -> str:
+    """*text* without its restored-files section (what the summarizer sees of a previous handoff)."""
+    return _BLOCK_RE.sub("", text or "")
+
+
+def _numbered(text: str, start: int = 1) -> str:
+    return "\n".join(f"{n}|{line}" for n, line in enumerate(text.removesuffix("\n").split("\n"), start))
+
+
+def _seen(message: dict[str, Any], calls: dict[str, tuple]) -> Optional[tuple[str, str, Optional[str]]]:
+    """``(path, how, body)`` when *message* is a file tool result: *body* is the content it showed or wrote,
+    ``None`` for a patch or a result without content (the file changed or was not shown)."""
+    from agent.context_compressor import _json_dict
+
+    if message.get("role") != "tool":
+        return None
+    tool, raw_args = calls.get(str(message.get("tool_call_id") or ""), ("", ""))
+    if tool not in ("read_file", "write_file", "patch"):
+        return None
+    args = _json_dict(raw_args) if isinstance(raw_args, str) else (raw_args or {})
+    path = args.get("path")
+    if not isinstance(path, str) or not path.strip():
+        return None
+    payload = _json_dict(message.get("content"))
+    if tool == "read_file":
+        body = payload.get("content")
+        if payload.get("dedup") or payload.get("error") or not isinstance(body, str) or not body.strip():
+            return None
+        first = int(args.get("offset") or 1)
+        return path, f"read from line {first}" if first > 1 or payload.get("truncated") else "read", body
+    if tool == "write_file" and isinstance(args.get("content"), str) and not payload.get("error"):
+        return path, "written", _numbered(args["content"])
+    return path, "patched", None
+
+
+def restore_files(
+    summary: str, messages: list[dict[str, Any]], head_end: int, tail_start: int, total_chars: int,
+) -> str:
+    """*summary* with the restored-files section for this compaction (unchanged when *total_chars* <= 0)."""
+    if total_chars <= 0:
+        return summary
+    from agent.context_compressor import (
+        _content_text_for_contains, _redact_compaction_text, _tool_calls_by_id, is_compaction_summary_message,
+    )
+
+    calls = _tool_calls_by_id(messages)
+    newest: dict[str, tuple[int, str, Optional[str]]] = {}
+    for i in range(len(messages) - 1, -1, -1):
+        m = messages[i]
+        if not isinstance(m, dict):
+            continue
+        if is_compaction_summary_message(m):
+            for path, seen, body in restored_files(_content_text_for_contains(m.get("content"))):
+                newest.setdefault(path, (i, seen, body))
+            continue
+        hit = _seen(m, calls)
+        if hit is not None:
+            newest.setdefault(hit[0], (i, hit[1], hit[2]))
+    parts, room = [], total_chars
+    for path, (i, seen, body) in newest.items():
+        if len(parts) >= FILES_MAX:
+            break
+        kept_row = (i < head_end or i >= tail_start) and not is_compaction_summary_message(messages[i])
+        if body is None or kept_row or '"' in path or len(body) > min(FILE_MAX_CHARS, room):
+            continue
+        parts.append(f'<restored-file path="{path}" seen="{seen}">\n{body}\n</restored-file>')
+        room -= len(body)
+    summary = strip_restored(summary).rstrip()
+    if not parts:
+        return summary
+    return summary + "\n\n" + _redact_compaction_text("\n".join([RESTORED_HEADING, _NOTE, *parts]))
