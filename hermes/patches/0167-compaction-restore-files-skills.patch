+        return budget(getattr(self, "restore_budget_chars", 0), getattr(self, "context_length", 0) or 0)
+
+    def _restore_files(
+        self, summary: str, canonical: list[dict[str, Any]], head_end: int, tail_start: int,
+    ) -> str:
