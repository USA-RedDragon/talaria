diff --git a/tests/gateway/test_restart_boundary_admission.py b/tests/gateway/test_restart_boundary_admission.py
new file mode 100644
index 00000000..c4453e92
--- /dev/null
+++ b/tests/gateway/test_restart_boundary_admission.py
@@ -0,0 +1,142 @@
+"""gateway.restart_turn_handoff_boundary keeps admission open during the boundary wait: a message sent after the
+restart began starts its turn on the old owner at once, instead of waiting queued until the next gateway takes
+the profile over. Admission closes once the turns that were running reached their boundaries; the turns that
+started meanwhile are then asked to hand off at their next one. A turn handed off here is never claimed again
+here: it waits queued for the next owner."""
+import asyncio
+from types import SimpleNamespace
+
+import pytest
+
+from gateway import turn_boundary, turn_handoff
+from gateway.config import GatewayConfig, Platform
+from gateway.drain_control import RESTART_WAIT_REASON, restart_wait_open
+from gateway.run_shutdown import GatewayShutdownMixin
+from gateway.session_events import SessionEvents
+from gateway.session_pending_controls import PendingControls
+from hermes_state_runtime import RuntimeStoreError
+
+
+@pytest.fixture(autouse=True)
+def _clean(monkeypatch):
+    monkeypatch.setattr(turn_handoff, "_handing_off", False)
+    monkeypatch.setattr(turn_boundary, "_resuming", set())
+    monkeypatch.setattr(turn_boundary, "_handed_off", set())
+
+
+class _Authority:
+    def __init__(self):
+        self.sessions, self.adopted, self.executing = {}, {}, {}
+        self.pending_results, self.pending_deliveries, self.steer_transfers = {}, {}, {}
+
+    def start(self, session_id, admission_id, generation):
+        """A claimed turn running in this process."""
+        events = SessionEvents()
+        events.execution = {"authority_epoch": 1, "execution_generation": generation, "admission_id": admission_id}
+        self.sessions[session_id] = SimpleNamespace(event_stream=events, controls=PendingControls(events), route=session_id)
+        agent = SimpleNamespace()
+        self.adopted[session_id] = (generation, agent)
+        self.executing[session_id] = generation
+        return agent
+
+    def hand_off(self, session_id):
+        """The turn reached its boundary and the drain requeued it for the next owner."""
+        admission_id = self.sessions[session_id].event_stream.execution["admission_id"]
+        turn_boundary._handed_off.add(admission_id)
+        self.sessions[session_id].event_stream.execution = {}
+        self.adopted.pop(session_id, None)
+
+
+class _Runner:
+    """Just what request_restart and the boundary wait touch."""
+    def __init__(self, authority, cap=30.0):
+        self.config = GatewayConfig(restart_turn_handoff=True, restart_turn_handoff_boundary=True,
+                                    restart_turn_handoff_wait_seconds=cap)
+        self.session_authority, self.session_authorities = authority, None
+        self._restart_task_started = self._restart_requested = self._draining = False
+        self._running = True
+        self.session_runtime_descriptor = {"state": "ready"}
+        self.marked_api_runs = 0
+        self.stopped = asyncio.Event()
+
+    def _mark_api_runs_shutdown_requested(self):
+        self.marked_api_runs += 1
+
+    async def _await_active_work_before_restart(self):
+        await turn_boundary.hand_off_at_boundaries(self, turn_handoff.wait_seconds(self))
+
+    async def stop(self, **kwargs):
+        self.stopped.set()
+
+
+async def _until(predicate, timeout=5.0):
+    loop = asyncio.get_running_loop()
+    end = loop.time() + timeout
+    while not predicate():
+        assert loop.time() < end, "timed out"
+        await asyncio.sleep(0.01)
+
+
+@pytest.mark.asyncio
+async def test_new_turns_start_on_the_old_owner_until_running_turns_reach_their_boundary():
+    authority = _Authority()
+    old = authority.start("busy", "a-old", 1)  # a turn in a long foreground command
+    runner = _Runner(authority)
+    assert GatewayShutdownMixin.request_restart(runner) is True
+    await _until(lambda: getattr(old, "_handoff_boundary", False))
+
+    # The restart began; a message to an idle chat is admitted and claimed here, with no wait.
+    assert runner._draining is False and not restart_wait_open(runner)
+    assert runner.session_runtime_descriptor.get("drain_reason") is None and runner.marked_api_runs == 0
+    new = authority.start("idle", "a-new", 7)
+    await asyncio.sleep(0.2)
+    assert getattr(new, "_handoff_boundary", False) is False  # it runs normally while admission is open
+    assert runner._draining is False
+
+    # The running turn reaches its boundary: admission closes, the new turn is asked at its next boundary.
+    authority.hand_off("busy")
+    await _until(lambda: getattr(new, "_handoff_boundary", False))
+    assert runner._draining is True and restart_wait_open(runner)
+    assert runner.session_runtime_descriptor["drain_reason"] == RESTART_WAIT_REASON and runner.marked_api_runs == 1
+    authority.hand_off("idle")
+    await asyncio.wait_for(runner.stopped.wait(), 5.0)
+
+
+@pytest.mark.asyncio
+async def test_without_the_boundary_key_a_restart_still_refuses_new_turns_at_once():
+    runner = _Runner(_Authority())
+    runner.config = GatewayConfig(restart_turn_handoff=True)
+    assert GatewayShutdownMixin.request_restart(runner) is True
+    assert runner._draining is True and restart_wait_open(runner) and runner.marked_api_runs == 1
+    await asyncio.wait_for(runner.stopped.wait(), 5.0)
+
+
+@pytest.mark.asyncio
+async def test_with_nothing_running_admission_closes_before_the_stop():
+    runner = _Runner(_Authority())
+    assert GatewayShutdownMixin.request_restart(runner) is True
+    await asyncio.wait_for(runner.stopped.wait(), 5.0)
+    assert runner._draining is True and runner.marked_api_runs == 1
+
+
+@pytest.mark.asyncio
+async def test_a_turn_handed_off_here_is_not_claimed_again_here(owner):
+    from gateway.session_authority import LiveSession
+    from gateway.session_contract import SessionRef
+    from gateway.session import SessionSource
+    from hermes_state_runtime import (admit_session_input, claim_session_input, get_session_admission,
+                                      hand_off_session_input)
+    owner.db.create_session("s1", source="telegram")
+    admit_session_input(owner.db, epoch=owner.epoch, principal_id="p", session_id="s1", request_id="r1",
+                        payload={"text": "do the thing"})
+    claimed = claim_session_input(owner.db, epoch=owner.epoch, session_id="s1")
+    hand_off_session_input(owner.db, epoch=owner.epoch, admission_id=claimed["admission_id"],
+                           generation=claimed["generation"], record={"prompts": []})
+    turn_boundary._handed_off.add(claimed["admission_id"])
+    live = LiveSession(SessionSource(platform=Platform.TELEGRAM, chat_id="c1"), "route-1")
+    owner.sessions["s1"] = live
+    assert owner.runner._draining is False  # admission is open (the boundary wait)
+    with pytest.raises(RuntimeStoreError) as refused:
+        await owner._claim_next(SessionRef(owner.profile_id, "s1"), live)
+    assert refused.value.reason == "runtime_draining"
+    assert get_session_admission(owner.db, admission_id=claimed["admission_id"])["status"] == "queued"
diff --git a/tests/gateway/test_restart_takeover_gap.py b/tests/gateway/test_restart_takeover_gap.py
new file mode 100644
index 00000000..61790b2e
--- /dev/null
+++ b/tests/gateway/test_restart_takeover_gap.py
@@ -0,0 +1,59 @@
+"""The takeover gap of a restart: a standby takes the profile within a few tens of milliseconds of its release
+(it used to poll every 200 ms), and an API run is still refused once a restart is requested while
+gateway.restart_turn_handoff_boundary keeps canonical admission open (an API run is not handed off and would
+hold the stop)."""
+import asyncio
+import time
+from types import SimpleNamespace
+
+import pytest
+
+from gateway import run_bootstrap
+from gateway.platforms.api_server_fire_startup import runner_is_draining
+from gateway.runtime_ownership import ProfileOwnership, process_ownership
+
+
+@pytest.fixture
+def home(tmp_path, monkeypatch):
+    home = tmp_path / "home"
+    home.mkdir()
+    monkeypatch.setenv("HERMES_HOME", str(home))
+    monkeypatch.setattr("gateway.run.get_hermes_home", lambda: home)
+    monkeypatch.setattr(run_bootstrap, "_prewarm_before_runtime_lock", lambda config=None: None)
+    monkeypatch.setattr(run_bootstrap, "_host_lock_held_by_predecessor", lambda _home: False)
+    yield home
+    process_ownership.close()
+
+
+def test_standby_polls_the_lock_often():
+    assert run_bootstrap.RUNTIME_LOCK_POLL_S <= 0.025
+
+
+@pytest.mark.platforms("linux")
+@pytest.mark.asyncio
+async def test_standby_takes_over_within_tens_of_milliseconds_of_the_release(home):
+    worst = 0.0
+    for attempt in range(6):
+        owner = ProfileOwnership()
+        owner.reserve([home])
+        waiter = asyncio.create_task(run_bootstrap._start_gateway_wait_for_runtime_lock([], 30))
+        await asyncio.sleep(0.25 + attempt * 0.033)  # the release lands at a different point of the poll each time
+        assert not waiter.done()
+        released = time.monotonic()
+        owner.close()
+        await asyncio.wait_for(waiter, 5)
+        worst = max(worst, time.monotonic() - released)
+        process_ownership.close()
+    assert worst < 0.1, worst
+
+
+@pytest.mark.parametrize("state, refused", [
+    ({}, False),
+    ({"_draining": True}, True),
+    ({"_external_drain_active": True}, True),
+    ({"_restart_requested": True}, True),  # boundary wait: canonical admission open, API runs refused
+])
+def test_api_runs_are_refused_from_the_restart_request(state, refused):
+    runner = SimpleNamespace(**{"_draining": False, "_external_drain_active": False, "_restart_requested": False,
+                                **state})
+    assert runner_is_draining(runner) is refused
diff --git a/tests/gateway/test_restart_turn_resume_pending_call.py b/tests/gateway/test_restart_turn_resume_pending_call.py
new file mode 100644
index 00000000..91eb5a35
--- /dev/null
+++ b/tests/gateway/test_restart_turn_resume_pending_call.py
@@ -0,0 +1,138 @@
+"""gateway.restart_turn_handoff_boundary, resume through the gateway's own history load: the next gateway runs
+the tool call(s) the handed-off turn's last assistant row left without a result (the call that raised a parked
+clarify or approval, or a tool round that had not started), exactly once and under the original tool_use id. It
+makes no model call to decide what to redo and writes no second assistant row.
+
+The transcript goes through the same path a claimed resume takes on the next owner: ``load_transcript`` rows,
+``TurnRunner._load_turn_history`` (``_build_gateway_agent_history``, then ``adopt_turn``), then the agent's
+conversation loop. The replay cleanup there treats an unanswered tail as a crash orphan (dropped when read-only,
+answered with an "effect UNKNOWN" notice otherwise); for a handed-off turn that tail is the step to run."""
+import json
+import tempfile
+from pathlib import Path
+from types import SimpleNamespace
+from unittest.mock import MagicMock, patch
+
+import pytest
+
+from gateway import turn_boundary
+from gateway.run_turn_runner import TurnRunner
+from gateway.session_transcript import SessionTranscriptMixin
+from hermes_state import SessionDB
+from run_agent import AIAgent
+
+
+@pytest.fixture(autouse=True)
+def _quiet(monkeypatch):
+    monkeypatch.setattr("agent.title_generator.maybe_auto_title", lambda *args, **kwargs: None)
+
+
+def _tool_defs(*names):
+    return [{"type": "function", "function": {"name": n, "description": n, "parameters": {"type": "object", "properties": {}}}}
+            for n in names]
+
+
+def _agent(db, session_id, tools):
+    home = Path(tempfile.mkdtemp(prefix="hermes-test-home-"))
+    (home / "logs").mkdir(parents=True, exist_ok=True)
+    with (patch("model_tools.get_tool_definitions", return_value=_tool_defs(*tools)),
+          patch("model_tools.check_toolset_requirements", return_value={}),
+          patch("agent.process_bootstrap.OpenAI"),
+          patch("run_agent._hermes_home", home),
+          patch("agent.model_metadata.fetch_model_metadata", return_value={})):
+        agent = AIAgent(api_key="test-key", base_url="https://openrouter.ai/api/v1", quiet_mode=True,
+                        skip_context_files=True, skip_memory=True)
+    agent.client = MagicMock()
+    agent._cached_system_prompt = "You are helpful."
+    agent._use_prompt_caching = False
+    agent.compression_enabled = False
+    agent.save_trajectories = False
+    agent._session_db = db
+    agent._session_db_created = True
+    agent.session_id = session_id
+    agent._last_flushed_db_idx = 0
+    agent._flushed_db_message_ids = set()
+    agent._flushed_db_message_session_id = None
+    agent._persist_disabled = False
+    return agent
+
+
+def _response(content="", tool_calls=None):
+    msg = SimpleNamespace(content=content, tool_calls=tool_calls)
+    return SimpleNamespace(choices=[SimpleNamespace(message=msg, finish_reason="tool_calls" if tool_calls else "stop")],
+                           model="test/model", usage=None)
+
+
+def _handed_off_transcript(tmp_path, name, args):
+    """What the old owner leaves: the turn's user row and its durable assistant row with a tool call that has
+    no result (a withdrawn clarify/approval, or a boundary before the tool round)."""
+    db = SessionDB(db_path=tmp_path / "state.db")
+    db.create_session(session_id="s1", source="api_server", model="test/model")
+    db.append_message("s1", "user", "do the thing")
+    db.append_message("s1", "assistant", "", tool_calls=[
+        {"id": "toolu_orig", "type": "function", "function": {"name": name, "arguments": json.dumps(args)}}])
+    return db
+
+
+def _resume_through_gateway(db, agent):
+    """The next owner's claimed resume: transcript load, the turn runner's history phase, the loop."""
+    store = SimpleNamespace(_db_for_session_id=lambda sid: db, _follow_reroutes=lambda sid: sid)
+    token = turn_boundary.resume_turn.set({"prompts": []})  # the claim of a handed-off admission
+    try:
+        ctx = SimpleNamespace(history=SessionTranscriptMixin.load_transcript(store, "s1"),
+                              channel_prompt=None, user_config={}, session_key="k1", session_id="s1")
+        fake = SimpleNamespace(_ctx=ctx, _runner=SimpleNamespace())
+        history, _, _ = TurnRunner._load_turn_history(fake, agent, False)
+    finally:
+        turn_boundary.resume_turn.reset(token)
+    with (patch.object(agent, "_persist_session"), patch.object(agent, "_save_trajectory"),
+          patch.object(agent, "_cleanup_task_resources")):
+        return agent.run_conversation("do the thing", conversation_history=history)
+
+
+@pytest.mark.parametrize("name,args", [
+    ("clarify", {"questions": [{"question": "Pick a color", "choices": ["blue", "green"]}]}),  # parked clarify
+    ("terminal", {"command": "rm -rf build"}),  # parked approval card
+    ("web_search", {"query": "x"}),  # boundary after the model call, read-only tool
+])
+def test_resume_runs_the_stored_call_not_a_new_model_call(tmp_path, name, args):
+    db = _handed_off_transcript(tmp_path, name, args)
+    agent = _agent(db, "s1", [name])
+    agent.client.chat.completions.create.side_effect = [_response("done")]
+    ran = []
+
+    def tool(function_name, function_args, *a, **k):
+        ran.append((function_name, function_args, k.get("tool_call_id")))
+        return "green" if function_name == "clarify" else "ok"
+
+    def clarify(questions, callback=None):  # the agent runs clarify inline, with its own callback
+        ran.append(("clarify", {"questions": questions}, None))
+        return "green"
+
+    with patch("model_tools.handle_function_call", side_effect=tool), \
+         patch("tools.clarify_tool.clarify_tool", side_effect=clarify):
+        result = _resume_through_gateway(db, agent)
+
+    assert result["final_response"] == "done"
+    assert [(n, a) for n, a, _ in ran] == [(name, args)]  # the stored call, exactly once
+    assert agent.client.chat.completions.create.call_count == 1  # only the call after its result
+    sent = agent.client.chat.completions.create.call_args.kwargs["messages"]
+    assert [m["role"] for m in sent if m["role"] != "system"] == ["user", "assistant", "tool"]
+    assert "Orphan recovery" not in json.dumps(sent)
+    rows = db.get_messages_as_conversation("s1")
+    assert [r["role"] for r in rows] == ["user", "assistant", "tool", "assistant"]
+    assert rows[1]["tool_calls"][0]["id"] == "toolu_orig"  # no second assistant row with a new tool_use
+    assert rows[2]["tool_call_id"] == "toolu_orig"
+    assert "Orphan recovery" not in rows[2]["content"]
+
+
+def test_a_normal_turn_still_cleans_a_crash_orphan(tmp_path):
+    """Not a resume: the dangling tail of a crashed turn is still answered as an orphan (unchanged)."""
+    from gateway.run import _build_gateway_agent_history
+    db = _handed_off_transcript(tmp_path, "terminal", {"command": "ls"})
+    store = SimpleNamespace(_db_for_session_id=lambda sid: db, _follow_reroutes=lambda sid: sid)
+    loaded = SessionTranscriptMixin.load_transcript(store, "s1")
+    assert [m["role"] for m in loaded] == ["user"]  # the load's alternation repair drops the dangling call
+    rows = db.get_messages_as_conversation("s1")
+    assert [m["role"] for m in _build_gateway_agent_history(rows)[0]] == ["user", "assistant", "tool"]
+    assert "Orphan recovery" in _build_gateway_agent_history(rows)[0][-1]["content"]
