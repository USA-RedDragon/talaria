+async def _while_admission_open(runner, deadline: float, asked: dict) -> None:
+    """While admission is still open (the restart did not refuse new turns yet): ask only the turns that
+    were running when the wait began to stop at their next boundary, and wait for them. New input keeps
+    starting turns here meanwhile, with no wait; they are asked once admission closes."""
+    from agent import turn_boundary_handoff as boundary
+    loop = asyncio.get_running_loop()
+    first = {t.admission_id for t in _turns(runner)}
+    last_log = 0.0
+    while True:
+        turns = [t for t in _turns(runner) if t.admission_id in first]
+        for turn in turns:
+            boundary.request(turn.agent)
+            asked[turn.admission_id] = turn
+        running = [t for t in turns if not _parked_prompts(t)]
+        now = loop.time()
+        if not running or now >= deadline:
+            return
+        if now - last_log >= 30.0:
+            logger.info("Restart: new turns still start here while %d running turn(s) reach a step boundary "
+                        "(%.0fs left, gateway.restart_turn_handoff_boundary)", len(running), deadline - now)
+            last_log = now
+        await asyncio.sleep(0.05)
+
