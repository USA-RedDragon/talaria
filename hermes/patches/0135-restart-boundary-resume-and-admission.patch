+def begin_restart_drain(runner) -> bool:
+    """Refuse new turns for the restart (``_draining``), publish its after-turn wait and persist the
+    shutdown boundary on API runs. Idempotent; True when this call closed admission.
+
+    A restart closes admission when it is requested, except with ``gateway.restart_turn_handoff_boundary``:
+    then the boundary wait keeps it open while the turns that were running reach their boundaries, and
+    closes it here once they did (``gateway.turn_boundary.hand_off_at_boundaries``)."""
+    if getattr(runner, "_draining", False):
+        return False
+    runner._draining = True
+    open_restart_wait(runner)  # clients may still answer a turn parked on approval/clarify (#139041)
+    # The restart's after-turn wait is a drain window too: pollers of GET /v1/runs/{id} must see
+    # the boundary from the moment new turns are refused, not only once stop() begins (#115133).
+    mark = getattr(runner, "_mark_api_runs_shutdown_requested", None)
+    if callable(mark):
+        mark()
+    return True
