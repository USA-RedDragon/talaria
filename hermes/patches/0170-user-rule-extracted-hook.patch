diff --git a/agent/rule_extractor.py b/agent/rule_extractor.py
index 50a5c93f..f60fa4a9 100644
--- a/agent/rule_extractor.py
+++ b/agent/rule_extractor.py
@@ -319,8 +319,45 @@ def schedule(agent: Any, messages: list[dict[str, Any]],
 
 
 def _after(agent: Any, snapshot: list[dict[str, Any]], found: list[dict[str, Any]]) -> None:
-    """A withdrawal takes its rule out of the live system prompt now; new items wait for the next compaction."""
+    """A withdrawal takes its rule out of the live system prompt now; new items wait for the next compaction.
+    Project-scope items go to the ``on_user_rule_extracted`` plugins (project memory), whose notes reach the
+    session's next turn."""
+    session_id = getattr(agent, "session_id", "") or ""
     if any(r["kind"] == "revocation" for r in found):
         from agent import pinned_rules
 
-        pinned_rules.refresh(agent, snapshot, session_id=getattr(agent, "session_id", "") or "")
+        pinned_rules.refresh(agent, snapshot, session_id=session_id)
+    project = [{k: r[k] for k in ("kind", "quote", "at", "msg", "id") if r.get(k)}
+               for r in found if r.get("scope") == "project"]
+    if project:
+        publish(session_id, project)
+
+
+def publish(session_id: str, project_items: list[dict[str, Any]]) -> list[str]:
+    """Hand *project_items* to the ``on_user_rule_extracted`` plugins; their notes wait for the next turn."""
+    try:
+        from hermes_cli.plugins import has_hook, invoke_hook
+
+        if not has_hook("on_user_rule_extracted"):
+            return []
+        results = invoke_hook("on_user_rule_extracted", session_id=session_id, items=project_items)
+    except Exception:
+        logger.debug("on_user_rule_extracted failed", exc_info=True)
+        return []
+    notes = [r.strip() for r in results if isinstance(r, str) and r.strip()]
+    if notes:
+        _append(session_id, [{"notice": n, "nid": _digest(n + str(time.time()))} for n in notes])
+    return notes
+
+
+def pop_notices(session_id: str) -> str:
+    """The notes plugins left for this session's next turn, once each."""
+    if not session_id:
+        return ""
+    recs = load(session_id)
+    done = {r.get("delivered") for r in recs if r.get("delivered")}
+    fresh = [r for r in recs if r.get("notice") and r.get("nid") not in done]
+    if not fresh:
+        return ""
+    _append(session_id, [{"delivered": r["nid"]} for r in fresh])
+    return "\n\n".join(str(r["notice"]) for r in fresh)
