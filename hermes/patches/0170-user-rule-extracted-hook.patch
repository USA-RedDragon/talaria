@@ -0,0 +1,68 @@
+"""Project-scope items from the rule extractor go to ``on_user_rule_extracted`` plugins; their notes reach the
+session's next turn once."""
+
+import json
+from types import SimpleNamespace
+from unittest.mock import patch
+
+import pytest
+
+from agent import decision_ledger as dl
+from agent import rule_extractor as rx
+from hermes_cli.plugins import VALID_HOOKS
+
+
+@pytest.fixture(autouse=True)
+def home(tmp_path, monkeypatch):
+    monkeypatch.setattr(dl, "archive_dir", lambda: tmp_path)
+    return tmp_path
+
+
+FOUND = [
+    {"kind": "fact", "quote": "hold Plus to skip a cutscene", "scope": "project", "id": "L00aa01", "at": "2026-11-21",
+     "msg": "700", "when": 1.0},
+    {"kind": "rule", "quote": "games run headed", "id": "L00aa02"},
+]
+
+
+def test_the_hook_is_known():
+    assert "on_user_rule_extracted" in VALID_HOOKS
+
+
+def test_only_project_items_go_to_the_plugins_and_their_note_reaches_the_next_turn_once():
+    calls = []
+
+    def invoke(name, **kw):
+        calls.append((name, kw))
+        return ["Saved to project memory: x. Say undo to remove it.", None, 3]
+
+    agent = SimpleNamespace(session_id="s1")
+    with patch("hermes_cli.plugins.has_hook", return_value=True), \
+         patch("hermes_cli.plugins.invoke_hook", side_effect=invoke):
+        rx._after(agent, [], FOUND)
+    assert calls == [("on_user_rule_extracted", {"session_id": "s1", "items": [
+        {"kind": "fact", "quote": "hold Plus to skip a cutscene", "at": "2026-11-21", "msg": "700", "id": "L00aa01"}]})]
+    assert rx.pop_notices("s1") == "Saved to project memory: x. Say undo to remove it."
+    assert rx.pop_notices("s1") == "" and rx.pop_notices("s2") == ""
+
+
+def test_no_plugin_no_call_no_note():
+    with patch("hermes_cli.plugins.has_hook", return_value=False), \
+         patch("hermes_cli.plugins.invoke_hook") as invoke:
+        assert rx.publish("s1", FOUND[:1]) == []
+    invoke.assert_not_called()
+    assert rx.pop_notices("s1") == ""
+
+
+def test_the_note_rides_the_next_turns_user_message(monkeypatch):
+    from agent import turn_context
+
+    rx._append("s1", [{"notice": "Saved: hold Plus. Say undo to remove it.", "nid": "n1"}])
+    agent = SimpleNamespace(session_id="s1")
+    for name in ("consume_gateway_turn_context_notes", "pop_plugin_notices", "consume_surface_switch_note",
+                 "consume_skills_index_note", "forward_lsp_verdicts"):
+        monkeypatch.setattr(turn_context, name, lambda *a, **k: "")
+    msgs = [{"role": "user", "content": "next"}]
+    assert "Saved: hold Plus." in turn_context._merge_gateway_notes(agent, msgs, 0, "")
+    assert turn_context._merge_gateway_notes(agent, msgs, 0, "") == ""
+    assert json.loads(rx.store_path("s1").read_text().splitlines()[-1]) == {"delivered": "n1"}
