From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: USA-RedDragon <USA-RedDragon@users.noreply.github.com>
Date: Sun, 15 Nov 2026 00:24:49 -0600
Subject: [PATCH] fix(approval): smart approval does not review send_file

send_file offers a file from the chat's machine to the chat owner only, and applies the device plugin's credential and secret rules at offer time and at read time, sending a secret file only when the owner's own message names it. Smart approval still raised a card for every call because send_file was not on the read-only tool list.

send_file joins READ_ONLY_TOOLS, so the provenance review and the hold skip it and its calls stay out of the review transcript. No other tool is added. A refusal by the tool's own secret rules is the tool's result, not an approval.
---
 tests/tools/test_smart_approval_send_file.py | 90 ++++++++++++++++++++
 tools/approval_automode.py                   |  2 +-
 2 files changed, 91 insertions(+), 1 deletion(-)
 create mode 100644 tests/tools/test_smart_approval_send_file.py

diff --git a/tests/tools/test_smart_approval_send_file.py b/tests/tools/test_smart_approval_send_file.py
new file mode 100644
index 0000000000..8dfe108f8b
--- /dev/null
+++ b/tests/tools/test_smart_approval_send_file.py
@@ -0,0 +1,90 @@
+"""send_file raises no smart approval card; its own secret rules stay the guard.
+
+Invariants:
+  1. send_file counts as a read-only call: it is never reviewed and never reaches the human.
+  2. Only send_file is added: other plugin tools, and writes, are still reviewed.
+  3. A secret path is not the approval's business: the call passes through to the tool, which refuses it.
+"""
+
+from __future__ import annotations
+
+import pytest
+
+from tools import approval as approval_module
+from tools import approval_automode as A
+from tools import approval_context
+
+
+@pytest.fixture()
+def reviewed(monkeypatch):
+    cfg = {"mode": "smart", "smart_provenance": True}
+    monkeypatch.setattr(approval_context, "_get_approval_config", lambda: cfg)
+    monkeypatch.setattr(approval_context, "_get_approval_mode", lambda: "smart")
+    monkeypatch.setattr(approval_module, "_YOLO_MODE_FROZEN", False)
+    monkeypatch.setenv("HERMES_EXEC_ASK", "1")
+    monkeypatch.setenv("HERMES_SESSION_KEY", "send-file-test")
+    monkeypatch.delenv("HERMES_CRON_SESSION", raising=False)
+    approval_module.clear_session("send-file-test")
+    calls, asked = [], []
+
+    def complete(stage, system, user, max_tokens):
+        calls.append(stage)
+        return "<block>yes</block>"
+
+    def human(*a, **k):
+        asked.append(k)
+        return {"approved": False, "message": "BLOCKED: denied by the user."}
+
+    A.set_complete_override(complete)
+    monkeypatch.setattr(approval_module, "_human_decision", human)
+    yield calls, asked
+    A.set_complete_override(None)
+
+
+@pytest.mark.parametrize("args", [
+    {"path": "build/report.pdf"},
+    {"path": "/home/u/Projects/app/out.tar.gz", "name": "app.tar.gz", "note": "the build"},
+    {"path": "/home/u/.ssh/id_ed25519"},
+    {"path": "/home/u/app/.env"},
+])
+def test_send_file_is_read_only_and_raises_no_card(reviewed, args):
+    calls, asked = reviewed
+    assert A.is_read_only_call("send_file", args)
+    assert approval_module.check_tool_provenance("send_file", args) is None
+    assert calls == [] and asked == []
+
+
+@pytest.mark.parametrize("name,args", [
+    ("agent_send", {"to": "parent", "text": "hi"}),
+    ("browser_click", {"ref": "e1"}),
+    ("browser_type", {"ref": "e1", "text": "x"}),
+    ("mcp_device_call", {"server": "s", "tool": "t"}),
+    ("send_message", {"target": "x", "message": "hi"}),
+    ("delegate_task", {"goal": "x"}),
+    ("send_file_to", {"path": "x"}),
+])
+def test_other_tools_are_still_reviewed(reviewed, name, args):
+    calls, asked = reviewed
+    assert not A.is_read_only_call(name, args)
+    approval_module.check_tool_provenance(name, args)
+    assert calls and asked
+
+
+def test_read_only_tool_set_gained_only_send_file():
+    assert A.READ_ONLY_TOOLS - {"send_file"} == frozenset({
+        "read_file", "search_files", "web_search", "web_extract", "session_search", "skill_view", "skills_list",
+        "vision_analyze", "browser_snapshot", "browser_vision", "browser_screenshot", "browser_status",
+        "browser_check", "browser_get_images", "browser_console", "clarify", "todo", "todo_list", "tool_search",
+        "tool_describe", "agent_peers", "mcp_device_servers", "mcp_device_tools", "text_to_speech",
+        "project_memory_read", "image_generate",
+    })
+    assert "send_file" in A.READ_ONLY_TOOLS
+
+
+def test_send_file_calls_stay_out_of_the_transcript():
+    import json
+    call = {"id": "t1", "function": {"name": "send_file", "arguments": json.dumps({"path": "a.txt"})}}
+    messages = [{"role": "user", "content": "send me the report"},
+                {"role": "assistant", "content": "", "tool_calls": [call]},
+                {"role": "tool", "tool_call_id": "t1", "content": "ok"}]
+    assert "send_file" not in A.transcript_lines(messages)
diff --git a/tools/approval_automode.py b/tools/approval_automode.py
index 97d623db37..cec9146ac9 100644
--- a/tools/approval_automode.py
+++ b/tools/approval_automode.py
@@ -62,7 +62,7 @@ READ_ONLY_TOOLS = frozenset({
     "vision_analyze", "browser_snapshot", "browser_vision", "browser_screenshot", "browser_status",
     "browser_check", "browser_get_images", "browser_console", "clarify", "todo", "todo_list", "tool_search",
     "tool_describe", "agent_peers", "mcp_device_servers", "mcp_device_tools", "text_to_speech",
-    "project_memory_read", "image_generate",
+    "project_memory_read", "image_generate", "send_file",
 })
 _READ_ONLY_ACTIONS = {
     "process": {"poll", "wait", "log", "list", "status"},
