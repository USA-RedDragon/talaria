+# How long a carried child's unit may take, after the child's run ended, to hold its result (``_Reached``).
+_RESULT_SETTLE_SECONDS = 5.0
+
+
+class _Reached:
+    """Set once a carried child stopped (its cleanup recorded its state) and its unit holds the result: the cleanup
+    runs before the unit's runner returns, so a child that finished in that gap would read as still running."""
+
+    def __init__(self, stopped: threading.Event, unit: Unit):
+        self.stopped, self.unit = stopped, unit
+
+    def is_set(self) -> bool:
+        return self.stopped.is_set() and self.unit.done.is_set()
+
+    def wait(self, timeout: Optional[float] = None) -> bool:
+        started = time.monotonic()
+        if not self.stopped.wait(timeout):
+            return False
+        left = _RESULT_SETTLE_SECONDS if timeout is None else max(0.0, timeout - (time.monotonic() - started))
+        return self.unit.done.wait(min(left, _RESULT_SETTLE_SECONDS)) or True
+
+
 def hand_off(agent: Any) -> list:
     """The subagent stops for a restart handoff: mark its running children as handed off (their tool state is kept for
     the next gateway) and return each unit's resume record. Finished but unread results ride along as kept entries."""
