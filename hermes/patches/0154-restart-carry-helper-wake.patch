+"""A background subagent waiting on its own helper across a per-turn restart (gateway.restart_turn_handoff_per_turn
+with delegation.restart_handoff): the real child loops of both, a scripted model.
+
+The subagent ended its turn to wait for its helper (0128); the restart carries the helper to its step boundary (0152)
+while the subagent's stop waits for it. A helper whose model call ends its run then (a final answer) finished
+normally: its result woke the subagent on the old gateway, which started a model call the stop then cut, and the
+helper's result was taken there, so the next gateway's subagent never read it. Now a subagent being handed off is not
+woken: the helper's result rides the handoff as a finished child and wakes the resumed subagent on the next gateway,
+once, in one model call. Also covered: the helper finishing just before the restart (the subagent's wake call runs
+to its end on the old gateway, which stops it at its next boundary) and just after the subagent's stop point (the
+helper is handed over unfinished and resumed there).
+"""
+import asyncio
+import json
+import os
+import threading
+import time
+from types import SimpleNamespace
+
+import pytest
+
+from agent import turn_boundary_handoff as boundary
+from gateway import turn_boundary, turn_carry, turn_handoff
+from gateway.run_shutdown import GatewayShutdownMixin
+from tests.agent.test_turn_boundary_handoff import _agent as _bare_agent
+from tests.agent.test_turn_boundary_handoff import _response
+from tests.gateway.test_restart_carry_subagent_command import _idle, _restart
+from tests.gateway.test_restart_turn_carry import _old_runner, _reserve_profile
+from tests.tools.test_delegate_resume_action import (  # the seams fixture
+    CHILD, PARENT, SID, _Parent, _call, _completions, _finished_child, _record, seams,
+)
+from tests.waiting import wait_until
+from tools import async_delegation as ad
+from tools import delegate_tool_handoff as handoff
+from tools.delegate_tool_registry import _active_subagents, _active_subagents_lock
+
+pytestmark = pytest.mark.platforms("linux")
+
+HELPER = "helper-0"
+HELPER_SID = "sa-1-help"
+RESULT = "zd-h1 the helper's finding"
+
+
+@pytest.fixture(autouse=True)
+def _clean(monkeypatch, tmp_path):
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path))
+    monkeypatch.setattr(turn_handoff, "_handing_off", False)
+    monkeypatch.setattr(turn_boundary, "_resuming", set())
+    monkeypatch.setattr(turn_boundary, "_handed_off", set())
+    monkeypatch.setattr(turn_carry, "_released", False)
+    monkeypatch.setattr(turn_carry, "_api_target", None)
+    monkeypatch.setattr(turn_carry, "_carrying", False)
+    monkeypatch.setattr("agent.title_generator.maybe_auto_title", lambda *a, **k: None)
+
+    async def noop(*_a, **_k):
+        return None
+    for name in ("_stop_cron", "_disconnect_messaging"):
+        monkeypatch.setattr(turn_carry, name, noop)
+    monkeypatch.setattr(GatewayShutdownMixin, "_stop_hand_off_processes", staticmethod(noop))
+    import tools.delegate_tool_config as config
+    monkeypatch.setattr(config, "_get_restart_handoff", lambda: True)
+    monkeypatch.setattr("tools.delegate_tool._get_max_spawn_depth", lambda: 3)
+    from tools.delegate_tool_routes import TaskRoute
+    creds = {"model": "qwen", "provider": None, "base_url": "http://ollama.example.com/v1", "api_key": None,
+             "api_mode": None}
+    monkeypatch.setattr("tools.delegate_tool._routes_for",
+                        lambda task_list, *_a: ([TaskRoute(creds=dict(creds), routing_cfg={})] * len(task_list), None))
+    ad._reset_for_tests()
+    yield
+    ad._reset_for_tests()
+    with _active_subagents_lock:
+        _active_subagents.clear()
+
+
+def _tool_call(name, args, call_id):
+    return SimpleNamespace(id=call_id, type="function",
+                           function=SimpleNamespace(name=name, arguments=json.dumps(args)))
+
+
+def _real(db, session_id, subagent_id, depth, parent, model_calls):
+    """A real agent: its own loop, its stored session, a scripted model."""
+    agent = _bare_agent(db, session_id)
+    agent.base_url = "http://ollama.example.com/v1"  # where the seams resolve the parent's endpoint again
+    agent._client_kwargs = {"api_key": "local", "base_url": agent.base_url}
+    for name, value in (("_delegate_restart_handoff", False), ("_delegate_live_writer", None),
+                        ("_live_transcript_path", None), ("_delegate_output_schema", None), ("_delegate_images", []),
+                        ("_subagent_id", subagent_id), ("model", "qwen"), ("_delegate_depth", depth),
+                        ("_parent_session_id", parent)):
+        setattr(agent, name, value)
+    script = list(model_calls)
+    agent.calls = []
+
+    def create(**kwargs):
+        agent.calls.append(kwargs)
+        return script.pop(0)(**kwargs)
+    agent.client.chat.completions.create.side_effect = create
+    agent.valid_tool_names = {"delegate_task"}
+    return agent
+
+
+def _helper(db, model_calls):
+    db.create_session(session_id=HELPER, source="subagent", parent_session_id=CHILD,
+                      model_config={"_delegate_from": CHILD, "_subagent_id": HELPER_SID})
+    helper = _real(db, HELPER, HELPER_SID, 2, CHILD, model_calls)
+    helper.valid_tool_names = set()
+    return helper
+
+
+def _sent_texts(calls):
+    """Each model call's newest user message."""
+    out = []
+    for call in calls:
+        users = [m for m in call["messages"] if m.get("role") == "user"]
+        out.append(str(users[-1].get("content")) if users else "")
+    return out
+
+
+class _Scene:
+    """The subagent (resumed with a new message) starts its helper in the background, ends its turn and waits."""
+
+    def __init__(self, db, seams, *, helper_calls, subagent_wake_calls):
+        self.db = db
+        self.helper_gate = threading.Event()
+        self.subagent = _real(db, CHILD, SID, 1, PARENT, [
+            lambda **_k: _response("", [_tool_call("delegate_task", {"goal": "find the bug", "background": True},
+                                                   "call_d1")]),
+            lambda **_k: _response("Waiting for my helper."),
+            *subagent_wake_calls,
+        ])
+        self.helper = _helper(db, helper_calls)
+        seams(self.subagent, self.helper)
+        handle = _call(_Parent(db), subagent_id=SID, message="find and fix the bug")
+        self.run_id = handle["run_id"]
+
+    def waiting(self):
+        with _active_subagents_lock:
+            return (_active_subagents.get(SID) or {}).get("status") == "waiting"
+
+
+def _record_with_cwd(tmp_path):
+    record = _record()
+    record[handoff.RESUME_STATE_KEY]["cwd"] = str(tmp_path)
+    return record
+
+
+async def _restart_and_close(runner):
+    try:
+        await asyncio.wait_for(_restart(runner), 30.0)
+    finally:
+        if getattr(runner, "_turn_carry", None) is not None and runner._turn_carry.lock_fd is not None:
+            os.close(runner._turn_carry.lock_fd)
+
+
+def _next_gateway(db, seams, model_calls):
+    """The next gateway adopts the handed-off subagent: a fresh agent rebuilt from its stored session."""
+    ad._reset_for_tests()
+    with _active_subagents_lock:
+        _active_subagents.clear()
+    resumed = _real(db, CHILD, SID, 1, PARENT, model_calls)
+    seams(resumed)
+    assert ad.adopt_handed_off_delegations(handoff._resume_unit) == 1
+    return resumed
+
+
+def _helper_results_read(calls):
+    return sum(text.count(RESULT) for text in _sent_texts(calls))
+
+
+@pytest.mark.live_system_guard_bypass
+@pytest.mark.asyncio
+@pytest.mark.parametrize("slow_stop", [False, True], ids=["stop", "slow-stop"])
+async def test_a_helper_that_finishes_during_the_carry_wakes_the_subagent_once_on_the_next_gateway(
+        owner, tmp_path, seams, monkeypatch, slow_stop):
+    from hermes_state_registry import acquire
+    db = acquire()
+    if slow_stop:  # the subagent's stop takes a while after its helper ended: room for a wake to win the race
+        state_of = handoff._child_state
+
+        def slow(child):
+            if getattr(child, "session_id", None) == CHILD:
+                time.sleep(1.5)
+            return state_of(child)
+        monkeypatch.setattr(handoff, "_child_state", slow)
+    _finished_child(db, record=_record_with_cwd(tmp_path))
+    gate = threading.Event()
+
+    def helper_call(**_kwargs):
+        assert gate.wait(20)
+        return _response(RESULT)
+
+    old_wake = []
+
+    def subagent_woken_here(**kwargs):
+        old_wake.append(kwargs)
+        time.sleep(0.5)  # a model call in flight when the stop comes
+        return _response("Fixed it with the helper's finding.")
+
+    scene = _Scene(db, seams, helper_calls=[helper_call], subagent_wake_calls=[subagent_woken_here])
+    await asyncio.to_thread(wait_until, lambda: scene.waiting() and scene.helper.calls, timeout=20,
+                            what="the subagent waits while its helper is in a model call")
+
+    _reserve_profile(tmp_path)
+    runner = _idle(_old_runner(owner, restart_turn_carry_ceiling_seconds=1080.0))
+    restart = asyncio.create_task(_restart_and_close(runner))
+    await asyncio.to_thread(wait_until, lambda: boundary.requested(scene.helper), timeout=20,
+                            what="the helper was asked to stop at its boundary")
+    gate.set()  # the helper's model call ends its run with a final answer, inside the carry
+    await restart
+
+    # Here: the helper ran once and the subagent made no model call the stop cut.
+    assert len(scene.helper.calls) == 1
+    assert old_wake == []
+    assert len(scene.subagent.calls) == 2
+    assert _completions(scene.run_id) == []
+    rows = scene.db.get_messages_as_conversation(CHILD)
+    assert not any(RESULT in str(r.get("content")) for r in rows)  # not read here
+
+    # The next gateway: the helper's result wakes the subagent once, in one model call; the helper is not run again.
+    resumed_calls = []
+
+    def resumed_model(**kwargs):
+        resumed_calls.append(kwargs)
+        return _response("Fixed it with the helper's finding.")
+    _next_gateway(db, seams, [resumed_model])
+    event = (await asyncio.to_thread(wait_until, lambda: _completions(scene.run_id), timeout=30,
+                                     what="the resumed subagent's result"))[0]
+    assert event["results"][0]["status"] == "completed"
+    assert len(resumed_calls) == 1
+    assert _helper_results_read(resumed_calls) == 1
+    assert len(scene.helper.calls) == 1
+    assert len(seams.built) == 3  # the subagent, its helper, the resumed subagent: no helper rebuilt to run again
+
+
+@pytest.mark.live_system_guard_bypass
+@pytest.mark.asyncio
+async def test_a_helper_that_finished_just_before_the_restart_lets_the_woken_call_end_here(owner, tmp_path, seams):
+    from hermes_state_registry import acquire
+    db = acquire()
+    _finished_child(db, record=_record_with_cwd(tmp_path))
+    in_call, release = threading.Event(), threading.Event()
+    old_wake = []
+
+    def subagent_woken_here(**kwargs):
+        old_wake.append(kwargs)
+        in_call.set()
+        assert release.wait(20)
+        return _response("Fixed it with the helper's finding.")
+
+    scene = _Scene(db, seams, helper_calls=[lambda **_k: _response(RESULT)],
+                   subagent_wake_calls=[subagent_woken_here])
+    await asyncio.to_thread(in_call.wait, 20)
+    assert in_call.is_set()
+
+    _reserve_profile(tmp_path)
+    runner = _idle(_old_runner(owner, restart_turn_carry_ceiling_seconds=1080.0))
+    restart = asyncio.create_task(_restart_and_close(runner))
+    await asyncio.to_thread(wait_until, lambda: boundary.requested(scene.subagent), timeout=20,
+                            what="the subagent was asked to stop at its boundary")
+    release.set()
+    await restart
+
+    # The woken call ran to its end here, once, with the helper's result; its answer ended the subagent's run, and
+    # that finished result rides the handoff: the next gateway delivers it without a model call or a helper run.
+    assert len(old_wake) == 1 and _helper_results_read(old_wake) == 1
+    assert len(scene.helper.calls) == 1
+    assert _completions(scene.run_id) == []
+    resumed_calls = []
+    _next_gateway(db, seams, [lambda **kw: resumed_calls.append(kw)])
+    event = (await asyncio.to_thread(wait_until, lambda: _completions(scene.run_id), timeout=30,
+                                     what="the subagent's result"))[0]
+    assert event["results"][0]["status"] == "completed"
+    assert "Fixed it with the helper's finding." in str(event["results"][0].get("summary"))
+    assert resumed_calls == [] and len(old_wake) == 1
+
+
+@pytest.mark.live_system_guard_bypass
+@pytest.mark.asyncio
+async def test_a_helper_still_running_at_the_subagents_stop_point_is_resumed_and_read_once(owner, tmp_path, seams):
+    from hermes_state_registry import acquire
+    db = acquire()
+    _finished_child(db, record=_record_with_cwd(tmp_path))
+    gate = threading.Event()
+
+    def helper_call(**_kwargs):
+        gate.wait(20)  # still in its model call when the boundary window of the carry ends
+        return _response("stale answer")
+
+    scene = _Scene(db, seams, helper_calls=[helper_call], subagent_wake_calls=[])
+    await asyncio.to_thread(wait_until, lambda: scene.waiting() and scene.helper.calls, timeout=20,
+                            what="the subagent waits while its helper is in a model call")
+
+    _reserve_profile(tmp_path)
+    # 62 s ceiling: the subagents get 2 s for their boundaries (turn_carry.SUBAGENT_STOP_RESERVE_S is 60).
+    runner = _idle(_old_runner(owner, restart_turn_carry_ceiling_seconds=62.0))
+    try:
+        await _restart_and_close(runner)
+    finally:
+        gate.set()  # the helper's call ends only after the subagent's stop point
+    await asyncio.sleep(1.0)
+    assert len(scene.subagent.calls) == 2
+    assert _completions(scene.run_id) == []
+
+    # The next gateway resumes the subagent, waiting, and its helper; the helper's result wakes it once.
+    resumed_calls = []
+
+    def resumed_model(**kwargs):
+        resumed_calls.append(kwargs)
+        return _response("Fixed it with the helper's finding.")
+    resumed_helper_calls = []
+
+    def resumed_helper(**kwargs):
+        resumed_helper_calls.append(kwargs)
+        return _response(RESULT)
+    ad._reset_for_tests()
+    with _active_subagents_lock:
+        _active_subagents.clear()
+    resumed = _real(db, CHILD, SID, 1, PARENT, [resumed_model])
+    helper_again = _real(db, HELPER, HELPER_SID, 2, CHILD, [resumed_helper])
+    helper_again.valid_tool_names = set()
+    seams(resumed, helper_again)
+    assert ad.adopt_handed_off_delegations(handoff._resume_unit) == 1
+    event = (await asyncio.to_thread(wait_until, lambda: _completions(scene.run_id), timeout=30,
+                                     what="the resumed subagent's result"))[0]
+    assert event["results"][0]["status"] == "completed"
+    assert len(resumed_helper_calls) == 1
+    assert len(resumed_calls) == 1 and _helper_results_read(resumed_calls) == 1
