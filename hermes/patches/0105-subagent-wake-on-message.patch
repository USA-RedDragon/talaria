index 00000000..398aa34c
--- /dev/null
+++ b/tests/tools/test_delegate_wait_wake.py
@@ -0,0 +1,167 @@
+"""A message or steer sent to a subagent that waits on its background job wakes it at once (patch 0105).
+
+Same seams as test_delegate_child_wait: real registries, fake child agents.
+"""
+
+import json
+import time
+
+from tests.tools.test_delegate_resume_action import (  # noqa: F401  (fixtures)
+    PARENT, SID, _Parent, _call, _clean_state, _completions, _db, _fake_child, _finished_child, seams,
+)
+from tests.waiting import wait_until
+from tools import delegate_tool_wait as wait
+from tools.delegate_tool_registry import (
+    _active_subagents, _active_subagents_lock, _handle_control_action, interrupt_subagent, steer_outcome,
+    steer_subagent,
+)
+from tools.process_registry import _handle_process, process_registry
+
+
+def _waiting_child(command):
+    """First round hands ``command`` off and ends its turn; every later round only records its input and ends again."""
+    child = _fake_child()
+    child._interrupt_requested = False
+    child.interrupt.side_effect = lambda *a, **k: setattr(child, "_interrupt_requested", True)
+    seen = {}
+
+    def converse(**kwargs):
+        child.conversations.append(kwargs)
+        if len(child.conversations) == 1:
+            session = process_registry.spawn_local(command, task_id=SID, owner_task_id=SID)
+            seen["session"] = session
+            json.loads(_handle_process({"action": "handoff", "session_id": session.id, "data": "job",
+                                        "resume_on_exit": True}, task_id=SID))
+        return {"final_response": "waiting", "completed": True, "interrupted": False, "api_calls": 1, "messages": []}
+
+    child.run_conversation.side_effect = converse
+    child.seen = seen
+    return child
+
+
+def _start(seams, command):
+    db = _db()
+    _finished_child(db)
+    child = _waiting_child(command)
+    seams(child)
+    handle = _call(_Parent(db), subagent_id=SID, message="go")
+    wait_until(lambda: any(r.get("status") == "waiting" for r in _active_subagents.values()), what="waiting")
+    return child, handle["run_id"]
+
+
+def _finish(child):
+    session = child.seen["session"]
+    if not session.exited:
+        process_registry.kill_process(session.id)
+
+
+def test_steer_to_a_waiting_child_wakes_it_once_and_keeps_the_watch(seams):
+    child, run_id = _start(seams, "sleep 60")
+    try:
+        assert steer_outcome(SID, "report where you are") == "woke"
+        wait_until(lambda: len(child.conversations) == 2, timeout=10, what="the wake-up round")
+        message = child.conversations[1]["user_message"]
+        assert "report where you are" in message
+        assert "sleep 60" in message and "still running" in message and "End your turn again" in message
+        # It goes back to waiting on the same job, which was never touched.
+        wait_until(lambda: any(r.get("status") == "waiting" for r in _active_subagents.values()), what="waiting again")
+        assert len(wait.waits_of(child)) == 1 and not child.seen["session"].exited
+        time.sleep(1.2)
+        assert len(child.conversations) == 2  # woken once
+        assert _completions(run_id) == []
+    finally:
+        _finish(child)
+        wait_until(lambda: _completions(run_id), timeout=30, what="completion")
+
+
+def test_two_steers_in_a_row_are_both_delivered_in_order(seams):
+    child, run_id = _start(seams, "sleep 60")
+    try:
+        assert steer_outcome(SID, "first") == "woke"
+        wait_until(lambda: len(child.conversations) == 2, timeout=10, what="round 2")
+        wait_until(lambda: any(r.get("status") == "waiting" for r in _active_subagents.values()), what="waiting again")
+        assert steer_outcome(SID, "second") == "woke"
+        wait_until(lambda: len(child.conversations) == 3, timeout=10, what="round 3")
+        assert "first" in child.conversations[1]["user_message"]
+        assert "second" in child.conversations[2]["user_message"]
+        assert "first" not in child.conversations[2]["user_message"]
+    finally:
+        _finish(child)
+        wait_until(lambda: _completions(run_id), timeout=30, what="completion")
+
+
+def test_steers_sent_together_are_read_in_order_in_one_wake(seams):
+    child, run_id = _start(seams, "sleep 60")
+    try:
+        with _active_subagents_lock:  # the child cannot leave the wait between the two
+            wait.wake(child, "alpha")
+            wait.wake(child, "beta")
+        wait_until(lambda: len(child.conversations) == 2, timeout=10, what="round 2")
+        message = child.conversations[1]["user_message"]
+        assert message.index("alpha") < message.index("beta")
+    finally:
+        _finish(child)
+        wait_until(lambda: _completions(run_id), timeout=30, what="completion")
+
+
+def test_a_message_after_the_job_ended_does_not_double_wake(seams):
+    child, run_id = _start(seams, "sleep 1; echo done")
+    wait_until(lambda: len(child.conversations) == 2, timeout=30, what="the exit wake-up")
+    wait_until(lambda: _completions(run_id), timeout=30, what="completion")
+    assert "exited with code 0" in child.conversations[1]["user_message"]
+    assert steer_outcome(SID, "too late") == ""  # nobody is waiting any more
+    time.sleep(1.0)
+    assert len(child.conversations) == 2
+
+
+def test_a_message_with_the_exit_is_one_wake(seams):
+    child, run_id = _start(seams, "sleep 60")
+    session = child.seen["session"]
+    process_registry.kill_process(session.id)
+    wait_until(lambda: session.exited, what="the job to be gone")
+    with _active_subagents_lock:  # the exit and the message reach the wait together
+        wait.wake(child, "note")
+    wait_until(lambda: len(child.conversations) == 2, timeout=10, what="round 2")
+    wait_until(lambda: _completions(run_id), timeout=30, what="completion")
+    message = child.conversations[1]["user_message"]
+    assert "note" in message and "exited" in message
+    time.sleep(1.0)
+    assert len(child.conversations) == 2
+
+
+def test_delegate_task_steer_says_it_woke_the_waiting_child(seams):
+    child, run_id = _start(seams, "sleep 60")
+    try:
+        out = json.loads(_handle_control_action("steer", SID, "hello?", _Parent(_db())))
+        assert out["status"] == "delivered" and "woke" in out["note"] and "queued" not in out["status"]
+        wait_until(lambda: len(child.conversations) == 2, timeout=10, what="round 2")
+        assert "hello?" in child.conversations[1]["user_message"]
+        assert steer_subagent(SID, "again") is True
+    finally:
+        _finish(child)
+        wait_until(lambda: _completions(run_id), timeout=30, what="completion")
+
+
+def test_an_agent_message_through_the_lifecycle_service_wakes_it_too(seams):
+    from agent.subagent_lifecycle import SubagentLifecycleService
+    child, run_id = _start(seams, "sleep 60")
+    try:
+        assert SubagentLifecycleService.steer_active(SID, "from a peer") is True
+        wait_until(lambda: len(child.conversations) == 2, timeout=10, what="round 2")
+        assert "from a peer" in child.conversations[1]["user_message"]
+    finally:
+        _finish(child)
+        wait_until(lambda: _completions(run_id), timeout=30, what="completion")
+
+
+def test_stop_on_a_waiting_child_stops_it_at_once(seams):
+    child, run_id = _start(seams, "sleep 60")
+    try:
+        started = time.time()
+        assert interrupt_subagent(SID) is True
+        wait_until(lambda: _completions(run_id), timeout=5, what="the stopped child's result")
+        assert time.time() - started < 3.0
+        assert not any(r.get("status") == "waiting" for r in _active_subagents.values())
+        assert len(child.conversations) == 1
+    finally:
+        _finish(child)
