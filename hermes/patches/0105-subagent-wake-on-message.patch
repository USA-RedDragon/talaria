+
+def steer_record_locked(record: dict[str, Any], text: str) -> str:
+    """Deliver ``text`` to the live agent of ``record`` (the caller holds ``_active_subagents_lock`` and has checked
+    ownership and ``accepting_steer``): ``"queued"``, ``"woke"`` for a child waiting on its job, or ``""``."""
+    agent = record.get("agent")
+    if agent is None:
+        return ""
+    if record.get("status") == "queued":  # not started: the text joins its goal when it starts
+        queued_steers = getattr(agent, "_queued_steers", None)
+        agent._queued_steers = [*(queued_steers if isinstance(queued_steers, list) else []), text]
+        return "queued"
+    if record.get("status") == "waiting":  # no tool result is coming: wake it with the text now
+        from tools.delegate_tool_wait import wake
+        return "woke" if wake(agent, text) else ""
+    try:
+        return "queued" if agent.steer(text) else ""
+    except Exception as exc:
+        logger.debug("steer of %s failed: %s", record.get("subagent_id"), exc)
+        return ""
 
