+def _todo_state(row):
+    """The ``todo_state`` wire shape (``{todos, revision}``) of a stored list, None when none is stored."""
+    if not row:
+        return None
+    return {'todos': list(row.get('todos') or []), 'revision': int(row.get('revision') or 0)}
+
+
+def todos_snapshot(authority, ref):
+    """``session.todos``: the session's stored todo list (tools/todo_durable.py), read from state.db, so
+    it answers with no live agent and after any number of compactions."""
+    target = physical_target(authority, ref)
+    target = authority.db.get_compression_tip(target) or target
+    return {'session_id': ref.session_id, 'todo_state': _todo_state(authority.db.get_session_todos(target))}
+
+
+def subagent_todos(authority, ref, records, subagent_id):
+    """``session.todos`` with ``subagent_id``: the list of one child of this session, running or
+    finished (a finished child's stored list stays readable)."""
+    record = next((r for r in records if r.get('subagent_id') == subagent_id), None)
+    child = getattr((record or {}).get('agent'), 'session_id', None)
+    if not (isinstance(child, str) and child):
+        from tools.delegate_tool_sessions import stored_child_session
+        from tools.delegate_tool_transcript import _compression_lineage
+        target = physical_target(authority, ref)
+        child = stored_child_session(authority.db, subagent_id,
+                                     _compression_lineage(authority.db, authority.db.get_compression_tip(target) or target))
+    if not child:
+        raise RuntimeStoreError('not_found')
+    state = _todo_state(authority.db.get_session_todos(child))
+    store = getattr((record or {}).get('agent'), '_todo_store', None)
+    if store is not None:
+        live = store.snapshot()
+        if (live['todos'] or live['revision']) and (state is None or live['revision'] > state['revision']):
+            state = {'todos': live['todos'], 'revision': live['revision']}
+    return {'session_id': ref.session_id, 'subagent_id': subagent_id, 'running': record is not None,
+            'todo_state': state}
+
+
+def watch_todos(authority):
+    """Publish ``todo.updated`` to a live session's viewers when its stored todo list changes outside
+    the session's own local turn: a subagent updating the items assigned to it, or a messaging
+    route's turn (a local turn already publishes it with its ``tool.complete``)."""
+    if getattr(authority, '_todo_listener', None) is not None:
+        return
+    import weakref
+    from types import SimpleNamespace
+    from tools import todo_durable
+    owner = weakref.ref(authority)
+
+    def listener(session_id, snapshot, origin):
+        current = owner()
+        if current is None:
+            todo_durable.remove_listener(listener)
+            return
+        from gateway.config import Platform
+        for sid, live in list(current.sessions.items()):
+            source = getattr(live, 'source', None)
+            if origin == 'own' and source is not None and source.platform == Platform.LOCAL:
+                continue
+            try:
+                target = physical_target(current, SimpleNamespace(session_id=sid))
+                if (current.db.get_compression_tip(target) or target) != session_id:
+                    continue
+                live.event_stream.publish(sid, {'todos': list(snapshot.get('todos') or []),
+                                                'revision': int(snapshot.get('revision') or 0)},
+                                          event_type='todo.updated')
+            except Exception:
+                continue
+
+    authority._todo_listener = listener
+    todo_durable.add_listener(listener)
 
 
 def subagent_tail(records, subagent_id):
