+def test_a_child_updates_its_assigned_items_and_the_parent_sees_it(db):
+    db.create_session("P", source="cli")
+    parent = _agent(db, "P")
+    _call(parent, todos=[{"id": "lane", "content": "port module", "status": "in_progress", "owner": "sa-1"},
+                         {"id": "other", "content": "someone else", "status": "pending", "owner": "sa-2"}])
+    child = _spawn(db, parent, "C", "sa-1")
+    seen = _call(child, list_name="parent")
+    assert seen["assigned_to_you"] == ["lane"]
+    done = _call(child, list_name="parent", todos=[{"id": "lane", "status": "completed", "notes": "commit abc123"},
+                                              {"id": "lane.1", "content": "follow-up", "status": "pending",
+                                               "parent": "lane"}])
+    assert "error" not in done
+    refused = _call(child, list_name="parent", todos=[{"id": "other", "status": "completed"}])
+    assert "not assigned to you" in refused["error"]
+    items = {i["id"]: i for i in _call(parent)["todos"]}
+    assert items["lane"]["status"] == "completed" and items["lane"]["notes"] == "commit abc123"
+    assert items["lane.1"]["owner"] == "sa-1" and items["other"]["status"] == "pending"
