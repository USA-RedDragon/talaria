+def test_a_master_plan_survives_many_compactions_restarts_and_subagents(db):
+    db.create_session("seg0", source="cli")
+    expected = {}
+    segment = "seg0"
+    for day in range(25):
+        handle = SessionDB(db_path=db.db_path)  # a gateway restart before every round
+        try:
+            parent = _agent(handle, segment)
+            phase = f"phase{day}"
+            batch = [{"id": phase, "content": f"phase {day}", "status": "pending"}]
+            for n in range(8):  # one lane per subagent
+                batch.append({"id": f"{phase}.{n}", "content": f"lane {n}", "status": "in_progress",
+                              "parent": phase, "owner": f"sa-{day}-{n}"})
+            assert "error" not in _call(parent, todos=batch, merge=True)
+            for n in range(8):
+                child = _spawn(handle, parent, f"child-{day}-{n}", f"sa-{day}-{n}")
+                status = "completed" if n % 3 else "blocked"
+                out = _call(child, list_name="parent", todos=[{"id": f"{phase}.{n}", "status": status,
+                                                         "notes": f"result {day}/{n}"}])
+                assert "error" not in out
+                expected[f"{phase}.{n}"] = status
+            expected[phase] = "pending"
+        finally:
+            handle.close()
+        nxt = f"seg{day + 1}"
+        _compact(db, segment, nxt)
+        segment = nxt
+    final = _agent(SessionDB(db_path=db.db_path), segment)
+    try:
+        items = {i["id"]: i for i in _call(final)["todos"]}
+        assert {k: v["status"] for k, v in items.items()} == expected
+        assert items["phase3.4"]["notes"] == "result 3/4"
+        text = final._todo_store.format_for_injection()
+        assert all(f"phase{d}.0." in text for d in range(25))  # every blocked lane is still in the handoff
+    finally:
+        final._session_db.close()
