+# (4) Subagents: own lists, the parent's view, assigned items.
+
+def _spawn(db, parent, child_sid, subagent_id):
+    db.create_session(child_sid, source="subagent", parent_session_id=parent.session_id,
+                      model_config={"_delegate_from": parent.session_id, "_subagent_id": subagent_id})
+    child = _agent(db, child_sid, _parent_session_id=parent.session_id, _subagent_id=subagent_id)
+    child._delegate_parent_ref = weakref.ref(parent)
+    return child
+
