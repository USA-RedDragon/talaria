+# (2) Durable storage in state.db, never the transcript.
+
+def test_a_fresh_agent_reads_the_stored_list(db):
+    db.create_session("s1", source="cli")
+    first = _agent(db, "s1")
+    out = _call(first, todos=[{"id": "a", "content": "plan", "status": "in_progress"}])
+    assert out["durable"] is True
+    # A restart: a new database handle and a new agent, no transcript at all.
+    reopened = SessionDB(db_path=db.db_path)
+    try:
+        fresh = _agent(reopened, "s1")
+        assert [i["id"] for i in _call(fresh)["todos"]] == ["a"]
+    finally:
+        reopened.close()
