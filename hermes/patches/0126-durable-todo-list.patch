+"""The todo list is a durable planning tool: always loaded, stored in state.db on every call, nested to
+any depth with notes and owners, shared between a parent and its subagents, carried through every
+compaction and restart, and readable over the gateway (tools/todo_durable.py, hermes_state_todo.py)."""
+
+import json
+import weakref
+from types import SimpleNamespace
+
+import pytest
+
+from hermes_state import SessionDB
+from tools.todo_tool import MAX_TODO_RESULT_CHARS, TODO_INJECTION_HEADER, TODO_SCHEMA, TodoStore, todo_tool
+
+
+@pytest.fixture
+def db(tmp_path):
+    with SessionDB(db_path=tmp_path / "state.db") as database:
+        yield database
+
+
+class _Agent(SimpleNamespace):
+    """A stand-in AIAgent (weak-referenceable, as the spawn tree's parent refs need)."""
+
+
+def _agent(db, session_id, **extra):
+    return _Agent(session_id=session_id, _session_db=db, _todo_store=TodoStore(), **extra)
+
+
+def _call(agent, **kwargs):
+    return json.loads(todo_tool(store=agent._todo_store, agent=agent, **kwargs))
+
+
+def _compact(db, old, new):
+    """One compaction: the old segment ends 'compression' and the new one continues it."""
+    db.create_session(new, source="cli", parent_session_id=old)
+    db.end_session(old, "compression")
+
+
+# (1) Always loaded, and the description says when to use it.
+
+def test_todo_list_is_not_deferred_by_default():
+    from hermes_cli.config_defaults import DEFAULT_CONFIG
+    from tools.tool_search import is_deferrable_tool_name
+
+    defer = frozenset(DEFAULT_CONFIG["tools"]["tool_search"]["defer"])
+    assert "todo_list" not in defer
+    assert not is_deferrable_tool_name("todo_list", defer, frozenset())
+
+
+def test_description_says_when_to_use_it_and_that_it_survives():
+    text = TODO_SCHEMA["description"]
+    for phrase in ("more than a few steps", "delegation plan", "'all N items'", "compaction", "restart"):
+        assert phrase in text
+    item = TODO_SCHEMA["parameters"]["properties"]["todos"]["items"]["properties"]
+    assert {"notes", "owner", "parent"} <= set(item)
+    assert "blocked" in item["status"]["enum"]
+
+
+def test_a_narrowed_subagent_keeps_the_todo_list():
+    from tools.delegate_tool_toolsets import _resolve_child_toolsets
+
+    parent = SimpleNamespace(enabled_toolsets=["hermes-cli"], disabled_toolsets=[])
+    enabled, _ = _resolve_child_toolsets(parent, ["terminal", "file"], "leaf")
+    assert "todo" in enabled
