diff --git a/tools/todo_durable.py b/tools/todo_durable.py
new file mode 100644
index 00000000..1e760fa6
--- /dev/null
+++ b/tools/todo_durable.py
@@ -0,0 +1,277 @@
+"""Durable todo lists: every write lands in state.db (``session_todos``) in one transaction.
+
+The agent's ``TodoStore`` is a cache of the stored list. A write loads the stored list inside the
+write transaction, applies the change and saves it, so a fresh AIAgent (the gateway builds one per
+message), a resumed or restarted chat, and a subagent that updates its parent's items all work on
+one list. A read loads the stored list when it is newer than the cache. Rows are keyed by session
+segment; a read walks the compression lineage back to the newest stored row, so the list follows a
+chat across every compaction (hermes_state_todo.py).
+
+Without a session database that stores lists (no ``_session_db``, a worker's runtime store), the
+store stays in memory as before, and transcript hydration is the only recovery.
+"""
+
+from __future__ import annotations
+
+import logging
+import threading
+from typing import Any, Callable, Optional
+
+logger = logging.getLogger(__name__)
+
+_lock = threading.RLock()
+_listeners: list[Callable[[str, dict[str, Any], str], None]] = []
+
+
+def add_listener(listener: Callable[[str, dict[str, Any], str], None]) -> None:
+    """Call ``listener(session_id, snapshot, origin)`` after every stored change. ``origin`` is ``own``
+    for the list owner's write and ``subagent`` for a child's update of its assigned items."""
+    with _lock:
+        if listener not in _listeners:
+            _listeners.append(listener)
+
+
+def remove_listener(listener: Callable[[str, dict[str, Any], str], None]) -> None:
+    with _lock:
+        if listener in _listeners:
+            _listeners.remove(listener)
+
+
+def _notify(session_id: str, snapshot: dict[str, Any], origin: str) -> None:
+    with _lock:
+        listeners = list(_listeners)
+    for listener in listeners:
+        try:
+            listener(session_id, snapshot, origin)
+        except Exception:
+            logger.debug("todo listener failed", exc_info=True)
+
+
+def session_db(agent: Any) -> Any:
+    """The agent's session database when it stores todo lists, else None."""
+    db = getattr(agent, "_session_db", None)
+    if db is None or not callable(getattr(db, "update_session_todos", None)):
+        return None
+    return db
+
+
+def _restore(store: Any, todos: Any, revision: Any) -> None:
+    try:
+        store.restore(todos if isinstance(todos, list) else [], revision=revision)
+    except ValueError:
+        logger.warning("stored todo list is invalid; keeping the one in memory")
+
+
+def sync(agent: Any, store: Any = None) -> bool:
+    """Load the stored list into the agent's store when it is at least as new. True when the list is
+    stored. A store ahead of the stored copy (a save that failed) is written back."""
+    store = store if store is not None else getattr(agent, "_todo_store", None)
+    db, sid = session_db(agent), str(getattr(agent, "session_id", "") or "")
+    if store is None or db is None or not sid:
+        return False
+    try:
+        row = db.get_session_todos(sid)
+    except Exception:
+        logger.debug("todo list read failed for %s", sid, exc_info=True)
+        return False
+    if row is None:
+        return False
+    with _lock:
+        if int(row.get("revision") or 0) >= int(store.snapshot().get("revision") or 0):
+            _restore(store, row.get("todos"), row.get("revision"))
+            return True
+    try:
+        transact(db, sid, store, lambda s: None)
+    except Exception:
+        logger.debug("todo list write-back failed for %s", sid, exc_info=True)
+    return True
+
+
+def transact(db: Any, session_id: str, store: Any, mutate: Callable[[Any], Any], *,
+             origin: str = "own") -> Any:
+    """Run ``mutate(store)`` on the stored list of *session_id* in one write transaction and save the
+    result. ``mutate`` may raise ValueError to reject the change (nothing is saved). Returns its
+    result."""
+    with _lock:
+        before_items, before_rev = store.read(), int(store.snapshot().get("revision") or 0)
+        saved: dict[str, Any] = {}
+
+        def apply(row: Optional[dict[str, Any]]):
+            # Start from the stored list when it is at least as new as the cache, else from the cache
+            # (also on a retried transaction, so a change never applies twice).
+            if row is not None and int(row.get("revision") or 0) >= before_rev:
+                _restore(store, row.get("todos"), row.get("revision"))
+            else:
+                _restore(store, before_items, before_rev)
+            start_rev = int(store.snapshot().get("revision") or 0)
+            result = mutate(store)
+            snap = store.snapshot()
+            changed = snap["revision"] != start_rev
+            if row is None:
+                save = bool(snap["todos"]) or changed
+            else:
+                # A new segment (after a compaction) gets its own copy, so later reads stop early.
+                save = changed or row.get("session_id") != session_id or snap["revision"] > int(row.get("revision") or 0)
+            saved["snapshot"] = snap if save else None
+            return result, (snap if save else None)
+
+        result = db.update_session_todos(session_id, apply)
+    if saved.get("snapshot") is not None:
+        _notify(session_id, saved["snapshot"], origin)
+    return result
+
+
+def write(agent: Any, store: Any, todos: list, merge: bool) -> tuple[list[dict[str, str]], bool]:
+    """``store.write(todos, merge)`` on the stored list. ``(items, durable)``; raises ValueError for an
+    invalid write. A failed save keeps the change in memory (the next call writes it back)."""
+    db, sid = session_db(agent), str(getattr(agent, "session_id", "") or "")
+    if db is None or not sid:
+        return store.write(todos, merge), False
+    done: dict[str, Any] = {}
+
+    def mutate(s):
+        done["items"] = s.write(todos, merge)
+        return done["items"]
+
+    try:
+        return transact(db, sid, store, mutate), True
+    except ValueError:
+        raise
+    except Exception:
+        logger.warning("todo list was not saved for %s", sid, exc_info=True)
+        if "items" in done:
+            return store.read(), False
+        return store.write(todos, merge), False
+
+
+def _payload(row: Optional[dict[str, Any]], **extra: Any) -> str:
+    from tools.todo_tool import result_json
+
+    todos = (row or {}).get("todos") or []
+    return result_json(todos, int((row or {}).get("revision") or 0), **extra)
+
+
+def _parent_ids(agent: Any) -> tuple[str, str]:
+    return (str(getattr(agent, "_parent_session_id", "") or ""), str(getattr(agent, "_subagent_id", "") or ""))
+
+
+def parent_list(agent: Any, todos: Optional[list]) -> str:
+    """``list='parent'``: read the parent agent's list, or update the items it assigned to this
+    subagent (owner = this subagent's id): their status and notes, and new subtasks under them."""
+    from tools.registry import tool_error
+    from tools.todo_tool import TodoStore
+
+    parent_sid, me = _parent_ids(agent)
+    db = session_db(agent)
+    if not parent_sid or not me:
+        return tool_error("list='parent' works only in a subagent: this agent has no parent agent.")
+    if db is None:
+        return tool_error("The parent's list is not readable here: no session database.")
+    if todos is None:
+        row = db.get_session_todos(parent_sid)
+        assigned = [i.get("id") for i in (row or {}).get("todos") or [] if i.get("owner") == me]
+        return _payload(row, list="parent", assigned_to_you=assigned, your_subagent_id=me)
+    try:
+        target = db.get_compression_tip(parent_sid) or parent_sid
+    except Exception:
+        target = parent_sid
+
+    def mutate(store):
+        items = {i["id"]: i for i in store.read()}
+        owned = {i for i, item in items.items() if item.get("owner") == me}
+
+        def under_owned(parent: str) -> bool:
+            seen = set()
+            while parent and parent not in seen:
+                if parent in owned:
+                    return True
+                seen.add(parent)
+                parent = (items.get(parent) or {}).get("parent", "")
+            return False
+
+        changes = []
+        for t in todos:
+            if not isinstance(t, dict) or not str(t.get("id", "")).strip():
+                raise ValueError("Each item needs an id.")
+            item_id = str(t["id"]).strip()
+            if item_id in items:
+                if item_id not in owned:
+                    raise ValueError(f"Item '{item_id}' of your parent's list is not assigned to you "
+                                     f"(its owner is not {me}). You may update only your own items.")
+                extra = set(t) - {"id", "status", "notes"}
+                if extra:
+                    raise ValueError(f"On your parent's items you may change only status and notes, not "
+                                     f"{', '.join(sorted(extra))}.")
+                changes.append({k: t[k] for k in ("id", "status", "notes") if k in t})
+            else:
+                parent = str(t.get("parent") or "").strip()
+                if not under_owned(parent):
+                    raise ValueError(f"New item '{item_id}' must have parent set to an item assigned to you.")
+                changes.append({**{k: t[k] for k in ("id", "content", "status", "notes") if k in t},
+                                "parent": parent, "owner": me})
+        return store.write(changes, merge=True)
+
+    try:
+        items = transact(db, target, TodoStore(), mutate, origin="subagent")
+    except ValueError as e:
+        return tool_error(str(e))
+    row = db.get_session_todos(target)
+    return _payload(row or {"todos": items}, list="parent",
+                    assigned_to_you=[i.get("id") for i in items if i.get("owner") == me], your_subagent_id=me)
+
+
+def _child_session(agent: Any, subagent_id: str) -> tuple[Optional[str], Optional[dict[str, Any]]]:
+    """``(stored session id, live record)`` of a child in this agent's spawn tree."""
+    from tools.delegate_tool_transcript import _compression_lineage, _owned_records
+
+    record = next((r for r in _owned_records(agent) if r.get("subagent_id") == subagent_id), None)
+    child = getattr((record or {}).get("agent"), "session_id", None)
+    if isinstance(child, str) and child:
+        return child, record
+    db, parent_sid = getattr(agent, "_session_db", None), str(getattr(agent, "session_id", "") or "")
+    if db is None or not parent_sid:
+        return None, record
+    from tools.delegate_tool_sessions import stored_child_session
+    try:
+        return stored_child_session(db, subagent_id, _compression_lineage(db, parent_sid)), record
+    except Exception:
+        logger.debug("stored child lookup failed for %s", subagent_id, exc_info=True)
+        return None, record
+
+
+def read_subagent_list(agent: Any, subagent_id: str) -> str:
+    """The todo list of one child (running or finished) of this agent's spawn tree."""
+    from tools.registry import tool_error
+
+    if agent is None or not subagent_id:
+        return tool_error("subagent_id needs a subagent of this conversation.")
+    try:
+        child, record = _child_session(agent, subagent_id)
+    except Exception as exc:
+        return tool_error(f"Could not look up subagent '{subagent_id}': {exc}")
+    if not child and record is None:
+        return tool_error(f"No subagent '{subagent_id}' in this conversation's spawn tree.")
+    db = session_db(agent)
+    row = None
+    if db is not None and child:
+        try:
+            row = db.get_session_todos(child)
+        except Exception:
+            row = None
+    store = getattr((record or {}).get("agent"), "_todo_store", None)
+    if store is not None and (row is None or store.snapshot()["revision"] > int(row.get("revision") or 0)):
+        row = store.snapshot()
+    status = (record or {}).get("status") or "running" if record is not None else "finished"
+    return _payload(row, subagent_id=subagent_id, subagent_status=status)
+
+
+def brief(agent: Any) -> Optional[dict[str, Any]]:
+    """A running child's current item(s) and counts, for its parent's ``delegate_task(action='list')``."""
+    store = getattr(agent, "_todo_store", None)
+    brief_fn = getattr(store, "brief", None)
+    if not callable(brief_fn):
+        return None
+    try:
+        return brief_fn()
+    except Exception:
+        return None
