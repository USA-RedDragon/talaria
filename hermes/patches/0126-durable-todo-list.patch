+    def _todo_lineage_back(self, session_id: str) -> list[str]:
+        """*session_id*, then each segment it continues by compression, newest first."""
+        ids, seen = [session_id], {session_id}
+        row = self.get_session(session_id)
+        while row and len(ids) < _TODO_LINEAGE_LIMIT and self._is_compression_child_row(row):
+            parent = row["parent_session_id"]
+            if parent in seen:
+                break
+            seen.add(parent)
+            ids.append(parent)
+            row = self.get_session(parent)
+        return ids
+
+    @staticmethod
+    def _todo_row_dict(row) -> Optional[dict[str, Any]]:
