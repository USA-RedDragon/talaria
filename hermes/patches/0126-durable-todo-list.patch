+    def update_session_todos(self, session_id: str, fn) -> Any:
+        """Read-modify-write the list of *session_id* in one write transaction. ``fn(row)`` gets the
+        stored list (``get_session_todos`` shape, or None) and returns ``(result, snapshot)``; a
+        snapshot ``{todos, revision}`` is stored under *session_id*, None stores nothing. Returns
+        ``result``. An exception from ``fn`` rolls back."""
