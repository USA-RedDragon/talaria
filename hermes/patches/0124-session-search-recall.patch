@@ -0,0 +1,151 @@
+"""session_search recall: a chat finds its own finished subagents' work, and a long query whose
+words are spread across messages is not empty."""
+import json
+import time
+
+import pytest
+
+from hermes_state import SessionDB
+from tools.session_search_tool import session_search
+
+
+@pytest.fixture
+def db(tmp_path):
+    return SessionDB(tmp_path / "state.db")
+
+
+def _search(db, query, current="parent", **kw):
+    return json.loads(session_search(query=query, db=db, current_session_id=current, **kw))
+
+
+def _child(db, sid, parent, text, *, end=None, source="subagent"):
+    db.create_session(sid, source=source, parent_session_id=parent)
+    db.append_message(sid, role="user", content=f"task for {sid}")
+    db.append_message(sid, role="assistant", content=text)
+    if end:
+        db.end_session(sid, end)
+
+
+def _parent_with_compacted_history(db):
+    db.create_session("parent", source="local")
+    db.append_message("parent", role="user", content="old plan: adrenotools driver zebra notes")
+    db.append_message("parent", role="assistant", content="old answer about adrenotools driver zebra")
+    db.archive_and_compact("parent", [
+        {"role": "user", "content": "Summary of earlier work"},
+        {"role": "assistant", "content": "Acknowledged"},
+    ])
+    db.append_message("parent", role="user", content="live message about quokka routing")
+
+
+class TestFinishedSubagents:
+    def test_finished_child_found_from_parent(self, db):
+        _parent_with_compacted_history(db)
+        _child(db, "kid", "parent", "turnip findings: the vulkan icd needs patching", end="agent_close")
+        res = _search(db, "turnip vulkan")
+        assert [r["session_id"] for r in res["results"]] == ["kid"]
+        assert res["results"][0]["parent_session_id"] == "parent"
+        assert res["results"][0]["subagent"] is True
+
+    def test_grandchild_and_sibling_see_finished_child(self, db):
+        db.create_session("parent", source="local")
+        db.append_message("parent", role="user", content="hello")
+        _child(db, "kid", "parent", "ibuprofen cadence analysis", end="agent_close")
+        _child(db, "grand", "kid", "grandchild found mandrake ledger", end="agent_close")
+        db.create_session("sib", source="subagent", parent_session_id="parent")
+        db.append_message("sib", role="user", content="sibling task")
+        assert [r["session_id"] for r in _search(db, "mandrake ledger", current="sib")["results"]] == ["grand"]
+        assert [r["session_id"] for r in _search(db, "ibuprofen cadence", current="sib")["results"]] == ["kid"]
+
+    @pytest.mark.parametrize("reason", ["agent_close", "gateway_restart", "shutdown", "session_reset"])
+    def test_any_end_reason_means_finished(self, db, reason):
+        db.create_session("parent", source="local")
+        db.append_message("parent", role="user", content="hello")
+        _child(db, "kid", "parent", "pelican manifest results", end=reason)
+        assert [r["session_id"] for r in _search(db, "pelican manifest")["results"]] == ["kid"]
+
+    def test_running_child_stays_hidden(self, db):
+        db.create_session("parent", source="local")
+        db.append_message("parent", role="user", content="hello")
+        _child(db, "kid", "parent", "walrus telemetry draft")
+        res = _search(db, "walrus telemetry")
+        assert res["count"] == 0
+        assert res["skipped_live_context"] == 1
+        assert "live context" in res["message"]
+
+    def test_unended_child_with_no_recent_writes_is_finished(self, db):
+        db.create_session("parent", source="local")
+        db.append_message("parent", role="user", content="hello")
+        _child(db, "kid", "parent", "heron schema review")
+        old = time.time() - 7200
+        db._execute_write(lambda c: c.execute("UPDATE messages SET timestamp = ? WHERE session_id = 'kid'", (old,)))
+        assert [r["session_id"] for r in _search(db, "heron schema")["results"]] == ["kid"]
+
+    def test_current_active_rows_stay_hidden_with_a_reason(self, db):
+        _parent_with_compacted_history(db)
+        res = _search(db, "quokka routing")
+        assert res["count"] == 0
+        assert res["skipped_live_context"] == 1
+        assert "live context" in res["message"]
+
+    def test_other_chats_subagents_stay_hidden(self, db):
+        db.create_session("parent", source="local")
+        db.append_message("parent", role="user", content="hello")
+        db.create_session("other", source="local")
+        db.append_message("other", role="user", content="hi")
+        _child(db, "okid", "other", "falcon dossier contents", end="agent_close")
+        assert _search(db, "falcon dossier")["count"] == 0
+
+    def test_no_current_session_hides_subagents(self, db):
+        db.create_session("parent", source="local")
+        _child(db, "kid", "parent", "badger registry notes", end="agent_close")
+        assert json.loads(session_search(query="badger registry", db=db))["count"] == 0
+
+    def test_compacted_rows_of_current_chat_found(self, db):
+        _parent_with_compacted_history(db)
+        res = _search(db, "adrenotools zebra")
+        assert [r["session_id"] for r in res["results"]] == ["parent"]
+
+
+class TestLongQueries:
+    def _seed(self, db):
+        db.create_session("a", source="local")
+        db.append_message("a", role="user", content="Thor save editor and Turnip drivers")
+        db.create_session("b", source="local")
+        db.append_message("b", role="user", content="adrenotools gpu_driver packaging for the zebra title screen")
+        db.create_session("c", source="local")
+        db.append_message("c", role="user", content="Re:Zero walkthrough")
+        db.create_session("cur", source="local")
+        db.append_message("cur", role="user", content="unrelated")
+
+    def test_words_spread_across_messages_fall_back_to_any_word(self, db):
+        self._seed(db)
+        res = _search(db, "Thor Re:Zero title screen Turnip adrenotools gpu_driver", current="cur")
+        assert res["count"] >= 2
+        assert {r["session_id"] for r in res["results"]} >= {"a", "b"}
+        assert res["match_mode"] == "all_terms_then_any_terms" or res["match_mode"] == "any_terms"
+        assert all(r["match"] == "any_terms" for r in res["results"])
+        assert "ANY of its words" in res["match_note"]
+
+    def test_exact_hits_come_first_and_are_labeled(self, db):
+        self._seed(db)
+        db.create_session("full", source="local")
+        db.append_message("full", role="user", content="Turnip adrenotools driver walkthrough")
+        res = _search(db, "Turnip adrenotools", current="cur")
+        modes = [r["match"] for r in res["results"]]
+        assert modes[0] == "all_terms"
+        res = _search(db, "Turnip adrenotools walkthrough", current="cur")
+        assert res["results"][0]["session_id"] == "full"
+        assert res["results"][0]["match"] == "all_terms"
+        assert res["match_mode"] == "all_terms_then_any_terms"
+
+    def test_all_terms_mode_reported_when_enough_match(self, db):
+        db.create_session("one", source="local")
+        db.append_message("one", role="user", content="solo gryphon query")
+        res = _search(db, "gryphon query", current="cur")
+        assert res["match_mode"] == "all_terms"
+        assert "match_note" not in res
+
+    def test_explicit_operators_are_not_relaxed(self, db):
+        self._seed(db)
+        res = _search(db, "Thor AND adrenotools", current="cur")
+        assert res["count"] == 0
