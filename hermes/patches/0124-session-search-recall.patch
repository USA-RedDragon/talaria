     return bool(a_root and a_root == _resolve_lineage(db, b))
 
 
+def _delegation_child_finished(db, session_id: str, meta: dict[str, Any]) -> bool:
+    """True for a ``delegate_task`` child whose run is over, so its transcript is not in any live
+    context (the parent only received its summary). Finished = the row has an end stamp (any
+    reason, e.g. ``agent_close`` or a restart's), or has none but nothing was written for
+    ``_RUNNING_CHILD_STALE_SECONDS`` (the run died with its gateway). A running child stays live."""
+    if meta.get("source") != _SUBAGENT_SOURCE:
+        return False
+    if meta.get("ended_at") or meta.get("end_reason"):
+        return True
+
+    def _last_write():
+        with db._lock:
+            row = db._conn.execute("SELECT MAX(timestamp) FROM messages WHERE session_id = ?", (session_id,)).fetchone()
+        return row[0] if row else None
+    last = _coerce_started_ts(_quiet(_last_write, None, "last-write lookup failed for %s", session_id))
+    last = last if last is not None else _coerce_started_ts(meta.get("started_at"))
+    return last is not None and time.time() - last > _RUNNING_CHILD_STALE_SECONDS
+
+
 def _session_left_live_context(db, session_id: str) -> bool:
     """True when the transcript left everyone's live context: ``compression``
-    (summarised into the child) or a fresh reset (child starts empty). Live delegation
-    children (``end_reason is None``) and ``branched`` parents (copied verbatim into
-    the branch) ARE the current context, so they stay excluded from recall."""
-    end_reason = (session_id and _get_session_meta(db, session_id).get("end_reason")) or None
-    return end_reason == "compression" or end_reason in _FRESH_RESET_END_REASONS
+    (summarised into the child), a fresh reset (child starts empty), or a finished
+    delegation child (the parent kept only its summary). Running delegation children
+    and ``branched`` parents (copied verbatim into the branch) ARE the current
+    context, so they stay excluded from recall."""
+    meta = _get_session_meta(db, session_id) if session_id else {}
+    end_reason = meta.get("end_reason") or None
+    if end_reason == "compression" or end_reason in _FRESH_RESET_END_REASONS:
+        return True
+    return _delegation_child_finished(db, session_id, meta)
 
 
