diff --git a/tools/approval_automode.py b/tools/approval_automode.py
index 62acd351da..3bfa7edea0 100644
--- a/tools/approval_automode.py
+++ b/tools/approval_automode.py
@@ -1078,6 +1078,8 @@ If the action should be blocked:
 If the action should be allowed:
 <block>no</block>
 
+The reason is read by the user as plain words. Say what the action does and why the rule applies. Name an earlier action by what it did (such as "an earlier kill like this one was blocked"), never by a transcript id or call number.
+
 The category is the matching BLOCK rule's exact name. An ALLOW exception name is never a category: if an exception covers the action, answer <block>no</block>. If you cannot name a BLOCK rule the action matches, answer <block>no</block>. If several match, name the most severe (HARD first).
 """
 
@@ -1132,6 +1134,22 @@ def user_prompt(review: ReviewInput) -> str:
 
 # --- verdict ----------------------------------------------------------------------------------------------
 
+_CALL_ID = r"(?:c\d+|call_[A-Za-z0-9]+|toolu_[A-Za-z0-9]+)"
+_CALL_IDS = rf"{_CALL_ID}(?:\s*(?:,|and|&)\s*{_CALL_ID})*"
+_CALL_ID_PAREN = re.compile(rf"\s*[(\[](?:(?:call|calls|id|ids|entry)\s+)?{_CALL_IDS}[)\]]", re.I)
+_CALL_ID_WORD = re.compile(rf"\s*\b(?:(?:calls?|ids?)\s+)?{_CALL_IDS}\b", re.I)
+
+
+def plain_reason(text: str) -> str:
+    """The checker's words for the card without internal transcript ids such as ``c56``: the judge sees its
+    tool calls by id, and a user cannot look one up. ``an earlier kill call (c56) was blocked`` reads
+    ``an earlier kill call was blocked``."""
+    out = _CALL_ID_PAREN.sub("", text or "")
+    out = _CALL_ID_WORD.sub("", out)
+    out = re.sub(r"[ \t]{2,}", " ", out)
+    return "\n".join(line.strip() for line in out.split("\n")).strip()
+
+
 @dataclass
 class Verdict:
     decision: str                 # "allow" | "block" | "unsure"
@@ -1151,9 +1169,20 @@ class Verdict:
                     "Approve or deny it yourself.")
         if self.decision == "unsure":
             return f"Smart approval could not decide ({self.reason or 'no valid answer from the review model'})"
-        reason = self.reason.strip()
+        reason = plain_reason(self.reason)
         return f"Smart approval rule \"{self.rule}\": {reason}" if reason else f"Smart approval rule \"{self.rule}\""
 
+    @property
+    def card_parts(self) -> dict:
+        """The card's text as separate fields, so a client shows each on its own line: ``rule`` (the rule
+        name; absent when no rule blocked) and ``reason`` (the checker's words, without call ids)."""
+        if self.decision == "unsure":
+            why = self.card_text
+            why = why[len("Smart approval "):] if why.startswith("Smart approval ") else why
+            return {"reason": why[:1].upper() + why[1:]}
+        reason = plain_reason(self.reason)
+        return {"rule": self.rule, **({"reason": reason} if reason else {})}
+
 
 _THINK_RE = re.compile(r"<think(?:ing)?>.*?</think(?:ing)?>", re.S | re.I)
 
@@ -1207,7 +1236,7 @@ def parse_stage2(text: str) -> Verdict:
         return Verdict("unsure", reason="the review model blocked without naming a known rule", stage=2)
     name, tier = known
     why = re.sub(r"^\s*\[[^\]]*\]\s*", "", reason[-1]).strip() if reason else ""
-    why = " ".join(why.split())[:300]
+    why = plain_reason(" ".join(why.split())[:300])
     return Verdict("block", rule=name, reason=why, tier=tier, stage=2)
 
 
