diff --git a/tests/tools/test_smart_approval_card_parts.py b/tests/tools/test_smart_approval_card_parts.py
new file mode 100644
index 0000000000..a2f6a6ba1e
--- /dev/null
+++ b/tests/tools/test_smart_approval_card_parts.py
@@ -0,0 +1,175 @@
+"""Smart approval cards carry their text as separate fields, and no internal call id reaches the user.
+
+Invariants:
+  1. The prompt event of a smart approval card has ``rule`` and ``reason`` as fields of their own, next to the
+     single ``description`` older clients still read; a subagent's goal is its own ``subagent`` field and a
+     source the card can allow is ``grant_source``.
+  2. The checker's reason never carries a transcript call id such as ``c56`` (judge prompt asks for plain words;
+     the card text strips any that are left).
+  3. A ledger write's entry and source lines follow the reason as further lines of ``reason``.
+  4. The pending prompt a client reads (``PendingControls``) keeps the fields.
+"""
+
+from __future__ import annotations
+
+import re
+import threading
+import time
+
+import pytest
+
+from agent.delegation_context import delegated_child_context
+from tools import approval as approval_mod
+from tools import approval_automode as A
+
+KEY = "card-parts-session"
+REASON = ("The kill call names no session_id, so it cannot be shown to target a process this agent started, "
+          "and an earlier similar kill call (c56) was blocked.")
+
+
+@pytest.fixture()
+def gateway(monkeypatch, tmp_path):
+    cards = []
+    monkeypatch.setattr(approval_mod, "get_current_session_key", lambda default="": KEY)
+    monkeypatch.setattr(A, "_cwd", lambda: str(tmp_path))
+    monkeypatch.setattr(A, "_current_agent", lambda: None)
+    monkeypatch.setattr(A.HeldReview, "INTERVAL", 0.0)
+    approval_mod.register_gateway_notify(KEY, cards.append)
+    yield cards
+    approval_mod.unregister_gateway_notify(KEY)
+
+
+def _ask(monkeypatch, verdict, goal=None, tool="process_manage", args=None):
+    monkeypatch.setattr(A, "review", lambda *a, **k: verdict)
+    args = args or {"action": "kill"}
+    holder = {}
+
+    def run():
+        def decide():
+            holder["result"] = approval_mod._provenance_decision(
+                approval_mod._ACTION_GATE, tool, args, command=f"<{tool}> {args}", approval_callback=None,
+                is_cli=False, is_gateway=True, is_ask=False)
+        if goal is None:
+            decide()
+        else:
+            with delegated_child_context("child-session", goal):
+                decide()
+
+    worker = threading.Thread(target=run, daemon=True)
+    worker.start()
+    return worker, holder
+
+
+def _card(cards, limit=10.0):
+    end = time.monotonic() + limit
+    while not cards and time.monotonic() < end:
+        time.sleep(0.02)
+    assert cards, "no approval card was raised"
+    return cards[0]
+
+
+def _finish(worker, card):
+    approval_mod.resolve_gateway_approval(KEY, "deny", request_id=card["request_id"])
+    worker.join(10)
+
+
+def test_the_card_event_carries_rule_and_reason_as_fields(gateway, monkeypatch):
+    verdict = A.Verdict("block", rule="Interfere With Workloads", reason=REASON, tier="soft", stage=2)
+    worker, _ = _ask(monkeypatch, verdict)
+    card = _card(gateway)
+    try:
+        assert card["rule"] == "Interfere With Workloads"
+        assert card["reason"].startswith("The kill call names no session_id")
+        assert card["reason"].endswith("an earlier similar kill call was blocked.")
+        assert not re.search(r"\bc\d+\b", card["reason"] + card["description"])
+        # older clients read the one string
+        assert card["description"].startswith('Smart approval rule "Interfere With Workloads": ')
+        assert "subagent" not in card
+    finally:
+        _finish(worker, card)
+
+
+def test_a_subagent_card_names_the_goal_once_as_a_field(gateway, monkeypatch):
+    verdict = A.Verdict("block", rule="Interfere With Workloads", reason=REASON, tier="soft", stage=2)
+    worker, _ = _ask(monkeypatch, verdict, goal="Analyze the chat-view jump and fix it")
+    card = _card(gateway)
+    try:
+        assert card["subagent"] == "Analyze the chat-view jump and fix it"
+        assert card["rule"] == "Interfere With Workloads" and "c56" not in card["reason"]
+        assert card["description"].startswith('Subagent "Analyze the chat-view jump and fix it" asks: ')
+    finally:
+        _finish(worker, card)
+
+
+def test_a_card_that_offers_a_source_names_it_as_a_field(gateway, monkeypatch):
+    monkeypatch.setattr(A, "grant_chat", lambda agent: ("sid", object(), "root"))
+    verdict = A.Verdict("block", rule="Code from External", reason="Downloads an AppImage and runs it.",
+                        tier="soft", stage=2, detail={"grant_sources": ["github.com/AppImage/appimagetool"]})
+    worker, _ = _ask(monkeypatch, verdict, tool="terminal", args={"command": "curl -O x && ./x"})
+    card = _card(gateway)
+    try:
+        assert card["grant_source"] == "github.com/AppImage/appimagetool"
+        assert card["rule"] == "Code from External" and card["reason"] == "Downloads an AppImage and runs it."
+    finally:
+        _finish(worker, card)
+
+
+def test_an_unsure_card_has_a_reason_and_no_rule(gateway, monkeypatch):
+    verdict = A.Verdict("unsure", reason="the review model's answer had no verdict", stage=2)
+    worker, _ = _ask(monkeypatch, verdict)
+    card = _card(gateway)
+    try:
+        assert "rule" not in card
+        assert card["reason"] == "Could not decide (the review model's answer had no verdict)"
+    finally:
+        _finish(worker, card)
+
+
+def test_a_ledger_write_adds_its_entry_and_source_lines_to_the_reason(gateway, monkeypatch):
+    monkeypatch.setattr(A, "card_context", lambda tool, args, agent=None: "It closes ledger entry L1 (open).\n"
+                                                                         "Nothing you said matches.")
+    verdict = A.Verdict("block", rule="Self-Modification", reason="Records an approval the user did not give.",
+                        tier="soft", stage=2)
+    worker, _ = _ask(monkeypatch, verdict, tool="ledger", args={"action": "close", "id": "L1"})
+    card = _card(gateway)
+    try:
+        assert card["reason"].split("\n") == ["Records an approval the user did not give.",
+                                              "It closes ledger entry L1 (open).", "Nothing you said matches."]
+    finally:
+        _finish(worker, card)
+
+
+@pytest.mark.parametrize("text, want", [
+    ("an earlier similar kill call (c56) was blocked.", "an earlier similar kill call was blocked."),
+    ("it repeats c72 and c73, which were blocked", "it repeats, which were blocked"),
+    ("the kill (call c56) and (c57, c58) were blocked", "the kill and were blocked"),
+    ("Runs a saved copy of the command blocked in c9.", "Runs a saved copy of the command blocked in."),
+    ("Nothing to strip here, version c3po stays.", "Nothing to strip here, version c3po stays."),
+])
+def test_call_ids_are_stripped_from_the_reason(text, want):
+    assert A.plain_reason(text) == want
+
+
+def test_the_judge_prompt_asks_for_plain_words_without_ids():
+    prompt = A.system_prompt(2)
+    assert "never by a transcript id or call number" in prompt
+
+
+def test_the_pending_prompt_a_client_reads_keeps_the_fields():
+    from gateway.session_pending_controls import PendingControls
+
+    class _Events:
+        lock = threading.RLock()
+
+        def publish(self, *a, **k):
+            pass
+
+    controls = PendingControls(_Events())
+    controls.register("s", object(), 1, {"request_id": "r1", "command": "c", "description": "old text",
+                                         "rule": "Code from External", "reason": "Line one\nLine two",
+                                         "subagent": "the goal", "smart_denied": True})
+    prompt = controls.pending["r1"][1]
+    assert prompt["rule"] == "Code from External" and prompt["reason"] == "Line one\nLine two"
+    assert prompt["subagent"] == "the goal" and prompt["description"] == "old text"
+    controls.register("s", object(), 1, {"request_id": "r2", "command": "c", "description": "old text"})
+    assert "rule" not in controls.pending["r2"][1] and "reason" not in controls.pending["r2"][1]
