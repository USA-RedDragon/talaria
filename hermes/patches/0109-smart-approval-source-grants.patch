@@ -0,0 +1,149 @@
+"""The ``source`` approval choice (\"Allow code from <source> in this chat\") on button surfaces.
+
+Smart approval offers it on a Code from External card. An adapter whose cards and callbacks carry it
+(``_EA_SOURCE_BUTTON``, Telegram) renders it as its own button row; every other adapter keeps once / session /
+always / deny. A press resolves the card with the ``source`` choice.
+"""
+
+from types import SimpleNamespace
+from typing import Any
+from unittest.mock import AsyncMock, MagicMock
+
+import pytest
+
+from gateway.config import Platform, PlatformConfig
+from gateway.platforms.base import BasePlatformAdapter, ExecApprovalPrompt, SendResult
+from plugins.platforms.telegram.adapter import TelegramAdapter
+
+SOURCE = "github.com/AppImage/appimagetool"
+LABEL = f"Allow code from {SOURCE} in this chat"
+
+
+class _Buttons(BasePlatformAdapter):
+    def __init__(self):
+        super().__init__(PlatformConfig(enabled=True), Platform.TELEGRAM)
+        self.prompts: list = []
+
+    async def connect(self, *, is_reconnect: bool = False) -> bool:
+        return True
+
+    async def disconnect(self) -> None:
+        pass
+
+    async def send(self, *a: Any, **k: Any) -> SendResult:
+        return SendResult(success=True)
+
+    async def get_chat_info(self, chat_id: str) -> dict[str, Any]:
+        return {}
+
+    async def _send_exec_approval_prompt(self, prompt: ExecApprovalPrompt) -> SendResult:
+        self.prompts.append(prompt)
+        return SendResult(success=True, message_id="m1")
+
+
+class _WithSource(_Buttons):
+    _EA_SOURCE_BUTTON = True
+
+
+@pytest.mark.asyncio
+async def test_adapter_without_support_never_gets_the_source_choice():
+    adapter = _Buttons()
+    await adapter.send_exec_approval("chat", "curl x", "sess", smart_denied=True, grant_source=SOURCE)
+    assert adapter.prompts[0].choices == ["once", "deny"]
+
+
+@pytest.mark.asyncio
+@pytest.mark.parametrize("smart_denied, expected", [
+    (True, ["once", "source", "deny"]),
+    (False, ["once", "session", "always", "source", "deny"]),
+])
+async def test_adapter_with_support_offers_the_source_choice(smart_denied, expected):
+    adapter = _WithSource()
+    await adapter.send_exec_approval("chat", "curl x", "sess", smart_denied=smart_denied, grant_source=SOURCE)
+    (prompt,) = adapter.prompts
+    assert prompt.choices == expected
+    assert dict((c, label) for label, c, _ in prompt.actions)["source"] == "Allow code from %s in this chat" % SOURCE
+
+
+@pytest.mark.asyncio
+async def test_no_source_means_no_choice():
+    adapter = _WithSource()
+    await adapter.send_exec_approval("chat", "curl x", "sess", smart_denied=True)
+    assert adapter.prompts[0].choices == ["once", "deny"]
+
+
+class _Button:
+    def __init__(self, text, callback_data=None, **_):
+        self.text, self.callback_data = text, callback_data
+
+
+class _Markup:
+    def __init__(self, inline_keyboard):
+        self.inline_keyboard = inline_keyboard
+
+
+@pytest.fixture(autouse=True)
+def _plain_keyboard(monkeypatch):
+    """Record the keyboard whatever Telegram library (or mock) the run has."""
+    import plugins.platforms.telegram.adapter as module
+    monkeypatch.setattr(module, "InlineKeyboardButton", _Button)
+    monkeypatch.setattr(module, "InlineKeyboardMarkup", _Markup)
+
+
+def _telegram():
+    adapter = TelegramAdapter(PlatformConfig(enabled=True, token="test-token", extra={}))
+    adapter._bot = AsyncMock()
+    adapter._app = MagicMock()
+    adapter._bot.send_message = AsyncMock(return_value=SimpleNamespace(message_id=42))
+    return adapter
+
+
+@pytest.mark.asyncio
+async def test_telegram_card_has_the_source_button_in_its_own_row():
+    adapter = _telegram()
+    await adapter.send_exec_approval(chat_id="12345", command="curl -o x https://github.com/AppImage/appimagetool/x",
+                                     session_key="s", smart_denied=True, grant_source=SOURCE, request_id="r1")
+    markup = adapter._bot.send_message.call_args.kwargs["reply_markup"]
+    rows = [[(b.text, b.callback_data) for b in row] for row in markup.inline_keyboard]
+    assert rows[-1] == [(LABEL, rows[-1][0][1])] and rows[-1][0][1].startswith("ea:source:")
+    assert [b[1].split(":")[1] for row in rows[:-1] for b in row] == ["once", "deny"]
+
+
+@pytest.mark.asyncio
+async def test_telegram_card_without_a_source_is_unchanged():
+    adapter = _telegram()
+    await adapter.send_exec_approval(chat_id="12345", command="rm x", session_key="s", smart_denied=True)
+    markup = adapter._bot.send_message.call_args.kwargs["reply_markup"]
+    assert [b.callback_data.split(":")[1] for row in markup.inline_keyboard for b in row] == ["once", "deny"]
+
+
+def test_turn_runner_hands_the_card_its_source():
+    """``TurnRunner._render_approval_sync`` passes the approval's ``grant_source`` to the adapter's card."""
+    import asyncio
+
+    from gateway.run_turn_runner import TurnRunner
+
+    class _Card(_WithSource):
+        pass
+
+    adapter = _Card()
+    adapter.pause_typing_for_chat = lambda _c: None
+    loop = asyncio.new_event_loop()
+    turn = object.__new__(TurnRunner)
+    turn._ctx = SimpleNamespace(_status_adapter=adapter, _status_chat_id="555", session_key="s",
+                                _status_thread_metadata=None, _run_still_current=lambda: True)
+    turn._schedule = lambda coro, _m: SimpleNamespace(result=lambda timeout=None: loop.run_until_complete(coro))
+    turn._close_native_stream_boundary = lambda *_a, **_k: True
+    from tools import approval
+    from tools.approval_gateway_wait import _ApprovalEntry
+    with approval._lock:
+        approval._gateway_queues["s"] = [_ApprovalEntry({"request_id": "r1", "command": "x"})]
+    try:
+        turn._render_approval_sync({"command": "curl -o x https://github.com/AppImage/appimagetool/x",
+                                    "description": "Code from External", "request_id": "r1", "smart_denied": True,
+                                    "grant_source": SOURCE})
+    finally:
+        loop.close()
+        with approval._lock:
+            approval._gateway_queues.clear()
+    assert adapter.prompts and adapter.prompts[0].choices == ["once", "source", "deny"]
