+# --- the hand-over after the carry (0156) -------------------------------------------------------------------------
+# Live (p107): a helper that finished during the carry, and the restart still carried for the whole ceiling: the old
+# gateway sent no process handoff, so the next gateway resumed every handed-off subagent of the instance ~18 minutes
+# late. The subagent carry waited until every unit settled, and a unit that does not settle (its runner stuck after
+# its children stopped, or a stop waiting on a helper that left its turn without recording its boundary) held every
+# other unit and the process handoff until the end of the boundary window.
+
+OTHER, OTHER_SID = "child-9", "sa-9-other"
+_STEP = "for i in 1 2 3; do sleep 1; done; echo zd-step"
+
+
+def _other_subagent(db, tmp_path, commands):
+    """An unrelated background subagent of the same chat, running foreground commands one after the other."""
+    import tests.tools.test_delegate_resume_action as ra
+    record = ra._record()
+    record[handoff.RESUME_KEY]["children"]["0"].update(subagent_id=OTHER_SID, session_id=OTHER)
+    record[handoff.RESUME_KEY]["live_deleg_id"] = "deleg_other"
+    record[handoff.RESUME_STATE_KEY].update(session_id=OTHER, cwd=str(tmp_path))
+    db.create_session(session_id=OTHER, source="subagent", parent_session_id=PARENT,
+                      model_config={"_delegate_from": PARENT, "_subagent_id": OTHER_SID, **record})
+    db.append_message(OTHER, "user", content="build it")
+    db.append_message(OTHER, "assistant", content="Built.")
+    db.end_session(OTHER, "agent_close")
+    script = [lambda n=n, **_k: _response("", [_tool_call("terminal", {"command": f"sleep 1; echo other{n}"},
+                                                          f"call_o{n}")]) for n in range(commands)]
+    other = _real(db, OTHER, OTHER_SID, 1, PARENT, [*script, lambda **_k: _response("Built it.")])
+    other.valid_tool_names = {"terminal"}
+    return other
+
+
+@pytest.fixture
+def real_steps(monkeypatch, tmp_path):
+    """The terminal tool for real (local backend); each command's end is recorded."""
+    import model_tools
+    from tools.terminal_tool import terminal_tool
+    original, ends = model_tools.handle_function_call, []
+
+    def call(name, args, *a, **k):
+        if name != "terminal":
+            return original(name, args, *a, **k)
+        try:
+            return terminal_tool(args["command"], task_id=k.get("task_id") or "zd", timeout=60)
+        finally:
+            ends.append(time.monotonic())
+    monkeypatch.setattr("model_tools.handle_function_call", call)
+    monkeypatch.setenv("TERMINAL_CWD", str(tmp_path))
+    return ends
+
+
+def _watching_next_gateway(monkeypatch, owner, tmp_path):
+    """The next gateway's real watch of the carrier; when it reattaches the processes and adopts the subagents."""
+    from hermes_state_runtime import turn_carry_record
+    from tests.gateway.test_restart_turn_carry import _NextAuthority
+    log = []
+
+    async def reattach(_runner):
+        log.append(("reattach", time.monotonic()))
+    monkeypatch.setattr(turn_carry, "_reattach_processes", reattach)
+    monkeypatch.setattr(handoff, "resume_handed_off_delegations", lambda: log.append(("adopt", time.monotonic())) or 1)
+    nxt = _NextAuthority(owner.db)
+    remote = turn_carry._Remote(owner.runner, nxt, turn_carry_record(owner.db), tmp_path)
+    nxt._turn_carrier = remote
+    return log, asyncio.ensure_future(turn_carry._watch(remote))
+
+
+def _frames(monkeypatch):
+    sent = []
+    write = turn_carry._write_frame
+
+    def recording(carry, params):
+        if params.get("type") == turn_carry.PROCESSES_HANDED:
+            sent.append(time.monotonic())
+        return write(carry, params)
+    monkeypatch.setattr(turn_carry, "_write_frame", recording)
+    return sent
+
+
+def _rows(db_path):
+    import sqlite3
+    with sqlite3.connect(db_path) as conn:
+        return {r[0]: (r[1], json.loads(r[2] or "{}")) for r in
+                conn.execute("SELECT delegation_id, state, task_json FROM async_delegations")}
+
+
+@pytest.mark.live_system_guard_bypass
+@pytest.mark.asyncio
+@pytest.mark.parametrize("stuck", [None, "teardown", "lost-boundary"])
+async def test_the_carry_hands_every_subagent_and_the_processes_over_right_after_the_last_step(
+        owner, tmp_path, seams, monkeypatch, real_steps, stuck):
+    """The k13 shape: a subagent waiting on its helper, the helper in a foreground command, an unrelated subagent in
+    its own commands. The old gateway hands the processes and every subagent over a few seconds after the last
+    carried step ends and the next gateway adopts them within a second, whatever one unit does after its step:
+    ``teardown``, the unrelated unit's runner hangs after its subagent stopped; ``lost-boundary``, the helper leaves
+    its turn without recording its boundary."""
+    from hermes_state_registry import acquire
+    from tools import delegate_tool_subunits as subunits
+    db = acquire()
+    _finished_child(db, record=_record_with_cwd(tmp_path))
+    sent = _frames(monkeypatch)
+    hang = threading.Event()
+    if stuck == "lost-boundary":
+        carry_helpers = subunits.carry_to_boundaries
+
+        def losing(agent):
+            events = carry_helpers(agent)
+            for unit in subunits.units_of(agent):
+                for child in unit.children:
+                    child._handoff_capture = None  # its run ends without its cleanup recording the boundary
+            return events
+        monkeypatch.setattr(subunits, "carry_to_boundaries", losing)
+
+    scene = _Scene(db, seams, helper_calls=[
+        lambda **_k: _response("", [_tool_call("terminal", {"command": _STEP}, "call_h1")]),
+        lambda **_k: _response(RESULT)], subagent_wake_calls=[])
+    scene.helper.valid_tool_names = {"terminal"}
+    await asyncio.to_thread(wait_until, lambda: len(seams.built) >= 2, timeout=20, what="subagent and helper built")
+    other = _other_subagent(db, tmp_path, commands=6)
+    if stuck == "teardown":
+        other.release_clients = lambda: hang.wait(60)  # e.g. a client close that does not return
+    seams(other)
+    _call(_Parent(db), subagent_id=OTHER_SID, message="build it")
+    await asyncio.to_thread(wait_until, lambda: scene.waiting() and real_steps == [] and other.calls,
+                            timeout=20, what="the helper and the other subagent in their first commands")
+
+    _reserve_profile(tmp_path)
+    # 120 s ceiling: the subagents' boundary window is 60 s (turn_carry.SUBAGENT_STOP_RESERVE_S is 60).
+    runner = _idle(_old_runner(owner, restart_turn_carry_ceiling_seconds=120.0))
+    restart = asyncio.create_task(_restart_and_close(runner))
+    try:
+        await asyncio.to_thread(wait_until, turn_carry.released, timeout=20, what="the profile released")
+        log, watch = _watching_next_gateway(monkeypatch, owner, tmp_path)
+        await asyncio.to_thread(wait_until, lambda: sent, timeout=40, what="the process handoff")
+        last_step = max(real_steps)
+        bound = 3.0 + (ad.UNIT_SETTLE_SECONDS if stuck == "teardown" else 0.0) + (
+            subunits._RESULT_SETTLE_SECONDS if stuck == "lost-boundary" else 0.0)
+        assert sent[0] - last_step <= bound, (sent[0] - last_step, bound)
+        await asyncio.to_thread(wait_until, lambda: any(k == "adopt" for k, _ in log), timeout=5,
+                                what="the next gateway adopting the subagents")
+        adopted = next(t for k, t in log if k == "adopt")
+        assert [k for k, _ in log][:2] == ["reattach", "adopt"]
+        assert adopted - sent[0] <= 1.0
+        # Every unit is recorded as handed off by then, with the state its subagent had at its boundary.
+        rows = _rows(ad._db_path())
+        assert len(rows) == 2 and all(state == "handed_off" for state, _ in rows.values())
+        for _state, task in rows.values():
+            assert task["handoff"]["resume"] == [0]
+            assert task["handoff"]["children"]["0"].get("session_id") in (CHILD, OTHER)
+        orchestrator = next(task for _s, task in rows.values() if task["handoff"]["children"]["0"]["session_id"] == CHILD)
+        assert orchestrator["handoff"]["children"]["0"]["units"][0]["task_indexes"] == [0]  # the helper rides along
+    finally:
+        hang.set()
+        await asyncio.wait_for(restart, 60)
+    await asyncio.wait_for(watch, 5.0)
+    assert len(scene.helper.calls) == 1  # its command ran once, here
+    assert _completions(scene.run_id) == []  # nothing delivered here; the next gateway resumes them
+    if stuck == "teardown":
+        # The stuck runner settles later; the unit stays handed off and nothing is delivered from this gateway.
+        await asyncio.to_thread(wait_until, lambda: not ad.active_count(), timeout=20, what="the stuck unit settled")
+        assert all(state == "handed_off" for state, _ in _rows(ad._db_path()).values())
+        assert _completions() == []
