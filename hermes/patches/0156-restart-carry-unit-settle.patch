 _RESULT_SETTLE_SECONDS = 5.0
 
 
+def wait_while_carried(event: Any, child: Any, timeout: Optional[float]) -> bool:
+    """Wait for a carried child's boundary ``event`` for up to ``timeout``, but only while the child is still in its
+    turn or recording its boundary. A child out of its turn whose boundary was not recorded within
+    ``_RESULT_SETTLE_SECONDS`` (its run ended without reaching the capture) carries nothing any more; waiting on for
+    the whole boundary window held every other subagent and the process handoff of the restart until the ceiling."""
+    from tools.delegate_tool_handoff import _in_turn
+    until = None if timeout is None else time.monotonic() + max(0.0, timeout)
+    idle_since = None
+    while True:
+        now = time.monotonic()
+        step = 0.1 if until is None else min(0.1, max(0.0, until - now))
+        if event.wait(step):
+            return True
+        now = time.monotonic()
+        if until is not None and now >= until:
+            return False
+        if _in_turn(child) or getattr(child, "_handoff_capturing", False) is True:
+            idle_since = None  # in its turn, or its cleanup is recording its boundary
+        elif idle_since is None:
+            idle_since = now
+        elif now - idle_since >= _RESULT_SETTLE_SECONDS:
+            logger.warning("Restart carry: a subagent left its turn without reaching its step boundary; not waiting "
+                           "for it any longer")
+            return False
+
+
 class _Reached:
     """Set once a carried child stopped (its cleanup recorded its state) and its unit holds the result: the cleanup
     runs before the unit's runner returns, so a child that finished in that gap would read as still running."""
 
-    def __init__(self, stopped: threading.Event, unit: Unit):
-        self.stopped, self.unit = stopped, unit
+    def __init__(self, stopped: threading.Event, unit: Unit, child: Any = None):
+        self.stopped, self.unit, self.child = stopped, unit, child
 
     def is_set(self) -> bool:
         return self.stopped.is_set() and self.unit.done.is_set()
 
     def wait(self, timeout: Optional[float] = None) -> bool:
         started = time.monotonic()
-        if not self.stopped.wait(timeout):
+        reached = (self.stopped.wait(timeout) if self.child is None
+                   else wait_while_carried(self.stopped, self.child, timeout))
+        if not reached:
             return False
         left = _RESULT_SETTLE_SECONDS if timeout is None else max(0.0, timeout - (time.monotonic() - started))
         return self.unit.done.wait(min(left, _RESULT_SETTLE_SECONDS)) or True
