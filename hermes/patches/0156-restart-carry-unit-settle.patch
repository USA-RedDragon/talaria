+# The per-turn carry (``hand_off_for_restart`` with ``boundary_seconds``): how long a unit may take to settle after
+# its handoff stopped all its children, before the restart goes on without it and it is handed over on its own.
+UNIT_SETTLE_SECONDS = 10.0
+
+
+def _hand_off_unsettled(ids: list[str]) -> None:
+    """Record each unit whose children all stopped for the carry but whose runner has not settled since as handed
+    off now, with the state its handoff kept (``_handoff_state``) and the children that had finished, so the next
+    gateway resumes it with the others. Its own finalize later updates the record while this process still owns
+    it, and is a no-op once the next gateway adopted it (``_persist_handoff``)."""
+    for delegation_id in ids:
+        with _records_lock:
+            record = _records.get(delegation_id)
+            if record is None or record.get("status") not in _LIVE_STATES:
+                continue
+            snapshot = dict(record)
+        indexes = list(snapshot.get("task_indexes") or range(len(snapshot.get("goals") or [])))
+        finished = dict(snapshot.get("_finished_children") or {})
+        resume = [i for i in indexes if i not in finished]
+        kept = [redact_child_result(finished[i]) for i in indexes if i in finished]
+        try:
+            if _persist_handoff(delegation_id, kept, resume, snapshot.get("_handoff_state") or {}):
+                with _records_lock:
+                    if delegation_id in _records:
+                        _records[delegation_id]["_handed_unsettled"] = True
+                logger.warning("Async delegation %s did not settle within %.0fs after its subagents stopped for the "
+                               "restart; handed to the next gateway on its own", delegation_id, UNIT_SETTLE_SECONDS)
+        except Exception:
+            logger.error("Async delegation %s: could not hand the unsettled unit to the next gateway", delegation_id,
+                         exc_info=True)
+
+
 def _hand_off_queued(records: list[dict[str, Any]]) -> int:
     """Record each queued unit as handed off with every task to resume, then release its unstarted children."""
     handed = 0
