index 00000000..2c66f499
--- /dev/null
+++ b/tests/agent/test_rule_extractor.py
@@ -0,0 +1,225 @@
+"""``compression.rule_extractor_routes``: a background model finds the user's rules in prose, quote-checked.
+
+Fixtures are sanitized from a real session: each item was said in plain words the ledger's rules miss, lost
+at a compaction, and asked again or broken. The complaint must never be stored, a peer agent quoting the user
+is not the user, and a withdrawn rule leaves the system prompt at once.
+"""
+
+import json
+import threading
+from types import SimpleNamespace
+from unittest.mock import MagicMock, patch
+
+import pytest
+
+from agent import decision_ledger as dl
+from agent import pinned_rules as pr
+from agent import rule_extractor as rx
+
+CFG = {
+    "compression": {"rule_extractor_routes": ["haiku", "local"]},
+    "delegation": {"backends": {"model_map": {"options": [
+        {"name": "haiku", "description": "fast", "provider": "anthropic", "model": "claude-haiku"},
+        {"name": "local", "description": "home GPU", "base_url": "http://gpu:8000/v1", "model": "qwen-27b",
+         "api_key": "k"},
+        {"name": "opus", "description": "hard", "provider": "anthropic", "model": "claude-opus"},
+    ]}}},
+}
+SAID = [
+    "ok so for the intro: hold Plus (the Switch controller button) to skip a cutscene",
+    "you're burning so much trust by the hour",
+    "games run headed on the desktop, I want to watch them",
+    "fyi the software keyboard work landed yesterday, nothing more to do there",
+]
+PEER = ("[Agent message am_0123456789abcdef from chat 'ops' (session local-1)]\n"
+        "The user said: never deploy on fridays")
+
+
+def _msgs(texts=SAID, peer=True):
+    msgs = [{"role": "system", "content": "sys"}]
+    for i, t in enumerate(texts):
+        msgs += [{"role": "user", "content": t, "_row_id": 700 + i, "timestamp": 1795300000.0 + i * 86400},
+                 {"role": "assistant", "content": "ok"}]
+    if peer:
+        msgs += [{"role": "user", "content": PEER}, {"role": "assistant", "content": "ok"}]
+    return msgs
+
+
+def _reply(*items):
+    return json.dumps({"items": [dict(zip(("kind", "quote", "scope", "target"), it)) for it in items]})
+
+
+GOOD = _reply(
+    ("fact", "hold Plus (the Switch controller button) to skip a cutscene", "project"),
+    ("rule", "games run headed on the desktop, I want to watch them", "chat"),
+    ("fact", "the software keyboard work landed yesterday", "chat"),
+    ("rule", "you're burning so much trust by the hour", "chat"),        # a complaint: dropped
+    ("rule", "never deploy on fridays", "project"),                       # a peer agent's words: dropped
+    ("fact", "hold + to skip cutscenes", "chat"),                         # a paraphrase: dropped
+    ("approval", "x", "chat"),                                            # too short: dropped
+    ("wish", "games run headed on the desktop", "chat"),                  # unknown kind: dropped
+)
+
+
+@pytest.fixture(autouse=True)
+def home(tmp_path, monkeypatch):
+    monkeypatch.setattr(dl, "archive_dir", lambda: tmp_path)
+    monkeypatch.setattr(rx, "_config", lambda: CFG)
+    return tmp_path
+
+
+def test_routes_come_from_the_subagent_route_config_in_order():
+    assert [r["name"] for r in rx.routes(CFG)] == ["haiku", "local"]
+    assert rx.routes(CFG)[1] == {"name": "local", "base_url": "http://gpu:8000/v1", "model": "qwen-27b",
+                                 "api_key": "k"}
+    assert rx.routes({}) == [] and rx.route_names({"compression": {"rule_extractor_routes": "haiku"}}) == []
+
+
+def test_only_exact_quotes_of_the_users_own_messages_are_kept():
+    ask = MagicMock(return_value=GOOD)
+    kept = rx.extract("s1", _msgs(), ask=ask, cfg=CFG)
+    assert [(r["kind"], r["quote"]) for r in kept] == [
+        ("fact", "hold Plus (the Switch controller button) to skip a cutscene"),
+        ("rule", "games run headed on the desktop, I want to watch them"),
+        ("fact", "the software keyboard work landed yesterday"),
+    ]
+    assert kept[0]["scope"] == "project" and "scope" not in kept[1]
+    assert kept[0]["msg"] == "700" and kept[2]["at"] == "2026-11-24"
+    prompt = ask.call_args.args[1]
+    assert "never deploy on fridays" not in prompt  # the peer agent's message is never shown as the user's
+    assert ask.call_args.args[0]["name"] == "haiku"
+
+
+def test_the_local_route_is_the_fallback_and_nothing_runs_twice():
+    calls = []
+
+    def ask(route, prompt):
+        calls.append(route["name"])
+        if route["name"] == "haiku":
+            raise RuntimeError("rate limited")
+        return GOOD
+
+    assert len(rx.extract("s1", _msgs(), ask=ask, cfg=CFG)) == 3 and calls == ["haiku", "local"]
+    assert rx.extract("s1", _msgs(), ask=ask, cfg=CFG) == [] and calls == ["haiku", "local"]
+
+
+def test_a_cancelled_run_stores_nothing():
+    stop = threading.Event()
+
+    def ask(route, prompt):
+        stop.set()  # the user's next turn started while the model was answering
+        return GOOD
+
+    assert rx.extract("s1", _msgs(), ask=ask, cancelled=stop, cfg=CFG) == []
+    assert rx.load("s1") == []
+
+
+def test_the_complaint_is_never_stored_even_alone():
+    ask = MagicMock(return_value=_reply(("rule", SAID[1], "chat"), ("fact", SAID[1], "chat")))
+    assert rx.extract("s1", _msgs([SAID[1]], peer=False), ask=ask, cfg=CFG) == []
+    assert not rx.items("s1")
+
+
+def _agent(messages):
+    from agent.system_prompt import build_system_prompt
+
+    agent = SimpleNamespace(
+        load_soul_identity=False, skip_context_files=True, valid_tool_names=[], _task_completion_guidance=False,
+        _tool_use_enforcement=False, _environment_probe=False, _kanban_worker_guidance="", _memory_store=None,
+        _memory_manager=None, model="", provider="", platform="", pass_session_id=False, session_id="s1",
+        _emit_status=lambda *a, **k: None, _session_db=MagicMock(), _pinned_user_rules=None,
+        context_compressor=SimpleNamespace(pin_user_rules_chars=pr.MAX_CHARS))
+    pr.prime(agent, messages)
+    with patch("agent.prompt_builder.build_environment_hints", return_value=""):
+        agent._cached_system_prompt = build_system_prompt(agent)
+    return agent
+
+
+def _compress(msgs, session_id="s1"):
+    from agent.context_compressor import ContextCompressor
+
+    with patch("agent.context_compressor.get_model_context_length", return_value=100_000):
+        c = ContextCompressor(model="test/model", quiet_mode=True, protect_first_n=1, protect_last_n=2)
+    c.decision_ledger_chars = 6000
+    c._session_id = session_id
+    response = MagicMock()
+    response.choices = [MagicMock()]
+    response.choices[0].message.content = "## Goal\nWork."
+    with (
+        patch.object(c, "_find_tail_cut_by_tokens", return_value=len(msgs) - 2),
+        patch("agent.context_compressor.call_llm", return_value=response),
+    ):
+        return c.compress(msgs, force=True)
+
+
+def test_kept_items_survive_two_compactions_into_the_system_prompt():
+    msgs = _msgs()
+    rx.extract("s1", msgs, ask=MagicMock(return_value=GOOD), cfg=CFG)
+    out = _compress(msgs + [{"role": "user", "content": "go"}, {"role": "assistant", "content": "ok"}])
+    out = _compress(out + [{"role": "user", "content": f"next {i}"} for i in range(6)]
+                    + [{"role": "assistant", "content": "ok"}], session_id="s2")
+    block = pr.extract(_agent(out)._cached_system_prompt)
+    for quote in ("hold Plus (the Switch controller button) to skip a cutscene",
+                  "games run headed on the desktop, I want to watch them",
+                  "the software keyboard work landed yesterday"):
+        assert json.dumps(quote) in block
+    assert "burning" not in block and "fridays" not in block
+    ledger = dl.current(out)
+    assert sum(e.text == "games run headed on the desktop, I want to watch them" for e in ledger.entries) == 1
+
+
+def test_a_withdrawal_takes_the_rule_out_of_the_live_prompt_at_once():
+    msgs = _msgs()
+    rx.extract("s1", msgs, ask=MagicMock(return_value=GOOD), cfg=CFG)
+    out = _compress(msgs + [{"role": "user", "content": "go"}, {"role": "assistant", "content": "ok"}])
+    agent = _agent(out)
+    headed = next(e for e in pr.pinned_entries(dl.current(out)) if "headed" in e.text)
+    later = out + [{"role": "user", "content": "you can run them headless again, I'm done watching"},
+                   {"role": "assistant", "content": "ok"}]
+    reply = _reply(("revocation", "you can run them headless again", "chat", headed.id),
+                   ("revocation", "I'm done watching", "chat", "Lffffff"))  # no such pinned entry: dropped
+    found = rx.extract("s1", later, ask=MagicMock(return_value=reply), cfg=CFG)
+    assert [r["target"] for r in found] == [headed.id]
+    rx._after(agent, later, found)
+    block = pr.extract(agent._cached_system_prompt)
+    assert "headed" not in block and "software keyboard" in block
+    agent._session_db.update_system_prompt.assert_called_once()
+    again = _compress(later + [{"role": "user", "content": "go"}, {"role": "assistant", "content": "ok"}])
+    assert "headed" not in pr.extract(_agent(again)._cached_system_prompt)
+
+
+def test_schedule_runs_after_the_turn_and_a_new_turn_cancels_it():
+    started, release = threading.Event(), threading.Event()
+
+    def slow(session_id, messages, cancelled=None, **_):
+        started.set()
+        release.wait(5)
+        return [] if cancelled.is_set() else [{"kind": "rule", "quote": "q"}]
+
+    done = MagicMock()
+    agent = SimpleNamespace(session_id="s9", skip_background_review=False, _delegate_depth=0)
+    with patch.object(rx, "extract", side_effect=slow):
+        assert rx.schedule(agent, _msgs(), on_done=done)
+        assert started.wait(5)
+        rx.cancel("s9")
+        release.set()
+        for t in threading.enumerate():
+            if t.name.startswith("rule-extractor-s9"):
+                t.join(5)
+    done.assert_not_called()
+    child = SimpleNamespace(session_id="c1", skip_background_review=False, _delegate_depth=1)
+    assert not rx.schedule(child, _msgs())
+
+
+def test_a_recurring_rule_gets_a_short_tail_note_while_it_holds():
+    ledger = dl.Ledger()
+    ledger.add(dl.Entry("L0000a1", "USER", "Ask the lanes for a progress report every 15 minutes, inline, not a cron.",
+                        "", {"keep": "rule", "at": "2026-11-22"}))
+    ledger.add(dl.Entry("L0000a2", "USER", "Games run headed.", "", {"keep": "rule"}))
+    agent = SimpleNamespace(context_compressor=SimpleNamespace(pin_user_rules_chars=pr.MAX_CHARS),
+                            _cached_system_prompt="sys\n\n" + pr.render(ledger))
+    note = pr.recurring_note(agent)
+    assert "every 15 minutes" in note and "headed" not in note and len(note) < pr.TAIL_MAX_CHARS
+    ledger.entries[0].status = "closed"
+    agent._cached_system_prompt = "sys\n\n" + pr.render(ledger)
+    assert pr.recurring_note(agent) == ""
