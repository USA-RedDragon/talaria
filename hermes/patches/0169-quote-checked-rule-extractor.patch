diff --git a/agent/rule_extractor.py b/agent/rule_extractor.py
new file mode 100644
index 00000000..50a5c93f
--- /dev/null
+++ b/agent/rule_extractor.py
@@ -0,0 +1,326 @@
+"""Opt-in ``compression.rule_extractor_routes``: a background model finds the user's rules in prose.
+
+The decision ledger keeps a user message by rule (``decision_ledger.keep_reason``), which misses a rule or a
+fact said in plain words. With routes set, after each finished turn the user's new messages go to a small
+model on the first of those routes that answers (names of ``delegation.backends.model_map.options``, the
+subagent routes, so no model is named here), which returns the rules, facts, approvals, decisions and
+withdrawals it finds, each with an exact quote. An item is kept only when its quote is an exact substring of
+a message the user wrote: words from a peer agent, a subagent or a tool never reach the model as the user's,
+and a paraphrase or an invented quote is dropped. A complaint with no rule in it is dropped too.
+
+The run never competes with the user: it starts after a turn is delivered and is cancelled when the next
+turn of the session starts (a result that lands after that is discarded). Kept items go to a sidecar file
+next to the ledger archive; each compaction merges them into the ledger, which carries them across
+handoffs and pins them in the system prompt (``pinned_rules``). A withdrawal closes the pinned entry it
+names and takes it out of the live system prompt at once.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import logging
+import re
+import threading
+import time
+from pathlib import Path
+from typing import Any, Callable, Optional
+
+from agent import decision_ledger as dl
+
+logger = logging.getLogger(__name__)
+
+KINDS = ("rule", "fact", "approval", "decision", "revocation")
+MAX_MESSAGES = 12
+MESSAGE_MAX_CHARS = 1500
+QUOTE_MIN_CHARS = 6
+SEEN_MAX = 400
+TIMEOUT = 60.0
+_COMPLAINT_RE = re.compile(
+    r"\b(?:burn\w*|trust|frustrat\w*|annoy\w*|ridiculous|useless|terrible|awful|wtf|sick of|tired of|"
+    r"disappoint\w*|pathetic)\b", re.IGNORECASE)
+_RUNS: dict[str, threading.Event] = {}
+_RUNS_LOCK = threading.Lock()
+
+PROMPT = """You read messages a user wrote to an AI agent and list what the agent must remember for the rest \
+of the work. Return only JSON: {{"items": [{{"kind": ..., "quote": ..., "scope": ..., "target": ...}}]}}.
+
+kind is one of:
+- "rule": a standing instruction for how to work from now on (how to run, test, report, what never to do).
+- "fact": something true about the work that the agent must not get wrong (a control, a path, what already \
+happened).
+- "approval": the user approving a plan, design or mockup.
+- "decision": the user choosing between options.
+- "revocation": the user withdrawing one of the CURRENT ITEMS below; target is its id.
+
+quote is the user's exact words, copied character for character from one message (a sentence or a part of \
+one). Never paraphrase, never join words from two places. scope is "project" when it is about the codebase or \
+project in general (it holds in other chats too), else "chat".
+
+Leave out complaints and venting, questions, one-off requests ("run it again"), and anything said by someone \
+other than the user. Return {{"items": []}} when there is nothing.
+
+CURRENT ITEMS:
+{current}
+
+USER MESSAGES:
+{messages}"""
+
+
+# ------------------------------------------------------------------ config and routes
+def _config() -> dict[str, Any]:
+    try:
+        from hermes_cli.config import load_config
+
+        return load_config() or {}
+    except Exception:
+        return {}
+
+
+def route_names(cfg: Optional[dict[str, Any]] = None) -> list[str]:
+    raw = ((cfg if cfg is not None else _config()).get("compression") or {}).get("rule_extractor_routes")
+    return [str(n).strip() for n in raw if str(n).strip()] if isinstance(raw, list) else []
+
+
+def routes(cfg: Optional[dict[str, Any]] = None) -> list[dict[str, str]]:
+    """The configured routes, in order, as ``call_llm`` keywords (a name with no usable option is skipped)."""
+    cfg = cfg if cfg is not None else _config()
+    backends = ((cfg.get("delegation") or {}).get("backends") or {})
+    options = ((backends.get("model_map") or {}).get("options") or []) if isinstance(backends, dict) else []
+    by_name = {o.get("name"): o for o in options if isinstance(o, dict) and o.get("name")}
+    out = []
+    for name in route_names(cfg):
+        opt = by_name.get(name)
+        if not opt or not opt.get("model") or not (opt.get("provider") or opt.get("base_url")):
+            continue
+        out.append({"name": name, **{k: str(opt[k]) for k in ("provider", "model", "base_url", "api_key")
+                                     if isinstance(opt.get(k), str) and opt[k].strip()}})
+    return out
+
+
+# ------------------------------------------------------------------ the sidecar store
+def store_path(session_id: str) -> Path:
+    safe = re.sub(r"[^\w.-]", "_", session_id or "session")[:80]
+    return dl.archive_dir() / f"{safe}.extracted.jsonl"
+
+
+def load(session_id: str) -> list[dict[str, Any]]:
+    """Every record in the session's sidecar file: kept items and ``seen`` marks."""
+    try:
+        lines = store_path(session_id).read_text(encoding="utf-8").splitlines()
+    except OSError:
+        return []
+    out = []
+    for line in lines:
+        try:
+            rec = json.loads(line)
+        except ValueError:
+            continue
+        if isinstance(rec, dict):
+            out.append(rec)
+    return out
+
+
+def _append(session_id: str, records: list[dict[str, Any]]) -> None:
+    path = store_path(session_id)
+    path.parent.mkdir(parents=True, exist_ok=True)
+    with path.open("a", encoding="utf-8") as f:
+        for rec in records:
+            f.write(json.dumps(rec, ensure_ascii=False) + "\n")
+
+
+def items(session_id: str) -> list[dict[str, Any]]:
+    return [r for r in load(session_id) if r.get("kind") in KINDS]
+
+
+def _digest(text: str) -> str:
+    return hashlib.sha1(text.encode("utf-8", "backslashreplace")).hexdigest()[:12]
+
+
+def merge(ledger: dl.Ledger, session_id: str) -> dl.Ledger:
+    """*ledger* with the session's extracted items: new ones as the user's entries (deduped by their words),
+    withdrawals closing the entry they name."""
+    if not session_id:
+        return ledger
+    for rec in items(session_id):
+        if rec["kind"] == "revocation":
+            dl.apply_op(ledger, {"op": "close", "id": rec.get("target", ""), "note": rec.get("quote", "")})
+            continue
+        quote = str(rec.get("quote") or "")
+        if not quote or dl._same_words(ledger, quote):
+            continue
+        fields = {"keep": rec["kind"], "via": "extractor"}
+        fields.update({k: str(rec[k]) for k in ("at", "msg") if rec.get(k)})
+        ledger.add(dl.Entry(str(rec.get("id") or dl.entry_id("extracted", quote)), "USER", quote, "", fields))
+    return ledger
+
+
+# ------------------------------------------------------------------ the run
+def _user_messages(messages: list[dict[str, Any]]) -> list[tuple[str, dict[str, Any]]]:
+    from agent.conversation_compression_scaffolding import user_authored_text
+
+    out = []
+    for m in messages:
+        words = user_authored_text(m)
+        if words and words.strip():
+            out.append((words.strip(), m))
+    return out
+
+
+def quote_ok(quote: str, sources: list[str]) -> bool:
+    """Whether *quote* is the user's own words: an exact substring of one of *sources*."""
+    quote = (quote or "").strip()
+    return len(quote) >= QUOTE_MIN_CHARS and any(quote in s for s in sources)
+
+
+def _complaint(quote: str) -> bool:
+    return bool(_COMPLAINT_RE.search(quote)) and not dl.keep_reason(quote)
+
+
+def check(raw: Any, sources: list[str], pinned_ids: set[str]) -> list[dict[str, Any]]:
+    """The model's items that pass: a known kind, an exact quote of the user's, no bare complaint, and for a
+    withdrawal a target that is pinned now."""
+    if isinstance(raw, str):
+        m = re.search(r"\{[\s\S]*\}", raw)
+        try:
+            raw = json.loads(m.group(0)) if m else {}
+        except ValueError:
+            raw = {}
+    found = raw.get("items") if isinstance(raw, dict) else None
+    out, seen = [], set()
+    for it in found if isinstance(found, list) else []:
+        if not isinstance(it, dict):
+            continue
+        kind, quote = str(it.get("kind") or "").strip().lower(), str(it.get("quote") or "").strip()
+        if kind not in KINDS or not quote_ok(quote, sources) or _complaint(quote) or quote in seen:
+            continue
+        rec: dict[str, Any] = {"kind": kind, "quote": quote}
+        if kind == "revocation":
+            target = str(it.get("target") or "").strip()
+            if target not in pinned_ids:
+                continue
+            rec["target"] = target
+        elif str(it.get("scope") or "").strip().lower() == "project" and kind in ("rule", "fact", "decision"):
+            rec["scope"] = "project"
+        seen.add(quote)
+        out.append(rec)
+    return out
+
+
+def _ask(route: dict[str, str], prompt: str) -> str:
+    from agent.auxiliary_client import call_llm
+
+    kwargs = {k: route[k] for k in ("provider", "model", "base_url", "api_key") if route.get(k)}
+    response = call_llm("rule_extractor", messages=[{"role": "user", "content": prompt}], temperature=0,
+                        max_tokens=900, timeout=TIMEOUT, **kwargs)
+    return str(response.choices[0].message.content or "")
+
+
+def extract(
+    session_id: str, messages: list[dict[str, Any]], *, ask: Optional[Callable[[dict[str, str], str], str]] = None,
+    cancelled: Optional[threading.Event] = None, cfg: Optional[dict[str, Any]] = None,
+) -> list[dict[str, Any]]:
+    """Run one extraction over the user's messages in *messages* not seen before; store and return the kept
+    items. Nothing is stored when *cancelled* is set before the model answers."""
+    from agent import pinned_rules
+
+    chain = routes(cfg)
+    if not chain or not session_id:
+        return []
+    seen = {r.get("seen") for r in load(session_id) if r.get("seen")}
+    fresh = [(w, m) for w, m in _user_messages(messages) if _digest(w) not in seen][-MAX_MESSAGES:]
+    if not fresh:
+        return []
+    ledger = merge(dl.current(list(messages)), session_id)
+    pinned = pinned_rules.pinned_entries(ledger)
+    current = "\n".join(f"- {e.id}: {json.dumps(e.text, ensure_ascii=False)}" for e in pinned) or "(none)"
+    shown = [w[:MESSAGE_MAX_CHARS] for w, _ in fresh]
+    prompt = PROMPT.format(current=current, messages="\n".join(f"[{i + 1}] {json.dumps(w, ensure_ascii=False)}"
+                                                               for i, w in enumerate(shown)))
+    reply, ask = None, ask or _ask
+    for route in chain:
+        if cancelled is not None and cancelled.is_set():
+            return []
+        try:
+            reply = ask(route, prompt)
+            break
+        except Exception as exc:
+            logger.info("Rule extraction on route %s failed: %s", route.get("name"), exc)
+    if reply is None or (cancelled is not None and cancelled.is_set()):
+        return []
+    kept = check(reply, shown, {e.id for e in pinned})
+    by_quote = {w: m for w, m in fresh}
+    records: list[dict[str, Any]] = []
+    for rec in kept:
+        source = next((m for w, m in by_quote.items() if rec["quote"] in w), {})
+        rec.update(dl._provenance(source, ""))
+        rec["id"] = dl.entry_id("extracted", rec["quote"])
+        rec["when"] = time.time()
+        records.append(rec)
+    _append(session_id, records + [{"seen": _digest(w)} for w, _ in fresh])
+    _trim(session_id)
+    return records
+
+
+def _trim(session_id: str) -> None:
+    recs = load(session_id)
+    marks = [r for r in recs if r.get("seen")]
+    if len(marks) <= SEEN_MAX:
+        return
+    keep = [r for r in recs if not r.get("seen")] + marks[-SEEN_MAX:]
+    path = store_path(session_id)
+    tmp = path.with_suffix(".tmp")
+    tmp.write_text("".join(json.dumps(r, ensure_ascii=False) + "\n" for r in keep), encoding="utf-8")
+    tmp.replace(path)
+
+
+# ------------------------------------------------------------------ scheduling
+def cancel(session_id: str) -> None:
+    """A turn of *session_id* starts: stop its running extraction (its result is discarded)."""
+    with _RUNS_LOCK:
+        event = _RUNS.pop(session_id or "", None)
+    if event is not None:
+        event.set()
+
+
+def schedule(agent: Any, messages: list[dict[str, Any]],
+             on_done: Optional[Callable[[Any, list[dict[str, Any]], list[dict[str, Any]]], None]] = None) -> bool:
+    """Start an extraction for *agent*'s session in the background after its turn. Returns whether one started."""
+    session_id = getattr(agent, "session_id", "") or ""
+    if (not session_id or getattr(agent, "skip_background_review", False) or getattr(agent, "_delegate_depth", 0)
+            or not route_names()):
+        return False
+    from agent.conversation_compression_scaffolding import user_authored_text
+
+    if not any(user_authored_text(m) for m in messages[-40:]):
+        return False
+    event = threading.Event()
+    with _RUNS_LOCK:
+        old = _RUNS.get(session_id)
+        if old is not None:
+            old.set()
+        _RUNS[session_id] = event
+    snapshot = list(messages)
+
+    def run() -> None:
+        try:
+            found = extract(session_id, snapshot, cancelled=event)
+            if found and not event.is_set():
+                (on_done or _after)(agent, snapshot, found)
+        except Exception:
+            logger.debug("Rule extraction failed", exc_info=True)
+        finally:
+            with _RUNS_LOCK:
+                if _RUNS.get(session_id) is event:
+                    _RUNS.pop(session_id, None)
+
+    threading.Thread(target=run, name=f"rule-extractor-{session_id[:12]}", daemon=True).start()
+    return True
+
+
+def _after(agent: Any, snapshot: list[dict[str, Any]], found: list[dict[str, Any]]) -> None:
+    """A withdrawal takes its rule out of the live system prompt now; new items wait for the next compaction."""
+    if any(r["kind"] == "revocation" for r in found):
+        from agent import pinned_rules
+
+        pinned_rules.refresh(agent, snapshot, session_id=getattr(agent, "session_id", "") or "")
