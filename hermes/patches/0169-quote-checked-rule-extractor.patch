+def recurring_note(agent: Any) -> str:
+    """A short note for the latest turn naming the pinned rules that recur (on a schedule, each time
+    something happens), which a long chat forgets first; ``""`` when none is in force."""
+    if not cap(agent):
+        return ""
+    prompt, pinned = getattr(agent, "_cached_system_prompt", ""), getattr(agent, "_pinned_user_rules", "")
+    block = extract(prompt if isinstance(prompt, str) else "") or (pinned if isinstance(pinned, str) else "")
+    lines = []
+    for m in _RULE_LINE_RE.finditer(block):
+        try:
+            text = json.loads(m.group("text"))
+        except ValueError:
+            continue
+        if _RECURRING_RE.search(text):
+            lines.append(f"- [{m.group('id')}] {json.dumps(text, ensure_ascii=False)}")
+    if not lines:
+        return ""
+    head = "[Standing rules that recur, still in force (the user's own words; the system prompt has all of them):"
+    out = head
+    for line in lines:
+        if len(out) + len(line) + 2 > TAIL_MAX_CHARS:
+            break
+        out += "\n" + line
+    return out + "]" if out != head else ""
+
