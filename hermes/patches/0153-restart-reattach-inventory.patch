new file mode 100644
index 00000000..55c33223
--- /dev/null
+++ b/tests/gateway/test_restart_reattach_burst.py
@@ -0,0 +1,149 @@
+"""The hub re-attaches every chat it watches, one after the other, when its socket moves to the gateway that took
+over (session.events.since, session.resume and config.set each). Each resume built the session's banner inventory
+(git branch, project, tool snapshot and availability, skills, MCP servers) again, though the chats of one profile
+share those sections: on a busy node that was most of each resume, the chats behind it waited (a streaming reply
+among them paused for seconds) and the API turns of that moment waited for the CPU. The profile-wide sections built
+moments ago now stand; what only a session's own agent knows is read each time."""
+import asyncio
+from types import SimpleNamespace
+
+import pytest
+
+from gateway import session_local_inventory as inventory
+from gateway.session_policy import LocalSessionPolicy
+
+
+def _policy(**over):
+    fields = dict(source="gui", platform="local", cwd="/w", model=None, toolsets=("hermes-cli",),
+                  config_json="{}", request_json="{}", terminal_json="{}")
+    fields.update(over)
+    return LocalSessionPolicy(**fields)
+
+
+def _forget():
+    getattr(inventory, "forget_reused_inventories", lambda: None)()
+
+
+@pytest.fixture
+def builds(monkeypatch):
+    """Counts each profile-wide section build; the policy's config read is the stored one."""
+    import hermes_cli.banner as banner
+    import tools.mcp_tool_discovery as mcp
+    from tui_gateway import git_probe
+    _forget()
+    calls = []
+
+    def count(name, value):
+        def build(*a, **k):
+            calls.append(name)
+            return value() if callable(value) else value
+        return build
+    monkeypatch.setattr(git_probe, "branch", count("branch", "main"))
+    monkeypatch.setattr(inventory, "_project", count("project", None))
+    monkeypatch.setattr(inventory, "_policy_tools", count(
+        "policy_tools", lambda: (["terminal"], [{"function": {"name": "terminal"}}])))
+    monkeypatch.setattr(banner, "compute_toolset_availability", count("availability", lambda: {"terminal": "ok"}))
+    monkeypatch.setattr(banner, "get_available_skills", count("skills", lambda: {"devops": ["arxiv"]}))
+    monkeypatch.setattr(mcp, "get_mcp_status", count("mcp", lambda: []))
+    monkeypatch.setattr(LocalSessionPolicy, "config", lambda self, authority=None, secrets=True: {})
+    yield calls
+    _forget()
+
+
+@pytest.fixture
+def snapshot(monkeypatch):
+    import gateway.session_local as session_local
+    import gateway.session_policy as session_policy
+    import gateway.session_usage as session_usage
+    policies, agents = {}, {}
+    monkeypatch.setattr(session_local, "local_session_info",
+                        lambda authority, ref: {"session_id": ref.session_id, "cwd": policies[ref.session_id].cwd})
+    monkeypatch.setattr(session_policy, "policy_for_source", lambda runner, source: policies[source])
+    monkeypatch.setattr(session_usage, "snapshot_usage", lambda authority, ref, agent: None)
+    authority = SimpleNamespace(profile_id="/home", runner=SimpleNamespace(),
+                                sessions={}, agent=lambda ref: agents.get(ref.session_id))
+
+    def add(sid, policy, agent=None):
+        policies[sid] = policy
+        authority.sessions[sid] = SimpleNamespace(source=sid)
+        if agent is not None:
+            agents[sid] = agent
+    return authority, add
+
+
+def _resume_all(authority, ids, **kw):
+    async def run():
+        return [await inventory.snapshot_info(authority, SimpleNamespace(session_id=sid), **kw) for sid in ids]
+    return asyncio.run(run())
+
+
+def _agent(name):
+    return SimpleNamespace(session_id=name, tools=[{"function": {"name": f"tool_{name}"}}],
+                           enabled_toolsets=["hermes-cli"], _cached_system_prompt=f"prompt {name}",
+                           provider="custom", requested_provider="custom", base_url="http://m", model="m")
+
+
+def test_a_reattach_burst_builds_the_profile_sections_once(builds, snapshot):
+    authority, add = snapshot
+    for n in range(6):  # chats of one profile: alike but for their own frozen-secret reference
+        add(f"s{n}", _policy(config_secret_ref=f"secret-{n}"))
+    for n in range(3):  # chats that ran turns: each has its own agent
+        add(f"a{n}", _policy(config_secret_ref=f"secret-a{n}"), _agent(f"a{n}"))
+    ids = [*(f"s{n}" for n in range(6)), *(f"a{n}" for n in range(3))]
+    infos = _resume_all(authority, ids)
+    assert sorted(builds) == sorted(["branch", "project", "policy_tools", "availability", "skills", "mcp",
+                                     "availability"])  # one availability per toolset list: the agents' differs
+    assert [info["session_id"] for info in infos] == ids
+    assert all(info["skills"] == {"devops": ["arxiv"]} and info["branch"] == "main" for info in infos)
+    assert [info["tools"] for info in infos[6:]] == [{"other": [f"tool_a{n}"]} for n in range(3)]  # its own agent
+    assert [info["system_prompt"] for info in infos[6:]] == [f"prompt a{n}" for n in range(3)]
+    assert infos[0]["tool_count"] == 1
+    infos[0]["skills"]["devops"].append("mutated")  # each caller has its own copy
+    assert _resume_all(authority, ["s1"])[0]["skills"] == {"devops": ["arxiv"]}
+    assert len(builds) == 7
+
+
+def test_session_info_and_an_old_section_build_anew(builds, snapshot, monkeypatch):
+    authority, add = snapshot
+    add("a", _policy())
+    add("b", _policy(cwd="/elsewhere"))
+    _resume_all(authority, ["a", "a"])
+    assert len(builds) == 6
+    _resume_all(authority, ["b"])  # another folder (a policy of its own): only what depends on them
+    assert builds[6:] == ["branch", "project", "policy_tools"]
+    _resume_all(authority, ["a"], reuse=False)  # session.info asks for the inventory of now
+    assert len(builds) == 15
+    clock = [1000.0]
+    monkeypatch.setattr(inventory.time, "monotonic", lambda: clock[0])
+    _forget()
+    _resume_all(authority, ["a"])
+    clock[0] += inventory.INVENTORY_REUSE_S + 0.1
+    _resume_all(authority, ["a"])
+    assert len(builds) == 27
+
+
+def test_another_profile_never_shares_a_section(builds):
+    policy = _policy()
+    one, two = SimpleNamespace(profile_id="/p1"), SimpleNamespace(profile_id="/p2")
+    for authority in (one, two, one):
+        inventory.reused_session_inventory(authority, policy, None, "/w")
+    assert len(builds) == 12
+    inventory.session_inventory(one, policy, None, "/w")  # outside a reuse window: built
+    assert len(builds) == 18
+
+
+def test_the_session_info_call_asks_for_a_fresh_inventory(monkeypatch):
+    from gateway import session_controls
+    seen = []
+
+    async def snapshot_info(authority, ref, **kw):
+        seen.append(kw)
+        return {}
+    monkeypatch.setattr(inventory, "snapshot_info", snapshot_info)
+
+    async def resolve(actor, ref):
+        return None
+    connection = SimpleNamespace(authority=SimpleNamespace(resolve=resolve), actor=None)
+    asyncio.run(session_controls.AuthorityConnection.info(connection, SimpleNamespace(session_id="a"),
+                                                          {"session_id": "a"}))
+    assert seen == [{"reuse": False}]
