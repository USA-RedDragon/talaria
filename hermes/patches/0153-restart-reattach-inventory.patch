 import asyncio
 import contextlib
+import contextvars
+import copy
+import dataclasses
+import hashlib
+import json
 import logging
+import threading
+import time
 
 logger = logging.getLogger(__name__)
 
@@ -125,16 +132,92 @@ def _session_provider(view, config=None):
                                      getattr(view, "base_url", None), getattr(view, "model", None), config=config)
 
 
+#: The banner sections every session of a profile shares (its git branch and project by folder, the tool
+#: snapshot of a policy, the availability of a toolset list, the skills, MCP servers and notices) are reused
+#: for this long once built. The hub re-attaches every chat it watches one after the other when its socket
+#: moves to the gateway that took over (a ``session.resume`` each), and each resume built them all again: on a
+#: busy node that was most of each resume, the chats behind it waited (a streaming reply among them paused for
+#: seconds) and the API turns of that moment waited for the CPU. ``session.info`` builds them anew.
+INVENTORY_REUSE_S = 10.0
+_REUSE_MAX = 512
+_reused: dict = {}
+_reuse_locks: dict = {}
+_reuse_guard = threading.Lock()
+_reuse_window = contextvars.ContextVar("inventory_reuse_s", default=0.0)
+
+
+def _policy_key(policy):
+    """The frozen policy as a key, without the session's own reference to its secrets (the inventory reads
+    ``policy.config(secrets=False)``), so sessions alike but for it share; None when it cannot be one."""
+    if policy is None:
+        return None
+    try:
+        if getattr(policy, "config_secret_ref", None) is not None:
+            policy = dataclasses.replace(policy, config_secret_ref=None)
+        hash(policy)
+    except (TypeError, ValueError):
+        return False
+    return policy
+
+
+def _config_key(config):
+    """What a section read of the session's resolved config: a config edit builds it anew."""
+    try:
+        return hashlib.sha1(json.dumps(config, sort_keys=True, default=str).encode()).hexdigest()
+    except (TypeError, ValueError):
+        return False
+
+
+def _section(authority, name, key, build):
+    """``build()``, or a copy of what it returned for the same profile, *name* and *key* within the reuse
+    window of this call (none outside :func:`reused_session_inventory`). Callers of one key wait for one build."""
+    window = _reuse_window.get()
+    if window <= 0 or key is False or (isinstance(key, tuple) and any(part is False for part in key)):
+        return build()
+    full = (id(authority), getattr(authority, "profile_id", None), name, key)
+    try:
+        hash(full)
+    except TypeError:
+        return build()
+    with _reuse_guard:
+        lock = _reuse_locks.setdefault(full, threading.Lock())
+    with lock:
+        hit = _reused.get(full)
+        if hit is not None and time.monotonic() - hit[0] < window:
+            return copy.deepcopy(hit[1])
+        value = build()
+        with _reuse_guard:
+            if len(_reused) >= _REUSE_MAX:
+                now = time.monotonic()
+                stale = [k for k, (t, _) in _reused.items() if now - t >= window] or list(_reused)[: _REUSE_MAX // 2]
+                for k in stale:
+                    _reused.pop(k, None)
+                    if k != full:
+                        _reuse_locks.pop(k, None)
+            _reused[full] = (time.monotonic(), value)
+        return copy.deepcopy(value)
+
+
+def forget_reused_inventories() -> None:
+    """Drop every reused section (tests; a change the next resume must show at once)."""
+    with _reuse_guard:
+        _reused.clear()
+        _reuse_locks.clear()
+
+
 def session_inventory(authority, policy, agent, cwd):
     """Main's banner/status fields for one session. Each section degrades to main's empty value on
     its own, so one failing builder never blanks the others (main wrapped each in ``suppress``)."""
     from gateway.session_authorities import owner_scope
     from tui_gateway import git_probe
+    pkey = _policy_key(policy)
     info: dict = {"tools": {}, "skills": {}, "mcp_servers": [], "version": "", "release_date": "",
                   "update_behind": None, "update_command": "",
-                  "branch": git_probe.branch(cwd) if cwd else "", "project": _project(cwd)}
+                  "branch": _section(authority, "branch", cwd, lambda: git_probe.branch(cwd)) if cwd else "",
+                  "project": _section(authority, "project", cwd, lambda: _project(cwd))}
     with owner_scope(authority):
         config = policy.config(authority, secrets=False) if policy is not None else {}
+        ckey = _config_key(config) if _reuse_window.get() > 0 else None
         if agent is not None:
             from agent.voice_turn_route import session_runtime_view
             info["provider"] = _session_provider(session_runtime_view(agent), config if policy is not None else None)
@@ -149,26 +232,30 @@ def session_inventory(authority, policy, agent, cwd):
             enabled = []
             if policy is not None:
                 try:
-                    enabled, tools = _policy_tools(policy, config)
-                    info["tools"] = _grouped(tools)
+                    enabled, grouped = _section(authority, "policy_tools", (pkey, ckey), lambda: (
+                        lambda pair: (pair[0], _grouped(pair[1])))(_policy_tools(policy, config)))
+                    info["tools"] = grouped
                 except Exception:  # health: allow BLE001 -- main's suppress: the banner shows no tools, not an error
                     logger.warning("session inventory: tool snapshot failed", exc_info=True)
         info["enabled_toolsets"] = sorted(enabled)
+        toolsets = tuple(enabled)
         with contextlib.suppress(Exception):
             # The classic CLI banner colours lazy (yellow) / disabled (red) tools from this.
             from hermes_cli.banner import compute_toolset_availability
-            info["tool_availability"] = compute_toolset_availability(enabled)
+            info["tool_availability"] = _section(authority, "availability", (ckey, toolsets),
+                                                 lambda: compute_toolset_availability(enabled))
         if policy is not None and policy.source == "cli":
-            info.update(_cli_startup_notices(enabled), unknown_toolsets=_unknown_toolsets(enabled, config))
+            info.update(_section(authority, "cli_notices", (pkey, ckey, toolsets), lambda: {
+                **_cli_startup_notices(enabled), "unknown_toolsets": _unknown_toolsets(enabled, config)}))
         with contextlib.suppress(Exception):
             if policy is not None and policy.source == "cli":
-                info["skills"] = _cli_skills()
+                info["skills"] = _section(authority, "cli_skills", ckey, _cli_skills)
             else:
                 from hermes_cli.banner import get_available_skills
-                info["skills"] = get_available_skills()
+                info["skills"] = _section(authority, "skills", ckey, get_available_skills)
         with contextlib.suppress(Exception):
             from tools.mcp_tool_discovery import get_mcp_status
-            info["mcp_servers"] = get_mcp_status()
+            info["mcp_servers"] = _section(authority, "mcp", ckey, get_mcp_status)
     with contextlib.suppress(Exception):
         from hermes_cli import __release_date__
         from hermes_cli.version_info import get_version_info
@@ -183,19 +270,34 @@ def session_inventory(authority, policy, agent, cwd):
     return info
 
 
-async def snapshot_info(authority, ref):
-    """``local_session_info`` plus main's inventory, the builders run off the owner loop."""
+def reused_session_inventory(authority, policy, agent, cwd, *, reuse_s=None):
+    """:func:`session_inventory` whose profile-wide sections built within *reuse_s* seconds
+    (:data:`INVENTORY_REUSE_S`) stand; the agent's own sections are read each time."""
+    token = _reuse_window.set(INVENTORY_REUSE_S if reuse_s is None else reuse_s)
+    try:
+        return session_inventory(authority, policy, agent, cwd)
+    finally:
+        _reuse_window.reset(token)
+
+
+async def snapshot_info(authority, ref, *, reuse=True):
+    """``local_session_info`` plus main's inventory, the builders run off the owner loop. *reuse*: the profile-wide
+    sections built moments ago stand (``reused_session_inventory``); ``session.info`` builds them anew."""
     from gateway.session_local import local_session_info
     from gateway.session_policy import policy_for_source
     info = local_session_info(authority, ref)
     policy = policy_for_source(authority.runner, authority.sessions[ref.session_id].source)
     agent = authority.agent(ref)
-    inventory = await asyncio.to_thread(session_inventory, authority, policy, agent, info.get("cwd"))
+    from gateway.session_usage import snapshot_usage
+
+    def build():  # one trip off the loop: on a starved gateway each trip waits for the CPU
+        return (reused_session_inventory(authority, policy, agent, info.get("cwd"), reuse_s=None if reuse else 0.0),
+                snapshot_usage(authority, ref, agent))
+    inventory, usage = await asyncio.to_thread(build)
     if info.get('tool_count') is None:
         # A lazy session: the tools its first turn loads (the banner's own count).
         info['tool_count'] = sum(len(names) for names in (inventory.get('tools') or {}).values())
-    from gateway.session_usage import snapshot_usage
-    if (usage := await asyncio.to_thread(snapshot_usage, authority, ref, agent)) is not None:
+    if usage is not None:
         info['usage'] = usage
     return {**inventory, **info}
 
